# Google Gemini API Key for AI Preset Generator (/api/generate-options)
# NEVER commit your real API key to git.
#
# 1. Local Development (npm run dev):
#    Copy this file to .env and insert your key from Google AI Studio:
#    GEMINI_API_KEY=your_gemini_api_key_here
#
# 2. Cloudflare Pages (Production):
#    Set in Cloudflare Pages Dashboard -> Settings -> Environment variables -> GEMINI_API_KEY
#
GEMINI_API_KEY=your_gemini_api_key_here

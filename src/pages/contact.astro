---
export const prerender = true;
import Base from '../layouts/Base.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact ToolNest',
  url: 'https://toolnest.pages.dev/contact',
  description: 'Direct contact details and feedback form for ToolNest utilities and inquiries.',
  mainEntity: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
    email: 'hello@toolnest.dev',
  },
};
---

<Base
  title="Contact ToolNest — Support & Inquiries | ToolNest"
  description="Get in touch with the ToolNest team for questions, tool suggestions, feedback, or bug reports. We respond to all inquiries within 24 to 48 hours."
  canonicalPath="/contact"
  ogImage="/og/contact.svg"
  breadcrumbs={[{ name: 'Contact', item: '/contact' }]}
  extraSchemas={[contactSchema]}
>
  <article class="space-y-10 max-w-2xl mx-auto">
    <!-- Header -->
    <header class="space-y-3 text-center sm:text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
        <span>💬</span>
        <span>Support & Feedback</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        Contact ToolNest
      </h1>
      <p class="text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        Have a feature request, spotted a bug, or want to suggest a new client-side tool? We read and reply to all messages.
      </p>
    </header>

    <!-- Quick Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="card p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
          ✉️
        </div>
        <h2 class="text-sm font-bold text-primary-light dark:text-primary-dark">Direct Email</h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark">Reach our engineering team directly via email.</p>
        <a
          href="mailto:hello@toolnest.dev"
          class="inline-block text-xs font-bold text-accent hover:underline pt-1"
        >
          hello@toolnest.dev &rarr;
        </a>
      </div>

      <div class="card p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold text-base">
          ⚡
        </div>
        <h2 class="text-sm font-bold text-primary-light dark:text-primary-dark">Response Time</h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark">We typically respond to inquiries within 24–48 business hours.</p>
        <span class="inline-block text-xs font-semibold text-secondary-light dark:text-secondary-dark pt-1">
          Monday – Friday (UTC)
        </span>
      </div>
    </div>

    <!-- Contact Form Section -->
    <section class="card p-6 sm:p-8 space-y-6" aria-labelledby="form-heading">
      <div class="space-y-1">
        <h2 id="form-heading" class="text-lg font-bold text-primary-light dark:text-primary-dark">
          Send Us a Message
        </h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark">
          Fill out the form below and we will get back to you promptly.
        </p>
      </div>

      <form id="contact-form" class="space-y-4" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
              Your Name <span class="text-accent">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              class="input-base text-sm py-2.5 px-3.5 w-full"
              placeholder="e.g. Alex Smith"
              autocomplete="name"
            />
          </div>

          <div class="space-y-1.5">
            <label for="contact-email" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
              Email Address <span class="text-accent">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="input-base text-sm py-2.5 px-3.5 w-full"
              placeholder="alex@example.com"
              autocomplete="email"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="contact-subject" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
            Topic / Tool <span class="text-accent">*</span>
          </label>
          <select id="contact-subject" name="subject" class="input-base text-sm py-2.5 px-3.5 w-full">
            <option value="general">General Question</option>
            <option value="age-calculator">Age Calculator</option>
            <option value="birthday-facts">Birthday Facts</option>
            <option value="decision-wheel">Decision Wheel</option>
            <option value="random-picker">Random Picker</option>
            <option value="countdown">Countdown Creator</option>
            <option value="names">Name Meanings</option>
            <option value="bug">Bug Report</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="contact-message" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
            Message <span class="text-accent">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            required
            class="input-base text-sm py-2.5 px-3.5 w-full resize-y"
            placeholder="Tell us what you need help with or what we could improve..."
          ></textarea>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="contact-submit-btn"
            class="btn-primary w-full sm:w-auto py-3 px-8 text-sm font-bold shadow-sm shadow-accent/20 cursor-pointer"
          >
            Send Message
          </button>
        </div>

        <!-- Success Toast Alert -->
        <div
          id="contact-status-box"
          class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs sm:text-sm font-medium"
          role="status"
        >
          Thank you! Your inquiry has been received. Our team will review your message and reach out shortly.
        </div>
      </form>
    </section>

    <!-- Trust & Privacy Footnote -->
    <div class="text-center text-xs text-secondary-light dark:text-secondary-dark space-y-1">
      <p>We respect your privacy. Inquiries are never shared or sold.</p>
      <p>
        Review our <a href="/privacy-policy" class="text-accent hover:underline">Privacy Policy</a> to learn how we protect your personal information.
      </p>
    </div>
  </article>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const statusBox = document.getElementById('contact-status-box');
    const submitBtn = document.getElementById('contact-submit-btn');

    if (form && statusBox && submitBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Sending...';

        setTimeout(() => {
          form.reset();
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'Send Message';
          statusBox.classList.remove('hidden');
          statusBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 600);
      });
    }
  </script>
</Base>

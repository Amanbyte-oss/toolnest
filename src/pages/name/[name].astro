---
export const prerender = true;
import NameDetailView from '../../views/NameDetailView.astro';
import namesData from '../../data/names.json';
import { type NameEntry } from '../../i18n';

export async function getStaticPaths() {
  const sorted = [...namesData].sort((a, b) => a.name.localeCompare(b.name));
  return sorted.map((item, index) => {
    const prev = index > 0 ? sorted[index - 1] : sorted[sorted.length - 1];
    const next = index < sorted.length - 1 ? sorted[index + 1] : sorted[0];
    return {
      params: { name: item.slug },
      props: {
        nameData: item,
        prevName: { name: prev.name, slug: prev.slug },
        nextName: { name: next.name, slug: next.slug },
      },
    };
  });
}

const { nameData, prevName, nextName } = Astro.props as {
  nameData: NameEntry;
  prevName: { name: string; slug: string };
  nextName: { name: string; slug: string };
};
---

<NameDetailView nameData={nameData} prevName={prevName} nextName={nextName} lang="en" />

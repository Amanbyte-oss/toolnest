---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import relatedLinksData from '../data/related-links.json';
import { MONTH_NAMES } from '../scripts/birthday-facts.js';

const currentYear = new Date().getFullYear();
const currentMonth = new Date().getMonth() + 1;
const currentDay = new Date().getDate();
const lastUpdatedDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Years array descending from current year down to 1920
const years = Array.from({ length: currentYear - 1920 + 1 }, (_, i) => currentYear - i);
const days = Array.from({ length: 31 }, (_, i) => i + 1);

// Comprehensive FAQ definitions (8 questions targeting core search clusters)
const faqs = [
  {
    question: 'What day of the week was I born on and how is it verified?',
    answer:
      'Your birth weekday is determined by calculating the elapsed days under the Gregorian calendar from a fixed historical anchor point using UTC-standardized timestamps, ensuring that daylight saving time transitions never cause date shift errors.',
  },
  {
    question: 'How do I find my zodiac sign by birthday and what does its element mean?',
    answer:
      'Your Western zodiac sun sign is established by the apparent position of the Sun across the twelve 30-degree celestial sectors (Aries through Pisces). Each sign belongs to an element (Fire, Earth, Air, or Water) that shapes your natural temperament and birthday personality.',
  },
  {
    question: 'What does my birthstone by month and birth flower symbolize?',
    answer:
      'Birthstones are historically attributed gemstones standardized in 1912 by the National Association of Jewelers. Each gem—such as Garnet for January or Emerald for May—carries centuries of cultural lore symbolizing virtues such as strength, wisdom, protection, and prosperity.',
  },
  {
    question: 'What is a golden birthday meaning and when does it happen?',
    answer:
      'A golden birthday (also known as a lucky or champagne birthday) occurs when you turn the exact age matching the calendar day of the month you were born—for example, turning 24 on the 24th of the month. It represents a rare once-in-a-lifetime personal celebration.',
  },
  {
    question: 'What is my numerology life path number and how is it calculated?',
    answer:
      'Your life path number is derived by reducing each component of your birth date (month, day, and year) to single digits using the Pythagorean numerology system, then summing the totals. Master Numbers 11, 22, and 33 are preserved, revealing your overarching life archetype and core personality purpose.',
  },
  {
    question: 'When is my half birthday and why do people celebrate it?',
    answer:
      'Your half birthday occurs exactly six calendar months after your birth date (or approximately 182.5 days). Half birthdays are popular for holiday-born babies (like Christmas or New Year) who prefer celebrating during milder weather, or for tracking mid-year personal milestones.',
  },
  {
    question: 'How are generational cohorts like Gen Z and Millennials determined?',
    answer:
      'Generational cohorts are mapped based on demographic frameworks established by the Pew Research Center. Major cohorts include the Silent Generation (1928–1945), Baby Boomers (1946–1964), Gen X (1965–1980), Millennials (1981–1996), and Gen Z (1997–2012).',
  },
  {
    question: 'Can I download and share my birthday facts card?',
    answer:
      'Yes! ToolNest generates a high-resolution PNG sticker card directly in your browser without sending your personal data to any server. You can save the crisp graphic to your camera roll or tap Share to distribute a formatted text summary across social channels.',
  },
];

const relatedTools = relatedLinksData['birthday-facts'];

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://toolnest.pages.dev/birthday-facts#app',
  name: 'Birthday Facts & Trivia Dossier',
  url: 'https://toolnest.pages.dev/birthday-facts',
  description: 'Find out what day of the week you were born on, your zodiac sign, birthstone, birth flower, lifetime day milestones, and famous birthdays.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
  featureList: [
    'Day of the week birth calculation with calendar accuracy',
    'Western astrological zodiac sign, element, and trait breakdown',
    'Monthly birthstone and birth flower symbolism',
    'Generational cohort identification (Gen Z, Millennial, Gen X, Boomer)',
    'Exportable high-resolution birthday facts sticker card for social sharing',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Discover Your Birthday Facts and Trivia in 3 Steps',
  description: 'A simple guide to discovering your birth weekday, astrological traits, birthstone, and lifetime milestones.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Enter your birth date',
      text: 'Select the month, day, and year you were born using the convenient dropdown selectors or calendar input.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Reveal personalized birthday trivia',
      text: 'Click Reveal My Birthday Facts to calculate your zodiac sign, birthstone, birth flower, and famous birthday twins.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Save or share your trivia card',
      text: 'Download your high-resolution card as a PNG image for social media or copy the summary to share with friends.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  title="What Day Was I Born? Birthday Facts & Zodiac | ToolNest"
  description="Discover the day of the week you were born, your zodiac sign, birthstone, birth flower, and famous birthdays with an exportable trivia card."
  canonicalPath="/birthday-facts"
  ogImage="/og/birthday-facts.svg"
  breadcrumbs={[{ name: 'Tools', item: '/#tools' }, { name: 'Birthday Facts', item: '/birthday-facts' }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
>
  <!-- CDN Scripts for Confetti and Client-Side Card Image Generation -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>

  <!-- Scoped Styles for Shake Animation & Card Sizing -->
  <style>
    @keyframes cardShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .animate-card-shake {
      animation: cardShake 320ms cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }
    @media (prefers-reduced-motion: reduce) {
      .animate-card-shake {
        animation: none !important;
      }
    }
    .shareable-card-container {
      container-type: inline-size;
      container-name: sharecard;
    }
  </style>

  <!-- 1. PAGE HEADER (H1 + one-line subtext) -->
  <header class="text-center py-4 sm:py-6 space-y-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span>Personal Birthday Dossier</span>
    </div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      What Day Was I Born? Birthday Facts & Trivia
    </h1>
    <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      Discover the day of the week you were born, your zodiac traits, birthstone meaning, and lifetime milestones.
    </p>
  </header>

  <!-- 2. INPUT CARD (Clean, thumb-friendly, max-w-xl centered, zero layout shift) -->
  <section
    id="dob-tool"
    class="card max-w-xl mx-auto p-5 sm:p-8 space-y-5 transition-all duration-200"
    aria-labelledby="dob-input-heading"
  >
    <div class="flex items-center justify-between border-b border-border-light dark:border-border-dark pb-3">
      <h2 id="dob-input-heading" class="text-sm sm:text-base font-bold text-primary-light dark:text-primary-dark">
        Select Your Date of Birth
      </h2>
      <span class="text-xs text-secondary-light dark:text-secondary-dark font-medium">
        1920 – {currentYear}
      </span>
    </div>

    <div class="space-y-4">
      <!-- 3 selects in a single row on mobile (Day/Month/Year each flex-1, min-height 48px, 16px font, visible labels above) -->
      <div class="flex items-start gap-2 sm:gap-3.5">
        <!-- Day Dropdown -->
        <div class="flex-1 min-w-0 space-y-1.5">
          <label for="dob-day" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            Day
          </label>
          <select
            id="dob-day"
            class="w-full min-h-[48px] text-base px-2 sm:px-3 py-2.5 rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-primary-light dark:text-primary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent cursor-pointer font-medium transition-colors"
          >
            {days.map((d) => (
              <option value={d} selected={d === 1}>
                {d}
              </option>
            ))}
          </select>
        </div>

        <!-- Month Dropdown -->
        <div class="flex-1 min-w-0 space-y-1.5">
          <label for="dob-month" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            Month
          </label>
          <select
            id="dob-month"
            class="w-full min-h-[48px] text-base px-2 sm:px-3 py-2.5 rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-primary-light dark:text-primary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent cursor-pointer font-medium transition-colors"
          >
            {MONTH_NAMES.map((name, index) => (
              <option value={index + 1} selected={index + 1 === 1}>
                {name}
              </option>
            ))}
          </select>
        </div>

        <!-- Year Dropdown -->
        <div class="flex-1 min-w-0 space-y-1.5">
          <label for="dob-year" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            Year
          </label>
          <select
            id="dob-year"
            class="w-full min-h-[48px] text-base px-2 sm:px-3 py-2.5 rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-primary-light dark:text-primary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent cursor-pointer font-medium transition-colors"
          >
            {years.map((y) => (
              <option value={y} selected={y === 1995}>
                {y}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Inline Validation Error -->
      <div
        id="facts-date-error"
        class="hidden rounded-xl border border-red-500/30 bg-red-500/10 dark:bg-red-500/15 p-3 text-xs sm:text-sm text-red-600 dark:text-red-400 font-medium flex items-center gap-2"
        role="alert"
        aria-live="polite"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span id="facts-date-error-text">Please enter a valid calendar date.</span>
      </div>

      <!-- Footer Action Area: Native Picker + Reveal Button -->
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 pt-1">
        <!-- Native Date Picker toggle -->
        <div class="flex items-center gap-2 text-xs text-secondary-light dark:text-secondary-dark">
          <label for="native-dob-date" class="cursor-pointer hover:text-accent transition-colors">
            Or pick from calendar:
          </label>
          <input
            type="date"
            id="native-dob-date"
            value="1995-01-01"
            max={`${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(currentDay).padStart(2, '0')}`}
            min="1920-01-01"
            class="rounded-lg border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark px-2.5 py-1 text-xs text-primary-light dark:text-primary-dark focus:outline-none focus:border-accent"
            aria-label="Native date picker"
          />
        </div>

        <!-- Reveal My Facts Button: sticky bottom on mobile, inline right-aligned on lg -->
        <div class="sticky bottom-3 z-20 lg:static lg:z-auto pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))] lg:pb-0 bg-surface-light/95 dark:bg-surface-dark/95 lg:bg-transparent backdrop-blur-md lg:backdrop-blur-none -mx-2 px-2 lg:mx-0 lg:px-0">
          <button
            id="reveal-facts-btn"
            type="button"
            class="btn-primary w-full lg:w-auto px-7 py-3 text-sm sm:text-base font-bold shadow-md shadow-accent/20 cursor-pointer justify-center"
            aria-describedby="facts-date-error"
          >
            Reveal My Facts
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RESULTS CONTAINER (Revealed on click with 50ms stagger) -->
  <div id="facts-results-container" class="hidden mt-10 space-y-12 sm:space-y-14 scroll-mt-24">
    
    <!-- 3A. SHAREABLE RESULT CARD & ACTIONS -->
    <section class="result-section-anim flex flex-col items-center space-y-4" aria-label="Personal Birthday Card">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
          Your Personal Birthday Card
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          Share your celebration sticker or save as a crisp high-res image.
        </p>
      </div>

      <!-- Centerpiece Shareable Card: max-w-sm (420px), fixed 4:5 aspect, container-relative sizing -->
      <div class="shareable-card-container w-full max-w-[420px] mx-auto px-1 sm:px-0">
        <div
          id="shareable-card"
          class="w-full aspect-[4/5] rounded-3xl border-2 border-slate-200/90 bg-white text-slate-900 p-4 sm:p-5 shadow-xl relative overflow-hidden flex flex-col justify-between ring-1 ring-black/5 select-none"
        >
          <!-- Top decorative gradient line -->
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-accent via-indigo-400 to-purple-500"></div>

          <!-- Card Header: Emoji, Generation Badge, Weekday Headline -->
          <div class="text-center space-y-1 pt-1">
            <div class="text-2xl sm:text-3xl leading-none" id="card-emoji">🎂</div>
            <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-accent/10 text-accent mx-auto" id="card-generation-badge">
              Generation
            </div>
            <h3 class="text-base sm:text-xl font-extrabold text-slate-900 tracking-tight leading-tight">
              Born on <span id="card-weekday" class="text-accent">Wednesday</span>
            </h3>
            <p id="card-formatted-date" class="text-[11px] sm:text-xs font-semibold text-slate-500">
              January 1, 1995
            </p>
          </div>

          <!-- Zodiac Row: Symbol + Sign Name + Element + Traits -->
          <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-1">
            <div class="flex items-center justify-center gap-1.5 sm:gap-2">
              <span id="card-zodiac-symbol" class="text-xl leading-none">♈</span>
              <span id="card-zodiac-name" class="text-xs sm:text-sm font-bold text-slate-900">Aries</span>
              <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-md bg-white border border-slate-200 font-semibold text-slate-600" id="card-zodiac-element">
                Fire
              </span>
            </div>
            <div id="card-zodiac-traits" class="flex flex-wrap items-center justify-center gap-1">
              <!-- Dynamic trait chips -->
            </div>
          </div>

          <!-- Mini Cards: Birthstone + Birth Flower (Side by side, robust truncation) -->
          <div class="grid grid-cols-2 gap-2">
            <!-- Birthstone Mini Card -->
            <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-0.5 min-w-0">
              <span class="text-base sm:text-lg block leading-none">💎</span>
              <span class="text-[9px] sm:text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
                Birthstone
              </span>
              <span id="card-stone-name" class="text-xs sm:text-sm font-bold text-slate-900 block truncate">
                Garnet
              </span>
              <p id="card-stone-meaning" class="text-[10px] sm:text-[11px] text-slate-500 line-clamp-1 leading-tight">
                Symbolizes protection & vitality.
              </p>
            </div>

            <!-- Birth Flower Mini Card -->
            <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-0.5 min-w-0">
              <span class="text-base sm:text-lg block leading-none">🌸</span>
              <span class="text-[9px] sm:text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
                Birth Flower
              </span>
              <span id="card-flower-name" class="text-xs sm:text-sm font-bold text-slate-900 block truncate">
                Carnation
              </span>
              <p id="card-flower-meaning" class="text-[10px] sm:text-[11px] text-slate-500 line-clamp-1 leading-tight">
                Symbolizes devotion & love.
              </p>
            </div>
          </div>

          <!-- Alive for X Days Accent Line -->
          <div class="py-1.5 sm:py-2 px-3 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-between">
            <span class="text-[10px] sm:text-xs font-semibold text-slate-600">
              Days on Earth:
            </span>
            <span class="text-xs sm:text-sm font-black text-accent tracking-tight" id="card-days-lived">
              0 days
            </span>
          </div>

          <!-- Card Watermark Footer -->
          <div class="pt-1.5 border-t border-slate-200/80 flex items-center justify-between text-[10px] sm:text-[11px] text-slate-400">
            <span class="font-bold text-slate-700">ToolNest</span>
            <span>toolnest.pages.dev</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons Row (stacked mobile, inline sm+) -->
      <div class="w-full max-w-[420px] mx-auto flex flex-col sm:flex-row items-center gap-2.5 pt-2">
        <button
          id="download-card-btn"
          type="button"
          class="btn-primary w-full sm:flex-1 py-3 text-xs sm:text-sm font-semibold justify-center gap-2 cursor-pointer shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Save Card as Image</span>
        </button>

        <button
          id="share-facts-btn"
          type="button"
          class="btn-secondary w-full sm:flex-1 py-3 text-xs sm:text-sm font-semibold justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
          </svg>
          <span>Share Facts</span>
        </button>

        <button
          id="reset-facts-btn"
          type="button"
          class="btn-secondary w-full sm:w-auto px-4 py-3 text-xs sm:text-sm font-medium justify-center shrink-0 cursor-pointer"
        >
          Calculate Another
        </button>
      </div>
    </section>

    <!-- 3B. FAMOUS BIRTHDAYS (responsive grid: 1 -> sm:2 -> lg:3 with fixed height & truncation) -->
    <section id="famous-section" class="result-section-anim space-y-4 pt-6 border-t border-border-light dark:border-border-dark" aria-labelledby="famous-heading">
      <div class="space-y-1 text-center sm:text-left">
        <h2 id="famous-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark flex items-center justify-center sm:justify-start gap-2">
          <span>🌟</span>
          <span>Famous Birthdays (<span id="famous-date-heading">Date</span>)</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          Notable icons, visionaries, and historical figures who share your birthday.
        </p>
      </div>

      <!-- Leap day notice if applicable -->
      <div id="leap-day-notice" class="hidden p-3 rounded-xl bg-accent/10 border border-accent/20 text-xs text-accent font-medium"></div>

      <!-- Famous People Responsive Grid -->
      <div id="famous-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <!-- Injected via JavaScript -->
      </div>
    </section>

    <!-- 3C. FACTS GRID (4-card responsive grid: 1 -> sm:2 -> lg:4 + Life Path Card) -->
    <section id="facts-grid-section" class="result-section-anim space-y-4 pt-6 border-t border-border-light dark:border-border-dark" aria-labelledby="facts-grid-heading">
      <div class="space-y-1 text-center sm:text-left">
        <h2 id="facts-grid-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark flex items-center justify-center sm:justify-start gap-2">
          <span>✨</span>
          <span>Birthday Dossier & Archetypes</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          Astrological, mineralogical, botanical, and demographic facets linked to your birth date.
        </p>
      </div>

      <!-- 4-Card Responsive Grid with consistent min-height for row alignment -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Zodiac Sign -->
        <div class="card p-5 flex flex-col justify-between min-h-[170px] space-y-2 border border-border-light dark:border-border-dark">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span id="detail-zodiac-symbol" class="text-2xl">♈</span>
              <span id="detail-zodiac-element" class="text-xs px-2.5 py-0.5 rounded-full font-semibold bg-accent/10 text-accent border border-accent/20">Fire</span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">Zodiac Sign</span>
            <h3 id="detail-zodiac-name" class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark">Aries</h3>
          </div>
          <p id="detail-zodiac-meaning" class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            Bold, energetic, and courageous temperament.
          </p>
        </div>

        <!-- Card 2: Birthstone -->

---
export const prerender = true;
import Base from '../layouts/Base.astro';

const tools = [
  { name: '🎂 Age Calculator', href: '/age-calculator', desc: 'Exact age & life stats' },
  { name: '🎉 Birthday Facts', href: '/birthday-facts', desc: 'Zodiac & milestones' },
  { name: '🎡 Decision Wheel', href: '/decision-wheel', desc: 'Spin to decide' },
  { name: '🎯 Random Picker', href: '/random-picker', desc: 'Fair prize & name drawing' },
  { name: '⏳ Countdown Creator', href: '/countdown', desc: 'Live event timers' },
  { name: '📖 Name Meanings', href: '/name-meaning', desc: '200+ origins & meanings' },
];
---

<Base
  title="Page Not Found (404) | ToolNest"
  description="Sorry, this page wandered off! Explore our collection of free, private, client-side web tools."
  canonicalPath="/404"
  noindex={true}
>
  <div class="py-8 sm:py-16 text-center space-y-8 max-w-xl mx-auto">
    <!-- Big 404 Badge & Visual -->
    <div class="space-y-3">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-3xl shadow-sm text-accent">
        🧭
      </div>
      <div class="font-mono text-5xl sm:text-6xl font-black text-accent tracking-tight">
        404
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        This page wandered off
      </h1>
      <p class="text-sm sm:text-base text-secondary-light dark:text-secondary-dark max-w-md mx-auto leading-relaxed">
        We couldn't find the page you were looking for. It might have been moved, renamed, or perhaps never existed.
      </p>
    </div>

    <!-- Home Action Button -->
    <div>
      <a href="/" class="btn-primary inline-flex py-3 px-6 text-sm font-bold shadow-md shadow-accent/20">
        &larr; Back to Home Overview
      </a>
    </div>

    <!-- Grid of Links to All 6 Tools -->
    <div class="pt-6 border-t border-border-light dark:border-border-dark space-y-4 text-left">
      <h2 class="text-sm font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark text-center">
        Explore Our Free Tools
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group card p-3.5 hover:border-accent/60 transition-all flex items-center justify-between"
          >
            <div>
              <span class="text-sm font-bold text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors block">
                {tool.name}
              </span>
              <span class="text-xs text-secondary-light dark:text-secondary-dark">
                {tool.desc}
              </span>
            </div>
            <svg class="w-4 h-4 text-secondary-light dark:text-secondary-dark group-hover:text-accent group-hover:translate-x-0.5 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>

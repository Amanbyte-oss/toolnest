---
export const prerender = true;
import AboutView from '../../views/AboutView.astro';
import { LOCALES, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
---

<AboutView lang={lang} />

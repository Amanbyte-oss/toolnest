---
export const prerender = true;
import CountdownViewerView from '../../../views/CountdownViewerView.astro';
import { NON_DEFAULT_LOCALES, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
---

<CountdownViewerView lang={lang} />

---
export const prerender = true;
import FaqView from '../../views/FaqView.astro';
import { LOCALES, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
---

<FaqView lang={lang} />

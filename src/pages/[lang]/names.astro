---
export const prerender = true;
import NamesView from '../../views/NamesView.astro';
import { LOCALES, type Lang } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
---

<NamesView lang={lang} />

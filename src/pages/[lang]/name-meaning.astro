---
export const prerender = true;
import NameMeaningView from '../../views/NameMeaningView.astro';
import { NON_DEFAULT_LOCALES, type Lang } from '../../i18n';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
---

<NameMeaningView lang={lang} />

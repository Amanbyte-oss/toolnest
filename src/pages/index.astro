---
export const prerender = true;
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';

const tools = [
  {
    title: 'Age Calculator',
    description: 'Years, months, days, minutes, seconds. Exact.',
    href: '/age-calculator',
    badge: 'Popular',
    icon: 'calendar',
    popular: true,
  },
  {
    title: 'Birthday Facts',
    description: 'Zodiac, birthstone, famous birthdays and a shareable card.',
    href: '/birthday-facts',
    badge: 'Trivia',
    icon: 'cake',
    popular: false,
  },
  {
    title: 'Decision Wheel',
    description: "Can't decide? Spin the interactive wheel.",
    href: '/decision-wheel',
    badge: 'Randomizer',
    icon: 'wheel',
    popular: false,
  },
  {
    title: 'Random Picker',
    description: 'Pick winners from any list fairly with crypto randomness.',
    href: '/random-picker',
    badge: 'Utility',
    icon: 'dice',
    popular: false,
  },
  {
    title: 'Countdown Timer',
    description: 'Live countdowns you can share with a link.',
    href: '/countdown',
    badge: 'Time',
    icon: 'clock',
    popular: false,
  },
  {
    title: 'Name Meanings',
    description: 'Look up any name for instant origins, meanings, and personality insights.',
    href: '/name-meaning',
    badge: 'AI + Database',
    icon: 'book',
    popular: false,
  },
];
---

<Base
  title="ToolNest — Free, Private Online Web Utilities"
  description="Fast, client-side web tools for everyday decisions and questions. Exact age calculator, decision wheel spinner, random picker, and countdown timers."
  canonicalPath="/"
  ogImage="/og/home.svg"
  maxWidthClass="max-w-5xl"
>
  <!-- Hero Section with polished subtle slate gradient background -->
  <section class="relative overflow-hidden rounded-3xl border border-border-light/80 dark:border-border-dark/80 bg-gradient-to-b from-slate-100/80 via-white to-slate-50/50 dark:from-[#15181C] dark:via-[#1B1E21] dark:to-[#111315] px-6 py-12 sm:py-16 text-center mb-8 shadow-sm">
    <div class="max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-medium text-primary-light dark:text-primary-dark">ToolNest</span>
        <span>•</span>
        <span>100% Client-Side Utilities</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark leading-[1.15]">
        Free tools for everyday questions
      </h1>

      <p class="text-base sm:text-lg text-secondary-light dark:text-secondary-dark max-w-xl mx-auto leading-relaxed">
        Simple, accurate, and private micro-tools for quick calculations, daily decisions, and timely countdowns. No sign-ups, no databases, zero tracking.
      </p>

      <div class="pt-2">
        <a href="#tools-grid" class="btn-primary inline-flex items-center gap-2 shadow-sm">
          <span>Explore Tools</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- "Jump Back In" Recent History Horizontal Chips -->
  <section id="jump-back-in-section" class="hidden mb-10 space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        <svg class="w-3.5 h-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Jump Back In</span>
      </div>
      <span class="text-[11px] text-secondary-light/70 dark:text-secondary-dark/70">From this device</span>
    </div>

    <div
      id="jump-back-in-chips"
      class="flex items-center gap-2.5 overflow-x-auto pb-2 pt-0.5 no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0"
    >
      <!-- Populated dynamically via client-side script -->
    </div>
  </section>

  <!-- Tools Grid Section (1 col mobile, 2 cols sm, 3 cols lg) -->
  <section id="tools-grid" class="scroll-mt-20 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-border-light dark:border-border-dark pb-4">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
          Available Tools
        </h2>
        <p class="text-sm text-secondary-light dark:text-secondary-dark">
          Instant client-side utilities engineered for speed on all devices.
        </p>
      </div>
      <span class="inline-flex items-center self-start sm:self-auto px-2.5 py-1 rounded-full text-xs font-medium bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark">
        6 Tools Online
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {tools.map((tool) => (
        <ToolCard
          title={tool.title}
          description={tool.description}
          href={tool.href}
          badge={tool.badge}
          icon={tool.icon}
          popular={tool.popular}
        />
      ))}
    </div>
  </section>

  <!-- Under-grid SEO Intro Block -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark">
    <div class="card space-y-4">
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
        Why Use ToolNest for Everyday Tasks?
      </h2>

      <div class="space-y-3 text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>
          ToolNest brings together a suite of fast, lightweight online utilities designed to solve common everyday questions without friction. Whether you need to determine your exact chronological age in years, months, and days down to the second, look up memorable cultural facts for an upcoming birthday, or make unbiased choices with an interactive decision wheel, our tools deliver accurate results instantaneously.
        </p>
        <p>
          Unlike traditional web calculators bloated with intrusive tracking scripts, heavy client libraries, and mandatory registrations, every single tool on ToolNest operates completely client-side in vanilla JavaScript. Your inputs, birth dates, custom lists, and timer settings never leave your device or touch a remote database, ensuring complete digital privacy and lightning-fast execution on both mobile networks and desktop connections.
        </p>
        <p>
          Engineered from the ground up with a mobile-first philosophy, our intuitive slate-grey interface adapts seamlessly to smartphone screens as narrow as 320px while offering full desktop ergonomics. Each tool is built for maximum clarity, accessible tap targets, and clean shareability—giving you dependable utility whenever and wherever you need it.
        </p>
      </div>
    </div>
  </section>

  <!-- Popular Searches & Keyword Anchor Directory -->
  <section class="mt-8 pt-8 border-t border-border-light dark:border-border-dark" aria-labelledby="popular-searches-heading">
    <div class="card p-5 sm:p-6 space-y-3 bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 id="popular-searches-heading" class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Popular Searches & Online Utilities
        </h2>
        <span class="text-[11px] text-accent font-medium">Quick Anchor Directory</span>
      </div>
      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/age-calculator" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          age calculator
        </a>
        <a href="/age-calculator" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          calculate my age
        </a>
        <a href="/birthday-facts" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          what day of the week was I born
        </a>
        <a href="/birthday-facts" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          zodiac sign by birthday
        </a>
        <a href="/decision-wheel" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          spin the wheel
        </a>
        <a href="/decision-wheel" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          what to eat for dinner decider
        </a>
        <a href="/random-picker" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          random name picker
        </a>
        <a href="/random-picker" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          random team picker
        </a>
        <a href="/countdown" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          days until calculator
        </a>
        <a href="/countdown" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          countdown timer online free
        </a>
        <a href="/name-meaning" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          name meanings
        </a>
        <a href="/names" class="px-3 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors font-medium">
          baby name ideas
        </a>
      </div>
    </div>
  </section>

  <script>
    import { getAllRecentHistory, formatRelativeTime } from '../scripts/history.js';

    function renderJumpBackIn() {
      const section = document.getElementById('jump-back-in-section');
      const container = document.getElementById('jump-back-in-chips');
      if (!section || !container) return;

      const recent = getAllRecentHistory(4);
      if (!recent || recent.length === 0) {
        section.classList.add('hidden');
        return;
      }

      container.innerHTML = recent
        .map(
          (item) => `
        <a
          href="${item.href}"
          class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark hover:border-accent/50 text-xs shadow-xs hover:shadow-sm hover:-translate-y-0.5 active:scale-95 transition-all shrink-0 group focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Reopen ${item.toolTitle}: ${item.t}"
        >
          <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-accent/10 text-accent dark:bg-accent/20">
            ${item.badge}
          </span>
          <span class="font-medium text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors truncate max-w-[150px] sm:max-w-[220px]">
            ${item.t}
          </span>
          <span class="text-[10px] text-secondary-light/70 dark:text-secondary-dark/70 shrink-0">
            ${formatRelativeTime(item.d)}
          </span>
        </a>
      `
        )
        .join('');

      section.classList.remove('hidden');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderJumpBackIn);
    } else {
      renderJumpBackIn();
    }
    window.addEventListener('toolnest:history-updated', renderJumpBackIn);
  </script>
</Base>

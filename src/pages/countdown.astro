---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import relatedLinksData from '../data/related-links.json';
import { PRESET_EMOJIS } from '../scripts/countdown.js';
import CountdownShareCard from '../components/CountdownShareCard.astro';

const lastUpdatedDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Comprehensive FAQ definitions (8 questions targeting core search clusters)
const faqs = [
  {
    question: 'Is this countdown timer online free and account-free?',
    answer:
      'Yes! ToolNest is 100% free with no registration, no email signup, no paywalls, and no ads. You can generate unlimited live event countdowns with real-time ticking seconds.',
  },
  {
    question: 'Can I use this as a days until calculator or live New Year countdown?',
    answer:
      'Yes! Use our quick preset buttons to launch an instant New Year countdown live, Christmas clock, or summer vacation timer. You can also calculate exact days until milestones with our customizable birthday countdown preset.',
  },
  {
    question: 'Where is my countdown timer stored and how does the share link work?',
    answer:
      'All event information—including your title, emoji, and target timestamp—is compressed directly into the shareable URL parameters. Because no database is involved, your link works permanently and will never expire.',
  },
  {
    question: 'How do I share a countdown link across WhatsApp, Instagram, or Discord?',
    answer:
      'After creating your timer, click "Share Link" or "Copy URL" to share countdown link URLs with your group. Paste the link into WhatsApp chats, Instagram Stories, Discord channels, or wedding invites. Anyone who clicks will see the live ticking timer synchronized to their local time.',
  },
  {
    question: 'How does the countdown handle friends in different time zones?',
    answer:
      'Timestamps are encoded in ISO-8601 UTC format. When someone in New York, London, or Tokyo clicks your link, their browser automatically translates the target time into their local timezone for a perfectly synchronized global countdown.',
  },
  {
    question: 'What happens when the countdown clock reaches zero?',
    answer:
      'The moment the timer strikes zero, the page automatically bursts with colorful confetti, displays a celebratory greeting ("It\'s here!"), and transitions into an elapsed time counter showing how long ago the milestone began.',
  },
  {
    question: 'Can I set an exact target hour and minute for my event countdown?',
    answer:
      'Yes! You can specify the exact calendar date, hour, and minute for your deadline or celebration. The clock continuously ticks down days, hours, minutes, and live seconds until the exact moment arrives.',
  },
  {
    question: 'Can I embed or view the timer full screen for livestreams?',
    answer:
      'Yes! Tapping the view link opens a distraction-free, full-screen live countdown display ideal for event projector screens, Twitch/YouTube streaming overlays, and office countdown boards.',
  },
];

const relatedTools = relatedLinksData['countdown'];

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://toolnest.pages.dev/countdown#app',
  name: 'Shareable Online Countdown Timer Clock',
  url: 'https://toolnest.pages.dev/countdown',
  description: 'Create and share live countdown timers online with friends. Zero account, zero database: all data is encoded in the shareable link.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
  featureList: [
    'Live ticking real-time countdown timer down to the second',
    'Stateless URL compression for permanent zero-database sharing',
    'Celebration state with confetti explosion when counter reaches zero',
    'Local timezone auto-detection for international recipients',
    'Preset templates for New Year, Summer, Halloween, and Christmas',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Create and Share a Countdown Timer in 3 Steps',
  description: 'A step-by-step guide to generating a live, shareable event countdown clock without an account.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Set your event title and date',
      text: 'Pick a name, target date, time, and custom icon or choose a holiday template.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Preview your live countdown',
      text: 'Review your ticking countdown card with real-time days, hours, minutes, and seconds.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Copy and share your permanent link',
      text: 'Copy your stateless countdown link and share it on WhatsApp, Discord, or Instagram.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  title="Online Countdown Timer — Share Event Clock | ToolNest"
  description="Free online countdown timer for birthdays, holidays, and milestones. Share live countdown clocks with custom links—no signup or database needed."
  canonicalPath="/countdown"
  ogImage="/og/countdown.svg"
  breadcrumbs={[{ name: 'Tools', item: '/#tools' }, { name: 'Countdown Timer', item: '/countdown' }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
>
  <script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>

  <!-- Hidden Share Card for 1080x1350 PNG export -->
  <CountdownShareCard id="creator-share-card" />

  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <span>⏳</span>
      <span>Shareable Event Timer</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      Online Countdown Timer — Share Event Clock
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      Create a live ticking countdown timer for any special moment. No database, no login: share the link with friends instantly.
    </p>
  </header>

  <!-- KEY TAKEAWAYS / FEATURED SNIPPET SUMMARY BOX -->
  <aside class="card mt-4 p-4 sm:p-5 border-l-4 border-accent bg-accent/5 space-y-2" aria-label="Key Takeaways">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent">
      <span>⚡</span>
      <span>Quick Answer & Key Takeaways</span>
    </div>
    <ul class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark space-y-1.5 list-disc list-inside leading-relaxed">
      <li><strong>Stateless Sharing:</strong> Every timer is encoded into the URL parameters so links never expire and require zero server databases.</li>
      <li><strong>Auto Timezone Sync:</strong> Uses ISO-8601 UTC timestamps, automatically converting the target date to every viewer's local time zone.</li>
      <li><strong>Celebration Finale:</strong> Automatically triggers confetti celebrations and elapsed time tracking the moment the counter hits zero.</li>
    </ul>
  </aside>

  <!-- QUICK TEMPLATES & COUNTDOWN IDEAS -->
  <section class="mt-6 space-y-2" aria-labelledby="templates-heading">
    <div class="flex items-center justify-between">
      <span id="templates-heading" class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
        Popular Countdown Ideas (Click to Prefill)
      </span>
      <span class="text-[11px] text-accent font-medium">10 Quick Presets</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-template="newyear"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎆</span>
        <span>New Year</span>
      </button>
      <button
        type="button"
        data-template="christmas"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎄</span>
        <span>Christmas</span>
      </button>
      <button
        type="button"
        data-template="halloween"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎃</span>
        <span>Halloween</span>
      </button>
      <button
        type="button"
        data-template="summersolstice"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>☀️</span>
        <span>Summer Solstice</span>
      </button>
      <button
        type="button"
        data-template="friday5pm"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🍻</span>
        <span>Next Friday 5 PM</span>
      </button>
      <button
        type="button"
        data-template="fullmoon"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🌕</span>
        <span>Next Full Moon</span>
      </button>
      <button
        type="button"
        data-template="graduation"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎓</span>
        <span>Graduation</span>
      </button>
      <button
        type="button"
        data-template="birthday"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎂</span>
        <span>Birthday</span>
      </button>
      <button
        type="button"
        data-template="vacation"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>✈️</span>
        <span>Summer Vacation</span>
      </button>
      <button
        type="button"
        data-template="productlaunch"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🚀</span>
        <span>Product Launch</span>
      </button>
    </div>
  </section>

  <!-- CREATOR INPUT CARD -->
  <section class="card mt-6 space-y-6" aria-labelledby="creator-form-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex items-center justify-between">
      <h2 id="creator-form-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
        Event Details
      </h2>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        All data is preserved in the link
      </span>
    </div>

    <!-- Event Title Input -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-between">
        <label for="event-title-input" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Event Title
        </label>
        <span id="title-char-count" class="text-xs text-secondary-light dark:text-secondary-dark">
          0 / 60
        </span>
      </div>
      <input
        id="event-title-input"
        type="text"
        maxlength="60"
        class="input-base text-base"
        placeholder="e.g. Vacation in Hawaii, Graduation Day, Product Launch"
        value="Trip to Hawaii"
        autocomplete="off"
      />
    </div>

    <!-- Target Date & Time Input -->
    <div class="space-y-1.5">
      <label for="event-datetime-input" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        Target Date & Time (Local Time)
      </label>
      <input
        id="event-datetime-input"
        type="datetime-local"
        class="input-base text-base cursor-pointer"
        aria-describedby="datetime-error-msg"
      />
      <!-- Inline Error Alert -->
      <div
        id="datetime-error-msg"
        class="hidden text-xs text-error font-medium items-center gap-1.5 pt-1"
        role="alert"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Target date and time must be in the future.</span>
      </div>
    </div>

    <!-- Emoji Picker Row -->
    <div class="space-y-2">
      <label class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        Pick an Event Emoji
      </label>
      <div class="flex flex-wrap items-center gap-2.5" id="emoji-picker-container">
        {PRESET_EMOJIS.map((emoji, idx) => (
          <button
            type="button"
            data-emoji={emoji}
            class={`emoji-btn w-11 h-11 rounded-xl text-xl flex items-center justify-center border transition-all cursor-pointer select-none ${
              idx === 0
                ? 'border-accent bg-accent/15 ring-2 ring-accent'
                : 'border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark hover:border-accent'
            }`}
            aria-label={`Select ${emoji} emoji`}
          >
            {emoji}
          </button>
        ))}
      </div>
    </div>

    <!-- LIVE PREVIEW CARD (Real-time dynamic updates) -->
    <div class="pt-4 border-t border-border-light dark:border-border-dark space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Live Preview
        </span>
        <span class="text-[11px] text-accent font-medium flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Ticking live</span>
        </span>
      </div>

      <!-- Mini Live Preview Box -->
      <div class="p-5 rounded-2xl border border-border-light dark:border-border-dark bg-gradient-to-b from-surface-light to-bg-light dark:from-surface-dark dark:to-bg-dark shadow-sm text-center space-y-3">
        <div class="flex items-center justify-center gap-2">
          <span id="preview-emoji" class="text-2xl">🎉</span>
          <h3 id="preview-title" class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark truncate max-w-xs">
            Trip to Hawaii
          </h3>
        </div>

        <!-- 4-unit mini timer -->
        <div class="grid grid-cols-4 gap-2 max-w-xs mx-auto">
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-days" class="font-mono text-xl sm:text-2xl font-black text-accent block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">Days</span>
          </div>
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-hours" class="font-mono text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">Hours</span>
          </div>
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-minutes" class="font-mono text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">Mins</span>
          </div>
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-seconds" class="font-mono text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">Secs</span>
          </div>
        </div>

        <!-- Preview Share & Download Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-1 border-t border-border-light/60 dark:border-border-dark/60 mt-3">
          <button
            id="preview-download-image-btn"
            type="button"
            class="btn-secondary py-1.5 px-3 text-xs font-semibold gap-1.5 cursor-pointer flex items-center justify-center transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
            aria-label="Download preview image"
          >
            <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download PNG</span>
          </button>
          <button
            id="preview-share-image-btn"
            type="button"
            class="btn-secondary py-1.5 px-3 text-xs font-semibold gap-1.5 cursor-pointer flex items-center justify-center transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
            aria-label="Share preview image"
          >
            <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
              <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
            </svg>
            <span>Share Image</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Desktop Create Button -->
    <div class="pt-2">
      <button
        id="create-countdown-btn"
        type="button"
        class="btn-primary w-full sm:w-auto sm:px-8 py-3.5 text-base font-bold shadow-md shadow-accent/20 cursor-pointer"
      >
        Create Countdown Link
      </button>
    </div>

    <!-- Sticky Mobile Button -->
    <div class="sm:hidden fixed bottom-3 left-4 right-4 z-30 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))]">
      <button
        id="mobile-create-countdown-btn"
        type="button"
        class="btn-primary w-full py-3.5 text-base font-bold shadow-xl shadow-accent/25 flex items-center justify-center gap-2 cursor-pointer"
        style="touch-action: manipulation;"
      >
        <span>⏳</span>
        <span>CREATE COUNTDOWN LINK</span>
      </button>
    </div>
  </section>

  <!-- Recent Activity History Card -->
  <div class="mt-8">
    <HistoryCard toolId="countdown" title="Recent Countdowns" icon="⏳" />
  </div>

  <!-- GENERATED LINK MODAL / OUTPUT CARD -->
  <section
    id="created-link-section"
    class="hidden mt-8 card space-y-4 border-2 border-accent/40 scroll-mt-20"
    aria-labelledby="share-link-heading"
  >
    <div class="flex items-center gap-2 text-emerald-500 font-bold text-sm">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <h3 id="share-link-heading" class="text-base text-primary-light dark:text-primary-dark">
        Your Countdown Link is Ready!
      </h3>
    </div>
    <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
      Anyone with this URL can view your live ticking countdown in their local time.
    </p>

    <!-- Readonly Link Box with Copy Button -->
    <div class="flex items-center gap-2">
      <input
        id="generated-url-input"
        type="text"
        readonly
        class="input-base text-xs font-mono text-secondary-light dark:text-secondary-dark select-all"
        aria-label="Generated Countdown Link"
      />
      <button
        id="copy-generated-url-btn"
        type="button"
        class="btn-primary shrink-0 py-2.5 px-4 text-xs font-semibold gap-1.5 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span>Copy Link</span>
      </button>
    </div>

    <!-- 48px+ Primary Image Actions (Instagram / WhatsApp Status) -->
    <div class="pt-2 border-t border-border-light/60 dark:border-border-dark/60">
      <div class="text-xs font-medium text-secondary-light dark:text-secondary-dark mb-2.5 flex items-center gap-1.5">
        <span>📸</span>
        <span>Share as Image (1080×1350 Story / Status Card)</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <button
          id="creator-download-image-btn"
          type="button"
          class="btn-secondary min-h-[48px] py-3 px-4 text-xs sm:text-sm font-bold gap-2 cursor-pointer flex items-center justify-center border-border-light dark:border-border-dark w-full transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
          aria-label="Download countdown image card"
        >
          <svg class="w-4 h-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Download image</span>
        </button>

        <button
          id="creator-share-image-btn"
          type="button"

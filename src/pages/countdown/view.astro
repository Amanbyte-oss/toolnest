---
export const prerender = true;
import Base from '../../layouts/Base.astro';
import CountdownShareCard from '../../components/CountdownShareCard.astro';

// Base WebApplication Schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Live Countdown Viewer',
  url: 'https://toolnest.pages.dev/countdown/view',
  description: 'View real-time countdown timers for events, deadlines, birthdays, and holidays in your local timezone.',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<Base
  title="⏳ Live Countdown | ToolNest"
  description="Someone created a live countdown for you! Open to see the remaining days, hours, minutes, and seconds until the event in real time."
  canonicalPath="/countdown/view"
  breadcrumbs={[
    { name: 'Countdown Timer', item: '/countdown' },
    { name: 'Live Countdown', item: '/countdown/view' },
  ]}
  extraSchemas={[webAppSchema]}
  noindex={true}
>
  <!-- CDN Confetti for Celebration State & html-to-image for High-Res PNG Export -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>

  <!-- Hidden Offscreen Render Target for High-Resolution PNG Export (540x675 @2x = 1080x1350) -->
  <CountdownShareCard id="viewer-share-card" />

  <div class="py-6 sm:py-12 flex flex-col items-center justify-center min-h-[65vh]">
    <!-- INVALID / MISSING DATA FALLBACK CARD -->
    <div
      id="countdown-error-card"
      class="hidden card max-w-md w-full text-center p-6 sm:p-8 space-y-4"
      role="alert"
    >
      <div class="text-4xl">⚠️</div>
      <h2 class="text-xl font-bold text-primary-light dark:text-primary-dark">
        Countdown Not Found
      </h2>
      <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
        This countdown link is missing or corrupted. You can easily create a fresh, shareable countdown in seconds!
      </p>
      <div class="pt-2">
        <a href="/countdown" class="btn-primary inline-flex py-3 px-6 text-sm font-bold">
          Create a New Countdown &rarr;
        </a>
      </div>
    </div>

    <!-- MAIN COUNTDOWN VIEWER STAGE -->
    <div id="countdown-stage" class="hidden w-full max-w-xl text-center space-y-7">
      <!-- Header: Emoji + Title + Target Local Time -->
      <div class="space-y-2">
        <div id="viewer-emoji" class="text-5xl sm:text-6xl select-none animate-bounce">
          🎉
        </div>
        <h1
          id="viewer-title"
          class="text-2xl sm:text-4xl font-black text-primary-light dark:text-primary-dark tracking-tight px-2 break-words"
        >
          Loading Event...
        </h1>
        <p
          id="viewer-target-date"
          class="text-xs sm:text-sm font-medium text-secondary-light dark:text-secondary-dark"
        >
          Calculating target time...
        </p>
      </div>

      <!-- CELEBRATION BANNER (Shown when zero reached) -->
      <div
        id="celebration-banner"
        class="hidden py-3 px-5 rounded-2xl bg-gradient-to-r from-amber-500/15 via-rose-500/15 to-purple-500/15 border border-accent/30 text-accent font-black text-lg sm:text-xl animate-pulse"
      >
        🎉 It's here! The moment has arrived!
      </div>

      <!-- THE 4-UNIT BIG TIMER ROW -->
      <div class="grid grid-cols-4 gap-1.5 sm:gap-4 max-w-lg mx-auto w-full select-none" id="timer-grid">
        <!-- DAYS UNIT -->
        <div class="p-2.5 sm:p-6 rounded-2xl sm:rounded-3xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-md flex flex-col items-center justify-center">
          <span
            id="timer-days"
            class="font-mono text-3xl sm:text-6xl md:text-7xl font-black text-accent block tabular-nums tracking-tight"
          >
            00
          </span>
          <span class="text-[9px] sm:text-xs uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark mt-1">
            Days
          </span>
        </div>

        <!-- HOURS UNIT -->
        <div class="p-2.5 sm:p-6 rounded-2xl sm:rounded-3xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-md flex flex-col items-center justify-center">
          <span
            id="timer-hours"
            class="font-mono text-3xl sm:text-6xl md:text-7xl font-black text-primary-light dark:text-primary-dark block tabular-nums tracking-tight"
          >
            00
          </span>
          <span class="text-[9px] sm:text-xs uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark mt-1">
            Hours
          </span>
        </div>

        <!-- MINUTES UNIT -->
        <div class="p-2.5 sm:p-6 rounded-2xl sm:rounded-3xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-md flex flex-col items-center justify-center">
          <span
            id="timer-minutes"
            class="font-mono text-3xl sm:text-6xl md:text-7xl font-black text-primary-light dark:text-primary-dark block tabular-nums tracking-tight"
          >
            00
          </span>
          <span class="text-[9px] sm:text-xs uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark mt-1">
            Minutes
          </span>
        </div>

        <!-- SECONDS UNIT (Scale pulse tick animation) -->
        <div
          id="seconds-card"
          class="p-2.5 sm:p-6 rounded-2xl sm:rounded-3xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-md flex flex-col items-center justify-center transition-transform duration-150"
        >
          <span
            id="timer-seconds"
            class="font-mono text-3xl sm:text-6xl md:text-7xl font-black text-primary-light dark:text-primary-dark block tabular-nums tracking-tight"
          >
            00
          </span>
          <span class="text-[9px] sm:text-xs uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark mt-1">
            Seconds
          </span>
        </div>
      </div>

      <!-- ELAPSED TIME NOTICE (If past) -->
      <p id="elapsed-notice" class="hidden text-xs sm:text-sm font-medium text-secondary-light dark:text-secondary-dark italic"></p>

      <!-- VIEWER ACTION BUTTONS: 48px+ Touch Targets -->
      <div class="pt-4 max-w-md mx-auto w-full space-y-3">
        <!-- Prominent Share & Download Image Buttons -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full">
          <button
            id="viewer-download-image-btn"
            type="button"
            class="btn-secondary min-h-[48px] py-3 px-4 text-xs sm:text-sm font-bold gap-2 cursor-pointer flex items-center justify-center shadow-sm w-full transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
            aria-label="Download countdown as image"
          >
            <svg class="w-4 h-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download image</span>
          </button>

          <button
            id="viewer-share-image-btn"
            type="button"
            class="btn-primary min-h-[48px] py-3 px-4 text-xs sm:text-sm font-bold gap-2 cursor-pointer flex items-center justify-center shadow-md shadow-accent/20 w-full transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
            aria-label="Share countdown card image"
          >
            <svg class="w-4 h-4 shrink-0 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
              <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
            </svg>
            <span>Share image</span>
          </button>
        </div>

        <!-- Secondary Link Sharing Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
          <button
            id="share-viewer-btn"
            type="button"
            class="btn-secondary py-2 px-3.5 text-xs font-semibold gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
              <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
            </svg>
            <span>Share Link</span>
          </button>

          <button
            id="copy-viewer-link-btn"
            type="button"
            class="btn-secondary py-2 px-3.5 text-xs font-semibold gap-1.5 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span>Copy Link</span>
          </button>

          <a
            href="/countdown"
            class="btn-secondary py-2 px-3.5 text-xs font-medium"
          >
            Make Your Own &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notification Box -->
  <div
    id="view-toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 flex items-center gap-2.5 px-4 py-3 rounded-xl bg-primary-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-white dark:text-primary-dark shadow-xl text-sm font-medium"
    role="status"
    aria-live="polite"
  >
    <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span id="view-toast-msg">Copied to clipboard!</span>
  </div>
</Base>

<script>
  import { decodeCountdown, getTimeRemaining } from '../../scripts/countdown.js';
  import { handleDownloadImage, handleShareImage } from '../../scripts/countdown-share.js';

  function initCountdownViewer() {
    const errorCard = document.getElementById('countdown-error-card');
    const stage = document.getElementById('countdown-stage');
    const emojiEl = document.getElementById('viewer-emoji');
    const titleEl = document.getElementById('viewer-title');
    const targetDateEl = document.getElementById('viewer-target-date');
    const celebrationBanner = document.getElementById('celebration-banner');
    const elapsedNotice = document.getElementById('elapsed-notice');

    const daysEl = document.getElementById('timer-days');
    const hoursEl = document.getElementById('timer-hours');
    const minutesEl = document.getElementById('timer-minutes');
    const secondsEl = document.getElementById('timer-seconds');
    const secondsCard = document.getElementById('seconds-card');

    const downloadImageBtn = document.getElementById('viewer-download-image-btn');
    const shareImageBtn = document.getElementById('viewer-share-image-btn');
    const shareCard = document.getElementById('viewer-share-card');

    const shareBtn = document.getElementById('share-viewer-btn');
    const copyBtn = document.getElementById('copy-viewer-link-btn');
    const toast = document.getElementById('view-toast');
    const toastMsg = document.getElementById('view-toast-msg');

    function showToast(message) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

      setTimeout(() => {
        toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }, 2500);
    }

    // Read and parse ?c= query parameter
    const params = new URLSearchParams(window.location.search);
    const encoded = params.get('c');
    const eventData = decodeCountdown(encoded);

    if (!eventData) {
      if (errorCard) errorCard.classList.remove('hidden');
      if (stage) stage.classList.add('hidden');
      return;
    }

    // Display parsed event data
    if (errorCard) errorCard.classList.add('hidden');
    if (stage) stage.classList.remove('hidden');

    if (emojiEl) emojiEl.textContent = eventData.emoji;
    if (titleEl) titleEl.textContent = eventData.title;
    document.title = `⏳ ${eventData.title} | ToolNest Countdown`;

    const targetDate = new Date(eventData.date);
    if (targetDateEl) {
      targetDateEl.textContent = `Target: ${targetDate.toLocaleDateString(undefined, {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })} at ${targetDate.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}`;
    }

    let hasCelebrated = false;
    let lastSecond = '';

    function tick() {
      const rem = getTimeRemaining(eventData.timestamp);

      if (daysEl) daysEl.textContent = rem.formattedDays;
      if (hoursEl) hoursEl.textContent = rem.formattedHours;
      if (minutesEl) minutesEl.textContent = rem.formattedMinutes;
      if (secondsEl) secondsEl.textContent = rem.formattedSeconds;

      // Subtle scale pulse on second change
      if (rem.formattedSeconds !== lastSecond) {
        lastSecond = rem.formattedSeconds;
        if (secondsCard) {
          secondsCard.classList.add('scale-105');
          setTimeout(() => secondsCard.classList.remove('scale-105'), 120);
        }
      }

      if (rem.isPast) {
        if (celebrationBanner) celebrationBanner.classList.remove('hidden');
        if (elapsedNotice) {
          elapsedNotice.textContent = `Milestone reached! Elapsed: ${rem.days}d ${rem.hours}h ${rem.minutes}m ${rem.seconds}s ago.`;
          elapsedNotice.classList.remove('hidden');
        }

        if (!hasCelebrated) {
          hasCelebrated = true;
          if (typeof window.confetti === 'function') {
            window.confetti({
              particleCount: 120,
              spread: 85,
              origin: { y: 0.5 },
            });
          }
        }
      } else {
        if (celebrationBanner) celebrationBanner.classList.add('hidden');
        if (elapsedNotice) elapsedNotice.classList.add('hidden');
      }
    }

    tick();
    const interval = setInterval(tick, 1000);

    // Download Countdown Card Image
    if (downloadImageBtn) {
      downloadImageBtn.addEventListener('click', () => {
        handleDownloadImage({
          cardEl: shareCard,
          getEventData: () => eventData,
          toastFn: showToast,
          buttonEl: downloadImageBtn,
        });
      });
    }

    // Share Countdown Card Image
    if (shareImageBtn) {
      shareImageBtn.addEventListener('click', () => {
        handleShareImage({
          cardEl: shareCard,
          getEventData: () => eventData,
          shareUrl: window.location.href,
          toastFn: showToast,
          buttonEl: shareImageBtn,
        });
      });
    }

    // Share Countdown
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        const shareData = {
          title: `⏳ Countdown: ${eventData.title}`,
          text: `Join the live countdown for "${eventData.title}":`,
          url: window.location.href,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {
            // Cancelled
          }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            showToast('Countdown link copied to clipboard!');
          } catch (e) {
            showToast('Unable to share.');
          }
        }
      });
    }

    // Copy Link
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          showToast('Countdown link copied to clipboard!');
        } catch (e) {
          showToast('Unable to copy.');
        }
      });
    }
  }

  initCountdownViewer();
  document.addEventListener('astro:after-swap', initCountdownViewer);
</script>

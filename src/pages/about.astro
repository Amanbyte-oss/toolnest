---
export const prerender = true;
import Base from '../layouts/Base.astro';

const tools = [
  {
    name: '🎂 Age Calculator',
    description: 'Calculate your exact age in years, months, days, and seconds. Includes upcoming birthday countdowns and life milestones.',
    href: '/age-calculator',
  },
  {
    name: '🎉 Birthday Facts',
    description: 'Uncover your western zodiac sign, birthstone, birth flower, generational cohort, and famous personalities sharing your birthday.',
    href: '/birthday-facts',
  },
  {
    name: '🎡 Decision Wheel',
    description: 'Resolve daily choices, food debates, and team tasks with a customizable physics-based deceleration spinning wheel.',
    href: '/decision-wheel',
  },
  {
    name: '🎯 Random Picker',
    description: 'Draw one or multiple winners completely fairly using cryptographic randomness, duplicate filtering, and elimination options.',
    href: '/random-picker',
  },
  {
    name: '⏳ Countdown Creator',
    description: 'Generate live, real-time ticking event countdowns with celebration states and zero-database shareable URL links.',
    href: '/countdown',
  },
  {
    name: '📖 Name Meanings',
    description: 'Explore origins, etymology, popularity ratings, and famous namesakes across 200+ curated baby and personal names.',
    href: '/name-meaning',
  },
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About ToolNest',
  url: 'https://toolnest.pages.dev/about',
  description: 'Learn about ToolNest: our mission, mathematical methodology, client-side zero-tracking architecture, and editorial standards.',
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
    logo: {
      '@type': 'ImageObject',
      url: 'https://toolnest.pages.dev/favicon.svg',
    },
  },
};
---

<Base
  title="About ToolNest — Fast, Private Web Utilities | ToolNest"
  description="Learn about ToolNest: our mission to provide fast, private, zero-tracking client-side tools, verified mathematical methodology, and editorial standards."
  canonicalPath="/about"
  ogImage="/og/about.svg"
  breadcrumbs={[{ name: 'About', item: '/about' }]}
  extraSchemas={[aboutSchema]}
>
  <article class="space-y-10 max-w-3xl mx-auto">
    <!-- Header -->
    <header class="space-y-3 text-center sm:text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
        <span>✨</span>
        <span>About the Platform</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        About ToolNest
      </h1>
      <p class="text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        ToolNest is an independent suite of fast, lightweight, and privacy-focused client-side web utilities created to answer everyday questions without sign-ups, trackers, or databases.
      </p>
    </header>

    <!-- Mission & Core Philosophy -->
    <section class="card p-6 sm:p-8 space-y-4" aria-labelledby="mission-heading">
      <h2 id="mission-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        Our Philosophy: Speed, Privacy & Mathematical Integrity
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>
          Too many simple web utilities today are weighed down by tracking scripts, invasive advertising cookies, slow server roundtrips, and mandatory email registrations. ToolNest was founded to prove that everyday digital tools should be instant, reliable, and completely private.
        </p>
        <p>
          Every calculation, spin, shuffle, and countdown runs entirely inside your browser sandbox using modern client-side JavaScript. We do not operate user databases, nor do we collect, store, or sell personal inputs on remote servers. What you calculate or randomize remains strictly on your device.
        </p>
      </div>
    </section>

    <!-- Methodology & Calculation Standards (E-E-A-T) -->
    <section class="card p-6 sm:p-8 space-y-4 border-l-4 border-accent" aria-labelledby="methodology-heading">
      <h2 id="methodology-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
        <span>📐</span>
        <span>Methodology & Calculation Standards</span>
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>
          <strong>Calendar & Age Mathematics:</strong> Our Age Calculator utilizes UTC-standardized Gregorian calendar algorithms. Rather than relying on inaccurate average approximations (like multiplying by 365.25 days), it computes exact day-by-day intervals accounting for leap years, uneven month boundaries, and daylight saving offsets.
        </p>
        <p>
          <strong>Cryptographic Randomness:</strong> The Random Picker uses the Web Cryptography API (<code class="text-xs bg-bg-light dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-light dark:border-border-dark font-mono">crypto.getRandomValues</code>) paired with an unbiased Fisher–Yates shuffle algorithm. This ensures true uniform probability distribution free from pseudo-random modular bias.
        </p>
        <p>
          <strong>Physics Deceleration Simulation:</strong> The Decision Wheel implements quadratic bezier deceleration curves synchronized via <code class="text-xs bg-bg-light dark:bg-bg-dark px-1.5 py-0.5 rounded border border-border-light dark:border-border-dark font-mono">requestAnimationFrame</code>, simulating realistic mechanical wheel friction without predetermined rigging.
        </p>
        <p>
          <strong>Stateless Event Timers:</strong> The Countdown Creator packages event titles, timestamps, and emoji into standard URL query parameters, enabling zero-database shareable countdown clocks that remain functional indefinitely.
        </p>
      </div>
    </section>

    <!-- Editorial Standards & Onomastic Research -->
    <section class="card p-6 sm:p-8 space-y-4" aria-labelledby="editorial-heading">
      <h2 id="editorial-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        Editorial Standards & Name Research
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>
          Our Name Meaning database covers over 200 curated names representing Germanic, Romance, Celtic, Hebrew, Hellenic, Slavic, and African linguistic traditions. Meanings and etymological roots are cross-verified against primary historical onomastic records, classical dictionaries, and demographic naming registries.
        </p>
        <p>
          When users request AI insights for rare or contemporary names, requests are processed in real-time through an isolated, server-side Google Gemini proxy that generates structured cultural and psychological archetypes without recording or training on user prompts.
        </p>
      </div>
    </section>

    <!-- Tools Collection Grid -->
    <section class="space-y-4" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        Included Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group card p-5 hover:border-accent/60 transition-all hover:shadow-md flex flex-col justify-between"
          >
            <div class="space-y-2">
              <h3 class="text-base font-bold text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
                {tool.description}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent pt-3 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              Launch tool &rarr;
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Architecture & Hosting Note -->
    <section class="card p-6 sm:p-8 space-y-4" aria-labelledby="tech-heading">
      <h2 id="tech-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        Technical Architecture & Edge Delivery
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>
          ToolNest is statically generated using <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-semibold">Astro</a> and styled with <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-semibold">Tailwind CSS</a>. By shipping static HTML and modular client scripts, pages achieve lightning-fast First Contentful Paint (FCP) and near-zero Cumulative Layout Shift (CLS).
        </p>
        <p>
          The application is served globally across Cloudflare Pages edge locations, providing low-latency distribution with automatic HTTPS, DDoS protection, and 99.9% uptime.
        </p>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="card p-6 sm:p-8 space-y-3 border-accent/30 bg-gradient-to-r from-accent/5 via-surface-light to-surface-light dark:from-accent/15 dark:via-surface-dark dark:to-surface-dark" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        Questions or Feedback?
      </h2>
      <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark max-w-xl leading-relaxed">
        We welcome suggestions for new tools, feature requests, and bug reports. Reach out to our engineering team anytime.
      </p>
      <div class="pt-2">
        <a href="/contact" class="btn-primary text-xs py-2.5 px-5 font-bold inline-flex items-center gap-1.5 shadow-xs">
          <span>Contact ToolNest &rarr;</span>
        </a>
      </div>
    </section>
  </article>
</Base>

---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import StickyPillNav from '../components/StickyPillNav.astro';
import relatedLinksData from '../data/related-links.json';

const navSections = [
  { id: 'picker-input-heading', label: 'Roster & Setup' },
  { id: 'results-section', label: 'Winners' },
  { id: 'how-to-use-heading', label: 'How to Use' },
  { id: 'use-cases-heading', label: 'Use Cases' },
  { id: 'faq-section', label: 'FAQ' },
  { id: 'related-tools', label: 'Related Tools' },
];

const lastUpdatedDate = new Date().toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Comprehensive FAQ definitions (8 questions targeting core search clusters)
const faqs = [
  {
    question: 'Is this random name picker truly fair and cryptographically unbiased?',
    answer:
      'Unlike standard randomizers relying on Math.random, ToolNest utilizes the browser Cryptographic API (crypto.getRandomValues). This supplies hardware-seeded entropy ensuring every entry has a strictly identical mathematical probability of being selected.',
  },
  {
    question: 'How do I use this tool as a random team picker or group generator?',
    answer:
      'To split names into random teams, first tap "Shuffle List" to completely randomize the roster order with a cryptographic Fisher-Yates shuffle. Then divide the shuffled list into your desired group size (such as pairs or teams of 4). You can also use the winner count stepper to draw team captains one round at a time.',
  },
  {
    question: 'Can I draw multiple unique giveaway winners at the same time?',
    answer:
      'Yes! Use the winner stepper to draw between 1 and 10 winners simultaneously. The selection algorithm implements an unbiased Fisher–Yates shuffle to guarantee all drawn giveaway winners are distinct without repeat duplicates.',
  },
  {
    question: 'What is the difference between crypto.getRandomValues and Math.random?',
    answer:
      'Math.random uses a pseudo-random number generator (PRNG) with predictable internal seed states that can exhibit statistical clustering over short sequences. The Web Cryptography API draws entropy from your operating system, ensuring zero statistical bias for raffles.',
  },
  {
    question: 'Can I automatically eliminate winners after each raffle draw round?',
    answer:
      'Yes. Toggle the "Remove winners after pick" switch above the button. Whenever a winner is drawn, their entry is automatically stripped from the roster so they cannot be chosen again in successive raffle rounds.',
  },
  {
    question: 'Does ToolNest store or upload my student or giveaway roster?',
    answer:
      'No. Your list never leaves your local browser memory. Text parsing, duplicate cleaning, and winner selection occur 100% client-side with zero server roundtrips, guaranteeing complete privacy for confidential rosters.',
  },
  {
    question: 'What types of lists can I paste into the list randomizer?',
    answer:
      'You can paste any list separated by line breaks, commas, or semicolons. The parser automatically trims whitespace and empty lines, making it easy to paste directly from spreadsheets like Excel or Google Sheets.',
  },
  {
    question: 'Can I filter duplicate names before drawing winners?',
    answer:
      'Yes! The tool automatically scans your list for repeated entries and displays a duplicate warning badge. Clicking "Remove Duplicates" instantly deduplicates your list while preserving original casing.',
  },
];

const relatedTools = relatedLinksData['random-picker'];

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://toolnest.pages.dev/random-picker#app',
  name: 'Random Name Picker & Giveaway Winner Generator',
  url: 'https://toolnest.pages.dev/random-picker',
  description: 'Cryptographically fair random name picker and list randomizer. Draw single or multiple giveaway winners, classroom students, and raffle items.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
  featureList: [
    'Cryptographically sound random entropy via Web Crypto API',
    'Fisher-Yates unbiased shuffle algorithm',
    'Draw 1 to 10 unique simultaneous winners without duplicates',
    'Automatic duplicate entry filtering and winner elimination switch',
    '100% private client-side execution with zero roster server storage',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Pick Random Winners from a List in 3 Steps',
  description: 'A quick guide to drawing fair raffle winners, student names, and giveaway entrants using ToolNest.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Paste or type your list of names',
      text: 'Enter names or options into the text area separated by new lines or commas.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Configure winner settings',
      text: 'Choose how many winners to draw (1 to 10) and enable duplicate filtering or elimination.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Pick winners with true randomness',
      text: 'Click Pick Random Winner to draw unbiased results powered by Web Crypto API.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  title="Random Name Picker — Draw Giveaway Winners | ToolNest"
  description="Fair random name picker and giveaway winner generator. Draw 1 to 10 unique winners with cryptographic randomness and duplicate filtering."
  canonicalPath="/random-picker"
  ogImage="/og/random-picker.svg"
  breadcrumbs={[{ name: 'Tools', item: '/#tools' }, { name: 'Random Picker', item: '/random-picker' }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
>
  <!-- CDN Confetti Loader for Winner Celebration -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <span>🎯</span>
      <span>Cryptographically Fair Randomizer</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      Random Name Picker — Draw Giveaway Winners
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      Paste your list of names, numbers, or choices. Pick one or multiple winners fairly for giveaways, classroom questions, raffles, or chores.
    </p>
  </header>

  <!-- KEY TAKEAWAYS / FEATURED SNIPPET SUMMARY BOX -->
  <aside class="card mt-4 p-4 sm:p-5 border-l-4 border-accent bg-accent/5 space-y-2" aria-label="Key Takeaways">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent">
      <span>⚡</span>
      <span>Quick Answer & Key Takeaways</span>
    </div>
    <ul class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark space-y-1.5 list-disc list-inside leading-relaxed">
      <li><strong>Cryptographic Randomness:</strong> Powered by the Web Cryptography API for true uniform probability distribution free from pseudo-random bias.</li>
      <li><strong>Multiple Unique Winners:</strong> Draw 1 to 10 winners simultaneously without duplicate repeats via Fisher–Yates shuffling.</li>
      <li><strong>Confidential Rosters:</strong> Your list is processed 100% inside your browser memory and is never uploaded or saved to remote databases.</li>
    </ul>
  </aside>

  <!-- MAIN INPUT CARD -->
  <section class="card mt-6 space-y-5" aria-labelledby="picker-input-heading">
    <div class="flex items-center justify-between border-b border-border-light dark:border-border-dark pb-3">
      <h2 id="picker-input-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
        Enter Items or Names
      </h2>
      <button
        id="clear-input-btn"
        type="button"
        class="text-xs text-secondary-light dark:text-secondary-dark hover:text-error transition-colors cursor-pointer"
      >
        Clear List
      </button>
    </div>

    <!-- Textarea Area -->
    <div class="space-y-2">
      <label for="items-textarea" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        One entry per line or comma-separated:
      </label>
      <textarea
        id="items-textarea"
        rows="7"
        class="input-base text-base font-normal resize-y min-h-[140px] leading-relaxed"
        placeholder="Alice&#10;Bob&#10;Charlie&#10;Diana&#10;Evan&#10;Fiona"
        aria-describedby="items-counter-status duplicate-warning"
      >Alice
Bob
Charlie
Diana
Evan
Fiona</textarea>
    </div>

    <!-- Status Bar: Item Count & Duplicate Warnings -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs" id="items-counter-status">
      <div class="flex items-center gap-2">
        <span class="font-bold text-primary-light dark:text-primary-dark" id="items-count-display">
          6 items (6 unique)
        </span>
      </div>

      <!-- Duplicate Alert with Quick-Fix Button -->
      <div id="duplicate-warning" class="hidden items-center gap-2 text-amber-600 dark:text-amber-400 font-medium">
        <span id="duplicate-count-text">0 duplicates</span>
        <button
          id="remove-duplicates-btn"
          type="button"
          class="underline font-bold hover:text-primary-light dark:hover:text-primary-dark cursor-pointer"
        >
          Remove duplicates
        </button>
      </div>
    </div>

    <!-- Settings & Controls Grid -->
    <div class="pt-3 border-t border-border-light dark:border-border-dark grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Winner Count Stepper -->
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Number of Winners
        </label>
        <div class="flex items-center gap-3">
          <div class="inline-flex items-center rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark p-1">
            <button
              id="stepper-minus-btn"
              type="button"
              class="w-10 h-10 flex items-center justify-center rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark font-bold text-base text-primary-light dark:text-primary-dark hover:border-accent active:scale-95 transition-all cursor-pointer select-none"
              aria-label="Decrease winners"
            >
              −
            </button>
            <span
              id="winners-count-display"
              class="w-12 text-center text-base font-extrabold text-primary-light dark:text-primary-dark"
              aria-live="polite"
            >
              1
            </span>
            <button
              id="stepper-plus-btn"
              type="button"
              class="w-10 h-10 flex items-center justify-center rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark font-bold text-base text-primary-light dark:text-primary-dark hover:border-accent active:scale-95 transition-all cursor-pointer select-none"
              aria-label="Increase winners"
            >
              +
            </button>
          </div>
          <span class="text-xs text-secondary-light dark:text-secondary-dark" id="stepper-hint">
            Max 10
          </span>
        </div>
      </div>

      <!-- Toggles Column -->
      <div class="space-y-2.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Pick Options
        </label>

        <!-- Toggle: Remove winners after pick -->
        <label class="flex items-center gap-2.5 cursor-pointer min-h-[36px] select-none">
          <input
            type="checkbox"
            id="toggle-remove-winners"
            class="sr-only peer"
          />
          <div class="w-9 h-5 bg-border-light dark:bg-border-dark peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent relative"></div>
          <span class="text-xs sm:text-sm font-medium text-primary-light dark:text-primary-dark">
            Remove winners after pick
          </span>
        </label>

        <!-- Toggle: Case-insensitive duplicates -->
        <label class="flex items-center gap-2.5 cursor-pointer min-h-[36px] select-none">
          <input
            type="checkbox"
            id="toggle-case-insensitive"
            checked
            class="sr-only peer"
          />
          <div class="w-9 h-5 bg-border-light dark:bg-border-dark peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent relative"></div>
          <span class="text-xs sm:text-sm font-medium text-primary-light dark:text-primary-dark">
            Case-insensitive duplicates
          </span>
        </label>
      </div>
    </div>

    <!-- Actions Row -->
    <div class="pt-3 border-t border-border-light dark:border-border-dark flex flex-col sm:flex-row items-center gap-3">
      <!-- Shuffle list button -->
      <button
        id="shuffle-list-btn"
        type="button"
        class="btn-secondary w-full sm:w-auto py-3 px-5 text-xs sm:text-sm font-semibold gap-1.5 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"/>
          <line x1="4" y1="20" x2="21" y2="3"/>
          <polyline points="21 16 21 21 16 21"/>
          <line x1="15" y1="15" x2="21" y2="21"/>
          <line x1="4" y1="4" x2="9" y2="9"/>
        </svg>
        <span>Shuffle List</span>
      </button>

      <!-- Desktop Primary Pick Button -->
      <button
        id="pick-winner-btn"
        type="button"
        class="btn-primary w-full sm:w-auto sm:px-8 py-3.5 text-base font-bold shadow-md shadow-accent/20 cursor-pointer"
      >
        Pick Winner(s)
      </button>
    </div>

    <!-- Sticky Mobile Button -->
    <div class="sm:hidden fixed bottom-3 left-4 right-4 z-30 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))]">
      <button
        id="mobile-pick-winner-btn"
        type="button"
        class="btn-primary w-full py-3.5 text-base font-bold shadow-xl shadow-accent/25 flex items-center justify-center gap-2 cursor-pointer"
        style="touch-action: manipulation;"
      >
        <span>🎯</span>
        <span>PICK WINNER(S)</span>
      </button>
    </div>
  </section>

  <!-- RESULTS SECTION (Smooth Reveal) -->
  <section
    id="results-section"
    class="hidden mt-8 card space-y-6 text-center scroll-mt-20"
    aria-live="polite"
    aria-labelledby="results-heading"
  >
    <div class="space-y-1">
      <div class="text-3xl sm:text-4xl animate-bounce" id="results-icon">🎉</div>
      <h2 id="results-heading" class="text-xs uppercase tracking-wider font-semibold text-secondary-light dark:text-secondary-dark">
        Selected Winner(s)
      </h2>
    </div>

    <!-- Shuffling Cycling Animation Box -->
    <div
      id="shuffle-animation-box"
      class="hidden py-6 rounded-2xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark"
    >
      <div class="text-xs text-secondary-light dark:text-secondary-dark mb-1">
        Drawing with cryptographic entropy...
      </div>
      <div
        id="cycling-name-display"
        class="text-2xl sm:text-3xl font-black text-accent tracking-tight animate-pulse truncate max-w-sm mx-auto px-4"
      >
        Selecting...
      </div>
    </div>

    <!-- Final Winners Container -->
    <div id="final-winners-box" class="space-y-4">
      <div id="winners-list" class="flex flex-col items-center gap-2.5">
        <!-- Injected via JavaScript -->
      </div>

      <!-- Action Buttons (Copy & Share) -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
        <button
          id="copy-winners-btn"
          type="button"
          class="btn-primary py-2.5 px-5 text-xs sm:text-sm font-semibold gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span>Copy Winner(s)</span>
        </button>

        <button
          id="share-winners-btn"
          type="button"
          class="btn-secondary py-2.5 px-5 text-xs sm:text-sm font-semibold gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
          </svg>
          <span>Share</span>
        </button>

        <button
          id="pick-again-btn"
          type="button"
          class="btn-secondary py-2.5 px-5 text-xs sm:text-sm font-semibold cursor-pointer"
        >
          Pick Again
        </button>
      </div>

      <p id="remaining-count-notice" class="text-xs text-secondary-light dark:text-secondary-dark italic pt-1 hidden"></p>
    </div>
  </section>

  <!-- PICK HISTORY SECTION -->
  <!-- Recent Activity History Card -->
  <div class="mt-8">
    <HistoryCard toolId="picker" title="Recent Draws" icon="🎲" />
  </div>

  <!-- SEO CONTENT & QUESTION-FORM HEADINGS -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark space-y-10">
    <!-- How to use -->
    <div class="space-y-4">
      <div class="space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
          How to Use the Random Name Picker in 3 Steps
        </h2>
        <p class="text-sm text-secondary-light dark:text-secondary-dark">
          Draw verifiable random winners in 3 quick steps.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card space-y-2 p-5">
          <div class="w-8 h-8 rounded-xl bg-accent text-white flex items-center justify-center text-sm font-bold shadow-sm">
            1
          </div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            Paste Your List
          </h3>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            Paste names separated by newlines or commas. The tool automatically detects formatting and alerts you if duplicates exist.
          </p>
        </div>

        <div class="card space-y-2 p-5">
          <div class="w-8 h-8 rounded-xl bg-accent text-white flex items-center justify-center text-sm font-bold shadow-sm">
            2
          </div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            Select Options & Count
          </h3>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            Set how many winners to draw (1 to 10) and choose whether to automatically remove winning entries for subsequent rounds.
          </p>
        </div>

        <div class="card space-y-2 p-5">
          <div class="w-8 h-8 rounded-xl bg-accent text-white flex items-center justify-center text-sm font-bold shadow-sm">
            3
          </div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            Draw & Copy Winners
          </h3>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            Watch the cycling animation settle on your winners with celebratory confetti. Copy the results to your clipboard with one click.
          </p>
        </div>
      </div>
    </div>

    <!-- Long-Tail Educational Content & Question-Form Subheadings -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card p-6 space-y-3">
        <h2 class="text-lg font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
          <span>🔒</span>
          <span>Why Does Cryptographic Randomness Matter for Contests?</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
          Standard web randomizers often use Math.random(), an algorithmic pseudo-random number generator that can produce statistical clustering over small lists. ToolNest queries the Web Cryptography API (crypto.getRandomValues), harvesting hardware and OS entropy to ensure uncompromised mathematical fairness for school raffles, social media giveaways, and corporate draws.
        </p>
      </div>

      <div class="card p-6 space-y-3">
        <h2 class="text-lg font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
          <span>👥</span>
          <span>How Do You Draw Multiple Unique Winners Without Repeats?</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
          When drawing multiple winners, naive random pickers risk selecting the same participant twice. ToolNest executes an in-place modern Fisher–Yates shuffle algorithm. By iterating through the array in reverse and swapping elements using cryptographically uniform indices, every permutation is equally probable and each drawn winner is guaranteed to be unique.
        </p>
      </div>
    </div>

    <!-- USE CASES SECTION -->
    <section class="space-y-4" aria-labelledby="use-cases-heading">
      <h2 id="use-cases-heading" class="text-lg sm:text-xl font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
        <span>💡</span>
        <span>Popular Use Cases for the Random Name Picker & Team Generator</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card p-5 space-y-2">
          <div class="text-2xl">👩‍🏫</div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">Name Picker for Teachers</h3>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            Select classroom students fairly for presentations, cold-call answers, and weekly classroom jobs with verified neutrality. If you prefer a visual spin animation, try our <a href="/decision-wheel" class="text-accent hover:underline font-medium">interactive wheel spinner</a>.
          </p>
        </div>
        <div class="card p-5 space-y-2">
          <div class="text-2xl">🎟️</div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">Giveaway Winner Picker & Raffles</h3>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            Execute transparent, cryptographically sound prize drawings for Instagram giveaways, Discord community raffles, and corporate promotions using a provably fair raffle drawer online.
          </p>
        </div>
        <div class="card p-5 space-y-2">
          <div class="text-2xl">⚽</div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">Random Team Picker & Squads</h3>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            Shuffle large rosters in seconds to divide classrooms, hackathons, sports leagues, and video game tournaments into balanced, randomized squads.
          </p>
        </div>
      </div>
    </section>

    <!-- DID YOU KNOW? FACT STRIP -->
    <section class="card p-5 sm:p-6 border-accent/20 bg-accent/5 space-y-3" aria-labelledby="trivia-strip-heading">
      <div class="flex items-center gap-2">
        <span class="text-lg">🧠</span>
        <h2 id="trivia-strip-heading" class="text-sm font-bold uppercase tracking-wider text-accent">
          Did You Know? Randomness & Sortition Trivia
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
        <div class="space-y-1">
          <span class="text-xs font-bold text-primary-light dark:text-primary-dark flex items-center gap-1.5">
            <span>🔐</span> Hardware Thermal Entropy
          </span>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            Standard Math.random algorithms can repeat patterns over time. The Web Cryptography API samples real physical noise from device CPU thermal fluctuations for casino-grade fairness.
          </p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-bold text-primary-light dark:text-primary-dark flex items-center gap-1.5">
            <span>🏛️</span> Ancient Athenian Democracy
          </span>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            In ancient Athens, political officials and court jurors were chosen by *sortition* (random lottery) using marble-slotted machines called *kleroterion* rather than elections.
          </p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-bold text-primary-light dark:text-primary-dark flex items-center gap-1.5">
            <span>🔀</span> The Fisher-Yates Guarantee
          </span>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            For a list of N items, there are N! possible orderings. The Fisher-Yates algorithm guarantees that every single permutation has an exact 1 / N! chance of occurring.
          </p>
        </div>
      </div>
    </section>

    <!-- Methodology & Entropy Guarantee (E-E-A-T) -->
    <div class="card p-5 border-border-light dark:border-border-dark space-y-2 bg-bg-light/50 dark:bg-bg-dark/50">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark flex items-center gap-1.5">
          <span>📐</span>
          <span>Methodology & Cryptographic Entropy</span>
        </h3>
        <span class="text-[11px] text-secondary-light dark:text-secondary-dark">
          Last updated: {lastUpdatedDate}
        </span>
      </div>
      <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
        Random number generation utilizes the W3C Web Cryptography Standard. List parsing, sanitization, and duplicate stripping execute exclusively inside client memory without transmitting data over the network.
      </p>
    </div>
  </section>

  <!-- COMMON QUESTIONS QUICK-JUMP BAR -->
  <section class="mt-12 space-y-3" id="faq-section">
    <div class="card p-4 space-y-2.5 bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Quick Navigation — Common Questions
        </span>
        <span class="text-xs text-accent font-medium">8 Answers</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {faqs.map((faq, idx) => (
          <a
            href={`#faq-item-${idx + 1}`}
            class="text-xs px-2.5 py-1 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors"
          >
            {faq.question}
          </a>
        ))}
      </div>
    </div>

    <!-- FAQ SECTION ACCORDION -->
    <Faq items={faqs} />
  </section>

  <!-- RELATED TOOLS SECTION -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
        Related Free Tools
      </h2>
      <a href="/" class="text-xs font-semibold text-accent hover:underline">
        View all tools &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {relatedTools.map((tool) => (
        <ToolCard
          title={tool.name}
          description={tool.desc}
          href={tool.href}
          anchor={tool.anchor}
          icon={tool.href.includes('wheel') ? 'target' : tool.href.includes('countdown') ? 'clock' : 'calendar'}
        />
      ))}
    </div>
  </section>

  <!-- Toast Notification Box -->
  <div
    id="picker-toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 pointer-events-none transition-all duration-200 flex items-center gap-2.5 px-4 py-3 rounded-xl bg-primary-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-white dark:text-primary-dark shadow-xl text-sm font-medium"
    role="status"
    aria-live="polite"
  >
    <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
    <span id="picker-toast-msg">Notification</span>
  </div>
</Base>

<script>
  import {
    parseItems,
    analyzeDuplicates,
    pickWinners,
    shuffleList,
    removeWinnersFromText,
  } from '../scripts/random-picker.js';
  import {
    saveHistory,
    saveLastState,
    getLastState,
    initHistoryCard,
  } from '../scripts/history.js';

  function initRandomPicker() {
    const textarea = document.getElementById('items-textarea');
    const clearBtn = document.getElementById('clear-input-btn');
    const countDisplay = document.getElementById('items-count-display');
    const duplicateWarning = document.getElementById('duplicate-warning');
    const duplicateCountText = document.getElementById('duplicate-count-text');
    const removeDuplicatesBtn = document.getElementById('remove-duplicates-btn');
    const stepperMinus = document.getElementById('stepper-minus-btn');
    const stepperPlus = document.getElementById('stepper-plus-btn');
    const winnersCountDisplay = document.getElementById('winners-count-display');
    const toggleRemoveWinners = document.getElementById('toggle-remove-winners');
    const toggleCaseInsensitive = document.getElementById('toggle-case-insensitive');
    const shuffleListBtn = document.getElementById('shuffle-list-btn');
    const pickBtn = document.getElementById('pick-winner-btn');
    const mobilePickBtn = document.getElementById('mobile-pick-winner-btn');

    // Results Elements
    const resultsSection = document.getElementById('results-section');
    const shuffleAnimBox = document.getElementById('shuffle-animation-box');
    const cyclingNameDisplay = document.getElementById('cycling-name-display');
    const finalWinnersBox = document.getElementById('final-winners-box');
    const winnersList = document.getElementById('winners-list');
    const copyWinnersBtn = document.getElementById('copy-winners-btn');
    const shareWinnersBtn = document.getElementById('share-winners-btn');
    const pickAgainBtn = document.getElementById('pick-again-btn');
    const remainingCountNotice = document.getElementById('remaining-count-notice');

    // History Elements
    const historyList = document.getElementById('history-list');
    const emptyHistoryText = document.getElementById('empty-history-text');
    const clearHistoryBtn = document.getElementById('clear-history-btn');

    // Toast Elements
    const toast = document.getElementById('picker-toast');
    const toastMsg = document.getElementById('picker-toast-msg');

    if (!textarea || !pickBtn) return;

    let winnersCount = 1;
    let currentWinners = [];
    let pickHistory = [];
    let isPicking = false;

    function showToast(message) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

      setTimeout(() => {
        toast.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
        toast.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }, 2500);
    }

    function updateCounts() {
      const rawText = textarea.value;
      const items = parseItems(rawText);
      const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
      const analysis = analyzeDuplicates(items, isCaseInsensitive);

      if (countDisplay) {
        countDisplay.textContent = `${analysis.totalCount} item${analysis.totalCount === 1 ? '' : 's'} (${analysis.uniqueCount} unique)`;
      }

      if (duplicateWarning && duplicateCountText) {
        if (analysis.duplicateCount > 0) {
          duplicateCountText.textContent = `${analysis.duplicateCount} duplicate${analysis.duplicateCount === 1 ? '' : 's'} detected — duplicates will be ignored`;
          duplicateWarning.classList.remove('hidden');
          duplicateWarning.classList.add('flex');
        } else {
          duplicateWarning.classList.add('hidden');
          duplicateWarning.classList.remove('flex');
        }
      }

      // Clamp winnersCount to available unique items
      const maxAllowed = Math.max(1, Math.min(10, analysis.uniqueCount || 1));
      if (winnersCount > maxAllowed) {
        winnersCount = maxAllowed;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }
    }

    textarea.addEventListener('input', updateCounts);
    if (toggleCaseInsensitive) toggleCaseInsensitive.addEventListener('change', updateCounts);

    // Clear Textarea
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (isPicking) return;
        textarea.value = '';
        updateCounts();
        textarea.focus();
        showToast('List cleared.');
      });
    }

    // Remove Duplicates Quick-Fix
    if (removeDuplicatesBtn) {
      removeDuplicatesBtn.addEventListener('click', () => {
        if (isPicking) return;
        const items = parseItems(textarea.value);
        const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
        const analysis = analyzeDuplicates(items, isCaseInsensitive);
        textarea.value = analysis.unique.join('\n');
        updateCounts();
        showToast(`Removed ${analysis.duplicateCount} duplicate${analysis.duplicateCount === 1 ? '' : 's'}.`);
      });
    }

    // Stepper Handlers
    if (stepperMinus) {
      stepperMinus.addEventListener('click', () => {
        if (isPicking) return;
        if (winnersCount > 1) {
          winnersCount--;
          if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
        }
      });
    }

    if (stepperPlus) {
      stepperPlus.addEventListener('click', () => {
        if (isPicking) return;
        const items = parseItems(textarea.value);
        const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
        const analysis = analyzeDuplicates(items, isCaseInsensitive);
        const maxAllowed = Math.min(10, analysis.uniqueCount || 1);

        if (winnersCount < maxAllowed) {
          winnersCount++;
          if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
        } else {
          showToast(`Cannot exceed ${maxAllowed} winner${maxAllowed === 1 ? '' : 's'} with current unique items.`);
        }
      });
    }

    // Shuffle Entire List
    if (shuffleListBtn) {
      shuffleListBtn.addEventListener('click', () => {
        if (isPicking) return;
        const items = parseItems(textarea.value);
        if (items.length < 2) {
          showToast('Add at least 2 items to shuffle.');
          return;
        }
        const shuffled = shuffleList(items);
        textarea.value = shuffled.join('\n');
        updateCounts();
        showToast('List shuffled randomly.');
      });
    }

    // Clear old history references

    // Main Pick Execution
    function handlePick() {
      if (isPicking) return;
      const rawText = textarea.value;
      const items = parseItems(rawText);
      const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
      const analysis = analyzeDuplicates(items, isCaseInsensitive);

      if (analysis.uniqueCount === 0) {
        showToast('Please enter at least one item.');
        return;
      }

      if (winnersCount > analysis.uniqueCount) {
        winnersCount = analysis.uniqueCount;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }

      isPicking = true;
      pickBtn.setAttribute('disabled', 'true');
      if (mobilePickBtn) mobilePickBtn.setAttribute('disabled', 'true');

      // Show Results Section and Cycling Box
      if (resultsSection) resultsSection.classList.remove('hidden');
      if (shuffleAnimBox) shuffleAnimBox.classList.remove('hidden');
      if (finalWinnersBox) finalWinnersBox.classList.add('hidden');

      resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      // Run Cycling Animation for ~1.5s
      let interval = 70;
      const duration = 1400;
      const startTime = performance.now();
      const pool = analysis.unique;

      function cycleStep() {
        const elapsed = performance.now() - startTime;
        const randomIdx = Math.floor(Math.random() * pool.length);
        if (cyclingNameDisplay) {
          cyclingNameDisplay.textContent = pool[randomIdx];
        }

        if (elapsed < duration) {
          // Progressively slow down interval
          interval += 12;
          setTimeout(cycleStep, interval);
        } else {
          // Final Winner Determination via crypto
          const winners = pickWinners(pool, winnersCount);
          currentWinners = winners;
          finishPick(winners);
        }
      }

      cycleStep();
    }

    function finishPick(winners) {
      if (shuffleAnimBox) shuffleAnimBox.classList.add('hidden');
      if (finalWinnersBox) finalWinnersBox.classList.remove('hidden');

      // Populate Winners List
      if (winnersList) {
        winnersList.innerHTML = winners
          .map((w, idx) => {
            const numBadge =
              winners.length > 1
                ? `<span class="w-6 h-6 rounded-full bg-accent/15 text-accent text-xs font-black flex items-center justify-center shrink-0">#${idx + 1}</span>`
                : '';
            return `
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-surface-light dark:bg-surface-dark border-2 border-accent/40 shadow-lg text-lg sm:text-xl font-extrabold text-primary-light dark:text-primary-dark">
              ${numBadge}
              <span class="tracking-tight text-accent break-all">${w}</span>
            </div>
          `;
          })
          .join('');
      }

      // Save to recent activity history and last state
      saveHistory('picker', {
        t: `Picked ${winners.length} from ${analysis.uniqueCount} items`,
        d: new Date().toISOString(),
        x: {
          rawInput: textarea.value,
          winnerCount: winnersCount,
          removeWinners: toggleRemoveWinners ? toggleRemoveWinners.checked : false,
          caseInsensitive: toggleCaseInsensitive ? toggleCaseInsensitive.checked : true,
        },
      });
      saveLastState('picker', {
        rawInput: textarea.value,
        winnerCount: winnersCount,
        removeWinners: toggleRemoveWinners ? toggleRemoveWinners.checked : false,
        caseInsensitive: toggleCaseInsensitive ? toggleCaseInsensitive.checked : true,
      });

      // Trigger Confetti
      if (typeof window.confetti === 'function') {
        window.confetti({
          particleCount: 90,
          spread: 75,
          origin: { y: 0.6 },
        });
      }

      // Handle "Remove winners after pick" option
      if (toggleRemoveWinners && toggleRemoveWinners.checked) {
        const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
        const newText = removeWinnersFromText(textarea.value, winners, isCaseInsensitive);
        textarea.value = newText;
        updateCounts();

        const remainingItems = parseItems(newText);
        if (remainingCountNotice) {
          remainingCountNotice.textContent = `Winners removed from list (${remainingItems.length} remaining).`;
          remainingCountNotice.classList.remove('hidden');
        }
      } else {
        if (remainingCountNotice) remainingCountNotice.classList.add('hidden');
      }

      // Reset controls
      isPicking = false;
      pickBtn.removeAttribute('disabled');
      if (mobilePickBtn) mobilePickBtn.removeAttribute('disabled');
    }

    pickBtn.addEventListener('click', handlePick);
    if (mobilePickBtn) mobilePickBtn.addEventListener('click', handlePick);
    if (pickAgainBtn) pickAgainBtn.addEventListener('click', handlePick);

    // Copy Winners
    if (copyWinnersBtn) {
      copyWinnersBtn.addEventListener('click', async () => {
        if (currentWinners.length === 0) return;
        const textToCopy = currentWinners.join('\n');
        try {
          await navigator.clipboard.writeText(textToCopy);
          showToast(`Copied ${currentWinners.length} winner${currentWinners.length === 1 ? '' : 's'} to clipboard!`);
        } catch (e) {
          showToast('Unable to copy.');
        }
      });
    }

    // Share Winners
    if (shareWinnersBtn) {
      shareWinnersBtn.addEventListener('click', async () => {
        if (currentWinners.length === 0) return;
        const shareData = {
          title: 'Winners Picked on ToolNest',
          text: `🎉 Selected winner${currentWinners.length === 1 ? '' : 's'}:\n${currentWinners.join('\n')}\n\nFairly drawn with ToolNest Random Picker:`,
          url: window.location.href,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {
            // User cancelled
          }
        } else {
          try {
            await navigator.clipboard.writeText(`${shareData.text} ${shareData.url}`);
            showToast('Result copied to clipboard!');
          } catch (e) {
            showToast('Unable to share.');
          }
        }
      });
    }

    // Restore from history
    function restorePicker(data) {
      if (!data) return;
      if (typeof data.rawInput === 'string') {
        textarea.value = data.rawInput;
      }
      if (data.winnerCount) {
        winnersCount = data.winnerCount;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }
      if (toggleRemoveWinners && data.removeWinners !== undefined) {
        toggleRemoveWinners.checked = !!data.removeWinners;
      }
      if (toggleCaseInsensitive && data.caseInsensitive !== undefined) {
        toggleCaseInsensitive.checked = data.caseInsensitive !== false;
      }
      updateCounts();
      showToast('Restored picker list.');
    }

    // Prefill from last state if available ("welcome back" effect)
    const lastPicker = getLastState('picker');
    if (lastPicker && typeof lastPicker.rawInput === 'string' && lastPicker.rawInput.trim()) {
      textarea.value = lastPicker.rawInput;
      if (lastPicker.winnerCount) {
        winnersCount = lastPicker.winnerCount;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }
      if (toggleRemoveWinners && lastPicker.removeWinners !== undefined) {
        toggleRemoveWinners.checked = !!lastPicker.removeWinners;
      }
      if (toggleCaseInsensitive && lastPicker.caseInsensitive !== undefined) {
        toggleCaseInsensitive.checked = lastPicker.caseInsensitive !== false;
      }
    }

    initHistoryCard({ toolId: 'picker', onRestore: restorePicker });

    // Initial count analysis
    updateCounts();
  }

  initRandomPicker();
  document.addEventListener('astro:after-swap', initRandomPicker);
</script>

---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const wheel = getNamespace(lang, 'wheel');
const errors = getNamespace(lang, 'errors');
const faqNs = getNamespace(lang, 'faq');
const t = { common, wheel, errors, nav: common.nav, siteName: common.siteName, description: common.description };

const localeCode = lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US';
const lastUpdatedDate = new Date().toLocaleDateString(localeCode, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Comprehensive Localized FAQ definitions
const faqs = (faqNs.wheel || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'decision-wheel');

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${getLocalizedPath('/decision-wheel', lang)}#app`,
  name: t.wheel.title,
  url: `https://toolnest.pages.dev${getLocalizedPath('/decision-wheel', lang)}`,
  description: t.wheel.subtitle,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.wheel.howTo.title,
  description: t.wheel.howTo.subtitle,
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: t.wheel.howTo.s1Title,
      text: t.wheel.howTo.s1Desc,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: t.wheel.howTo.s2Title,
      text: t.wheel.howTo.s2Desc,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: t.wheel.howTo.s3Title,
      text: t.wheel.howTo.s3Desc,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  metaKey="wheel"
  canonicalPath={getLocalizedPath('/decision-wheel', lang)}
  ogImage="/og/decision-wheel.svg"
  breadcrumbs={[{ name: common.nav.home, item: getLocalizedPath('/', lang) }, { name: common.nav.decisionWheel, item: getLocalizedPath('/decision-wheel', lang) }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
  lang={lang}
>
  <!-- CDN Confetti Loader for Winner Celebration -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 2v20M2 12h20m-4.93-7.07L4.93 19.07m0-14.14l14.14 14.14"/>
      </svg>
      <span>{t.wheel.ui?.physicsRandomizer || 'Physics & AI Randomizer'}</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.wheel.title}
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      {t.wheel.subtitle}
    </p>
  </header>

  <!-- WHEEL & STAGE CONTAINER -->
  <section id="wheel-tool" class="card mt-4 flex flex-col items-center p-5 sm:p-8 space-y-6" aria-labelledby="wheel-heading">
    <h2 id="wheel-heading" class="sr-only">{t.wheel.ui?.wheelAria || 'Interactive Decision Wheel'}</h2>

    <!-- Wheel Wrapper with Fixed Top Pointer & Center Spin Hub -->
    <div class="relative flex items-center justify-center w-full max-w-[420px] aspect-square select-none p-1.5 sm:p-2.5 rounded-full bg-surface-light/40 dark:bg-surface-dark/70 border border-border-light/60 dark:border-border-dark/80 shadow-inner">
      <!-- Fixed Pointer at 12 o'clock pointing down -->
      <div class="absolute -top-3 z-20 flex flex-col items-center pointer-events-none drop-shadow-md">
        <svg class="w-8 h-8 text-primary-light dark:text-primary-dark filter drop-shadow" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 21L4 7h16l-8 14z"/>
        </svg>
      </div>

      <!-- Canvas Element -->
      <canvas
        id="wheel-canvas"
        class="w-full h-full max-w-[420px] max-h-[420px] rounded-full shadow-lg border border-border-light dark:border-border-dark cursor-grab active:cursor-grabbing"
        style="touch-action: none;"
        role="img"
        aria-label={t.wheel.ui?.wheelAria || 'Decision wheel graphic'}
      ></canvas>

      <!-- Center Spin Hub Button -->
      <button
        id="center-spin-btn"
        type="button"
        class="absolute z-10 w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-surface-light dark:bg-surface-dark border-4 border-border-light dark:border-border-dark shadow-2xl flex flex-col items-center justify-center font-black text-sm sm:text-base text-primary-light dark:text-primary-dark hover:text-accent dark:hover:text-accent hover:scale-105 active:scale-95 transition-all duration-150 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-accent"
        style="touch-action: manipulation;"
        aria-label={t.wheel.ui?.spinButton || t.common.buttons.spin || 'SPIN'}
      >
        <span class="tracking-wider">{t.wheel.ui?.spinButton || 'SPIN'}</span>
        <span class="text-[10px] font-normal text-secondary-light dark:text-secondary-dark">{t.wheel.ui?.orSpace || (lang === 'ar' ? 'أو مسافة' : lang === 'pt' ? 'ou Espaço' : lang === 'id' ? 'atau Spasi' : 'or Space')}</span>
      </button>
    </div>

    <!-- Quick Wheel Actions Bar (Share & Shuffle) -->
    <div class="flex items-center justify-center gap-3 pt-2">
      <button
        id="share-wheel-btn"
        type="button"
        class="btn-secondary text-xs px-4 py-2 min-h-[40px] gap-1.5"
        aria-label={t.common.share}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"/>
          <circle cx="6" cy="12" r="3"/>
          <circle cx="18" cy="19" r="3"/>
          <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
          <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
        </svg>
        <span>{t.common.share}</span>
      </button>

      <button
        id="shuffle-wheel-btn"
        type="button"
        class="btn-secondary text-xs px-4 py-2 min-h-[40px] gap-1.5"
        aria-label={t.common.shuffle}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"/>
          <line x1="4" y1="20" x2="21" y2="3"/>
          <polyline points="21 16 21 21 16 21"/>
          <line x1="15" y1="15" x2="21" y2="21"/>
          <line x1="4" y1="4" x2="9" y2="9"/>
        </svg>
        <span>{t.common.shuffle}</span>
      </button>
    </div>

    <!-- Sticky Mobile Spin Trigger -->
    <div class="sm:hidden fixed bottom-3 inset-x-4 z-30 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))]">
      <button
        id="mobile-spin-btn"
        type="button"
        class="btn-primary w-full py-3.5 text-base font-bold shadow-xl shadow-accent/25 flex items-center justify-center gap-2"
        style="touch-action: manipulation;"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2v20M2 12h20"/>
        </svg>
        <span>{t.common.buttons.spin || t.common.spin}</span>
      </button>
    </div>
  </section>

  <!-- AI PRESET GENERATOR CARD -->
  <section class="card mt-6 space-y-5 border border-accent/40 bg-gradient-to-b from-accent/5 via-surface-light to-surface-light dark:from-accent/10 dark:via-surface-dark dark:to-surface-dark shadow-sm" aria-labelledby="ai-generator-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-accent/15 text-accent flex items-center justify-center text-sm font-bold shadow-sm">
          <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
        </span>
        <h2 id="ai-generator-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
          {wheel.aiGeneratorTitle}
        </h2>
        <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-accent/15 text-accent">
          Gemini 2.0
        </span>
      </div>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        {wheel.aiGeneratorSubtitle}
      </span>
    </div>

    <!-- Suggestion Chips -->
    <div class="space-y-1.5">
      <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
        {wheel.quickIdeasHeading}
      </span>
      <div class="flex flex-wrap items-center gap-2" id="ai-suggestions-row">
        <button
          type="button"
          data-suggestion={wheel.ideas.whatToEat}
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>🍽️</span>
          <span>{wheel.ideas.whatToEat}</span>
        </button>
        <button
          type="button"
          data-suggestion={wheel.ideas.workout}
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>🏃</span>
          <span>{wheel.ideas.workout}</span>
        </button>
        <button
          type="button"
          data-suggestion={wheel.ideas.movie}
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>🎬</span>
          <span>{wheel.ideas.movie}</span>
        </button>
        <button
          type="button"
          data-suggestion={wheel.ideas.travel}
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>✈️</span>
          <span>{wheel.ideas.travel}</span>
        </button>
      </div>
    </div>

    <!-- Input Form & Controls -->
    <div class="space-y-3">
      <div class="space-y-1.5">
        <label for="ai-prompt-input" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {wheel.aiPromptLabel}
        </label>
        <input
          id="ai-prompt-input"
          type="text"
          class="input-base text-base"
          placeholder={wheel.aiPromptPlaceholder}
          maxlength="120"
          autocomplete="off"
        />
      </div>

      <!-- Count Selector & Action Button Row -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1">
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-semibold text-secondary-light dark:text-secondary-dark mr-1">
            {wheel.aiCountLabel}
          </span>
          {[4, 6, 8, 12].map((cnt) => (
            <button
              type="button"
              data-ai-count={cnt}
              class={`ai-count-btn px-2.5 py-1.5 rounded-lg text-xs font-bold border transition-colors cursor-pointer min-h-[36px] min-w-[36px] ${
                cnt === 6
                  ? 'border-accent bg-accent text-white'
                  : 'border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark hover:border-accent'
              }`}
              aria-label={`${cnt} options`}
            >
              {cnt}
            </button>
          ))}
        </div>

        <!-- Submit Button -->
        <button
          id="ai-generate-btn"
          type="button"
          class="btn-primary py-2.5 px-5 text-sm font-bold flex items-center justify-center gap-2 shadow-sm shadow-accent/20 cursor-pointer min-h-[44px]"
        >
          <span id="ai-btn-spinner" class="hidden">
            <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="ai-btn-text">{wheel.aiGenerateBtn}</span>
        </button>
      </div>
    </div>

    <!-- SKELETON SHIMMER LOADER -->
    <div id="ai-skeleton-loader" class="hidden animate-pulse pt-2 space-y-2">
      <div class="text-xs text-secondary-light dark:text-secondary-dark font-medium flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
        <span id="ai-loader-text">{wheel.aiGeneratingText}</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <div class="h-8 w-24 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-28 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-20 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-32 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-24 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-28 rounded-xl bg-black/10 dark:bg-white/10"></div>
      </div>
    </div>

    <!-- INLINE CONFIRMATION CARD -->
    <div id="ai-confirm-card" class="hidden p-4 rounded-xl border border-amber-500/40 bg-amber-500/10 space-y-3" role="alert">
      <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-sm">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>{wheel.replaceConfirmTitle}</span>
      </div>
      <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
        {wheel.replaceConfirmDesc}
      </p>
      <div class="flex items-center gap-2 pt-1">
        <button
          id="ai-confirm-replace-btn"
          type="button"
          class="btn-primary py-2 px-4 text-xs font-bold cursor-pointer"
        >
          {wheel.replaceConfirmBtn}
        </button>
        <button
          id="ai-cancel-replace-btn"
          type="button"
          class="btn-secondary py-2 px-3 text-xs font-semibold cursor-pointer"
        >
          {wheel.replaceCancelBtn}
        </button>
      </div>
    </div>

    <!-- INLINE ERROR BOX WITH RETRY -->
    <div
      id="ai-error-box"
      class="hidden p-3.5 rounded-xl border border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs flex items-center justify-between gap-3"
      role="alert"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        <span id="ai-error-text">{t.wheel.ui?.failedGenerate || 'Failed to generate options.'}</span>
      </div>
      <button
        id="ai-retry-btn"
        type="button"
        class="btn-secondary py-1 px-3 text-xs font-semibold shrink-0 cursor-pointer"
      >
        {common.buttons.retry || 'Retry'}
      </button>
    </div>

    <!-- Disclaimer -->
    <p class="text-[11px] text-secondary-light dark:text-secondary-dark flex items-center gap-1.5 pt-1">
      <span>{t.wheel.ui?.aiDisclaimer || 'Powered by AI — results may vary.'}</span>
    </p>
  </section>

  <!-- OPTIONS MANAGER CARD -->
  <section class="card mt-8 space-y-6" aria-labelledby="options-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h2 id="options-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
          {wheel.optionsHeading}
        </h2>
        <span id="option-counter" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-accent/10 text-accent">
          6 / 12
        </span>
      </div>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        {t.wheel.ui?.minMaxOptions || '2 min — 12 max'}
      </span>
    </div>

    <!-- Presets Row -->
    <div class="space-y-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
        {t.wheel.ui?.popularPresets || 'Popular Presets'}
      </span>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-preset="eat"
          class="preset-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center"
        >
          <svg class="w-3.5 h-3.5 me-1.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
            <path d="M7 2v20"/>
            <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
          </svg>
          <span>{wheel.presetEat}</span>
        </button>
        <button
          type="button"
          data-preset="watch"
          class="preset-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center"
        >
          <svg class="w-3.5 h-3.5 me-1.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <path d="m9 8 7 4-7 4Z"/>
          </svg>
          <span>{wheel.presetWatch}</span>
        </button>
        <button
          type="button"
          data-preset="yesno"
          class="preset-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center"
        >
          <svg class="w-3.5 h-3.5 me-1.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>{wheel.presetYesNo}</span>
        </button>
      </div>
    </div>

    <!-- Add Option Input Form -->
    <form id="add-option-form" class="space-y-2">
      <div class="flex items-center gap-2">
        <input
          id="new-option-input"
          type="text"
          class="input-base text-sm"
          placeholder={wheel.addPlaceholder}
          maxlength="40"
          autocomplete="off"
        />
        <button
          id="add-option-btn"
          type="submit"
          class="btn-primary shrink-0 text-sm font-semibold px-5"
        >
          {common.buttons.add}
        </button>
      </div>
      <p id="option-limit-hint" class="hidden text-xs text-amber-500 font-medium">
        {t.wheel.ui?.maxOptionsReached || 'Maximum 12 options reached. Remove an option to add another.'}
      </p>
    </form>

    <!-- Removable Chips Container -->
    <div id="chips-container" class="flex flex-wrap gap-2 pt-1" aria-label="Current wheel choices">
    </div>
  </section>

  <!-- Recent Activity History Card -->
  <div class="mt-8">
    <HistoryCard toolId="wheel" title={t.wheel.ui?.recentWheels || 'Recent Wheels'} lang={lang} />
  </div>

  <!-- WINNER REVEAL MODAL -->
  <div
    id="winner-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-winner-title"
  >

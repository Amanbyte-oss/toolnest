---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import relatedLinksData from '../data/related-links.json';
import { getTranslations, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const lastUpdatedDate = new Date().toLocaleDateString(lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Comprehensive FAQ definitions (8 questions targeting core search clusters)
const faqs = [
  {
    question: 'Is the wheel spinner truly random and mathematically fair?',
    answer:
      'Yes. The wheel uses cryptographically secure browser randomness to generate the initial spin velocity and duration. The winning slice is derived purely from physical deceleration laws, guaranteeing each segment has an identical mathematical probability of winning.',
  },
  {
    question: 'Can AI automatically generate custom options for the wheel?',
    answer:
      'Yes! ToolNest features an AI preset generator powered by Google Gemini. Simply describe your dilemma (such as "what to eat for dinner decider" or "classroom trivia topics"), choose your desired count, and receive instant personalized choices on your wheel.',
  },
  {
    question: 'Can I use this as a Wheel of Names alternative or prize wheel online?',
    answer:
      'Absolutely. ToolNest serves as a clean, ad-free Wheel of Names alternative and interactive prize wheel online. Enter student names, giveaway prizes, or raffle entries, spin the wheel, and eliminate the winner after each round for multi-draw contests.',
  },
  {
    question: 'How do I set up a yes or no wheel or dinner decider?',
    answer:
      'You can quickly set up a yes or no wheel by entering two options: "Yes" and "No". For a dinner decider, choose our pre-built food preset or type your favorite takeout spots. The wheel spins smoothly and makes the final pick for you.',
  },
  {
    question: 'How does the wheel physics deceleration simulation work?',
    answer:
      'The wheel runs a custom canvas physics engine using quadratic bezier drag deceleration curves rendered at 60 frames per second via requestAnimationFrame. This mimics authentic mechanical friction and pointer tick resistance without predetermined stops.',
  },
  {
    question: 'Can I share my custom decision wheel configuration with a link?',
    answer:
      'Yes! Your options are encoded directly into the URL parameters in real time. Tapping "Share Wheel" or copying the URL allows anyone who opens the link to spin your exact custom wheel without needing an account or database save.',
  },
  {
    question: 'How many options can I put on the wheel generator?',
    answer:
      'You can configure between 2 and 12 options. Setting a 12-item maximum ensures high slice readability, responsive mobile layout performance, and multi-line word wrapping on each segment canvas.',
  },
  {
    question: 'Can I remove the winning choice after each spin?',
    answer:
      'Yes. When the victory celebration modal pops up, you can click "Remove Winner". The chosen slice is instantly eliminated from the wheel, enabling effortless raffle giveaways and multi-round elimination tournaments.',
  },
];

const relatedTools = relatedLinksData['decision-wheel'];

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://toolnest.pages.dev/decision-wheel#app',
  name: 'Random Decision Wheel Spinner',
  url: 'https://toolnest.pages.dev/decision-wheel',
  description: 'Spin the interactive AI-powered decision wheel to make random choices quickly. Generate custom options with Gemini AI or enter your own.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
  featureList: [
    'Interactive physics deceleration canvas wheel spinner',
    'AI-assisted option preset generator with Google Gemini',
    'Customizable 2 to 12 segment choices with multi-line word wrapping',
    'Stateless URL sharing with zero server database storage',
    'Winner elimination mode for tournament or giveaway rounds',
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Use the Random Decision Wheel in 3 Steps',
  description: 'A step-by-step guide to setting up options, spinning the decision wheel, and resolving everyday choices.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Enter your choices or generate with AI',
      text: 'Type custom options into the list or describe your dilemma to let Gemini AI generate options.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Spin the wheel',
      text: 'Tap the center Spin button or press Spacebar to launch the physics deceleration spin.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Declare a winner or eliminate options',
      text: 'Celebrate the selected slice with confetti and optionally remove the winner for another round.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  title={`${t.wheel.metaTitle} | ${t.siteName}`}
  description={t.wheel.metaDescription}
  canonicalPath={getLocalizedPath('/decision-wheel', lang)}
  ogImage="/og/decision-wheel.svg"
  breadcrumbs={[{ name: t.nav.home, item: getLocalizedPath('/', lang) }, { name: t.nav.decisionWheel, item: getLocalizedPath('/decision-wheel', lang) }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
  lang={lang}
>
  <!-- CDN Confetti Loader for Winner Celebration -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 2v20M2 12h20m-4.93-7.07L4.93 19.07m0-14.14l14.14 14.14"/>
      </svg>
      <span>Physics & AI Randomizer</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.wheel.title}
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      {t.wheel.subtitle}
    </p>
  </header>

  <!-- WHEEL & STAGE CONTAINER -->
  <section id="wheel-tool" class="card mt-4 flex flex-col items-center p-5 sm:p-8 space-y-6" aria-labelledby="wheel-heading">
    <h2 id="wheel-heading" class="sr-only">Interactive Decision Wheel</h2>

    <!-- Wheel Wrapper with Fixed Top Pointer & Center Spin Hub -->
    <div class="relative flex items-center justify-center w-full max-w-[420px] aspect-square select-none p-1.5 sm:p-2.5 rounded-full bg-surface-light/40 dark:bg-surface-dark/70 border border-border-light/60 dark:border-border-dark/80 shadow-inner">
      <!-- Fixed Pointer at 12 o'clock pointing down -->
      <div class="absolute -top-3 z-20 flex flex-col items-center pointer-events-none drop-shadow-md">
        <svg class="w-8 h-8 text-primary-light dark:text-primary-dark filter drop-shadow" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 21L4 7h16l-8 14z"/>
        </svg>
      </div>

      <!-- Canvas Element (touch-action: none isolated to canvas) -->
      <canvas
        id="wheel-canvas"
        class="w-full h-full max-w-[420px] max-h-[420px] rounded-full shadow-lg border border-border-light dark:border-border-dark cursor-grab active:cursor-grabbing"
        style="touch-action: none;"
        role="img"
        aria-label="Decision wheel graphic"
      ></canvas>

      <!-- Center Spin Hub Button -->
      <button
        id="center-spin-btn"
        type="button"
        class="absolute z-10 w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-surface-light dark:bg-surface-dark border-4 border-border-light dark:border-border-dark shadow-2xl flex flex-col items-center justify-center font-black text-sm sm:text-base text-primary-light dark:text-primary-dark hover:text-accent dark:hover:text-accent hover:scale-105 active:scale-95 transition-all duration-150 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-accent"
        style="touch-action: manipulation;"
        aria-label={t.common.spin}
      >
        <span class="tracking-wider">{t.wheel.spinButton || 'SPIN'}</span>
        <span class="text-[10px] font-normal text-secondary-light dark:text-secondary-dark">{lang === 'ar' ? 'أو مسافة' : lang === 'pt' ? 'ou Espaço' : lang === 'id' ? 'atau Spasi' : 'or Space'}</span>
      </button>
    </div>

    <!-- Quick Wheel Actions Bar (Share & Shuffle) -->
    <div class="flex items-center justify-center gap-3 pt-2">
      <button
        id="share-wheel-btn"
        type="button"
        class="btn-secondary text-xs px-4 py-2 min-h-[40px] gap-1.5"
        aria-label={t.common.share}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"/>
          <circle cx="6" cy="12" r="3"/>
          <circle cx="18" cy="19" r="3"/>
          <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
          <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
        </svg>
        <span>{t.common.share}</span>
      </button>

      <button
        id="shuffle-wheel-btn"
        type="button"
        class="btn-secondary text-xs px-4 py-2 min-h-[40px] gap-1.5"
        aria-label={t.common.shuffle}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"/>
          <line x1="4" y1="20" x2="21" y2="3"/>
          <polyline points="21 16 21 21 16 21"/>
          <line x1="15" y1="15" x2="21" y2="21"/>
          <line x1="4" y1="4" x2="9" y2="9"/>
        </svg>
        <span>{t.common.shuffle}</span>
      </button>
    </div>

    <!-- Sticky Mobile Spin Trigger (One-thumb ease) -->
    <div class="sm:hidden fixed bottom-3 left-4 right-4 z-30 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))]">
      <button
        id="mobile-spin-btn"
        type="button"
        class="btn-primary w-full py-3.5 text-base font-bold shadow-xl shadow-accent/25 flex items-center justify-center gap-2"
        style="touch-action: manipulation;"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 2v20M2 12h20"/>
        </svg>
        <span>{t.common.spin}</span>
      </button>
    </div>
  </section>

  <!-- AI PRESET GENERATOR CARD -->
  <section class="card mt-6 space-y-5 border border-accent/40 bg-gradient-to-b from-accent/5 via-surface-light to-surface-light dark:from-accent/10 dark:via-surface-dark dark:to-surface-dark shadow-sm" aria-labelledby="ai-generator-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-accent/15 text-accent flex items-center justify-center text-sm font-bold shadow-sm">
          <svg class="w-4 h-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
        </span>
        <h2 id="ai-generator-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
          AI Preset Generator
        </h2>
        <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-accent/15 text-accent">
          Gemini 2.0
        </span>
      </div>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        Curate custom slices in seconds
      </span>
    </div>

    <!-- Suggestion Chips (One-tap fills) -->
    <div class="space-y-1.5">
      <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
        Quick Ideas
      </span>
      <div class="flex flex-wrap items-center gap-2" id="ai-suggestions-row">
        <button
          type="button"
          data-suggestion="What to eat for dinner"
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>🍽️</span>
          <span>What to eat</span>
        </button>
        <button
          type="button"
          data-suggestion="Quick daily workout exercises"
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>🏃</span>
          <span>Workout today</span>
        </button>
        <button
          type="button"
          data-suggestion="Exciting movie genres and film ideas"
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>🎬</span>
          <span>Movie night</span>
        </button>
        <button
          type="button"
          data-suggestion="Weekend holiday travel destinations"
          class="ai-suggestion-chip px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent hover:text-accent transition-colors min-h-[38px] flex items-center gap-1.5 cursor-pointer"
        >
          <span>✈️</span>
          <span>Travel destinations</span>
        </button>
      </div>
    </div>

    <!-- Input Form & Controls -->
    <div class="space-y-3">
      <div class="space-y-1.5">
        <label for="ai-prompt-input" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          Describe what you need to decide
        </label>
        <input
          id="ai-prompt-input"
          type="text"
          class="input-base text-base"
          placeholder="Describe what you need to decide (e.g. what to eat for dinner, weekend activities, chores for kids, party games)..."
          maxlength="120"
          autocomplete="off"
        />
      </div>

      <!-- Count Selector & Action Button Row -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1">
        <!-- Count selector chips -->
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-semibold text-secondary-light dark:text-secondary-dark mr-1">
            Count:
          </span>
          {[4, 6, 8, 12].map((cnt) => (
            <button
              type="button"
              data-ai-count={cnt}
              class={`ai-count-btn px-2.5 py-1.5 rounded-lg text-xs font-bold border transition-colors cursor-pointer min-h-[36px] min-w-[36px] ${
                cnt === 6
                  ? 'border-accent bg-accent text-white'
                  : 'border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark hover:border-accent'
              }`}
              aria-label={`${cnt} options`}
            >
              {cnt}
            </button>
          ))}
        </div>

        <!-- Submit Button -->
        <button
          id="ai-generate-btn"
          type="button"
          class="btn-primary py-2.5 px-5 text-sm font-bold flex items-center justify-center gap-2 shadow-sm shadow-accent/20 cursor-pointer min-h-[44px]"
        >
          <span id="ai-btn-spinner" class="hidden">
            <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
          <span id="ai-btn-text">Generate with AI</span>
        </button>
      </div>
    </div>

    <!-- SKELETON SHIMMER LOADER -->
    <div id="ai-skeleton-loader" class="hidden animate-pulse pt-2 space-y-2">
      <div class="text-xs text-secondary-light dark:text-secondary-dark font-medium flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
        <span id="ai-loader-text">Generating… can take up to 20 seconds on first try</span>
      </div>
      <div class="flex flex-wrap gap-2">
        <div class="h-8 w-24 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-28 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-20 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-32 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-24 rounded-xl bg-black/10 dark:bg-white/10"></div>
        <div class="h-8 w-28 rounded-xl bg-black/10 dark:bg-white/10"></div>
      </div>
    </div>

    <!-- INLINE CONFIRMATION CARD -->
    <div id="ai-confirm-card" class="hidden p-4 rounded-xl border border-amber-500/40 bg-amber-500/10 space-y-3" role="alert">
      <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 font-bold text-sm">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>Replace current wheel options?</span>
      </div>
      <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
        Your wheel currently has custom slices. Would you like to replace them with the new AI-generated options?
      </p>
      <div class="flex items-center gap-2 pt-1">
        <button
          id="ai-confirm-replace-btn"
          type="button"
          class="btn-primary py-2 px-4 text-xs font-bold cursor-pointer"
        >
          Replace Options
        </button>
        <button
          id="ai-cancel-replace-btn"
          type="button"
          class="btn-secondary py-2 px-3 text-xs font-semibold cursor-pointer"
        >
          Keep Current Options
        </button>
      </div>
    </div>

    <!-- INLINE ERROR BOX WITH RETRY -->
    <div
      id="ai-error-box"
      class="hidden p-3.5 rounded-xl border border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400 text-xs flex items-center justify-between gap-3"
      role="alert"
    >
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/>
          <line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
        <span id="ai-error-text">Failed to generate options.</span>
      </div>
      <button
        id="ai-retry-btn"
        type="button"
        class="btn-secondary py-1 px-3 text-xs font-semibold shrink-0 cursor-pointer"
      >
        Retry
      </button>
    </div>

    <!-- Disclaimer -->
    <p class="text-[11px] text-secondary-light dark:text-secondary-dark flex items-center gap-1.5 pt-1">
      <span>Powered by AI — results may vary.</span>
    </p>
  </section>

  <!-- OPTIONS MANAGER CARD -->
  <section class="card mt-8 space-y-6" aria-labelledby="options-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <h2 id="options-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
          Wheel Options
        </h2>
        <span id="option-counter" class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-accent/10 text-accent">
          6 / 12
        </span>
      </div>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        2 min — 12 max
      </span>
    </div>

    <!-- Presets Row -->
    <div class="space-y-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
        Popular Presets
      </span>
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          data-preset="eat"
          class="preset-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center"
        >
          <svg class="w-3.5 h-3.5 mr-1.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
            <path d="M7 2v20"/>
            <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
          </svg>
          <span>What to eat</span>
        </button>
        <button
          type="button"
          data-preset="watch"
          class="preset-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center"
        >
          <svg class="w-3.5 h-3.5 mr-1.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <path d="m9 8 7 4-7 4Z"/>
          </svg>
          <span>What to watch</span>
        </button>
        <button
          type="button"
          data-preset="yesno"
          class="preset-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center"
        >
          <svg class="w-3.5 h-3.5 mr-1.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">

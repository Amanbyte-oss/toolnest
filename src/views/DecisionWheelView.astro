<script>
  import {
    DecisionWheel,
    PRESETS,
    WHEEL_PALETTE,
    encodeOptionsToUrl,
    decodeOptionsFromUrl,
  } from '../scripts/decision-wheel.js';
  import {
    saveHistory,
    saveLastState,
    getLastState,
    initHistoryCard,
  } from '../scripts/history.js';
  import { showToast } from '../scripts/toast.js';

  const LOCALIZED_PRESETS: Record<string, typeof PRESETS> = {
    pt: {
      eat: ['Pizza', 'Tacos', 'Sushi', 'Hambúrguer', 'Salada', 'Massa'],
      watch: ['Ação', 'Comédia', 'Ficção Científica', 'Terror', 'Documentário', 'Drama'],
      yesno: ['Sim', 'Não', 'Talvez', 'Com certeza', 'Pergunte de novo'],
    },
    id: {
      eat: ['Pizza', 'Taco', 'Sushi', 'Burger', 'Salad', 'Pasta'],
      watch: ['Aksi', 'Komedi', 'Fiksi Ilmiah', 'Horor', 'Dokumenter', 'Drama'],
      yesno: ['Ya', 'Tidak', 'Mungkin', 'Pasti', 'Tanya lagi'],
    },
    ar: {
      eat: ['بيتزا', 'تاكو', 'سوشي', 'برجر', 'سلطة', 'مكرونة'],
      watch: ['أكشن', 'كوميديا', 'خيال علمي', 'رعب', 'وثائقي', 'دراما'],
      yesno: ['نعم', 'لا', 'ربما', 'بالتأكيد', 'اسأل مرة أخرى'],
    },
    en: PRESETS,
  };

  function initDecisionWheel() {
    const i18n = (window as any).__WHEEL_I18N__ || {};
    const tWheel = i18n.wheel || {};
    const tCommon = i18n.common || {};
    const tErrors = i18n.errors || {};
    const currentLang = (window as any).__PAGE_LANG__ || document.documentElement.lang || 'en';
    const activePresets = LOCALIZED_PRESETS[currentLang] || PRESETS;

    const canvas = document.getElementById('wheel-canvas') as HTMLCanvasElement;
    const centerSpinBtn = document.getElementById('center-spin-btn') as HTMLButtonElement;
    const mobileSpinBtn = document.getElementById('mobile-spin-btn') as HTMLButtonElement;
    const addForm = document.getElementById('add-option-form') as HTMLFormElement;
    const addInput = document.getElementById('new-option-input') as HTMLInputElement;
    const addBtn = document.getElementById('add-option-btn') as HTMLButtonElement;
    const limitHint = document.getElementById('option-limit-hint');
    const counterEl = document.getElementById('option-counter');
    const chipsContainer = document.getElementById('chips-container');
    const shareBtn = document.getElementById('share-wheel-btn');
    const shuffleBtn = document.getElementById('shuffle-wheel-btn');

    // Winner Modal Elements
    const modal = document.getElementById('winner-modal');
    const modalCard = document.getElementById('modal-card');
    const modalWinnerTitle = document.getElementById('modal-winner-title');
    const modalSpinAgainBtn = document.getElementById('modal-spin-again-btn') as HTMLButtonElement;
    const modalRemoveWinnerBtn = document.getElementById('modal-remove-winner-btn') as HTMLButtonElement;
    const modalCloseBtn = document.getElementById('modal-close-btn');

    if (!canvas || !centerSpinBtn) return;

    // Initial options: read from URL, then last state, then default to localized 'eat'
    const urlParams = new URLSearchParams(window.location.search);
    const urlEncodedOptions = urlParams.get('o');
    const restoredOptions = urlEncodedOptions ? decodeOptionsFromUrl(urlEncodedOptions) : null;
    const lastWheel = getLastState('wheel');

    let options = (restoredOptions && restoredOptions.length >= 2)
      ? restoredOptions
      : (lastWheel && Array.isArray(lastWheel.options) && lastWheel.options.length >= 2)
        ? [...lastWheel.options]
        : [...(activePresets.eat || PRESETS.eat)];
    let currentWinner: string | null = null;

    // Sync options to URL query string (?o=...)
    function syncUrl() {
      const encoded = encodeOptionsToUrl(options);
      const url = new URL(window.location.href);
      if (encoded) {
        url.searchParams.set('o', encoded);
      } else {
        url.searchParams.delete('o');
      }
      window.history.replaceState({}, '', url.toString());
      saveLastState('wheel', { options: [...options] });
    }

    // Render Options Chips
    function renderChips() {
      if (!chipsContainer || !counterEl) return;
      counterEl.textContent = `${options.length} / 12`;

      if (options.length >= 12) {
        if (addBtn) addBtn.setAttribute('disabled', 'true');
        if (limitHint) limitHint.classList.remove('hidden');
      } else {
        if (addBtn) addBtn.removeAttribute('disabled');
        if (limitHint) limitHint.classList.add('hidden');
      }

      chipsContainer.innerHTML = options
        .map((opt, i) => {
          const color = WHEEL_PALETTE[i % WHEEL_PALETTE.length].bg;
          return `
          <div class="inline-flex items-center gap-2 pl-2.5 pr-1.5 py-1 rounded-full text-xs font-semibold bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark group shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: ${color}"></span>
            <span class="truncate max-w-[140px] sm:max-w-[180px]">${opt}</span>
            <button
              type="button"
              class="remove-chip-btn w-6 h-6 flex items-center justify-center rounded-full text-secondary-light hover:text-red-500 hover:bg-red-500/10 transition-colors cursor-pointer"
              data-remove-index="${i}"
              aria-label="Remove ${opt}"
            >
              <svg class="w-3.5 h-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        `;
        })
        .join('');

      // Bind remove buttons
      chipsContainer.querySelectorAll('.remove-chip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (wheel.isSpinning) return;
          const idx = parseInt(btn.getAttribute('data-remove-index') || '0', 10);
          if (options.length <= 2) {
            showToast(tWheel.toasts?.requiresTwo || 'The wheel requires at least 2 options.');
            return;
          }
          options.splice(idx, 1);
          wheel.setOptions(options);
          renderChips();
          syncUrl();
        });
      });
    }

    // Winner Modal Controller
    function openModal(winner: string) {
      currentWinner = winner;
      if (!modal || !modalWinnerTitle) return;
      modalWinnerTitle.textContent = winner;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      if (modalCard) modalCard.classList.remove('scale-95');
      if (modalCard) modalCard.classList.add('scale-100');

      if (typeof (window as any).confetti === 'function') {
        (window as any).confetti({
          particleCount: 100,
          spread: 80,
          origin: { y: 0.6 },
        });
      }

      if (modalSpinAgainBtn) modalSpinAgainBtn.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      if (modalCard) modalCard.classList.add('scale-95');
      if (modalCard) modalCard.classList.remove('scale-100');
    }

    // Wheel Instantiation
    const wheel = new DecisionWheel({
      canvas,
      options,
      onSpinStart: () => {
        centerSpinBtn.setAttribute('disabled', 'true');
        if (mobileSpinBtn) mobileSpinBtn.setAttribute('disabled', 'true');
        centerSpinBtn.classList.add('opacity-60', 'cursor-not-allowed');
      },
      onSpinEnd: ({ winner }) => {
        centerSpinBtn.removeAttribute('disabled');
        if (mobileSpinBtn) mobileSpinBtn.removeAttribute('disabled');
        centerSpinBtn.classList.remove('opacity-60', 'cursor-not-allowed');

        // Save to recent activity history
        const summary =
          options.slice(0, 3).join(', ') +
          (options.length > 3 ? ` +${options.length - 3}` : '');
        saveHistory('wheel', {
          t: `${tWheel.title || 'Wheel'}: ${summary}`,
          d: new Date().toISOString(),
          x: { options: [...options] },
        });
        saveLastState('wheel', { options: [...options] });

        openModal(winner);
      },
    });

    renderChips();

    // Redraw wheel canvas when theme changes
    window.addEventListener('themechange', () => {
      if (wheel) wheel.draw();
    });
    const themeObserver = new MutationObserver(() => {
      if (wheel) wheel.draw();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // Trigger Spin handler
    function triggerSpin() {
      if (wheel.isSpinning) return;
      if (options.length < 2) {
        showToast(tWheel.toasts?.requiresTwo || 'Please add at least 2 options to spin.');
        return;
      }
      wheel.spin();
    }

    centerSpinBtn.addEventListener('click', triggerSpin);
    if (mobileSpinBtn) mobileSpinBtn.addEventListener('click', triggerSpin);

    // Keyboard trigger (Space / Enter on window when modal not open)
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && e.target === document.body && modal && !modal.classList.contains('opacity-100')) {
        e.preventDefault();
        triggerSpin();
      }
      if (e.key === 'Escape' && modal && modal.classList.contains('opacity-100')) {
        closeModal();
      }
    });

    // Add Option Form
    if (addForm && addInput) {
      addForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (wheel.isSpinning) return;

        const val = addInput.value.trim();
        if (!val) {
          showToast(tErrors.requiredField || 'Please type an option name.');
          return;
        }

        if (options.some((o) => o.toLowerCase() === val.toLowerCase())) {
          showToast(tWheel.toasts?.alreadyExists || 'That option is already on the wheel.');
          return;
        }

        if (options.length >= 12) {
          showToast(tWheel.toasts?.maxOptions || 'Maximum 12 options reached.');
          return;
        }

        options.push(val);
        wheel.setOptions(options);
        renderChips();
        syncUrl();
        addInput.value = '';
        addInput.focus();
      });
    }

    // Presets
    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (wheel.isSpinning) return;
        const pKey = btn.getAttribute('data-preset') as keyof typeof PRESETS;
        const chosen = activePresets[pKey] || PRESETS[pKey];
        if (chosen) {
          options = [...chosen];
          wheel.setOptions(options);
          renderChips();
          syncUrl();
          showToast(tCommon.toasts?.loaded || 'Preset loaded.');
        }
      });
    });

    // Shuffle
    if (shuffleBtn) {
      shuffleBtn.addEventListener('click', () => {
        if (wheel.isSpinning) return;
        for (let i = options.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [options[i], options[j]] = [options[j], options[i]];
        }
        wheel.setOptions(options);
        renderChips();
        syncUrl();
        showToast(tWheel.toasts?.shuffled || 'Options shuffled.');
      });
    }

    // Share Wheel
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        syncUrl();
        const shareData = {
          title: `${tWheel.title || 'Decision Wheel'} • ToolNest`,
          text: `Spin this decision wheel: ${options.slice(0, 4).join(', ')}...`,
          url: window.location.href,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {
            // User cancelled
          }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            showToast(tCommon.toasts?.copied || 'Wheel link copied to clipboard!');
          } catch (e) {
            showToast(tCommon.toasts?.errorOccurred || 'Unable to copy link.');
          }
        }
      });
    }

    // Modal Actions
    if (modalSpinAgainBtn) {
      modalSpinAgainBtn.addEventListener('click', () => {
        closeModal();
        setTimeout(triggerSpin, 300);
      });
    }

    if (modalRemoveWinnerBtn) {
      modalRemoveWinnerBtn.addEventListener('click', () => {
        if (currentWinner) {
          const idx = options.indexOf(currentWinner);
          if (idx !== -1) {
            if (options.length <= 2) {
              showToast(tWheel.toasts?.cannotRemoveWinner || 'Cannot remove winner: minimum 2 options required.');
              closeModal();
              return;
            }
            options.splice(idx, 1);
            wheel.setOptions(options);
            renderChips();
            syncUrl();
            showToast(tWheel.toasts?.removedWinner || `Removed "${currentWinner}".`);
          }
        }
        closeModal();
        setTimeout(triggerSpin, 300);
      });
    }

    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // ==========================================
    // ✨ AI PRESET GENERATOR CONTROLLER
    // ==========================================
    const aiPromptInput = document.getElementById('ai-prompt-input') as HTMLInputElement;
    const aiGenerateBtn = document.getElementById('ai-generate-btn') as HTMLButtonElement;
    const aiBtnSpinner = document.getElementById('ai-btn-spinner');
    const aiBtnText = document.getElementById('ai-btn-text');
    const aiSkeleton = document.getElementById('ai-skeleton-loader');
    const aiLoaderText = document.getElementById('ai-loader-text');
    const aiConfirmCard = document.getElementById('ai-confirm-card');
    const aiConfirmReplaceBtn = document.getElementById('ai-confirm-replace-btn');
    const aiCancelReplaceBtn = document.getElementById('ai-cancel-replace-btn');
    const aiErrorBox = document.getElementById('ai-error-box');
    const aiErrorText = document.getElementById('ai-error-text');
    const aiRetryBtn = document.getElementById('ai-retry-btn');
    const aiCountButtons = document.querySelectorAll('.ai-count-btn');
    const aiSuggestionChips = document.querySelectorAll('.ai-suggestion-chip');

    let aiCount = 6;
    let pendingAiOptions: string[] | null = null;
    let lastAiPrompt = '';

    aiSuggestionChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const text = chip.getAttribute('data-suggestion') || '';
        if (aiPromptInput) {
          aiPromptInput.value = text;
          aiPromptInput.focus();
        }
        if (aiErrorBox) aiErrorBox.classList.add('hidden');
      });
    });

    aiCountButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        aiCountButtons.forEach((b) => {
          b.classList.remove('border-accent', 'bg-accent', 'text-white');
          b.classList.add(
            'border-border-light',
            'dark:border-border-dark',
            'bg-input-light',
            'dark:bg-input-dark',
            'text-secondary-light',
            'dark:text-secondary-dark'
          );
        });
        btn.classList.remove(
          'border-border-light',
          'dark:border-border-dark',
          'bg-input-light',
          'dark:bg-input-dark',
          'text-secondary-light',
          'dark:text-secondary-dark'
        );
        btn.classList.add('border-accent', 'bg-accent', 'text-white');
        aiCount = parseInt(btn.getAttribute('data-ai-count') || '6', 10) || 6;
      });
    });

    function setAiLoading(isLoading: boolean, statusText?: string) {
      if (!aiGenerateBtn) return;
      if (isLoading) {
        aiGenerateBtn.setAttribute('disabled', 'true');
        aiGenerateBtn.classList.add('opacity-75', 'cursor-not-allowed');
        if (aiBtnSpinner) aiBtnSpinner.classList.remove('hidden');
        if (aiBtnText) aiBtnText.textContent = statusText || tWheel.aiGeneratingText || 'Generating…';
        if (aiLoaderText) {
          aiLoaderText.textContent =
            statusText === 'Retrying…'
              ? (tWheel.aiRetryingText || 'Retrying…')
              : (tWheel.aiGeneratingText || 'Generating…');
        }
        if (aiSkeleton) aiSkeleton.classList.remove('hidden');
      } else {
        aiGenerateBtn.removeAttribute('disabled');
        aiGenerateBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        if (aiBtnSpinner) aiBtnSpinner.classList.add('hidden');
        if (aiBtnText) aiBtnText.textContent = tWheel.aiGenerateBtn ? `${tWheel.aiGenerateBtn} ✨` : 'Generate with AI ✨';
        if (aiSkeleton) aiSkeleton.classList.add('hidden');
      }
    }

    function showAiError(message: string) {
      if (!aiErrorBox || !aiErrorText) return;
      aiErrorText.textContent = message;
      aiErrorBox.classList.remove('hidden');
    }

    function applyAiOptions(newOpts: string[]) {
      options = [...newOpts];
      wheel.setOptions(options);
      renderChips();
      syncUrl();

      showToast((tWheel.toasts?.generatedCount || 'Generated {count} options!').replace('{count}', String(options.length)));
    }

    async function requestAiOptions(prompt: string, count: number, isRetry = false): Promise<{ ok: boolean; options?: string[]; error?: string; reason?: string }> {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 30000);

      try {
        const response = await fetch('/api/generate-options', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            prompt,
            count,
            lang: currentLang,
          }),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);
        const data = await response.json().catch(() => null);

        if (!response.ok) {
          if ((response.status === 504 || data?.reason === 'timeout') && !isRetry) {
            setAiLoading(true, 'Retrying…');
            return await requestAiOptions(prompt, count, true);
          }

          let errMessage = data?.error;
          if (!errMessage) {
            if (response.status === 429) {
              errMessage = tErrors.rateLimit || 'Rate limit reached. Please wait a minute.';
            } else if (response.status === 504) {
              errMessage = tErrors.timeoutError || 'Generation timed out. Please try again.';
            } else if (response.status === 503) {
              errMessage = tErrors.unavailableError || 'Gemini AI service is temporarily unavailable.';
            } else {
              errMessage = tErrors.genericError || 'Generation failed. Please try again.';
            }
          }
          return { ok: false, error: errMessage, reason: data?.reason || 'server_error' };
        }

        if (!data?.options || !Array.isArray(data.options) || data.options.length < 2) {
          return {
            ok: false,
            error: tErrors.parseError || 'Could not parse valid options. Please try a different topic.',
            reason: 'parse_error',
          };
        }

        return { ok: true, options: data.options };
      } catch (err: any) {
        clearTimeout(timeoutId);
        if (err.name === 'AbortError') {
          if (!isRetry) {
            setAiLoading(true, 'Retrying…');
            return await requestAiOptions(prompt, count, true);
          }
          return {
            ok: false,
            error: tErrors.timeoutError || 'Generation timed out after 30 seconds.',
            reason: 'timeout',
          };
        }
        return {
          ok: false,
          error: tCommon.toasts?.errorOccurred || 'Network error connecting to AI generator.',
          reason: 'network_error',
        };
      }
    }

    async function handleAiGenerate() {
      if (wheel.isSpinning) return;
      const prompt = aiPromptInput?.value.trim() || '';

      if (aiErrorBox) aiErrorBox.classList.add('hidden');
      if (aiConfirmCard) aiConfirmCard.classList.add('hidden');

      if (!prompt || prompt.length < 3) {
        showAiError(tErrors.requiredField || 'Please enter at least 3 characters.');
        aiPromptInput?.focus();
        return;
      }

      const cacheKey = `toolnest_ai_wheel_${prompt.toLowerCase()}_${aiCount}_${currentLang}`;
      try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed) && parsed.length >= 2) {
            applyAiOptions(parsed);
            return;
          }
        }
      } catch (e) {}

      lastAiPrompt = prompt;
      setAiLoading(true);

      try {
        const result = await requestAiOptions(prompt, aiCount, false);

        if (!result.ok) {
          showAiError(result.error || 'Failed to generate');
          return;
        }

        const newOptions = result.options!;

        try {
          sessionStorage.setItem(cacheKey, JSON.stringify(newOptions));
        } catch (e) {}

        const isPreset =
          JSON.stringify(options) === JSON.stringify(activePresets.eat) ||
          JSON.stringify(options) === JSON.stringify(activePresets.watch) ||
          JSON.stringify(options) === JSON.stringify(activePresets.yesno);

        if (!isPreset && options.length >= 2) {
          pendingAiOptions = newOptions;
          if (aiConfirmCard) {
            aiConfirmCard.classList.remove('hidden');
            aiConfirmCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        } else {
          applyAiOptions(newOptions);
        }
      } catch (err) {
        showAiError(tCommon.toasts?.errorOccurred || 'An unexpected error occurred. Please try again.');
      } finally {
        setAiLoading(false);
      }
    }

    if (aiGenerateBtn) {
      aiGenerateBtn.addEventListener('click', handleAiGenerate);
    }

    if (aiRetryBtn) {
      aiRetryBtn.addEventListener('click', () => {
        if (aiPromptInput && lastAiPrompt) {
          aiPromptInput.value = lastAiPrompt;
        }
        handleAiGenerate();
      });
    }

    if (aiConfirmReplaceBtn) {
      aiConfirmReplaceBtn.addEventListener('click', () => {
        if (pendingAiOptions) {
          applyAiOptions(pendingAiOptions);
          pendingAiOptions = null;
        }
        if (aiConfirmCard) aiConfirmCard.classList.add('hidden');
      });
    }

    if (aiCancelReplaceBtn) {
      aiCancelReplaceBtn.addEventListener('click', () => {
        pendingAiOptions = null;
        if (aiConfirmCard) aiConfirmCard.classList.add('hidden');
        showToast(tWheel.toasts?.keptOptions || 'Kept current wheel options.');
      });
    }

    if (aiPromptInput) {
      aiPromptInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleAiGenerate();
        }
      });
    }

    // Restore from history
    function restoreWheel(data: any) {
      if (!data || !Array.isArray(data.options) || data.options.length < 2) return;
      options = [...data.options];
      wheel.setOptions(options);
      renderChips();
      syncUrl();
      showToast(tWheel.toasts?.loadedHistory || 'Loaded wheel options.');
    }

    initHistoryCard({ toolId: 'wheel', onRestore: restoreWheel });

    window.addEventListener('resize', () => {
      wheel.resize();
    });
  }

  initDecisionWheel();
  document.addEventListener('astro:after-swap', initDecisionWheel);
</script>

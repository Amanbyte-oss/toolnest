---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import namesData from '../data/names.json';
import {
  getNamespace,
  getLocalizedPath,
  type Lang,
  generateEditorial,
  getNameDetailFaqs,
  type NameEntry,
} from '../i18n';

export interface Props {
  nameData: NameEntry;
  prevName: { name: string; slug: string };
  nextName: { name: string; slug: string };
  lang?: Lang;
}

const { nameData, prevName, nextName, lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const names = getNamespace(lang, 'names');
const errors = getNamespace(lang, 'errors');

const t = {
  names,
  common,
  errors,
  nav: common.nav,
  siteName: common.siteName,
};

// Popularity dots score
const popularityScore =
  nameData.popularity === 'very high' ? 5 : nameData.popularity === 'high' ? 4 : 3;

// Resolve similar names data objects
const namesBySlug = new Map(namesData.map((n) => [n.slug, n]));
const similarNames = nameData.similar
  .map((slug) => namesBySlug.get(slug))
  .filter(Boolean) as NameEntry[];

// Valid slugs map for safe client-side linking
const validSlugMap = JSON.stringify(
  Object.fromEntries(namesData.map((n) => [n.name.toLowerCase(), n.slug]))
);

// Editorial paragraphs in active language
const { p1, p2, openingSentence } = generateEditorial(nameData, lang);

// FAQs in active language
const faqs = getNameDetailFaqs(nameData, lang);

// SEO formatting (<60 title, <155 desc)
const shortMeaning = nameData.meaning.length > 30 ? `${nameData.meaning.slice(0, 27)}...` : nameData.meaning;
let pageTitle = `${nameData.name} — Meaning, Origin & Traits | ToolNest`;
let metaDescription = `What does ${nameData.name} mean? Explore ${nameData.origin} origin, meaning ("${shortMeaning}"), ${nameData.gender} traits, and popularity on ToolNest.`;

if (lang === 'pt') {
  pageTitle = `${nameData.name} — Significado, Origem e Traços | ToolNest`;
  metaDescription = `O que significa ${nameData.name}? Explore a origem ${nameData.origin}, significado ("${shortMeaning}"), traços e popularidade no ToolNest.`;
} else if (lang === 'id') {
  pageTitle = `${nameData.name} — Arti Nama, Asal Usul & Karakter | ToolNest`;
  metaDescription = `Apa arti nama ${nameData.name}? Temukan asal usul ${nameData.origin}, arti ("${shortMeaning}"), karakter, dan popularitas di ToolNest.`;
} else if (lang === 'ar') {
  pageTitle = `${nameData.name} — معنى الاسم، أصله وصفاته | ToolNest`;
  metaDescription = `ما معنى اسم ${nameData.name}؟ اكتشف أصل ${nameData.origin} ومعناه ("${shortMeaning}") وصفاته وشعبيته على ToolNest.`;
}

// Structured Data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: lang === 'ar' ? `${nameData.name} — معنى الاسم، أصله وصفاته` : lang === 'pt' ? `${nameData.name} — Significado, Origem e Traços` : lang === 'id' ? `${nameData.name} — Arti Nama, Asal Usul & Karakter` : `${nameData.name} — Name Meaning, Origin & Personality Traits`,
  description: metaDescription,
  datePublished: '2024-01-01T00:00:00Z',
  dateModified: new Date().toISOString(),
  author: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
    logo: {
      '@type': 'ImageObject',
      url: 'https://toolnest.pages.dev/favicon.svg',
    },
  },
  mainEntityOfPage: `https://toolnest.pages.dev${getLocalizedPath(`/name/${nameData.slug}`, lang)}`,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<Base
  title={pageTitle}
  description={metaDescription}
  canonicalPath={getLocalizedPath(`/name/${nameData.slug}`, lang)}
  ogImage="/og/names.svg"
  breadcrumbs={[
    { name: t.nav.home, item: getLocalizedPath('/', lang) },
    { name: t.nav.names, item: getLocalizedPath('/names', lang) },
    { name: nameData.name, item: getLocalizedPath(`/name/${nameData.slug}`, lang) },
  ]}
  extraSchemas={[articleSchema, faqSchema]}
  lang={lang}
>
  <!-- Pass localized data to client script -->
  <script is:inline define:vars={{ pageLang: lang, commonI18n: common, errorsI18n: errors }}>
    window.__PAGE_LANG__ = pageLang;
    window.__COMMON_I18N__ = commonI18n;
    window.__ERRORS_I18N__ = errorsI18n;
  </script>

  <article
    id="name-page-article"
    data-name={nameData.name}
    data-slug={nameData.slug}
    class="space-y-8"
  >
    <!-- Page Header & H1 -->
    <header class="space-y-3">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
          <span>📖</span>
          <span class="capitalize">
            {lang === 'ar' ? (nameData.gender === 'female' ? 'اسم مؤنث' : nameData.gender === 'male' ? 'اسم مذكر' : 'اسم للجنسين') : lang === 'pt' ? (nameData.gender === 'female' ? 'Nome Feminino' : nameData.gender === 'male' ? 'Nome Masculino' : 'Nome Unissex') : lang === 'id' ? (nameData.gender === 'female' ? 'Nama Perempuan' : nameData.gender === 'male' ? 'Nama Laki-laki' : 'Nama Uniseks') : `${nameData.gender} Name`}
          </span>
        </div>
        <a
          href={getLocalizedPath('/names', lang)}
          class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline"
        >
          <span>&larr;</span>
          <span>{common.buttons?.exploreMore || 'Back to all names'}</span>
        </a>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        {nameData.name} — {lang === 'ar' ? 'معنى الاسم، أصله وصفاته' : lang === 'pt' ? 'Significado, Origem e Características' : lang === 'id' ? 'Arti Nama, Asal Usul & Karakter' : 'Name Meaning, Origin & Traits'}
      </h1>
      <!-- Unique intro sentence combining origin + meaning + gender -->
      <p class="text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed font-medium">
        {openingSentence}
      </p>
    </header>

    <!-- PREV / NEXT ALPHABETICAL NAVIGATION -->
    <nav class="flex items-center justify-between gap-2 border-y border-border-light dark:border-border-dark py-3 min-w-0" aria-label="Alphabetical Name Navigation">
      <a
        href={getLocalizedPath(`/name/${prevName.slug}`, lang)}
        class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-secondary-light dark:text-secondary-dark hover:text-accent transition-colors min-w-0 max-w-[48%] sm:max-w-none"
      >
        <span class="rtl:rotate-180 shrink-0" aria-hidden="true">&larr;</span>
        <span class="truncate">{lang === 'ar' ? 'السابق:' : lang === 'pt' ? 'Anterior:' : lang === 'id' ? 'Sebelumnya:' : 'Prev:'} <strong class="text-primary-light dark:text-primary-dark">{prevName.name}</strong></span>
      </a>
      <a
        href={getLocalizedPath('/names', lang)}
        class="text-xs font-bold text-accent uppercase tracking-wider hover:underline hidden sm:inline-block shrink-0 px-2"
      >
        {names.ui?.directoryAtoZ || "Directory (A–Z)"}
      </a>
      <a
        href={getLocalizedPath(`/name/${nextName.slug}`, lang)}
        class="inline-flex items-center justify-end gap-1 text-xs sm:text-sm font-semibold text-secondary-light dark:text-secondary-dark hover:text-accent transition-colors min-w-0 max-w-[48%] sm:max-w-none text-end"
      >
        <span class="truncate">{lang === 'ar' ? 'التالي:' : lang === 'pt' ? 'Próximo:' : lang === 'id' ? 'Berikutnya:' : 'Next:'} <strong class="text-primary-light dark:text-primary-dark">{nextName.name}</strong></span>
        <span class="rtl:rotate-180 shrink-0" aria-hidden="true">&rarr;</span>
      </a>
    </nav>

    <!-- KEY ATTRIBUTES CARD -->
    <section class="card p-6 sm:p-7 space-y-6" aria-labelledby="overview-heading">
      <h2 id="overview-heading" class="text-lg font-bold text-primary-light dark:text-primary-dark border-b border-border-light dark:border-border-dark pb-3">
        {lang === 'ar' ? 'نظرة عامة على الاسم' : lang === 'pt' ? 'Visão Geral do Nome' : lang === 'id' ? 'Ringkasan Nama' : 'Name Overview'}
      </h2>

      <!-- Meaning, Origin, Gender Chips -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Meaning Chip -->
        <div class="p-4 rounded-xl bg-input-light dark:bg-input-dark border border-border-light dark:border-border-dark space-y-1">
          <span class="text-[11px] uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark block">
            {names.meaningLabel || "Meaning"}
          </span>
          <span class="text-base font-bold text-primary-light dark:text-primary-dark capitalize">
            "{nameData.meaning}"
          </span>
        </div>

        <!-- Origin Chip -->
        <div class="p-4 rounded-xl bg-input-light dark:bg-input-dark border border-border-light dark:border-border-dark space-y-1">
          <span class="text-[11px] uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark block">
            {names.originLabel || "Origin"}
          </span>
          <span class="text-base font-bold text-primary-light dark:text-primary-dark">
            {nameData.origin}
          </span>
        </div>

        <!-- Gender Chip -->
        <div class="p-4 rounded-xl bg-input-light dark:bg-input-dark border border-border-light dark:border-border-dark space-y-1">
          <span class="text-[11px] uppercase tracking-wider font-bold text-secondary-light dark:text-secondary-dark block">
            {lang === 'ar' ? 'الجنس' : lang === 'pt' ? 'Gênero' : lang === 'id' ? 'Jenis Kelamin' : 'Gender'}
          </span>
          <span class="text-base font-bold text-primary-light dark:text-primary-dark capitalize">
            {nameData.gender === 'female' ? (names.ui?.female || 'Female') : nameData.gender === 'male' ? (names.ui?.male || 'Male') : (names.ui?.unisex || 'Unisex')}
          </span>
        </div>
      </div>

      <!-- POPULARITY INDICATOR: 5-DOT VISUAL SCALE -->
      <div class="pt-2 space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {lang === 'ar' ? 'مقياس الشعبية' : lang === 'pt' ? 'Escala de Popularidade' : lang === 'id' ? 'Skala Popularitas' : 'Popularity Scale'}
          </span>
          <span class="text-xs font-bold text-accent capitalize">
            {nameData.popularity === 'very high' ? (lang === 'ar' ? 'عالية جداً' : lang === 'pt' ? 'Muito alta' : lang === 'id' ? 'Sangat tinggi' : 'Very high') : nameData.popularity === 'high' ? (lang === 'ar' ? 'عالية' : lang === 'pt' ? 'Alta' : lang === 'id' ? 'Tinggi' : 'High') : (lang === 'ar' ? 'متوسطة' : lang === 'pt' ? 'Média' : lang === 'id' ? 'Menengah' : 'Medium')} ({popularityScore} / 5)
          </span>
        </div>
        <div class="flex items-center gap-2" aria-label={`Popularity rating ${popularityScore} out of 5`}>
          {[1, 2, 3, 4, 5].map((dot) => (
            <div
              class={`h-3 flex-1 rounded-full transition-colors ${
                dot <= popularityScore
                  ? 'bg-accent shadow-sm shadow-accent/40'
                  : 'bg-border-light dark:border-border-dark'
              }`}
            />
          ))}
        </div>
        <p class="text-xs text-secondary-light dark:text-secondary-dark pt-0.5">
          {lang === 'ar' ? 'بناءً على سجلات المواليد الحديثة وتكرار التسمية دولياً.' : lang === 'pt' ? 'Com base em registros modernos de nascimentos e frequência internacional de nomes.' : lang === 'id' ? 'Berdasarkan data kelahiran modern dan frekuensi penamaan internasional.' : 'Based on modern birth records and international naming frequency.'}
        </p>
      </div>
    </section>

    <!-- IN-DEPTH EDITORIAL PARAGRAPHS -->
    <section class="card p-6 sm:p-7 space-y-4 leading-relaxed" aria-labelledby="analysis-heading">
      <h2 id="analysis-heading" class="text-lg font-bold text-primary-light dark:text-primary-dark">
        {lang === 'ar' ? `حول اسم ${nameData.name}` : lang === 'pt' ? `Sobre o Nome ${nameData.name}` : lang === 'id' ? `Tentang Nama ${nameData.name}` : `About the Name ${nameData.name}`}
      </h2>
      <p class="text-sm sm:text-base text-secondary-light dark:text-secondary-dark">
        {p1}
      </p>
      <p class="text-sm sm:text-base text-secondary-light dark:text-secondary-dark">
        {p2}
      </p>
    </section>

    <!-- FAMOUS PEOPLE LIST -->
    {nameData.famous && nameData.famous.length > 0 && (
      <section class="card p-6 sm:p-7 space-y-4" aria-labelledby="famous-heading">
        <div class="flex items-center gap-2">
          <span class="text-xl">🌟</span>
          <h2 id="famous-heading" class="text-lg font-bold text-primary-light dark:text-primary-dark">
            {lang === 'ar' ? `شخصيات بارزة باسم ${nameData.name}` : lang === 'pt' ? `Personalidades Notáveis Chamadas ${nameData.name}` : lang === 'id' ? `Tokoh Terkenal Bernama ${nameData.name}` : `Notable People Named ${nameData.name}`}
          </h2>
        </div>
        <ul class="divide-y divide-border-light dark:divide-border-dark">
          {nameData.famous.map((person) => (
            <li class="py-3 flex items-center gap-3 text-sm text-primary-light dark:text-primary-dark font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span>
              <span>{person}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- ✨ AI INSIGHTS CARD (On-Demand Gemini Analysis) -->
    <section
      id="ai-insights-section"
      class="card p-6 sm:p-7 space-y-5 border border-accent/25 bg-gradient-to-b from-surface-light via-surface-light to-accent/5 dark:from-surface-dark dark:via-surface-dark dark:to-accent/5 shadow-sm scroll-mt-20"
      aria-labelledby="ai-insights-heading"
      data-valid-slugs={validSlugMap}
    >
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-accent/15 text-accent border border-accent/30">
          <span>✨</span>
          <span>{names.aiInsightsHeading || "AI Name Insights"}</span>
        </div>
        <span class="text-[11px] text-secondary-light dark:text-secondary-dark font-medium">
          Powered by Gemini
        </span>
      </div>

      <div class="space-y-1">
        <h2 id="ai-insights-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
          {lang === 'ar' ? `تحليل ثقافي وشخصي عميق لاسم ${nameData.name}` : lang === 'pt' ? `Análise Cultural e de Personalidade Profunda para ${nameData.name}` : lang === 'id' ? `Analisis Budaya & Kepribadian Mendalam untuk ${nameData.name}` : `Deep Cultural & Personality Analysis for ${nameData.name}`}
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          {lang === 'ar' ? 'اكتشف سمات الشخصية المدعومة بالذكاء الاصطناعي، والجوهر العاطفي، وتصنيف النمط، ومعلومات تاريخية مشوقة.' : lang === 'pt' ? 'Desbloqueie traços de personalidade por IA, essência emocional, classificação de estilo e curiosidades históricas.' : lang === 'id' ? 'Dapatkan wawasan kepribadian AI, esensi emosional, klasifikasi gaya, dan fakta sejarah menarik.' : 'Unlock on-demand AI personality traits, emotional essence, style classification, and fascinating historical trivia.'}
        </p>
      </div>

      <!-- Teaser State (Collapsed by default, zero network overhead until requested) -->
      <div id="ai-insights-teaser" class="pt-2">
        <button
          id="unlock-ai-btn"
          type="button"
          class="btn-primary inline-flex items-center gap-2.5 py-3 px-6 text-sm font-bold shadow-md shadow-accent/20 cursor-pointer min-h-[48px]"
        >
          <span>✨</span>
          <span>{lang === 'ar' ? 'فتح تحليلات الذكاء الاصطناعي' : lang === 'pt' ? 'Desbloquear Análise com IA' : lang === 'id' ? 'Buka Wawasan AI' : 'Unlock AI Insights'}</span>
        </button>
      </div>

      <!-- Loading Skeleton Shimmer -->
      <div id="ai-insights-loading" class="hidden space-y-4 pt-2">
        <div class="flex items-center gap-2 text-xs font-semibold text-accent animate-pulse">
          <svg class="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span id="ai-loading-status">{common.buttons?.loading || "Consulting the name experts..."}</span>
        </div>

        <div class="space-y-3 animate-pulse">
          <div class="h-20 bg-input-light dark:bg-input-dark rounded-2xl"></div>
          <div class="h-10 bg-input-light dark:bg-input-dark rounded-xl"></div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
            <div class="h-9 bg-input-light dark:bg-input-dark rounded-xl"></div>
            <div class="h-9 bg-input-light dark:bg-input-dark rounded-xl"></div>
            <div class="h-9 bg-input-light dark:bg-input-dark rounded-xl"></div>
            <div class="h-9 bg-input-light dark:bg-input-dark rounded-xl"></div>
          </div>
        </div>
      </div>

      <!-- Inline Error State -->
      <div
        id="ai-insights-error"
        class="hidden p-4 rounded-xl border border-red-500/30 bg-red-500/10 dark:bg-red-500/20 text-xs sm:text-sm space-y-2"
        role="alert"
      >
        <p id="ai-error-message" class="text-red-600 dark:text-red-400 font-medium"></p>
        <button
          id="ai-retry-btn"
          type="button"
          class="btn-secondary text-xs px-3.5 py-1.5 font-semibold min-h-[36px]"
        >
          {lang === 'ar' ? 'إعادة المحاولة' : lang === 'pt' ? 'Tentar Novamente' : lang === 'id' ? 'Coba Lagi' : 'Try Again'}
        </button>
      </div>

      <!-- Results Container (Populated via JS) -->
      <div id="ai-insights-results" class="hidden space-y-5 pt-1">
        <!-- 💫 Essence sentence -->
        <div class="p-4 sm:p-5 rounded-2xl bg-accent/10 dark:bg-accent/15 border border-accent/30 space-y-1.5">
          <div class="text-[11px] font-bold uppercase tracking-wider text-accent flex items-center gap-1.5">
            <span>💫</span>
            <span>{names.meaningLabel || "Core Essence"}</span>
          </div>
          <p id="ai-essence-text" class="text-sm sm:text-base font-semibold text-primary-light dark:text-primary-dark leading-relaxed italic"></p>
        </div>

        <!-- 🧭 Origin & 🏷️ Style Badge -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="p-3.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center gap-2 text-xs sm:text-sm">
            <span class="text-base">🧭</span>
            <div>
              <span class="text-[10px] uppercase font-bold text-secondary-light dark:text-secondary-dark block">{names.originLabel || "Cultural Root"}</span>
              <span id="ai-origin-text" class="font-bold text-primary-light dark:text-primary-dark"></span>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-between text-xs sm:text-sm">
            <div class="flex items-center gap-2">
              <span class="text-base">🏷️</span>
              <span class="text-[10px] uppercase font-bold text-secondary-light dark:text-secondary-dark block">{lang === 'ar' ? 'النمط' : lang === 'pt' ? 'Estilo' : lang === 'id' ? 'Gaya' : 'Style'}</span>
            </div>
            <span id="ai-style-badge" class="px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-accent/15 text-accent border border-accent/30"></span>
          </div>
        </div>

        <!-- 🎭 Personality Traits -->
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark flex items-center gap-1.5">
            <span>🎭</span>
            <span>{lang === 'ar' ? 'نمط الشخصية' : lang === 'pt' ? 'Arquétipo de Personalidade' : lang === 'id' ? 'Arketipe Kepribadian' : 'Personality Archetype'}</span>
          </div>
          <div id="ai-personality-chips" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- ⭐ Famous Namesakes -->
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark flex items-center gap-1.5">
            <span>⭐</span>
            <span>{lang === 'ar' ? 'شخصيات بارزة' : lang === 'pt' ? 'Personalidades Notáveis' : lang === 'id' ? 'Tokoh Terkenal' : 'Notable Namesakes'}</span>
          </div>
          <ul id="ai-famous-list" class="space-y-1.5 text-xs sm:text-sm"></ul>
        </div>

        <!-- 🎲 Fun Fact Highlight Card -->
        <div class="p-4 rounded-xl border border-border-light dark:border-border-dark bg-bg-light dark:bg-bg-dark space-y-1.5">
          <div class="text-xs font-bold text-secondary-light dark:text-secondary-dark flex items-center gap-1.5">
            <span>🎲</span>
            <span>{lang === 'ar' ? 'حقيقة مشوقة' : lang === 'pt' ? 'Curiosidade Fascinante' : lang === 'id' ? 'Fakta Menarik' : 'Fascinating Fact'}</span>
          </div>
          <p id="ai-funfact-text" class="text-xs sm:text-sm text-primary-light dark:text-primary-dark leading-relaxed"></p>
        </div>

        <!-- 🔗 Related Names -->
        <div class="space-y-2">
          <div class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark flex items-center gap-1.5">
            <span>🔗</span>
            <span>{lang === 'ar' ? 'أسماء ذات صلة' : lang === 'pt' ? 'Nomes Relacionados' : lang === 'id' ? 'Nama Terkait' : 'Related Names'}</span>
          </div>
          <div id="ai-similar-chips" class="flex flex-wrap gap-2"></div>
        </div>
      </div>
    </section>

    <!-- SIMILAR NAMES SECTION (INTERNAL LINKING FOR PROGRAMMATIC SEO) -->
    {similarNames.length > 0 && (
      <section class="space-y-4" aria-labelledby="similar-heading">
        <div class="flex items-center justify-between">
          <h2 id="similar-heading" class="text-lg font-bold text-primary-light dark:text-primary-dark">
            {lang === 'ar' ? `أسماء مشابهة لاسم ${nameData.name}` : lang === 'pt' ? `Nomes Semelhantes a ${nameData.name}` : lang === 'id' ? `Nama Serupa dengan ${nameData.name}` : `Similar Names to ${nameData.name}`}
          </h2>
          <a href={getLocalizedPath('/names', lang)} class="text-xs font-semibold text-accent hover:underline">
            {lang === 'ar' ? 'استكشف أكثر من 200 اسم' : lang === 'pt' ? 'Explorar 200+ nomes' : lang === 'id' ? 'Jelajahi 200+ nama' : 'Explore 200+ names'} &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          {similarNames.map((sim) => (
            <a
              href={getLocalizedPath(`/name/${sim.slug}`, lang)}
              class="group card p-4 hover:border-accent/60 transition-all hover:shadow-md flex flex-col justify-between"
            >
              <div class="space-y-1">
                <div class="flex items-center justify-between">
                  <span class="text-base font-bold text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors">
                    {sim.name}
                  </span>
                  <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-md bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark">
                    {sim.gender === 'female' ? (names.ui?.female || 'Female') : sim.gender === 'male' ? (names.ui?.male || 'Male') : (names.ui?.unisex || 'Unisex')}
                  </span>
                </div>
                <p class="text-xs text-secondary-light dark:text-secondary-dark line-clamp-1">
                  <span class="font-medium text-primary-light dark:text-primary-dark">{sim.origin}</span> &bull; "{sim.meaning}"
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- FREQUENTLY ASKED QUESTIONS -->
    <section class="space-y-4">
      <h2 class="text-lg font-bold text-primary-light dark:text-primary-dark">
        {common.buttons?.faq || 'Frequently Asked Questions'}
      </h2>
      <Faq items={faqs} lang={lang} />
    </section>

    <!-- CROSS-TOOL CTA BANNERS (Link to /birthday-facts and /name-meaning) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <section class="card p-6 bg-gradient-to-r from-accent/10 via-surface-light to-surface-light dark:from-accent/20 dark:via-surface-dark dark:to-surface-dark border-accent/30 space-y-3">
        <div class="flex items-center gap-2 text-accent font-bold text-xs uppercase tracking-wider">
          <span>🎉</span>
          <span>{lang === 'ar' ? 'شخصية يوم الميلاد' : lang === 'pt' ? 'Personalidade do Aniversário' : lang === 'id' ? 'Kepribadian Hari Lahir' : 'Birthday Personality'}</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark">
          {lang === 'ar' ? 'ماذا يكشف تاريخ ميلادك؟' : lang === 'pt' ? 'O que seu aniversário revela?' : lang === 'id' ? 'Apa yang diungkapkan hari lahir Anda?' : 'What does your birthday reveal?'}
        </h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {lang === 'ar'
            ? 'اكتشف برجك، ورقم مسار حياتك، وحجر ميلادك، ومشاهير يشاركونك يوم الميلاد في ملف حقائق أعياد الميلاد.'
            : lang === 'pt'
            ? 'Descubra seu signo do zodíaco, número do caminho de vida, pedra do nascimento e famosos aniversariantes no nosso dossiê de fatos de aniversário.'
            : lang === 'id'
            ? 'Temukan zodiak, angka jalur hidup, batu kelahiran, dan tokoh yang lahir di hari yang sama di kalkulator fakta ulang tahun kami.'
            : 'Discover your zodiac sign, life path number, birthstone, and famous birthday twins on our birthday facts dossier.'}
        </p>
        <div class="pt-1">
          <a
            href={getLocalizedPath('/birthday-facts', lang)}
            class="btn-primary inline-flex py-2 px-4 text-xs font-bold shadow-sm shadow-accent/20"
          >
            <span>{lang === 'ar' ? 'اكتشف حقائق الميلاد' : lang === 'pt' ? 'Ver Fatos do Aniversário' : lang === 'id' ? 'Cek Fakta Hari Lahir' : 'Check Birthday Facts'} &rarr;</span>
          </a>
        </div>
      </section>

      <section class="card p-6 bg-gradient-to-r from-accent/10 via-surface-light to-surface-light dark:from-accent/20 dark:via-surface-dark dark:to-surface-dark border-accent/30 space-y-3">
        <div class="flex items-center gap-2 text-accent font-bold text-xs uppercase tracking-wider">
          <span>✨</span>
          <span>{names.aiInsightsHeading || "Custom Name Insights"}</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark">
          {lang === 'ar' ? 'تحليل اسم مميز آخر' : lang === 'pt' ? 'Analisar outro nome único' : lang === 'id' ? 'Analisis nama unik lainnya' : 'Analyze another unique name'}
        </h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {lang === 'ar'
            ? 'ابحث عن أي اسم مولود نادر أو دولي باستخدام محرك معاني الأسماء بالذكاء الاصطناعي للحصول على معانٍ فورية.'
            : lang === 'pt'
            ? 'Pesquise qualquer nome internacional, raro ou moderno em nosso localizador de significados com IA para obter etimologia e traços instantâneos.'
            : lang === 'id'
            ? 'Cari nama bayi internasional, unik, atau modern di pencari arti nama AI kami untuk mendapatkan etimologi dan karakter secara instan.'
            : 'Search any international, rare, or modern baby name on our AI-assisted name meaning finder to get instant etymology and traits.'}
        </p>
        <div class="pt-1">
          <a
            href={getLocalizedPath('/name-meaning', lang)}
            class="btn-secondary inline-flex py-2 px-4 text-xs font-bold"
          >
            <span>{lang === 'ar' ? 'ابحث عن اسم آخر' : lang === 'pt' ? 'Buscar Outro Nome' : lang === 'id' ? 'Cari Nama Lain' : 'Search Another Name'} &rarr;</span>
          </a>
        </div>
      </section>
    </div>

    <!-- BOTTOM PREV / NEXT ALPHABETICAL NAVIGATION -->
    <nav class="flex items-center justify-between border-t border-border-light dark:border-border-dark pt-4" aria-label="Bottom Alphabetical Name Navigation">
      <a
        href={getLocalizedPath(`/name/${prevName.slug}`, lang)}
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-secondary-light dark:text-secondary-dark hover:text-accent transition-colors"
      >
        <span>&larr;</span>
        <span>{lang === 'ar' ? 'السابق:' : lang === 'pt' ? 'Anterior:' : lang === 'id' ? 'Sebelumnya:' : 'Previous:'} <strong class="text-primary-light dark:text-primary-dark">{prevName.name}</strong></span>
      </a>
      <a
        href={getLocalizedPath('/names', lang)}
        class="text-xs font-bold text-accent uppercase tracking-wider hover:underline"
      >
        {names.ui?.directoryAtoZ || "All Names (A–Z)"}
      </a>
      <a
        href={getLocalizedPath(`/name/${nextName.slug}`, lang)}
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-secondary-light dark:text-secondary-dark hover:text-accent transition-colors text-right"
      >
        <span>{lang === 'ar' ? 'التالي:' : lang === 'pt' ? 'Próximo:' : lang === 'id' ? 'Berikutnya:' : 'Next:'} <strong class="text-primary-light dark:text-primary-dark">{nextName.name}</strong></span>
        <span>&rarr;</span>
      </a>
    </nav>
  </article>
</Base>

<script>
  import { saveHistory } from '../scripts/history.js';

  function initNamePage() {
    const article = document.getElementById('name-page-article');
    if (!article) return;

    const name = article.getAttribute('data-name');
    const slug = article.getAttribute('data-slug');
    const pageLang = (window as any).__PAGE_LANG__ || 'en';
    const langPrefix = pageLang !== 'en' ? `/${pageLang}` : '';

    // 1. Record in History module
    if (name && slug) {
      const historyTitle = pageLang === 'ar' ? `عرض الاسم: ${name}` : pageLang === 'pt' ? `Visualizou nome: ${name}` : pageLang === 'id' ? `Melihat nama: ${name}` : `Viewed name: ${name}`;
      saveHistory('names', {
        t: historyTitle,
        d: new Date().toISOString(),
        x: { name, slug, url: `${langPrefix}/name/${slug}` },
      });
    }

    // 2. AI Insights Controller
    const aiSection = document.getElementById('ai-insights-section');
    const teaserEl = document.getElementById('ai-insights-teaser');
    const unlockBtn = document.getElementById('unlock-ai-btn');
    const loadingEl = document.getElementById('ai-insights-loading');
    const errorEl = document.getElementById('ai-insights-error');
    const errorMessageEl = document.getElementById('ai-error-message');
    const retryBtn = document.getElementById('ai-retry-btn');
    const resultsEl = document.getElementById('ai-insights-results');

    // Result elements
    const essenceText = document.getElementById('ai-essence-text');
    const originText = document.getElementById('ai-origin-text');
    const styleBadge = document.getElementById('ai-style-badge');
    const personalityChips = document.getElementById('ai-personality-chips');
    const famousList = document.getElementById('ai-famous-list');
    const funfactText = document.getElementById('ai-funfact-text');
    const similarChips = document.getElementById('ai-similar-chips');

    if (!unlockBtn || !name) return;

    let validSlugs: Record<string, string> = {};
    try {
      const rawSlugs = aiSection?.getAttribute('data-valid-slugs');
      if (rawSlugs) validSlugs = JSON.parse(rawSlugs);
    } catch (e) {
      validSlugs = {};
    }

    function renderInsights(insights: any) {
      if (!insights) return;

      if (essenceText) essenceText.textContent = `"${insights.meaning}"`;
      if (originText) originText.textContent = insights.origin || (pageLang === 'ar' ? 'عالمي' : pageLang === 'pt' ? 'Internacional' : pageLang === 'id' ? 'Internasional' : 'International');
      if (styleBadge) styleBadge.textContent = insights.style || 'timeless';

      if (personalityChips) {
        personalityChips.innerHTML = (insights.personality || [])
          .map(
            (trait: string) =>
              `<span class="px-3 py-1 rounded-xl text-xs font-semibold bg-input-light dark:bg-input-dark border border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark shadow-xs">${trait}</span>`
          )
          .join('');
      }

      if (famousList) {
        famousList.innerHTML = (insights.famous || [])
          .map(
            (person: string) =>
              `<li class="flex items-center gap-2.5 text-primary-light dark:text-primary-dark font-medium"><span class="w-1.5 h-1.5 rounded-full bg-accent shrink-0"></span><span>${person}</span></li>`
          )
          .join('');
      }

      if (funfactText) funfactText.textContent = insights.funFact || '';

      if (similarChips) {
        similarChips.innerHTML = (insights.similar || [])
          .map((simName: string) => {
            const clean = simName.trim();
            const targetSlug = validSlugs[clean.toLowerCase()];
            if (targetSlug) {
              return `<a href="${langPrefix}/name/${targetSlug}" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-accent hover:border-accent hover:bg-accent/10 transition-colors shadow-xs">${clean} &rarr;</a>`;
            }
            return `<span class="px-3 py-1.5 rounded-xl text-xs font-medium bg-input-light dark:bg-input-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark">${clean}</span>`;
          })
          .join('');
      }

      // Display results view
      if (teaserEl) teaserEl.classList.add('hidden');
      if (loadingEl) loadingEl.classList.add('hidden');
      if (errorEl) errorEl.classList.add('hidden');
      if (resultsEl) resultsEl.classList.remove('hidden');
    }

    async function fetchInsights() {
      // 1. Check sessionStorage cache
      const cacheKey = `toolnest_ai_insights_${name.toLowerCase()}`;
      try {
        const cached = sessionStorage.getItem(cacheKey);
        if (cached) {
          const parsed = JSON.parse(cached);
          renderInsights(parsed);
          return;
        }
      } catch (e) {
        // Ignore storage errors
      }

      // 2. Set loading state
      if (teaserEl) teaserEl.classList.add('hidden');
      if (errorEl) errorEl.classList.add('hidden');
      if (resultsEl) resultsEl.classList.add('hidden');
      if (loadingEl) loadingEl.classList.remove('hidden');
      if (unlockBtn) unlockBtn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/name-insights', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, lang: pageLang }),
        });

        if (!res.ok) {
          if (res.status === 429) {
            throw new Error((window as any).__ERRORS_I18N__?.rateLimit || 'Too many lookups — try again in a minute.');
          }
          const errData = await res.json().catch(() => null);
          throw new Error(errData?.error || (window as any).__ERRORS_I18N__?.aiUnavailable || 'Unable to load insights at this time. Please try again.');
        }

        const data = await res.json();
        if (!data?.insights) throw new Error('Invalid response received from AI service.');

        // Cache in sessionStorage
        try {
          sessionStorage.setItem(cacheKey, JSON.stringify(data.insights));
        } catch (e) {
          // sessionStorage may be disabled or full
        }

        // Save AI insights lookup in history
        const aiTitle = pageLang === 'ar' ? `تحليلات ذكاء اصطناعي: ${name}` : pageLang === 'pt' ? `Análise IA: ${name}` : pageLang === 'id' ? `Wawasan AI: ${name}` : `AI Insights: ${name}`;
        saveHistory('names', {
          t: aiTitle,
          d: new Date().toISOString(),
          x: { name, slug, url: `${langPrefix}/name/${slug}` },
        });

        renderInsights(data.insights);
      } catch (err: any) {
        if (loadingEl) loadingEl.classList.add('hidden');
        if (errorEl) {
          errorEl.classList.remove('hidden');
          if (errorMessageEl) errorMessageEl.textContent = err.message || 'Something went wrong.';
        }
        if (teaserEl) teaserEl.classList.remove('hidden');
      } finally {
        if (unlockBtn) unlockBtn.removeAttribute('disabled');
      }
    }

    // Check if previously loaded in this session
    const cacheKey = `toolnest_ai_insights_${name.toLowerCase()}`;
    try {
      const cached = sessionStorage.getItem(cacheKey);
      if (cached) {
        renderInsights(JSON.parse(cached));
      }
    } catch (e) {}

    unlockBtn.addEventListener('click', fetchInsights);
    if (retryBtn) retryBtn.addEventListener('click', fetchInsights);
  }

  initNamePage();
  document.addEventListener('astro:after-swap', initNamePage);
</script>

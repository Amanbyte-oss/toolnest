---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const home = getNamespace(lang, 'home');
const age = getNamespace(lang, 'age');
const birthday = getNamespace(lang, 'birthday');
const wheel = getNamespace(lang, 'wheel');
const picker = getNamespace(lang, 'picker');
const countdown = getNamespace(lang, 'countdown');
const names = getNamespace(lang, 'names');
const compressor = getNamespace(lang, 'compressor');
const converter = getNamespace(lang, 'converter');

const tools = [
  {
    title: common.nav.imageCompressor,
    description: compressor.subtitle,
    href: getLocalizedPath('/image-compressor', lang),
    badge: lang === 'ar' ? 'جديد • خصوصية 100%' : lang === 'pt' ? 'Novo • 100% Privado' : lang === 'id' ? 'Baru • 100% Privat' : 'New • 100% Private',
    icon: 'image' as const,
    popular: true,
  },
  {
    title: common.nav.imageConverter,
    description: converter.subtitle,
    href: getLocalizedPath('/image-converter', lang),
    badge: lang === 'ar' ? 'جديد • خصوصية 100%' : lang === 'pt' ? 'Novo • 100% Privado' : lang === 'id' ? 'Baru • 100% Privat' : 'New • 100% Private',
    icon: 'convert' as const,
    popular: true,
  },
  {
    title: common.nav.ageCalculator,
    description: age.subtitle,
    href: getLocalizedPath('/age-calculator', lang),
    badge: common.labels?.popular || (lang === 'ar' ? 'شائع' : lang === 'pt' ? 'Popular' : lang === 'id' ? 'Populer' : 'Popular'),
    icon: 'calendar' as const,
    popular: true,
  },
  {
    title: common.nav.birthdayFacts,
    description: birthday.subtitle,
    href: getLocalizedPath('/birthday-facts', lang),
    badge: lang === 'ar' ? 'معلومات' : lang === 'pt' ? 'Curiosidades' : lang === 'id' ? 'Trivia' : 'Trivia',
    icon: 'cake' as const,
    popular: false,
  },
  {
    title: common.nav.decisionWheel,
    description: wheel.subtitle,
    href: getLocalizedPath('/decision-wheel', lang),
    badge: lang === 'ar' ? 'عشوائي' : lang === 'pt' ? 'Sorteador' : lang === 'id' ? 'Pengacak' : 'Randomizer',
    icon: 'wheel' as const,
    popular: false,
  },
  {
    title: common.nav.randomPicker,
    description: picker.subtitle,
    href: getLocalizedPath('/random-picker', lang),
    badge: lang === 'ar' ? 'أداة' : lang === 'pt' ? 'Utilitário' : lang === 'id' ? 'Utilitas' : 'Utility',
    icon: 'dice' as const,
    popular: false,
  },
  {
    title: common.nav.countdown,
    description: countdown.subtitle,
    href: getLocalizedPath('/countdown', lang),
    badge: lang === 'ar' ? 'الوقت' : lang === 'pt' ? 'Tempo' : lang === 'id' ? 'Waktu' : 'Time',
    icon: 'clock' as const,
    popular: false,
  },
  {
    title: common.nav.nameMeaning,
    description: names.subtitle,
    href: getLocalizedPath('/name-meaning', lang),
    badge: lang === 'ar' ? 'ذكاء اصطناعي + قاعدة بيانات' : lang === 'pt' ? 'IA + Dados' : lang === 'id' ? 'AI + Database' : 'AI + Database',
    icon: 'book' as const,
    popular: false,
  },
];
---

<Base
  metaKey="home"
  canonicalPath={getLocalizedPath('/', lang)}
  ogImage="/og/home.svg"
  maxWidthClass="max-w-5xl"
  lang={lang}
>
  <!-- Pass localized data to client script -->
  <script is:inline define:vars={{ pageLang: lang }}>
    window.__PAGE_LANG__ = pageLang;
  </script>

  <!-- Client-side First Visit Redirect Fallback on root -->
  {lang === 'en' && (
    <script is:inline>
      (function () {
        if (window.location.pathname === '/' || window.location.pathname === '') {
          try {
            var stored = localStorage.getItem('toolnest_lang');
            if (stored && ['pt', 'id', 'ar'].indexOf(stored) !== -1) {
              window.location.replace('/' + stored + '/');
            }
          } catch (e) {}
        }
      })();
    </script>
  )}

  <!-- Hero Section -->
  <section class="relative overflow-hidden rounded-3xl border border-border-light/80 dark:border-border-dark/80 bg-gradient-to-b from-slate-100/80 via-white to-slate-50/50 dark:from-[#15181C] dark:via-[#1B1E21] dark:to-[#111315] px-6 py-12 sm:py-16 text-center mb-8 shadow-sm">
    <div class="max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-medium text-primary-light dark:text-primary-dark">ToolNest</span>
        <span>•</span>
        <span>{common.badgeFree}</span>
        <span>•</span>
        <span>{common.badgePrivacy}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark leading-[1.15]">
        {home.heroTitle}
      </h1>

      <p class="text-base sm:text-lg text-secondary-light dark:text-secondary-dark max-w-xl mx-auto leading-relaxed">
        {home.heroSubtitle}
      </p>

      <div class="pt-2">
        <a href="#tools-grid" class="btn-primary inline-flex items-center gap-2 shadow-sm">
          <span>{common.buttons.exploreMore}</span>
          <svg class="w-4 h-4 rtl-flip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Jump Back In Section -->
  <section
    id="jump-back-in-section"
    class="hidden mb-8 p-4 rounded-2xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark transition-all"
    aria-label={lang === 'ar' ? 'النشاط الأخير' : lang === 'pt' ? 'Atividade Recente' : lang === 'id' ? 'Aktivitas Terbaru' : 'Recent Activity'}
  >
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <h2 class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{lang === 'ar' ? 'استئناف النشاط الأخير' : lang === 'pt' ? 'Continuar de onde parou' : lang === 'id' ? 'Lanjutkan Aktivitas' : 'Jump Back In'}</span>
      </h2>
      <span class="text-[11px] text-secondary-light/70 dark:text-secondary-dark/70">
        {lang === 'ar' ? 'محفوظ محلياً في متصفحك فقط' : lang === 'pt' ? 'Salvo apenas no seu navegador' : lang === 'id' ? 'Tersimpan hanya di browser Anda' : 'Stored only in your browser'}
      </span>
    </div>
    <div id="jump-back-in-chips" class="flex flex-wrap gap-2"></div>
  </section>

  <!-- Tools Grid Section -->
  <section id="tools-grid" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-primary-light dark:text-primary-dark">
        {home.exploreToolsHeading}
      </h2>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        {tools.length} {lang === 'ar' ? 'أدوات مصغرة' : lang === 'pt' ? 'microferramentas' : lang === 'id' ? 'alat mikro' : 'micro-tools'}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {tools.map((tool) => (
        <ToolCard
          title={tool.title}
          description={tool.description}
          href={tool.href}
          badge={tool.badge}
          icon={tool.icon}
          popular={tool.popular}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <!-- Value Props / Why Choose ToolNest Section -->
  <section class="mt-16 pt-12 border-t border-border-light dark:border-border-dark">
    <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
      <h2 class="text-2xl font-bold text-primary-light dark:text-primary-dark">
        {home.whyChooseTitle}
      </h2>
      <p class="text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
        {lang === 'ar' ? `${common.siteName} مصممة مع التركيز الكامل على الخصوصية، والسرعة، والبساطة الفائقة.` : lang === 'pt' ? `${common.siteName} é desenvolvido com privacidade, desempenho e simplicidade em sua essência.` : lang === 'id' ? `${common.siteName} dibuat dengan mengutamakan privasi, performa, dan kesederhanaan.` : `${common.siteName} is crafted with privacy, performance, and simplicity at its core.`}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card space-y-3">
        <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
          {home.whyFast}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {home.whyFastDesc}
        </p>
      </div>

      <div class="card space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
          {home.whyPrivate}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {home.whyPrivateDesc}
        </p>
      </div>

      <div class="card space-y-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-500">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
          {home.whyFree}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {home.whyFreeDesc}
        </p>
      </div>
    </div>
  </section>

  <script>
    import { getAllRecentHistory, formatRelativeTime } from '../scripts/history.js';

    function renderJumpBackIn() {
      const section = document.getElementById('jump-back-in-section');
      const container = document.getElementById('jump-back-in-chips');
      if (!section || !container) return;

      const recent = getAllRecentHistory(4);
      if (!recent || recent.length === 0) {
        section.classList.add('hidden');
        return;
      }

      const pageLang = (window as any).__PAGE_LANG__ || 'en';
      const langPrefix = pageLang !== 'en' ? `/${pageLang}` : '';

      container.innerHTML = recent
        .map(
          (item) => {
            const rawHref = item.href || '/';
            const cleanHref = rawHref.startsWith('/pt/') || rawHref.startsWith('/id/') || rawHref.startsWith('/ar/')
              ? rawHref
              : (pageLang !== 'en' ? `${langPrefix}${rawHref}` : rawHref);

            return `
        <a
          href="${cleanHref}"
          class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark hover:border-accent/50 text-xs shadow-xs hover:shadow-sm hover:-translate-y-0.5 active:scale-95 transition-all shrink-0 group focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="${item.toolTitle}: ${item.t}"
        >
          <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-accent/10 text-accent dark:bg-accent/20">
            ${item.badge}
          </span>
          <span class="font-medium text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors truncate max-w-[150px] sm:max-w-[220px]">
            ${item.t}
          </span>
          <span class="text-[10px] text-secondary-light/70 dark:text-secondary-dark/70 shrink-0">
            ${formatRelativeTime(item.d, pageLang)}
          </span>
        </a>
      `;
          }
        )
        .join('');

      section.classList.remove('hidden');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderJumpBackIn);
    } else {
      renderJumpBackIn();
    }
    window.addEventListener('toolnest:history-updated', renderJumpBackIn);
  </script>
</Base>


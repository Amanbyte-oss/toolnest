---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import { getTranslations, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const tools = [
  {
    title: t.nav.ageCalculator,
    description: t.age.subtitle,
    href: getLocalizedPath('/age-calculator', lang),
    badge: 'Popular',
    icon: 'calendar' as const,
    popular: true,
  },
  {
    title: t.nav.birthdayFacts,
    description: t.birthday.subtitle,
    href: getLocalizedPath('/birthday-facts', lang),
    badge: 'Trivia',
    icon: 'cake' as const,
    popular: false,
  },
  {
    title: t.nav.decisionWheel,
    description: t.wheel.subtitle,
    href: getLocalizedPath('/decision-wheel', lang),
    badge: 'Randomizer',
    icon: 'wheel' as const,
    popular: false,
  },
  {
    title: t.nav.randomPicker,
    description: t.picker.subtitle,
    href: getLocalizedPath('/random-picker', lang),
    badge: 'Utility',
    icon: 'dice' as const,
    popular: false,
  },
  {
    title: t.nav.countdown,
    description: t.countdown.subtitle,
    href: getLocalizedPath('/countdown', lang),
    badge: 'Time',
    icon: 'clock' as const,
    popular: false,
  },
  {
    title: t.nav.nameMeaning,
    description: t.names.subtitle,
    href: getLocalizedPath('/name-meaning', lang),
    badge: 'AI + Database',
    icon: 'book' as const,
    popular: false,
  },
];
---

<Base
  title={`${t.home.heroTitle} — ${t.siteName}`}
  description={t.description}
  canonicalPath={getLocalizedPath('/', lang)}
  ogImage="/og/home.svg"
  maxWidthClass="max-w-5xl"
  lang={lang}
>
  <!-- Client-side First Visit Redirect Fallback on root -->
  {lang === 'en' && (
    <script is:inline>
      (function () {
        if (window.location.pathname === '/' || window.location.pathname === '') {
          try {
            var stored = localStorage.getItem('toolnest_lang');
            if (stored && ['pt', 'id', 'ar'].indexOf(stored) !== -1) {
              window.location.replace('/' + stored + '/');
            }
          } catch (e) {}
        }
      })();
    </script>
  )}

  <!-- Hero Section -->
  <section class="relative overflow-hidden rounded-3xl border border-border-light/80 dark:border-border-dark/80 bg-gradient-to-b from-slate-100/80 via-white to-slate-50/50 dark:from-[#15181C] dark:via-[#1B1E21] dark:to-[#111315] px-6 py-12 sm:py-16 text-center mb-8 shadow-sm">
    <div class="max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark shadow-xs">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        <span class="font-medium text-primary-light dark:text-primary-dark">ToolNest</span>
        <span>•</span>
        <span>{t.badgeFree}</span>
        <span>•</span>
        <span>{t.badgePrivacy}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark leading-[1.15]">
        {t.home.heroTitle}
      </h1>

      <p class="text-base sm:text-lg text-secondary-light dark:text-secondary-dark max-w-xl mx-auto leading-relaxed">
        {t.home.heroSubtitle}
      </p>

      <div class="pt-2">
        <a href="#tools-grid" class="btn-primary inline-flex items-center gap-2 shadow-sm">
          <span>{t.common.exploreMore}</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Jump Back In Section -->
  <section id="jump-back-in-section" class="hidden mb-10 space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        <svg class="w-3.5 h-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Recent Activity</span>
      </div>
    </div>
    <div id="jump-back-in-chips" class="flex flex-wrap gap-2.5"></div>
  </section>

  <!-- Tools Grid -->
  <section id="tools-grid" class="scroll-mt-24 space-y-6">
    <div class="flex items-center justify-between border-b border-border-light dark:border-border-dark pb-3">
      <h2 class="text-xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
        {t.home.exploreToolsHeading}
      </h2>
      <span class="text-xs font-medium text-secondary-light dark:text-secondary-dark">
        6 {t.common.options.toLowerCase()}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {tools.map((tool) => (
        <ToolCard
          title={tool.title}
          description={tool.description}
          href={tool.href}
          badge={tool.badge}
          icon={tool.icon}
          popular={tool.popular}
        />
      ))}
    </div>
  </section>

  <!-- Value Props / Why Choose ToolNest Section -->
  <section class="mt-16 pt-12 border-t border-border-light dark:border-border-dark">
    <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
      <h2 class="text-2xl font-bold text-primary-light dark:text-primary-dark">
        {t.home.whyChooseTitle}
      </h2>
      <p class="text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
        {t.siteName} is crafted with privacy, performance, and simplicity at its core.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card space-y-3">
        <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </div>
        <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
          {t.home.whyFast}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {t.home.whyFastDesc}
        </p>
      </div>

      <div class="card space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
          {t.home.whyPrivate}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {t.home.whyPrivateDesc}
        </p>
      </div>

      <div class="card space-y-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-500">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
          {t.home.whyFree}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {t.home.whyFreeDesc}
        </p>
      </div>
    </div>
  </section>

  <script>
    import { getAllRecentHistory, formatRelativeTime } from '../scripts/history.js';

    function renderJumpBackIn() {
      const section = document.getElementById('jump-back-in-section');
      const container = document.getElementById('jump-back-in-chips');
      if (!section || !container) return;

      const recent = getAllRecentHistory(4);
      if (!recent || recent.length === 0) {
        section.classList.add('hidden');
        return;
      }

      container.innerHTML = recent
        .map(
          (item) => `
        <a
          href="${item.href}"
          class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark hover:border-accent/50 text-xs shadow-xs hover:shadow-sm hover:-translate-y-0.5 active:scale-95 transition-all shrink-0 group focus:outline-none focus:ring-2 focus:ring-accent"
          aria-label="Reopen ${item.toolTitle}: ${item.t}"
        >
          <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-accent/10 text-accent dark:bg-accent/20">
            ${item.badge}
          </span>
          <span class="font-medium text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors truncate max-w-[150px] sm:max-w-[220px]">
            ${item.t}
          </span>
          <span class="text-[10px] text-secondary-light/70 dark:text-secondary-dark/70 shrink-0">
            ${formatRelativeTime(item.d)}
          </span>
        </a>
      `
        )
        .join('');

      section.classList.remove('hidden');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', renderJumpBackIn);
    } else {
      renderJumpBackIn();
    }
    window.addEventListener('toolnest:history-updated', renderJumpBackIn);
  </script>
</Base>

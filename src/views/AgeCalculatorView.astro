---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import { getNamespace, getLocalizedPath, getLocalizedRelatedLinks, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const age = getNamespace(lang, 'age');
const errors = getNamespace(lang, 'errors');
const faqNs = getNamespace(lang, 'faq');
const t = { age, common, errors, nav: common.nav, siteName: common.siteName };

const currentYear = new Date().getFullYear();
const currentMonth = new Date().getMonth() + 1;
const currentDay = new Date().getDate();
const lastUpdatedDate = new Date().toLocaleDateString(lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Years array descending from current year down to 1900
const years = Array.from({ length: currentYear - 1900 + 1 }, (_, i) => currentYear - i);
const days = Array.from({ length: 31 }, (_, i) => i + 1);

// Localized month names using Intl
const localeMap: Record<string, string> = { en: 'en-US', pt: 'pt-BR', id: 'id-ID', ar: 'ar-EG' };
const currentLocale = localeMap[lang] || 'en-US';
const monthFormatter = new Intl.DateTimeFormat(currentLocale, { month: 'long' });
const monthNames = Array.from({ length: 12 }, (_, i) => monthFormatter.format(new Date(2024, i, 15)));

// Localized FAQs and Related Tools
const faqs = faqNs.age || [];
const relatedTools = getLocalizedRelatedLinks(lang, 'age-calculator');

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${getLocalizedPath('/age-calculator', lang)}#app`,
  name: t.age.title || 'Age Calculator — Exact Chronological Age & Life Stats',
  url: `https://toolnest.pages.dev${getLocalizedPath('/age-calculator', lang)}`,
  description: t.age.subtitle || 'Calculate your exact age in years, months, days, and hours. Discover upcoming birthday countdowns, lived seconds, and milestone dates.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.age.howTo?.title || 'How to Calculate Your Exact Age Online in 3 Steps',
  description: t.age.howTo?.subtitle || 'A quick guide to determining your exact chronological age in years, months, days, and live seconds using ToolNest.',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: t.age.howTo?.s1Title || 'Select your birth date',
      text: t.age.howTo?.s1Desc || 'Select your birth year, month, and day using the dropdown menus or click the calendar icon for native date picking.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: t.age.howTo?.s2Title || 'Choose an optional reference date',
      text: t.age.howTo?.s2Desc || 'By default, your age is calculated relative to today. Expand the optional date panel to calculate your age at a past wedding, graduation, or future milestone.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: t.age.howTo?.s3Title || 'Calculate and explore your life statistics',
      text: t.age.howTo?.s3Desc || 'Click Calculate Exact Age to reveal your full chronological breakdown, lived seconds ticker, and upcoming birthday countdown.',
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f: any) => ({
    '@type': 'Question',
    name: f.q || f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a || f.answer,
    },
  })),
};
---

<Base
  metaKey="age"
  canonicalPath={getLocalizedPath('/age-calculator', lang)}
  ogImage="/og/age-calculator.svg"
  breadcrumbs={[{ name: common.nav.home, item: getLocalizedPath('/', lang) }, { name: common.nav.ageCalculator, item: getLocalizedPath('/age-calculator', lang) }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
  lang={lang}
>
  <!-- CDN Confetti Loader for Birthday Celebration -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <!-- Page Header (Compact, tool is immediately visible) -->
  <header class="text-center py-2 sm:py-4 space-y-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
        <line x1="16" x2="16" y1="2" y2="6"/>
        <line x1="8" x2="8" y1="2" y2="6"/>
        <line x1="3" x2="21" y1="10" y2="10"/>
      </svg>
      <span>Precision Calendar Math</span>
    </div>
    <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.age.title}
    </h1>
    <p class="text-xs sm:text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      {t.age.subtitle}
    </p>
  </header>

  <!-- TOOL FIRST: INPUT SECTION (Card) -->
  <section id="calculator-tool" class="card mt-3 sm:mt-4 space-y-6 scroll-mt-20" aria-labelledby="input-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex items-center justify-between">
      <h2 id="input-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
        {t.age.ui?.enterDob || t.age.birthDateLabel || 'Enter Date of Birth'}
      </h2>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        {t.age.ui?.accurateToDay || 'Accurate to the day'}
      </span>
    </div>

    <!-- Primary Dropdown Pickers (Day, Month, Year for consistent mobile/iOS UX) -->
    <div class="space-y-4">
      <div class="grid grid-cols-3 gap-2.5 sm:gap-4">
        <!-- Month Dropdown -->
        <div class="space-y-1.5">
          <label for="birth-month" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.month || 'Month'}
          </label>
          <select id="birth-month" class="input-base cursor-pointer">
            <option value="">{t.age.ui?.month || 'Month'}</option>
            {monthNames.map((name, index) => (
              <option value={index + 1} selected={index + 1 === 1}>
                {name}
              </option>
            ))}
          </select>
        </div>

        <!-- Day Dropdown -->
        <div class="space-y-1.5">
          <label for="birth-day" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.day || 'Day'}
          </label>
          <select id="birth-day" class="input-base cursor-pointer">
            <option value="">{t.age.ui?.day || 'Day'}</option>
            {days.map((d) => (
              <option value={d} selected={d === 1}>
                {d}
              </option>
            ))}
          </select>
        </div>

        <!-- Year Dropdown -->
        <div class="space-y-1.5">
          <label for="birth-year" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.year || 'Year'}
          </label>
          <select id="birth-year" class="input-base cursor-pointer">
            <option value="">{t.age.ui?.year || 'Year'}</option>
            {years.map((y) => (
              <option value={y} selected={y === 2000}>
                {y}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Native Date Input Sync Toggle / Secondary option -->
      <div class="flex items-center justify-between pt-1 text-xs">
        <label for="native-birth-date" class="text-secondary-light dark:text-secondary-dark cursor-pointer flex items-center gap-1.5 hover:text-accent">
          <span>{t.age.ui?.orUseCalendar || 'Or use calendar picker:'}</span>
        </label>
        <input
          type="date"
          id="native-birth-date"
          value="2000-01-01"
          max={`${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(currentDay).padStart(2, '0')}`}
          min="1900-01-01"
          class="rounded-lg border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark px-2.5 py-1 text-xs text-primary-light dark:text-primary-dark focus:outline-none focus:border-accent"
          aria-label={t.age.ui?.orUseCalendar || 'Native birth date picker'}
        />
      </div>

      <!-- Inline Validation Error Alert -->
      <div
        id="date-error"
        class="hidden rounded-xl border border-error/30 bg-rose-500/10 dark:bg-rose-500/15 p-3.5 text-xs text-error font-medium flex items-center gap-2"
        role="alert"
        aria-live="polite"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span id="date-error-text">{t.age.toasts?.invalidDate || 'Please enter a valid calendar date.'}</span>
      </div>

      <!-- Optional "Calculate age at date" Accordion -->
      <details class="group rounded-xl border border-border-light dark:border-border-dark bg-bg-light/50 dark:bg-bg-dark/50 transition-all duration-150">
        <summary class="flex items-center justify-between p-3.5 text-xs font-semibold text-secondary-light dark:text-secondary-dark cursor-pointer list-none select-none rounded-xl hover:text-accent">
          <span>{t.age.ui?.calculateAtDate || 'Calculate age at a specific date (optional)'}</span>
          <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="p-3.5 pt-1 border-t border-border-light/60 dark:border-border-dark/60 space-y-3">
          <p class="text-xs text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.targetDateDesc || 'Defaults to today. Change this to see your age at a past wedding, graduation, or future milestone.'}
          </p>
          <div class="flex items-center gap-2">
            <input
              type="date"
              id="target-date-input"
              value={`${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(currentDay).padStart(2, '0')}`}
              min="1900-01-01"
              max="2100-12-31"
              class="input-base text-sm py-2"
              aria-label={t.age.ui?.calculateAtDate || 'Target calculation date'}
            />
            <button
              id="reset-target-today"
              type="button"
              class="btn-secondary text-xs px-3 py-2 shrink-0 min-h-[44px]"
            >
              {t.age.ui?.resetToToday || 'Reset to Today'}
            </button>
          </div>
        </div>
      </details>

      <!-- Calculate Button: sticky bottom on mobile with safe-area inset, standard on desktop -->
      <div class="sticky bottom-3 z-20 sm:static sm:z-auto pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))] sm:pb-0 bg-surface-light/90 dark:bg-surface-dark/90 sm:bg-transparent backdrop-blur-md sm:backdrop-blur-none -mx-2 px-2 sm:mx-0 sm:px-0">
        <button
          id="calculate-button"
          type="button"
          class="btn-primary w-full sm:w-auto sm:px-8 py-3.5 text-base font-bold shadow-md shadow-accent/20 cursor-pointer"
        >
          {t.age.calculateBtn || 'Calculate Exact Age'}
        </button>
      </div>
    </div>
  </section>

  <!-- RESULTS CONTAINER (Revealed on calculate with staggered fade-up) -->
  <div id="results-container" class="hidden mt-8 space-y-8 scroll-mt-24">
    <!-- Hero Result Card -->
    <section class="card bg-gradient-to-br from-surface-light via-surface-light to-accent/5 dark:from-surface-dark dark:via-surface-dark dark:to-accent/10 border-accent/30 shadow-md text-center py-7 sm:py-9 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
        <span>{t.age.exactAgeHeading || 'Exact Chronological Age'}</span>
      </span>

      <!-- Primary Age Hero Display -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        <div class="flex items-baseline gap-1">
          <span id="hero-years" class="text-accent font-black">0</span>
          <span class="text-base sm:text-xl font-medium text-secondary-light dark:text-secondary-dark">{t.age.years?.toLowerCase() || 'years'}</span>
        </div>
        <span class="text-secondary-light dark:text-secondary-dark text-xl sm:text-3xl">•</span>
        <div class="flex items-baseline gap-1">
          <span id="hero-months" class="text-accent font-black">0</span>
          <span class="text-base sm:text-xl font-medium text-secondary-light dark:text-secondary-dark">{t.age.months?.toLowerCase() || 'months'}</span>
        </div>
        <span class="text-secondary-light dark:text-secondary-dark text-xl sm:text-3xl">•</span>
        <div class="flex items-baseline gap-1">
          <span id="hero-days" class="text-accent font-black">0</span>
          <span class="text-base sm:text-xl font-medium text-secondary-light dark:text-secondary-dark">{t.age.days?.toLowerCase() || 'days'}</span>
        </div>
      </div>

      <!-- Live Seconds Ticker -->
      <div class="pt-2">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-xs sm:text-sm font-medium text-secondary-light dark:text-secondary-dark">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>{t.age.ui?.liveSecondsPrefix || 'You are exactly'} <strong id="live-seconds" class="text-primary-light dark:text-primary-dark font-mono font-semibold">0</strong> {t.age.ui?.liveSecondsSuffix || 'seconds old'}</span>
        </div>
      </div>

      <!-- Action Buttons Row (Copy & Share) -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <button
          id="copy-results-btn"
          type="button"
          class="btn-secondary text-xs sm:text-sm gap-1.5"
          aria-label={t.age.ui?.copyResults || 'Copy Results'}
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span>{t.age.ui?.copyResults || 'Copy Results'}</span>
        </button>

        <button
          id="share-results-btn"
          type="button"
          class="btn-secondary text-xs sm:text-sm gap-1.5"
          aria-label={t.age.ui?.share || 'Share'}
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
          </svg>
          <span>{t.age.ui?.share || 'Share'}</span>
        </button>
      </div>
    </section>

    <!-- Next Birthday Card -->
    <section id="next-birthday-card" class="card bg-surface-light dark:bg-surface-dark border-border-light dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-4 p-5 sm:p-6">
      <div class="space-y-1 text-center sm:text-left">
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <span class="text-xl">🎈</span>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            {t.age.nextBirthdayHeading || 'Next Birthday Countdown'}
          </h3>
        </div>
        <p id="bday-countdown-text" class="text-sm text-secondary-light dark:text-secondary-dark">
          {t.age.ui?.calculatingNextBday || 'Calculating next birthday...'}
        </p>
      </div>

      <!-- Birthday badge status -->
      <div id="bday-badge-container" class="shrink-0 text-center sm:text-right">
        <div id="bday-days-pill" class="px-4 py-2 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark font-mono font-bold text-lg sm:text-xl text-accent">
          <span id="bday-days-remaining">0</span> <span class="text-xs font-sans font-medium text-secondary-light dark:text-secondary-dark">{t.age.days?.toLowerCase() || 'days'}</span>
        </div>
        <div id="bday-today-banner" class="hidden px-4 py-2 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-success font-bold text-base flex items-center gap-1.5 animate-bounce">
          <span>🎉 {t.age.ui?.happyBirthday || 'Happy Birthday!'}</span>
        </div>
      </div>
    </section>

    <!-- Totals Grid (2 cols mobile, 4 cols desktop) -->
    <section class="space-y-3" aria-labelledby="totals-heading">
      <h3 id="totals-heading" class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        {t.age.ui?.totalMilestones || 'Total Lifetime Milestones'}
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        <div class="card p-4 text-center space-y-1">
          <span class="text-xs text-secondary-light dark:text-secondary-dark">{t.age.ui?.totalMonths || t.age.months || 'Total Months'}</span>
          <div id="total-months" class="text-xl sm:text-2xl font-extrabold text-primary-light dark:text-primary-dark">0</div>
        </div>
        <div class="card p-4 text-center space-y-1">
          <span class="text-xs text-secondary-light dark:text-secondary-dark">{t.age.ui?.totalWeeks || t.age.weeks || 'Total Weeks'}</span>
          <div id="total-weeks" class="text-xl sm:text-2xl font-extrabold text-primary-light dark:text-primary-dark">0</div>
        </div>
        <div class="card p-4 text-center space-y-1">
          <span class="text-xs text-secondary-light dark:text-secondary-dark">{t.age.ui?.totalDays || t.age.days || 'Total Days'}</span>
          <div id="total-days" class="text-xl sm:text-2xl font-extrabold text-primary-light dark:text-primary-dark">0</div>
        </div>
        <div class="card p-4 text-center space-y-1">
          <span class="text-xs text-secondary-light dark:text-secondary-dark">{t.age.ui?.totalHours || t.age.hours || 'Total Hours'}</span>
          <div id="total-hours" class="text-xl sm:text-2xl font-extrabold text-primary-light dark:text-primary-dark">0</div>
        </div>
      </div>
    </section>

    <!-- Fun Stats Section -->
    <section class="space-y-3" aria-labelledby="fun-stats-heading">
      <h3 id="fun-stats-heading" class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        {t.age.ui?.funStatsHeading || 'Fascinating Life & Planetary Stats'}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <!-- Sleep Card -->
        <div class="card p-4 space-y-2">
          <div class="flex items-center gap-2 text-sm font-semibold text-primary-light dark:text-primary-dark">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <span>{t.age.ui?.hoursSlept || 'Hours Slept (~8h/day)'}</span>
          </div>
          <div id="stat-sleep" class="text-xl font-bold text-accent">0</div>
          <p class="text-xs text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.hoursSleptDesc || 'Approximately one third of your lifetime spent dreaming and recharging.'}
          </p>
        </div>

        <!-- Heartbeats Card -->
        <div class="card p-4 space-y-2">
          <div class="flex items-center gap-2 text-sm font-semibold text-primary-light dark:text-primary-dark">
            <svg class="w-4 h-4 text-rose-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span>{t.age.ui?.heartbeatsTitle || 'Heartbeats (~80 bpm)'}</span>
          </div>
          <div id="stat-heartbeats" class="text-xl font-bold text-accent">0</div>
          <p class="text-xs text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.heartbeatsDesc || 'Pumping gallons of vital energy uninterrupted through your body.'}
          </p>
        </div>

        <!-- Breaths Card -->
        <div class="card p-4 space-y-2">
          <div class="flex items-center gap-2 text-sm font-semibold text-primary-light dark:text-primary-dark">
            <svg class="w-4 h-4 text-sky-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>
            </svg>
            <span>{t.age.ui?.breathsTitle || 'Breaths (~16/min)'}</span>
          </div>
          <div id="stat-breaths" class="text-xl font-bold text-accent">0</div>
          <p class="text-xs text-secondary-light dark:text-secondary-dark">
            {t.age.ui?.breathsDesc || 'Continuous cycles of oxygen fueling every cell and thought.'}
          </p>
        </div>
      </div>

      <!-- Planetary Ages Grid -->
      <div class="card p-5 space-y-4">
        <div class="flex items-center justify-between">
          <h4 class="text-sm font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span>{t.age.ui?.planetAgeTitle || 'Your Age on Other Planets'}</span>
          </h4>
          <span class="text-xs text-secondary-light dark:text-secondary-dark">{t.age.ui?.planetAgeSubtitle || 'Based on orbital periods'}</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-center">

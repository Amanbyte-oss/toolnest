<script>
  import { validateDate, calculateAge } from '../scripts/age-calculator.js';
  import {
    saveHistory,
    saveLastState,
    getLastState,
    initHistoryCard,
  } from '../scripts/history.js';
  import { showToast } from '../scripts/toast.js';

  let tickerInterval = null;
  let currentComputedResult = null;

  function initAgeCalculator() {
    const i18n = (window as any).__AGE_I18N__ || {};
    const tAge = i18n.age || {};
    const tCommon = i18n.common || {};
    const tErrors = i18n.errors || {};

    const monthSelect = document.getElementById('birth-month');
    const daySelect = document.getElementById('birth-day');
    const yearSelect = document.getElementById('birth-year');
    const nativeDateInput = document.getElementById('native-birth-date');
    const targetDateInput = document.getElementById('target-date-input');
    const resetTargetBtn = document.getElementById('reset-target-today');
    const calcBtn = document.getElementById('calculate-button');
    const errorContainer = document.getElementById('date-error');
    const errorText = document.getElementById('date-error-text');
    const resultsContainer = document.getElementById('results-container');
    const copyBtn = document.getElementById('copy-results-btn');
    const shareBtn = document.getElementById('share-results-btn');

    if (!monthSelect || !daySelect || !yearSelect || !calcBtn) return;

    // Synchronize native date input with dropdowns
    if (nativeDateInput) {
      nativeDateInput.addEventListener('change', () => {
        if (!nativeDateInput.value) return;
        const [y, m, d] = nativeDateInput.value.split('-').map(Number);
        if (y && m && d) {
          yearSelect.value = String(y);
          monthSelect.value = String(m);
          daySelect.value = String(d);
          clearError();
        }
      });
    }

    function syncNativeFromDropdowns() {
      if (!nativeDateInput) return;
      const y = yearSelect.value;
      const m = monthSelect.value.padStart(2, '0');
      const d = daySelect.value.padStart(2, '0');
      if (y && m && d) {
        nativeDateInput.value = `${y}-${m}-${d}`;
      }
    }

    [monthSelect, daySelect, yearSelect].forEach((el) => {
      el.addEventListener('change', () => {
        clearError();
        syncNativeFromDropdowns();
      });
    });

    if (resetTargetBtn && targetDateInput) {
      resetTargetBtn.addEventListener('click', () => {
        const now = new Date();
        const y = now.getUTCFullYear();
        const m = String(now.getUTCMonth() + 1).padStart(2, '0');
        const d = String(now.getUTCDate()).padStart(2, '0');
        targetDateInput.value = `${y}-${m}-${d}`;
        showToast(tCommon.toasts?.loaded || 'Reset target date to today.');
      });
    }

    function showError(msg) {
      if (!errorContainer || !errorText) return;
      errorText.textContent = msg;
      errorContainer.classList.remove('hidden');
    }

    function clearError() {
      if (errorContainer) errorContainer.classList.add('hidden');
    }

    // Animated count-up
    function animateValue(element, start, end, duration = 600) {
      if (!element) return;
      if (start === end) {
        element.textContent = Number(end).toLocaleString();
        return;
      }
      const startTime = performance.now();
      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(start + (end - start) * ease);
        element.textContent = Number(current).toLocaleString();
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          element.textContent = Number(end).toLocaleString();
        }
      }
      requestAnimationFrame(update);
    }

    // Start Live Seconds Ticker
    function startSecondsTicker(birthUtc) {
      if (tickerInterval) clearInterval(tickerInterval);
      const secondsEl = document.getElementById('live-seconds');
      if (!secondsEl) return;

      function update() {
        const diff = Math.max(0, Math.floor((Date.now() - birthUtc) / 1000));
        secondsEl.textContent = diff.toLocaleString();
      }
      update();
      tickerInterval = setInterval(update, 1000);
    }

    // Execute Calculation
    function handleCalculate() {
      clearError();

      const year = parseInt(yearSelect.value, 10);
      const month = parseInt(monthSelect.value, 10);
      const day = parseInt(daySelect.value, 10);

      let targetDateObj = null;
      if (targetDateInput && targetDateInput.value) {
        const [tY, tM, tD] = targetDateInput.value.split('-').map(Number);
        targetDateObj = { year: tY, month: tM, day: tD };
      }

      const validation = validateDate(year, month, day, targetDateObj);
      if (!validation.valid) {
        showError(tAge.toasts?.invalidDate || validation.error || 'Invalid date.');
        return;
      }

      if (!targetDateObj) {
        const now = new Date();
        targetDateObj = {
          year: now.getUTCFullYear(),
          month: now.getUTCMonth() + 1,
          day: now.getUTCDate(),
        };
      }

      const res = calculateAge({ year, month, day }, targetDateObj);
      currentComputedResult = res;

      // Save to recent activity history and last input state
      const dobString = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      saveHistory('age', {
        t: `DOB: ${dobString}`,
        d: new Date().toISOString(),
        x: { year, month, day, targetDate: targetDateInput?.value || '' },
      });
      saveLastState('age', {
        year,
        month,
        day,
        targetDate: targetDateInput?.value || '',
      });

      // Reveal results section with staggered fade-up & smooth scroll
      if (resultsContainer) {
        resultsContainer.classList.remove('hidden');

        const animSections = resultsContainer.querySelectorAll('section');
        animSections.forEach((sec, idx) => {
          sec.classList.remove('animate-fade-slide-up');
          void sec.offsetWidth;
          sec.style.animationDelay = `${idx * 50}ms`;
          sec.classList.add('animate-fade-slide-up');
        });

        const headerOffset = 80;
        const rect = resultsContainer.getBoundingClientRect();
        const targetScrollY = rect.top + window.pageYOffset - headerOffset;
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        window.scrollTo({
          top: Math.max(0, targetScrollY),
          behavior: prefersReduced ? 'auto' : 'smooth',
        });
      }

      // Animate Hero Result Numbers
      animateValue(document.getElementById('hero-years'), 0, res.exact.years);
      animateValue(document.getElementById('hero-months'), 0, res.exact.months);
      animateValue(document.getElementById('hero-days'), 0, res.exact.days);

      // Start live seconds ticker
      startSecondsTicker(res.birthUtc);

      // Totals
      animateValue(document.getElementById('total-months'), 0, res.totals.months);
      animateValue(document.getElementById('total-weeks'), 0, res.totals.weeks);
      animateValue(document.getElementById('total-days'), 0, res.totals.days);
      animateValue(document.getElementById('total-hours'), 0, res.totals.hours);

      // Fun stats
      animateValue(document.getElementById('stat-sleep'), 0, res.funStats.hoursSlept);
      animateValue(document.getElementById('stat-heartbeats'), 0, res.funStats.heartbeats);
      animateValue(document.getElementById('stat-breaths'), 0, res.funStats.breaths);

      // Planetary ages
      const mercuryEl = document.getElementById('planet-mercury');
      const venusEl = document.getElementById('planet-venus');
      const marsEl = document.getElementById('planet-mars');
      const jupiterEl = document.getElementById('planet-jupiter');

      if (mercuryEl) mercuryEl.textContent = res.funStats.planetAges.mercury.toFixed(1);
      if (venusEl) venusEl.textContent = res.funStats.planetAges.venus.toFixed(1);
      if (marsEl) marsEl.textContent = res.funStats.planetAges.mars.toFixed(1);
      if (jupiterEl) jupiterEl.textContent = res.funStats.planetAges.jupiter.toFixed(1);

      // Birthday Card & Celebration
      const bdayCountdownText = document.getElementById('bday-countdown-text');
      const bdayDaysRemaining = document.getElementById('bday-days-remaining');
      const bdayDaysPill = document.getElementById('bday-days-pill');
      const bdayTodayBanner = document.getElementById('bday-today-banner');

      if (res.nextBirthday.isToday) {
        if (bdayDaysPill) bdayDaysPill.classList.add('hidden');
        if (bdayTodayBanner) bdayTodayBanner.classList.remove('hidden');
        if (bdayCountdownText) {
          bdayCountdownText.textContent = `Today is your special day! Happy Birthday from ToolNest!`;
        }

        // Trigger confetti (respecting reduced motion preferences)
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (typeof window.confetti === 'function' && !prefersReducedMotion) {
          window.confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 },
          });
        }
      } else {
        if (bdayDaysPill) bdayDaysPill.classList.remove('hidden');
        if (bdayTodayBanner) bdayTodayBanner.classList.add('hidden');
        if (bdayDaysRemaining) bdayDaysRemaining.textContent = String(res.nextBirthday.daysRemaining);
        if (bdayCountdownText) {
          bdayCountdownText.textContent = `Your next birthday falls on a ${res.nextBirthday.weekday} (${res.nextBirthday.formattedDate}).`;
        }
      }
    }

    calcBtn.addEventListener('click', handleCalculate);

    // Copy Results
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!currentComputedResult) return;
        const res = currentComputedResult;
        const text = [
          `🎂 Exact Age Breakdown (via ToolNest):`,
          `Age: ${res.exact.years} years, ${res.exact.months} months, ${res.exact.days} days`,
          `Total Days Lived: ${res.totals.days.toLocaleString()}`,
          `Total Hours Lived: ${res.totals.hours.toLocaleString()}`,
          res.nextBirthday.isToday
            ? `🎉 Today is my birthday!`
            : `Next Birthday: In ${res.nextBirthday.daysRemaining} days on a ${res.nextBirthday.weekday}`,
          `Calculate yours: ${window.location.href}`,
        ].join('\n');

        try {
          await navigator.clipboard.writeText(text);
          showToast(tAge.toasts?.copiedSummary || 'Results copied to clipboard!');
        } catch (e) {
          showToast(tCommon.toasts?.errorOccurred || 'Unable to copy to clipboard.');
        }
      });
    }

    // Share Results
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (!currentComputedResult) return;
        const res = currentComputedResult;
        const shareData = {
          title: 'My Exact Age on ToolNest',
          text: `I am ${res.exact.years} years, ${res.exact.months} months, and ${res.exact.days} days old (${res.totals.days.toLocaleString()} days lived)!`,
          url: window.location.href,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {
            // User cancelled or share aborted
          }
        } else {
          // Clipboard fallback
          try {
            await navigator.clipboard.writeText(`${shareData.text} ${shareData.url}`);
            showToast(tAge.toasts?.copiedSummary || 'Share link copied to clipboard!');
          } catch (e) {
            showToast(tCommon.toasts?.errorOccurred || 'Sharing not supported on this device.');
          }
        }
      });
    }
    // Restore from history
    function restoreAge(data) {
      if (!data || !data.year) return;
      yearSelect.value = String(data.year);
      monthSelect.value = String(data.month);
      daySelect.value = String(data.day);
      syncNativeFromDropdowns();
      if (targetDateInput && data.targetDate) {
        targetDateInput.value = data.targetDate;
      }
      handleCalculate();
    }

    // Prefill from last state if available ("welcome back" effect)
    const lastState = getLastState('age');
    if (lastState && lastState.year) {
      yearSelect.value = String(lastState.year);
      monthSelect.value = String(lastState.month);
      daySelect.value = String(lastState.day);
      syncNativeFromDropdowns();
      if (targetDateInput && lastState.targetDate) {
        targetDateInput.value = lastState.targetDate;
      }
    }

    initHistoryCard({ toolId: 'age', onRestore: restoreAge });
  }

  initAgeCalculator();
  document.addEventListener('astro:after-swap', initAgeCalculator);
</script>

---
import Base from '../layouts/Base.astro';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const about = getNamespace(lang, 'about');
const compressor = getNamespace(lang, 'compressor');
const converter = getNamespace(lang, 'converter');
const imageToPdf = getNamespace(lang, 'imageToPdf');
const age = getNamespace(lang, 'age');
const birthday = getNamespace(lang, 'birthday');
const picker = getNamespace(lang, 'picker');
const countdown = getNamespace(lang, 'countdown');

const t = {
  about,
  common,
  nav: common.nav,
  siteName: common.siteName,
};

const tools = [
  {
    name: `📄 ${common.nav?.imageToPdf || 'Image to PDF'}`,
    description: imageToPdf.subtitle || 'Combine and convert images into clean, multi-page PDF documents.',
    href: getLocalizedPath('/image-to-pdf', lang),
  },
  {
    name: `🗜️ ${common.nav?.imageCompressor || 'Image Compressor'}`,
    description: compressor.subtitle,
    href: getLocalizedPath('/image-compressor', lang),
  },
  {
    name: `🔄 ${common.nav?.imageConverter || 'Image Converter'}`,
    description: converter.subtitle,
    href: getLocalizedPath('/image-converter', lang),
  },
  {
    name: `🎂 ${common.nav?.ageCalculator || 'Age Calculator'}`,
    description: age.subtitle,
    href: getLocalizedPath('/age-calculator', lang),
  },
  {
    name: `🎉 ${common.nav?.birthdayFacts || 'Birthday Facts'}`,
    description: birthday.subtitle,
    href: getLocalizedPath('/birthday-facts', lang),
  },
  {
    name: `🎲 ${common.nav?.randomPicker || 'Random Picker'}`,
    description: picker.subtitle,
    href: getLocalizedPath('/random-picker', lang),
  },
  {
    name: `⏳ ${common.nav?.countdown || 'Countdown Timer'}`,
    description: countdown.subtitle,
    href: getLocalizedPath('/countdown', lang),
  },
];

const stats = [
  { label: 'Free Online Tools', value: '7', icon: '🛠️' },
  { label: 'Languages Supported', value: '4', icon: '🌐' },
  { label: 'Client-Side Privacy', value: '100%', icon: '🛡️' },
  { label: 'Sign-Up Required', value: '0', icon: '⚡' },
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: about.title || 'About ToolNest',
  url: `https://toolnest.pages.dev${getLocalizedPath('/about', lang)}`,
  description: about.metaDesc,
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
    logo: {
      '@type': 'ImageObject',
      url: 'https://toolnest.pages.dev/favicon.svg',
    },
  },
};
---

<Base
  metaKey="about"
  canonicalPath={getLocalizedPath('/about', lang)}
  ogImage="/og/share-banner.svg"
  breadcrumbs={[{ name: t.nav.about, item: getLocalizedPath('/about', lang) }]}
  extraSchemas={[aboutSchema]}
  lang={lang}
>
  <article class="space-y-10 max-w-3xl mx-auto">
    <!-- Header -->
    <header class="space-y-3 text-center sm:text-left rtl:sm:text-right">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
        <span>✨</span>
        <span>{t.about.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        {t.about.heading}
      </h1>
      <p class="text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        {t.about.subheading}
      </p>
    </header>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {stats.map((st) => (
        <div class="card p-4 text-center space-y-1">
          <span class="text-xl block">{st.icon}</span>
          <div class="text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark">
            {st.value}
          </div>
          <div class="text-[11px] font-medium text-secondary-light dark:text-secondary-dark">
            {st.label}
          </div>
        </div>
      ))}
    </div>

    <!-- Mission & Core Philosophy -->
    <section class="card p-6 sm:p-8 space-y-4" aria-labelledby="mission-heading">
      <h2 id="mission-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        {t.about.philosophyTitle}
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>{t.about.philosophyP1}</p>
        <p>{t.about.philosophyP2}</p>
      </div>
    </section>

    <!-- Privacy-First Promise (Client-Side Processing) -->
    <section class="card p-6 sm:p-8 space-y-4 border-l-4 rtl:border-l-0 rtl:border-r-4 border-emerald-500 bg-emerald-500/5 dark:bg-emerald-500/10" aria-labelledby="privacy-promise-heading">
      <h2 id="privacy-promise-heading" class="text-xl font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
        <span>🔒</span>
        <span>Our 100% Client-Side Privacy Promise</span>
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>
          Unlike traditional web tools that require you to upload your sensitive photos, identity documents, and personal spreadsheets to cloud servers, ToolNest executes everything directly inside your web browser.
        </p>
        <p>
          Whether you are compressing personal photos, generating multi-page PDF documents from passport scans, or converting image formats, your files are processed in local device memory (RAM) via HTML5 Canvas and WebAssembly. Nothing is ever sent to our servers or stored in any remote database. When you close the browser tab, the data is completely wiped.
        </p>
      </div>
    </section>

    <!-- Methodology & Calculation Standards -->
    <section class="card p-6 sm:p-8 space-y-4 border-l-4 rtl:border-l-0 rtl:border-r-4 border-accent" aria-labelledby="methodology-heading">
      <h2 id="methodology-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
        <span>📐</span>
        <span>{t.about.methodologyTitle}</span>
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>{t.about.methodologyP1}</p>
      </div>
    </section>

    <!-- Tools Collection Grid -->
    <section class="space-y-4" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        {t.about.toolsTitle}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tools.map((tool) => (
          <a
            href={tool.href}
            class="group card p-5 hover:border-accent/60 transition-all hover:shadow-md flex flex-col justify-between"
          >
            <div class="space-y-2">
              <h3 class="text-base font-bold text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
                {tool.description}
              </p>
            </div>
            <span class="text-xs font-semibold text-accent pt-3 flex items-center gap-1 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform">
              {t.about.launchTool}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Architecture & Hosting Note -->
    <section class="card p-6 sm:p-8 space-y-4" aria-labelledby="tech-heading">
      <h2 id="tech-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        {t.about.techTitle}
      </h2>
      <div class="space-y-3 text-sm sm:text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        <p>{t.about.techP1}</p>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="card p-6 sm:p-8 space-y-3 border-accent/30 bg-gradient-to-r from-accent/5 via-surface-light to-surface-light dark:from-accent/15 dark:via-surface-dark dark:to-surface-dark" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="text-xl font-bold text-primary-light dark:text-primary-dark">
        {t.about.contactTitle}
      </h2>
      <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark max-w-xl leading-relaxed">
        {t.about.contactDesc}
      </p>
      <div class="pt-2">
        <a href={getLocalizedPath('/contact', lang)} class="btn-primary text-xs py-2.5 px-5 font-bold inline-flex items-center gap-1.5 shadow-xs">
          <span>{t.about.contactBtn}</span>
        </a>
      </div>
    </section>
  </article>
</Base>

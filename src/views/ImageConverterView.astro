---
/**
 * src/views/ImageConverterView.astro
 * 100% Client-Side Image Format Converter.
 * Minimal architecture with EXACTLY TWO CONTROLS: Output Format & Quality Slider.
 * Privacy-first: Canvas API, zero network requests.
 */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import { getNamespace, getLocalizedPath, type Lang, isRtlLang } from '../i18n';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const converter = getNamespace(lang, 'converter');
const faqNs = getNamespace(lang, 'faq');
const t = { converter, common, nav: common.nav, siteName: common.siteName };

const isRtl = isRtlLang(lang);
const canonicalPath = getLocalizedPath('/image-converter', lang);

// Localized FAQs
const faqs = (faqNs.converter || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'image-converter');

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${canonicalPath}#app`,
  name: t.converter.title,
  url: `https://toolnest.pages.dev${canonicalPath}`,
  description: t.converter.subtitle,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires HTML5 Canvas and JavaScript support. Works 100% client-side without internet uploads.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  metaKey="imageConverter"
  canonicalPath={canonicalPath}
  ogImage="/og/image-converter.svg"
  breadcrumbs={[
    { name: common.nav.home, item: getLocalizedPath('/', lang) },
    { name: common.nav.imageConverter, item: canonicalPath },
  ]}
  extraSchemas={[webAppSchema, faqSchema]}
  lang={lang}
>
  <div class="max-w-2xl mx-auto space-y-6 pb-12">
    <!-- HERO & PRIVACY BADGE -->
    <header class="text-center py-2 sm:py-4 space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          {t.converter.privacyBadge}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        {t.converter.title}
      </h1>
      <p class="text-xs sm:text-base text-secondary-light dark:text-secondary-dark max-w-xl mx-auto leading-relaxed">
        {t.converter.subtitle}
      </p>
    </header>

    <!-- CONVERTER APP CONTAINER -->
    <div id="converter-app" class="space-y-4" data-i18n={JSON.stringify(t.converter)}>
      <!-- ERROR BANNER -->
      <div id="error-banner" class="hidden p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-300 text-xs sm:text-sm flex items-start justify-between gap-2.5" role="alert">
        <div class="flex items-start gap-2 min-w-0">
          <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="error-message" class="break-words"></span>
        </div>
        <button type="button" id="dismiss-error" class="text-red-500 hover:text-red-700 dark:hover:text-red-300 p-1 shrink-0 cursor-pointer" aria-label="Dismiss error">
          ✕
        </button>
      </div>

      <!-- HIDDEN FILE INPUT -->
      <input
        type="file"
        id="file-input"
        accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/bmp,image/*"
        class="sr-only"
        aria-hidden="true"
        tabindex="-1"
      />

      <!-- 1. UPLOAD DROP ZONE (VISIBLE INITIALLY) -->
      <div
        id="dropzone"
        role="button"
        tabindex="0"
        aria-label={t.converter.dropzone.tapOrDrop}
        class="card relative p-8 sm:p-12 border-2 border-dashed border-border-light dark:border-border-dark hover:border-accent dark:hover:border-accent transition-all duration-200 text-center space-y-3 cursor-pointer select-none group focus:outline-none focus:ring-2 focus:ring-accent"
      >
        <div class="w-16 h-16 mx-auto rounded-2xl bg-accent/10 dark:bg-accent/20 flex items-center justify-center text-accent group-hover:scale-110 transition-transform duration-200">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
            <path d="M16 16h5v5"></path>
          </svg>
        </div>
        <div class="space-y-1">
          <p class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark">
            {t.converter.dropzone.tapOrDrop}
          </p>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
            {t.converter.dropzone.clickOrPaste}
          </p>
        </div>
      </div>

      <!-- UPLOADED IMAGE PREVIEW (REPLACES DROP ZONE WHEN LOADED) -->
      <div id="preview-card" class="card p-4 sm:p-5 hidden space-y-3">
        <div class="flex items-center justify-between gap-3 pb-3 border-b border-border-light dark:border-border-dark">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span id="file-name" class="font-medium text-xs sm:text-sm text-primary-light dark:text-primary-dark truncate max-w-[180px] sm:max-w-[280px]"></span>
              <span class="text-xs text-secondary-light dark:text-secondary-dark shrink-0">—</span>
              <span id="format-size" class="text-xs sm:text-sm font-semibold text-secondary-light dark:text-secondary-dark shrink-0"></span>
            </div>
          </div>
          <!-- ✕ BUTTON TO REMOVE AND START OVER -->
          <button
            type="button"
            id="remove-btn"
            class="w-8 h-8 rounded-lg flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-red-500 hover:bg-red-500/10 transition-colors shrink-0 cursor-pointer"
            title={t.converter.preview.remove}
            aria-label={t.converter.preview.remove}
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <!-- Thumbnail (max ~300px wide) -->
        <div class="flex justify-center py-2">
          <img
            id="preview-img"
            src=""
            alt="Image preview"
            class="max-w-[300px] max-h-[220px] w-auto h-auto rounded-xl object-contain border border-border-light dark:border-border-dark bg-black/5 dark:bg-white/5 shadow-xs"
          />
        </div>
      </div>

      <!-- CONTROLS & DOWNLOAD SECTION (VISIBLE WHEN IMAGE LOADED) -->
      <div id="controls-section" class="card p-5 sm:p-6 space-y-5 hidden">
        <!-- CONTROL 1 — OUTPUT FORMAT PICKER (SEGMENTED BUTTONS) -->
        <div class="space-y-2">
          <label class="block text-xs sm:text-sm font-semibold text-primary-light dark:text-primary-dark">
            {t.converter.controls.outputFormat}
          </label>
          <div class="grid grid-cols-4 gap-2" role="radiogroup" aria-label={t.converter.controls.outputFormat}>
            <button
              type="button"
              data-format="webp"
              class="format-btn active px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-bold flex items-center justify-center transition-all cursor-pointer bg-accent text-white border-accent shadow-xs"
              role="radio"
              aria-checked="true"
            >
              WebP
            </button>
            <button
              type="button"
              data-format="jpg"
              class="format-btn px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-bold flex items-center justify-center transition-all cursor-pointer border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-secondary-light dark:text-secondary-dark hover:border-accent/60"
              role="radio"
              aria-checked="false"
            >
              JPG
            </button>
            <button
              type="button"
              data-format="png"
              class="format-btn px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-bold flex items-center justify-center transition-all cursor-pointer border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-secondary-light dark:text-secondary-dark hover:border-accent/60"
              role="radio"
              aria-checked="false"
            >
              PNG
            </button>
            <button
              type="button"
              data-format="avif"
              class="format-btn px-3 py-2.5 rounded-xl border text-xs sm:text-sm font-bold flex items-center justify-center transition-all cursor-pointer border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-secondary-light dark:text-secondary-dark hover:border-accent/60"
              role="radio"
              aria-checked="false"
            >
              AVIF
            </button>
          </div>
        </div>

        <!-- CONTROL 2 — QUALITY SLIDER (HIDDEN FOR PNG) -->
        <div id="quality-control" class="space-y-2 transition-opacity duration-200">
          <div class="flex items-center justify-between text-xs sm:text-sm">
            <label for="quality-slider" class="font-semibold text-primary-light dark:text-primary-dark cursor-pointer">
              {t.converter.controls.quality}: <span id="quality-val" class="text-accent font-bold">85%</span>
            </label>
          </div>
          <input
            type="range"
            id="quality-slider"
            min="1"
            max="100"
            value="85"
            class="w-full h-2 bg-border-light dark:bg-border-dark rounded-lg appearance-none cursor-pointer accent-accent"
          />
        </div>

        <!-- PNG LOSSLESS NOTE (SHOWN WHEN PNG IS SELECTED) -->
        <div id="png-note" class="hidden p-3 rounded-xl bg-accent/5 border border-accent/15 text-xs text-secondary-light dark:text-secondary-dark flex items-center gap-2">
          <span>✨</span>
          <span>{t.converter.controls.pngLosslessNote}</span>
        </div>

        <!-- RESULT LINE WITH SPINNER -->
        <div class="p-3.5 rounded-xl bg-accent/5 border border-accent/15 flex items-center min-h-[46px]">
          <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-primary-light dark:text-primary-dark min-w-0">
            <svg id="convert-spinner" class="hidden animate-spin w-4 h-4 text-accent shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="result-text" class="break-words"></span>
          </div>
        </div>

        <!-- DOWNLOAD BUTTON -->
        <div>
          <button
            type="button"
            id="download-btn"
            class="w-full btn-primary py-3.5 px-6 rounded-xl font-bold text-sm sm:text-base shadow-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-[0.99]"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span id="download-btn-text">Download WebP</span>
          </button>
        </div>

        <!-- CROSS-LINK FUNNEL TO COMPRESSOR -->
        <div class="pt-1 text-center">
          <a
            href={getLocalizedPath('/image-compressor', lang)}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline cursor-pointer"
          >
            <span>{t.converter.controls.compressCrossLink}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ SECTION -->
    {faqs.length > 0 && <Faq faqs={faqs} lang={lang} />}

    <!-- RELATED TOOLS -->
    {relatedTools.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-border-light dark:border-border-dark">
        <h2 class="text-lg sm:text-xl font-bold text-primary-light dark:text-primary-dark">
          {common.nav?.relatedTools || 'Related Tools'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedTools.map((tool) => (
            <ToolCard
              title={tool.name}
              description={tool.desc}
              href={tool.href}
              anchor={tool.anchor}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  function initImageConverter() {
    const app = document.getElementById('converter-app');
    if (!app) return;

    // Load i18n dictionary
    let i18n: any = {};
    try {
      i18n = JSON.parse(app.getAttribute('data-i18n') || '{}');
    } catch {
      i18n = {};
    }

    // DOM Elements
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const previewCard = document.getElementById('preview-card');
    const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
    const fileNameEl = document.getElementById('file-name');
    const formatSizeEl = document.getElementById('format-size');
    const removeBtn = document.getElementById('remove-btn');
    const controlsSection = document.getElementById('controls-section');
    const formatButtons = document.querySelectorAll('.format-btn');
    const qualityControl = document.getElementById('quality-control');
    const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
    const qualityVal = document.getElementById('quality-val');
    const pngNote = document.getElementById('png-note');
    const resultText = document.getElementById('result-text');
    const convertSpinner = document.getElementById('convert-spinner');
    const downloadBtn = document.getElementById('download-btn');
    const downloadBtnText = document.getElementById('download-btn-text');
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');
    const dismissError = document.getElementById('dismiss-error');

    // Supported Formats Configuration
    const FORMAT_INFO: Record<string, { mime: string; ext: string; name: string; isLossless: boolean }> = {
      webp: { mime: 'image/webp', ext: 'webp', name: 'WebP', isLossless: false },
      jpg: { mime: 'image/jpeg', ext: 'jpg', name: 'JPG', isLossless: false },
      png: { mime: 'image/png', ext: 'png', name: 'PNG', isLossless: true },
      avif: { mime: 'image/avif', ext: 'avif', name: 'AVIF', isLossless: false },
    };

    // App State
    let currentFormatKey = 'webp';
    let currentFile: File | null = null;
    let previewUrl: string | null = null;
    let loadedImage: {
      drawable: CanvasImageSource;
      width: number;
      height: number;
      close: () => void;
    } | null = null;
    let convertedBlob: Blob | null = null;
    let convertedUrl: string | null = null;
    let debounceTimer: any = null;
    let currentTaskToken = 0;

    function formatBytes(bytes: number): string {
      if (!bytes || bytes <= 0) return '0 B';
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) {
        const kb = bytes / 1024;
        return (kb >= 10 ? Math.round(kb) : kb.toFixed(1)) + ' KB';
      }
      const mb = bytes / (1024 * 1024);
      return (mb >= 10 ? Math.round(mb) : mb.toFixed(1)) + ' MB';
    }

    function getOriginalFormatLabel(file: File): string {
      const type = file.type.toLowerCase();
      if (type === 'image/jpeg') return 'JPG';
      if (type === 'image/png') return 'PNG';
      if (type === 'image/webp') return 'WebP';
      if (type === 'image/avif') return 'AVIF';
      if (type === 'image/gif') return 'GIF';
      if (type === 'image/bmp') return 'BMP';
      const ext = file.name.split('.').pop()?.toUpperCase();
      if (ext === 'JPEG') return 'JPG';
      return ext || 'IMG';
    }

    function showError(msg: string) {
      if (!errorBanner || !errorMessage) return;
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }

    function clearError() {
      if (!errorBanner || !errorMessage) return;
      errorMessage.textContent = '';
      errorBanner.classList.add('hidden');
    }

    dismissError?.addEventListener('click', clearError);

    function cleanupState() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = null;
      }
      if (convertedUrl) {
        URL.revokeObjectURL(convertedUrl);
        convertedUrl = null;
      }
      if (loadedImage) {
        loadedImage.close();
        loadedImage = null;
      }
      currentFile = null;
      convertedBlob = null;
      if (debounceTimer) clearTimeout(debounceTimer);
    }

    function updateDownloadButtonText() {
      if (!downloadBtnText) return;
      const targetName = FORMAT_INFO[currentFormatKey]?.name || 'WebP';
      const tpl = i18n.controls?.downloadBtn || 'Download {format}';
      downloadBtnText.textContent = tpl.replace('{format}', targetName);
    }

    function resetUI() {
      cleanupState();
      if (fileInput) fileInput.value = '';
      if (qualitySlider) qualitySlider.value = '85';
      if (qualityVal) qualityVal.textContent = '85%';
      
      // Reset format to WebP default
      selectFormat('webp');

      previewCard?.classList.add('hidden');
      controlsSection?.classList.add('hidden');
      dropzone?.classList.remove('hidden');
      clearError();
    }

    removeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      resetUI();
    });

    // Format selection handler
    function selectFormat(key: string) {
      currentFormatKey = key;
      const info = FORMAT_INFO[key] || FORMAT_INFO.webp;

      formatButtons.forEach((btn) => {
        const btnFormat = btn.getAttribute('data-format');
        const isActive = btnFormat === key;
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
        if (isActive) {
          btn.classList.remove('border-border-light', 'dark:border-border-dark', 'bg-surface-light', 'dark:bg-surface-dark', 'text-secondary-light', 'dark:text-secondary-dark');
          btn.classList.add('active', 'bg-accent', 'text-white', 'border-accent', 'shadow-xs');
        } else {
          btn.classList.remove('active', 'bg-accent', 'text-white', 'border-accent', 'shadow-xs');
          btn.classList.add('border-border-light', 'dark:border-border-dark', 'bg-surface-light', 'dark:bg-surface-dark', 'text-secondary-light', 'dark:text-secondary-dark');
        }
      });

      // Control 2: Quality slider vs PNG lossless note
      if (info.isLossless) {
        qualityControl?.classList.add('hidden');
        pngNote?.classList.remove('hidden');
      } else {
        qualityControl?.classList.remove('hidden');
        pngNote?.classList.add('hidden');
      }

      updateDownloadButtonText();
    }

    formatButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-format') || 'webp';
        selectFormat(key);
        scheduleConversion();
      });
    });

    // Image decoder supporting all formats
    async function decodeImage(file: File) {
      if ('createImageBitmap' in window) {
        const bitmap = await createImageBitmap(file);
        return {
          drawable: bitmap,
          width: bitmap.width,
          height: bitmap.height,
          close: () => bitmap.close?.(),
        };
      }

      return new Promise<{
        drawable: CanvasImageSource;
        width: number;
        height: number;
        close: () => void;
      }>((resolve, reject) => {
        const img = new Image();
        const objUrl = URL.createObjectURL(file);
        const timer = setTimeout(() => {
          URL.revokeObjectURL(objUrl);
          reject(new Error('Corrupt image'));
        }, 3000);
        img.onload = () => {
          clearTimeout(timer);
          resolve({
            drawable: img,
            width: img.naturalWidth,
            height: img.naturalHeight,
            close: () => URL.revokeObjectURL(objUrl),
          });
        };
        img.onerror = () => {
          clearTimeout(timer);
          URL.revokeObjectURL(objUrl);
          reject(new Error('Corrupt image'));
        };
        img.src = objUrl;
      });
    }

    function canvasToBlob(canvas: HTMLCanvasElement, mime: string, quality?: number): Promise<Blob> {
      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => {
            if (blob) {
              if (mime === 'image/avif' && blob.type !== 'image/avif') {
                reject(new Error('AVIF_UNSUPPORTED'));
              } else {
                resolve(blob);
              }
            } else {
              reject(new Error('Canvas toBlob failed'));
            }
          },
          mime,
          quality
        );
      });
    }

    // Core conversion pipeline
    async function runConversion() {
      if (!loadedImage || !currentFile) return;

      const taskToken = ++currentTaskToken;
      if (convertSpinner) convertSpinner.classList.remove('hidden');
      if (resultText) resultText.textContent = i18n.controls?.converting || 'Converting...';

      // Yield frame so spinner paints smoothly
      await new Promise((r) => requestAnimationFrame(() => setTimeout(r, 10)));

      try {
        const origSize = currentFile.size;
        const origFormat = getOriginalFormatLabel(currentFile);
        const targetInfo = FORMAT_INFO[currentFormatKey] || FORMAT_INFO.webp;

        const canvas = document.createElement('canvas');
        canvas.width = loadedImage.width;
        canvas.height = loadedImage.height;
        const ctx = canvas.getContext('2d');
        if (!ctx) throw new Error('Canvas 2D context unavailable');

        // SPECIAL RULE: For JPEG, flatten transparency onto solid white background
        if (targetInfo.mime === 'image/jpeg') {
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        // Draw source image at original dimensions (no resizing)
        ctx.drawImage(loadedImage.drawable, 0, 0, canvas.width, canvas.height);

        // Quality parameter (only for lossy formats)
        const qualityValNum = qualitySlider ? Math.max(1, Math.min(100, parseInt(qualitySlider.value, 10))) / 100 : 0.85;
        const qualityParam = targetInfo.isLossless ? undefined : qualityValNum;

        const blob = await canvasToBlob(canvas, targetInfo.mime, qualityParam);

        if (taskToken !== currentTaskToken) return;

        convertedBlob = blob;
        if (convertedUrl) {
          URL.revokeObjectURL(convertedUrl);
        }
        convertedUrl = URL.createObjectURL(blob);

        // Calculate size comparison and display result
        const origStr = formatBytes(origSize);
        const compStr = formatBytes(blob.size);

        if (blob.size < origSize) {
          const savedPct = Math.round((1 - blob.size / origSize) * 100);
          const smallerLabel = i18n.controls?.smaller || 'smaller';
          if (resultText) {
            resultText.textContent = `${origStr} ${origFormat} → ${compStr} ${targetInfo.name} · ${savedPct}% ${smallerLabel} ✅`;
          }
        } else {
          let biggerMsg = i18n.controls?.biggerWarning || 'Bigger ⚠️ try WebP instead';
          if (targetInfo.name === 'WebP') {
            biggerMsg = i18n.controls?.biggerWebpWarning || 'Bigger ⚠️ try lower quality';
          }
          if (resultText) {
            resultText.textContent = `${origStr} ${origFormat} → ${compStr} ${targetInfo.name} · ${biggerMsg}`;
          }
        }
      } catch (err: any) {
        if (taskToken !== currentTaskToken) return;
        console.error('Conversion error:', err);
        if (err?.message === 'AVIF_UNSUPPORTED') {
          showError(i18n.errors?.avifUnsupported || 'AVIF export is not supported in this browser. Please select WebP, JPG, or PNG.');
        } else {
          showError(i18n.errors?.corruptFile || 'Could not convert this image.');
        }
      } finally {
        if (taskToken === currentTaskToken && convertSpinner) {
          convertSpinner.classList.add('hidden');
        }
      }
    }

    function scheduleConversion() {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        runConversion();
      }, 300);
    }

    // Handle file input
    async function handleFile(file: File) {
      clearError();

      const isValidImage =
        file.type.startsWith('image/') ||
        /\.(jpe?g|png|webp|avif|gif|bmp|tiff|svg)$/i.test(file.name);

      if (!isValidImage) {
        showError(i18n.errors?.invalidType || 'Please select a valid image file (JPG, PNG, WebP, AVIF, GIF, BMP).');
        return;
      }

      try {
        cleanupState();
        currentFile = file;

        // Decode image client-side
        loadedImage = await decodeImage(file);

        // Show image thumbnail and details
        previewUrl = URL.createObjectURL(file);
        if (previewImg) previewImg.src = previewUrl;
        if (fileNameEl) fileNameEl.textContent = file.name;

        const origFormat = getOriginalFormatLabel(file);
        if (formatSizeEl) {
          formatSizeEl.textContent = `${origFormat} · ${formatBytes(file.size)}`;
        }

        // Replace dropzone with preview
        dropzone?.classList.add('hidden');
        previewCard?.classList.remove('hidden');
        controlsSection?.classList.remove('hidden');

        updateDownloadButtonText();

        // Trigger initial conversion
        runConversion();
      } catch (err) {
        console.error('Image decode error:', err);
        cleanupState();
        previewCard?.classList.add('hidden');
        controlsSection?.classList.add('hidden');
        dropzone?.classList.remove('hidden');
        showError(i18n.errors?.corruptFile || 'Could not decode this image file. It may be corrupt or unreadable.');
      }
    }

    // Dropzone triggers
    dropzone?.addEventListener('click', () => {
      fileInput?.click();
    });

    dropzone?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput?.click();
      }
    });

    fileInput?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files.length > 0) {
        handleFile(files[0]);
      }
      if (fileInput) fileInput.value = '';
    });

    // Drag & drop
    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-accent', 'bg-accent/5');
      });
    });

    ['dragleave', 'drop'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-accent', 'bg-accent/5');
      });
    });

    dropzone?.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFile(dt.files[0]);
      }
    });

    // Global Paste (Ctrl+V)
    function onPaste(e: ClipboardEvent) {
      if (!e.clipboardData) return;
      const items = e.clipboardData.items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    }
    window.addEventListener('paste', onPaste);

    // Quality slider input
    qualitySlider?.addEventListener('input', () => {
      if (qualityVal && qualitySlider) {
        qualityVal.textContent = `${qualitySlider.value}%`;
      }
      scheduleConversion();
    });

    // Download button
    downloadBtn?.addEventListener('click', () => {
      if (!convertedBlob || !currentFile) return;

      const origBaseName = currentFile.name.replace(/\.[^/.]+$/, '');
      const targetExt = FORMAT_INFO[currentFormatKey]?.ext || 'webp';
      const downloadName = `${origBaseName}.${targetExt}`;

      const link = document.createElement('a');
      const url = URL.createObjectURL(convertedBlob);
      link.href = url;
      link.download = downloadName;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      setTimeout(() => {
        URL.revokeObjectURL(url);
      }, 2000);
    });
  }

  // Initialize on document ready & Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageConverter);
  } else {
    initImageConverter();
  }
  document.addEventListener('astro:after-swap', initImageConverter);
</script>

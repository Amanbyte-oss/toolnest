---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import namesData from '../data/names.json';
import relatedLinksData from '../data/related-links.json';
import { getTranslations, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);

const lastUpdatedDate = new Date().toLocaleDateString(lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Alphabetical sort of all 200 names
const sortedNames = [...namesData].sort((a, b) => a.name.localeCompare(b.name));
const alphabet = Array.from(new Set(sortedNames.map((n) => n.name[0].toUpperCase()))).sort();

const seenLetters = new Set<string>();

const relatedTools = relatedLinksData['names'];

// WebApplication schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': 'https://toolnest.pages.dev/names#app',
  name: 'Baby Names Directory A–Z — Meanings & Roots',
  url: 'https://toolnest.pages.dev/names',
  description: 'Search and explore meanings, origins, popularity, and famous namesakes for 200+ popular baby names worldwide.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};
---

<Base
  title={`${t.names.metaTitle} | ${t.siteName}`}
  description={t.names.metaDescription}
  canonicalPath={getLocalizedPath('/names', lang)}
  ogImage="/og/names.svg"
  breadcrumbs={[{ name: t.nav.home, item: getLocalizedPath('/', lang) }, { name: t.nav.names, item: getLocalizedPath('/names', lang) }]}
  extraSchemas={[webAppSchema]}
  lang={lang}
>
  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <span>📖</span>
      <span>{t.nav.names}</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.names.title}
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-2xl mx-auto leading-relaxed">
      {t.names.subtitle}
    </p>
  </header>

  <!-- KEY TAKEAWAYS / FEATURED SNIPPET SUMMARY BOX -->
  <aside class="card mt-2 p-4 sm:p-5 border-l-4 border-accent bg-accent/5 space-y-2" aria-label="Key Takeaways">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent">
      <span>⚡</span>
      <span>Quick Answer & Key Takeaways</span>
    </div>
    <ul class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark space-y-1.5 list-disc list-inside leading-relaxed">
      <li><strong>200+ Curated Profiles:</strong> Comprehensive dossiers detailing historical definitions, phonetic roots, and rankings.</li>
      <li><strong>A–Z Quick Navigation:</strong> Jump instantly between letters or filter dynamically by gender, cultural origin, and popularity.</li>
      <li><strong>Private Onomastic Tool:</strong> Instant search running 100% in your browser without tracking or mandatory user logins.</li>
    </ul>
  </aside>

  <!-- AI SEARCH PROMO BANNER -->
  <div class="card mt-4 p-3.5 sm:p-4 border border-accent/25 bg-accent/5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs sm:text-sm">
    <div class="flex items-center gap-2.5 text-primary-light dark:text-primary-dark">
      <span class="text-base select-none">✨</span>
      <span>Looking for a rare or custom name not listed below?</span>
    </div>
    <a href={getLocalizedPath('/name-meaning', lang)} class="btn-primary text-xs px-3.5 py-1.5 font-bold shrink-0 inline-flex items-center gap-1 shadow-xs">
      <span>Try AI Name Meaning Finder &rarr;</span>
    </a>
  </div>

  <!-- A–Z QUICK JUMP ANCHOR BAR -->
  <div class="card mt-4 p-3 space-y-1.5 border border-border-light dark:border-border-dark" aria-label="Alphabetical Jump">
    <div class="flex items-center justify-between px-1">
      <span class="text-[11px] font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        Alphabetical Index (A–Z)
      </span>
      <span class="text-[11px] text-accent font-semibold">{sortedNames.length} Curated Names</span>
    </div>
    <nav class="flex flex-wrap items-center gap-1 sm:gap-1.5" aria-label="Alphabet Jump Links">
      {alphabet.map((letter) => (
        <a
          href={`#letter-${letter.toLowerCase()}`}
          class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-lg text-xs font-bold bg-input-light dark:bg-input-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:border-accent hover:text-accent hover:bg-accent/5 transition-all"
        >
          {letter}
        </a>
      ))}
    </nav>
  </div>

  <!-- SEARCH & FILTER TOOLBAR -->
  <section class="card mt-4 p-5 space-y-4" aria-labelledby="filter-heading">
    <h2 id="filter-heading" class="sr-only">Filter Names</h2>
    <div class="flex flex-col sm:flex-row gap-3">
      <!-- Search Input -->
      <div class="relative flex-1">
        <svg class="w-4 h-4 text-secondary-light dark:text-secondary-dark absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="name-search-input"
          type="search"
          placeholder="Search by name, origin (e.g. Latin, Greek), or meaning..."
          class="input-base text-sm pl-10 pr-4 py-2.5 w-full"
          aria-label="Search names"
          autocomplete="off"
        />
      </div>

      <!-- Gender Filter Chips -->
      <div class="flex flex-wrap items-center gap-1.5" id="gender-filter-chips">
        <button
          type="button"
          data-gender="all"
          class="gender-chip px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all cursor-pointer border-accent bg-accent text-white"
        >
          All ({sortedNames.length})
        </button>
        <button
          type="button"
          data-gender="female"
          class="gender-chip px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all cursor-pointer border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark hover:border-accent"
        >
          Female
        </button>
        <button
          type="button"
          data-gender="male"
          class="gender-chip px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all cursor-pointer border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark hover:border-accent"
        >
          Male
        </button>
        <button
          type="button"
          data-gender="unisex"
          class="gender-chip px-3.5 py-2 rounded-xl text-xs font-semibold border transition-all cursor-pointer border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark hover:border-accent"
        >
          Unisex
        </button>
      </div>
    </div>

    <!-- Live Counter -->
    <div class="flex items-center justify-between text-xs text-secondary-light dark:text-secondary-dark pt-1 border-t border-border-light dark:border-border-dark">
      <span id="name-results-count">Showing {sortedNames.length} of {sortedNames.length} names</span>
      <button
        id="clear-filters-btn"
        type="button"
        class="hidden text-accent hover:underline font-medium cursor-pointer"
      >
        Clear filters
      </button>
    </div>
  </section>

  <!-- Recent Activity History Card -->
  <div class="mt-6">
    <HistoryCard toolId="names" title="Recently Viewed Names" icon="🏷️" />
  </div>

  <!-- NAMES DIRECTORY GRID -->
  <section class="mt-6" aria-labelledby="directory-grid-heading">
    <h2 id="directory-grid-heading" class="sr-only">Names Directory List</h2>

    <div
      id="names-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5"
    >
      {sortedNames.map((item) => {
        const score = item.popularity === 'very high' ? 5 : item.popularity === 'high' ? 4 : 3;
        const firstLetter = item.name[0].toUpperCase();
        let letterAnchor = null;
        if (!seenLetters.has(firstLetter)) {
          seenLetters.add(firstLetter);
          letterAnchor = `letter-${firstLetter.toLowerCase()}`;
        }

        return (
          <a
            id={letterAnchor || undefined}
            href={getLocalizedPath(`/name/${item.slug}`, lang)}
            data-name={item.name.toLowerCase()}
            data-origin={item.origin.toLowerCase()}
            data-meaning={item.meaning.toLowerCase()}
            data-gender={item.gender}
            class="name-card group card p-4 hover:border-accent/60 transition-all hover:shadow-md flex flex-col justify-between scroll-mt-24"
          >
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="text-base font-bold text-primary-light dark:text-primary-dark group-hover:text-accent transition-colors">
                  {item.name}
                </span>
                <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded-md bg-input-light dark:bg-input-dark text-secondary-light dark:text-secondary-dark">
                  {item.gender}
                </span>
              </div>
              <p class="text-xs text-secondary-light dark:text-secondary-dark line-clamp-1">
                <span class="font-medium text-primary-light dark:text-primary-dark">{item.origin}</span> &bull; "{item.meaning}"
              </p>
            </div>

            <div class="pt-3 border-t border-border-light/60 dark:border-border-dark/60 mt-3 flex items-center justify-between text-xs">
              <div class="flex items-center gap-1" title={`Popularity: ${score}/5`}>
                {[1, 2, 3, 4, 5].map((dot) => (
                  <span
                    class={`w-1.5 h-1.5 rounded-full ${
                      dot <= score ? 'bg-accent' : 'bg-border-light dark:border-border-dark'
                    }`}
                  />
                ))}
              </div>
              <span class="text-accent font-semibold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
                Meaning &rarr;
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- EMPTY STATE -->
    <div
      id="no-names-found"
      class="hidden card text-center py-12 px-4 space-y-3"
      role="status"
    >
      <span class="text-3xl">🔍</span>
      <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
        No names match your search
      </h3>
      <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark max-w-sm mx-auto">
        Try adjusting your keywords, checking your spelling, or clearing your active gender filter.
      </p>
    </div>
  </section>

  <!-- METHODOLOGY & ONOMASTICS NOTE (E-E-A-T) -->
  <section class="card mt-12 p-5 border-border-light dark:border-border-dark space-y-2 bg-bg-light/50 dark:bg-bg-dark/50">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark flex items-center gap-1.5">
        <span>📐</span>
        <span>Directory Methodology & Onomastic Research</span>
      </h2>
      <span class="text-[11px] text-secondary-light dark:text-secondary-dark">
        Last updated: {lastUpdatedDate}
      </span>
    </div>
    <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
      Each name entry is verified against primary historical lexicons and demographic registries. Popularity scores are mapped to statistical birth percentiles, ensuring reliable cultural and etymological documentation.
    </p>
  </section>

  <!-- RELATED TOOLS SECTION -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
        Related Free Tools
      </h2>
      <a href="/" class="text-xs font-semibold text-accent hover:underline">
        View all tools &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {relatedTools.map((tool) => (
        <ToolCard
          title={tool.name}
          description={tool.desc}
          href={tool.href}
          anchor={tool.anchor}
          icon={tool.href.includes('meaning') ? 'book' : tool.href.includes('birthday') ? 'cake' : 'calendar'}
        />
      ))}
    </div>
  </section>
</Base>

<script>
  import { initHistoryCard } from '../scripts/history.js';

  function initNamesDirectory() {
    const searchInput = document.getElementById('name-search-input') as HTMLInputElement | null;
    const countDisplay = document.getElementById('name-results-count');
    const clearBtn = document.getElementById('clear-filters-btn');
    const noNamesBox = document.getElementById('no-names-found');
    const cards = Array.from(document.querySelectorAll('.name-card')) as HTMLElement[];
    const genderChips = Array.from(document.querySelectorAll('.gender-chip')) as HTMLButtonElement[];

    if (!searchInput || cards.length === 0) return;

    let activeGender = 'all';

    function filterCards() {
      const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const origin = card.getAttribute('data-origin') || '';
        const meaning = card.getAttribute('data-meaning') || '';
        const gender = card.getAttribute('data-gender') || '';

        const matchesQuery =
          !query ||
          name.includes(query) ||
          origin.includes(query) ||
          meaning.includes(query);

        const matchesGender =
          activeGender === 'all' || gender === activeGender;

        if (matchesQuery && matchesGender) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} of ${cards.length} names`;
      }

      if (clearBtn) {
        if (query || activeGender !== 'all') {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }

      if (noNamesBox) {
        if (visibleCount === 0) {
          noNamesBox.classList.remove('hidden');
        } else {
          noNamesBox.classList.add('hidden');
        }
      }
    }

    searchInput.addEventListener('input', filterCards);

    genderChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const gender = chip.getAttribute('data-gender') || 'all';
        activeGender = gender;

        genderChips.forEach((c) => {
          c.classList.remove('border-accent', 'bg-accent', 'text-white');
          c.classList.add(
            'border-border-light',
            'dark:border-border-dark',
            'bg-input-light',
            'dark:bg-input-dark',
            'text-secondary-light',
            'dark:text-secondary-dark'
          );
        });

        chip.classList.remove(
          'border-border-light',
          'dark:border-border-dark',
          'bg-input-light',
          'dark:bg-input-dark',
          'text-secondary-light',
          'dark:text-secondary-dark'
        );
        chip.classList.add('border-accent', 'bg-accent', 'text-white');

        filterCards();
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        activeGender = 'all';

        genderChips.forEach((c) => {
          const g = c.getAttribute('data-gender');
          if (g === 'all') {
            c.classList.remove(
              'border-border-light',
              'dark:border-border-dark',
              'bg-input-light',
              'dark:bg-input-dark',
              'text-secondary-light',
              'dark:text-secondary-dark'
            );
            c.classList.add('border-accent', 'bg-accent', 'text-white');
          } else {
            c.classList.remove('border-accent', 'bg-accent', 'text-white');
            c.classList.add(
              'border-border-light',
              'dark:border-border-dark',
              'bg-input-light',
              'dark:bg-input-dark',
              'text-secondary-light',
              'dark:text-secondary-dark'
            );
          }
        });

        filterCards();
      });
    }
  }

  function setupNamesPage() {
    initNamesDirectory();
    initHistoryCard({ toolId: 'names' });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNamesPage);
  } else {
    setupNamesPage();
  }
  document.addEventListener('astro:after-swap', setupNamesPage);
</script>

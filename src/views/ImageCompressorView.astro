---
/**
 * src/views/ImageCompressorView.astro
 * Minimal, high-performance, 100% client-side Image Compressor.
 * EXACTLY TWO CONTROLS: Quality Slider & Target Size.
 * Privacy-first: Canvas API, zero network requests.
 */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import { getNamespace, getLocalizedPath, type Lang, isRtlLang } from '../i18n';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const compressor = getNamespace(lang, 'compressor');
const faqNs = getNamespace(lang, 'faq');
const t = { compressor, common, nav: common.nav, siteName: common.siteName };

const isRtl = isRtlLang(lang);
const canonicalPath = getLocalizedPath('/image-compressor', lang);

// Localized FAQs
const faqs = (faqNs.compressor || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'image-compressor');

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${canonicalPath}#app`,
  name: t.compressor.title,
  url: `https://toolnest.pages.dev${canonicalPath}`,
  description: t.compressor.subtitle,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires HTML5 Canvas and JavaScript support. Works 100% client-side without internet uploads.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  metaKey="imageCompressor"
  canonicalPath={canonicalPath}
  ogImage="/og/image-compressor.svg"
  breadcrumbs={[
    { name: common.nav.home, item: getLocalizedPath('/', lang) },
    { name: common.nav.imageCompressor, item: canonicalPath },
  ]}
  extraSchemas={[webAppSchema, faqSchema]}
  lang={lang}
>
  <div class="max-w-2xl mx-auto space-y-6 pb-12">
    <!-- HERO & PRIVACY BADGE -->
    <header class="text-center py-2 sm:py-4 space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          {t.compressor.privacyBadge}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        {t.compressor.title}
      </h1>
      <p class="text-xs sm:text-base text-secondary-light dark:text-secondary-dark max-w-xl mx-auto leading-relaxed">
        {t.compressor.subtitle}
      </p>
    </header>

    <!-- COMPRESSOR APP CONTAINER -->
    <div id="compressor-app" class="space-y-4" data-i18n={JSON.stringify(t.compressor)}>
      <!-- ERROR BANNER -->
      <div id="error-banner" class="hidden p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-700 dark:text-red-300 text-xs sm:text-sm flex items-start justify-between gap-2.5" role="alert">
        <div class="flex items-start gap-2 min-w-0">
          <svg class="w-4 h-4 shrink-0 mt-0.5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span id="error-message" class="break-words"></span>
        </div>
        <button type="button" id="dismiss-error" class="text-red-500 hover:text-red-700 dark:hover:text-red-300 p-1 shrink-0 cursor-pointer" aria-label="Dismiss error">
          ✕
        </button>
      </div>

      <!-- HIDDEN FILE INPUT -->
      <input
        type="file"
        id="file-input"
        accept="image/jpeg,image/png,image/webp,image/avif,image/*"
        class="sr-only"
        aria-hidden="true"
        tabindex="-1"
      />

      <!-- 1. UPLOAD DROP ZONE (VISIBLE INITIALLY) -->
      <div
        id="dropzone"
        role="button"
        tabindex="0"
        aria-label={t.compressor.dropzone.tapOrDrop}
        class="card relative p-8 sm:p-12 border-2 border-dashed border-border-light dark:border-border-dark hover:border-accent dark:hover:border-accent transition-all duration-200 text-center space-y-3 cursor-pointer select-none group focus:outline-none focus:ring-2 focus:ring-accent"
      >
        <div class="w-16 h-16 mx-auto rounded-2xl bg-accent/10 dark:bg-accent/20 flex items-center justify-center text-accent group-hover:scale-110 transition-transform duration-200">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>
        <div class="space-y-1">
          <p class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark">
            {t.compressor.dropzone.tapOrDrop}
          </p>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
            {t.compressor.dropzone.clickOrPaste}
          </p>
        </div>
      </div>

      <!-- UPLOADED IMAGE PREVIEW (REPLACES DROP ZONE WHEN LOADED) -->
      <div id="preview-card" class="card p-4 sm:p-5 hidden space-y-3">
        <div class="flex items-center justify-between gap-3 pb-3 border-b border-border-light dark:border-border-dark">
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2 flex-wrap">
              <span id="file-name" class="font-medium text-xs sm:text-sm text-primary-light dark:text-primary-dark truncate max-w-[200px] sm:max-w-[320px]"></span>
              <span class="text-xs text-secondary-light dark:text-secondary-dark shrink-0">—</span>
              <span id="original-size" class="text-xs sm:text-sm font-semibold text-secondary-light dark:text-secondary-dark shrink-0"></span>
            </div>
          </div>
          <!-- ✕ BUTTON TO REMOVE AND START OVER -->
          <button
            type="button"
            id="remove-btn"
            class="w-8 h-8 rounded-lg flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-red-500 hover:bg-red-500/10 transition-colors shrink-0 cursor-pointer"
            title={t.compressor.preview.remove}
            aria-label={t.compressor.preview.remove}
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <!-- Thumbnail (max ~300px wide) -->
        <div class="flex justify-center py-2">
          <img
            id="preview-img"
            src=""
            alt="Image preview"
            class="max-w-[300px] max-h-[220px] w-auto h-auto rounded-xl object-contain border border-border-light dark:border-border-dark bg-black/5 dark:bg-white/5 shadow-xs"
          />
        </div>
      </div>

      <!-- CONTROLS & DOWNLOAD SECTION (VISIBLE WHEN IMAGE LOADED) -->
      <div id="controls-section" class="card p-5 sm:p-6 space-y-5 hidden">
        <!-- COMPACT OUTPUT FORMAT PICKER -->
        <div class="flex items-center justify-between gap-2 flex-wrap pb-1">
          <span class="text-xs font-semibold text-secondary-light dark:text-secondary-dark">{t.compressor.controls?.formatLabel || 'Format'}:</span>
          <div id="format-picker" class="inline-flex p-1 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-xs font-semibold" role="group" aria-label={t.compressor.controls?.formatLabel || 'Format'}>
            <button
              type="button"
              data-format="webp"
              class="format-btn px-3 py-1.5 rounded-lg transition-all duration-150 cursor-pointer bg-accent text-white shadow-xs font-bold"
            >
              WebP
            </button>
            <button
              type="button"
              data-format="jpg"
              class="format-btn px-3 py-1.5 rounded-lg transition-all duration-150 cursor-pointer text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark"
            >
              JPG
            </button>
            <button
              type="button"
              data-format="png"
              class="format-btn px-3 py-1.5 rounded-lg transition-all duration-150 cursor-pointer text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark"
            >
              PNG
            </button>
          </div>
        </div>

        <!-- CONTROL 1 — QUALITY SLIDER -->
        <div id="quality-control" class="space-y-2 transition-opacity duration-200">
          <div class="flex items-center justify-between text-xs sm:text-sm">
            <label for="quality-slider" class="font-semibold text-primary-light dark:text-primary-dark cursor-pointer">
              {t.compressor.controls.quality}: <span id="quality-val" class="text-accent font-bold">75%</span>
            </label>
          </div>
          <input
            type="range"
            id="quality-slider"
            min="1"
            max="100"
            value="75"
            class="w-full h-2 bg-border-light dark:bg-border-dark rounded-lg appearance-none cursor-pointer accent-accent"
          />
          <!-- PNG LOSSLESS NOTE (Only shown when PNG selected) -->
          <p id="png-note" class="text-[11px] sm:text-xs text-secondary-light dark:text-secondary-dark hidden">
            ✨ {t.compressor.controls?.pngLosslessNote || 'PNG is lossless — size depends on image'}
          </p>
        </div>

        <!-- CONTROL 2 — TARGET SIZE TEXT BOX -->
        <div id="target-control" class="space-y-1.5">
          <label for="target-size-input" class="block text-xs sm:text-sm font-semibold text-primary-light dark:text-primary-dark">
            {t.compressor.controls.targetLabel}
          </label>
          <div class="relative">
            <input
              type="number"
              id="target-size-input"
              min="1"
              step="any"
              inputmode="numeric"
              placeholder={t.compressor.controls.targetPlaceholder}
              class="w-full px-3.5 py-2.5 pe-12 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-primary-light dark:text-primary-dark placeholder:text-secondary-light/60 dark:placeholder:text-secondary-dark/60 focus:ring-2 focus:ring-accent focus:border-accent outline-none text-xs sm:text-sm transition-all"
            />
            <span class="absolute end-3.5 top-1/2 -translate-y-1/2 text-xs font-semibold text-secondary-light dark:text-secondary-dark pointer-events-none">
              KB
            </span>
          </div>
        </div>

        <!-- RESULT LINE WITH SPINNER -->
        <div class="p-3.5 rounded-xl bg-accent/5 border border-accent/15 flex items-center min-h-[46px]">
          <div class="flex items-center gap-2 text-xs sm:text-sm font-medium text-primary-light dark:text-primary-dark min-w-0">
            <svg id="compress-spinner" class="hidden animate-spin w-4 h-4 text-accent shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span id="result-text" class="break-words"></span>
          </div>
        </div>

        <!-- DOWNLOAD BUTTON -->
        <div>
          <button
            type="button"
            id="download-btn"
            class="w-full btn-primary py-3.5 px-6 rounded-xl font-bold text-sm sm:text-base shadow-md flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-[0.99]"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span id="download-text">{t.compressor.controls?.downloadBtn?.replace('{format}', 'WebP') || 'Download WebP'}</span>
          </button>
        </div>

        <!-- Cross-link Funnels -->
        <div class="pt-1 flex items-center justify-center gap-3 text-center flex-wrap">
          <a
            href={getLocalizedPath('/image-to-pdf', lang)}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline cursor-pointer"
          >
            <span>{lang === 'ar' ? 'تحويل الصور إلى PDF ←' : lang === 'pt' ? 'Converter para PDF →' : lang === 'id' ? 'Ubah ke PDF →' : 'Convert to PDF →'}</span>
          </a>
          <span class="text-secondary-light/40 dark:text-secondary-dark/40 text-xs">•</span>
          <a
            href={getLocalizedPath('/image-converter', lang)}
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline cursor-pointer"
          >
            <span>{t.compressor.controls?.convertCrossLink || 'Convert format →'}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ SECTION -->
    {faqs.length > 0 && <Faq faqs={faqs} lang={lang} />}

    <!-- RELATED TOOLS -->
    {relatedTools.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-border-light dark:border-border-dark">
        <h2 class="text-lg sm:text-xl font-bold text-primary-light dark:text-primary-dark">
          {common.nav?.relatedTools || 'Related Tools'}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {relatedTools.map((tool) => (
            <ToolCard
              title={tool.name}
              description={tool.desc}
              href={tool.href}
              anchor={tool.anchor}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  function initImageCompressor() {
    const app = document.getElementById('compressor-app');
    if (!app) return;

    // Load i18n dictionary
    let i18n: any = {};
    try {
      i18n = JSON.parse(app.getAttribute('data-i18n') || '{}');
    } catch {
      i18n = {};
    }

    // DOM Elements
    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const previewCard = document.getElementById('preview-card');
    const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
    const fileNameEl = document.getElementById('file-name');
    const originalSizeEl = document.getElementById('original-size');
    const removeBtn = document.getElementById('remove-btn');
    const controlsSection = document.getElementById('controls-section');
    const formatBtns = document.querySelectorAll('.format-btn');
    const qualityControl = document.getElementById('quality-control');
    const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
    const qualityVal = document.getElementById('quality-val');
    const pngNote = document.getElementById('png-note');
    const targetSizeInput = document.getElementById('target-size-input') as HTMLInputElement | null;
    const resultText = document.getElementById('result-text');
    const compressSpinner = document.getElementById('compress-spinner');
    const downloadBtn = document.getElementById('download-btn');
    const downloadText = document.getElementById('download-text');
    const errorBanner = document.getElementById('error-banner');
    const errorMessage = document.getElementById('error-message');
    const dismissError = document.getElementById('dismiss-error');

    // App State
    let currentFile: File | null = null;
    let currentFormat: 'webp' | 'jpg' | 'png' = 'webp';
    let previewUrl: string | null = null;
    let loadedImage: {
      drawable: CanvasImageSource;
      width: number;
      height: number;
      close: () => void;
    } | null = null;
    let compressedBlob: Blob | null = null;
    let compressedUrl: string | null = null;
    let debounceTimer: any = null;
    let currentTaskToken = 0;

    function formatBytes(bytes: number): string {
      if (!bytes || bytes <= 0) return '0 B';
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) {
        const kb = bytes / 1024;
        return (kb >= 10 ? Math.round(kb) : kb.toFixed(1)) + ' KB';
      }
      const mb = bytes / (1024 * 1024);
      return (mb >= 10 ? Math.round(mb) : mb.toFixed(1)) + ' MB';
    }

    function showError(msg: string) {
      if (!errorBanner || !errorMessage) return;
      errorMessage.textContent = msg;
      errorBanner.classList.remove('hidden');
    }

    function clearError() {
      if (!errorBanner || !errorMessage) return;
      errorMessage.textContent = '';
      errorBanner.classList.add('hidden');
    }

    dismissError?.addEventListener('click', clearError);

    // Update download button text based on active format
    function updateDownloadButtonText() {
      const formatUpper = currentFormat === 'jpg' ? 'JPG' : currentFormat === 'png' ? 'PNG' : 'WebP';
      const template = i18n.controls?.downloadBtn || 'Download {format}';
      if (downloadText) {
        downloadText.textContent = template.replace('{format}', formatUpper);
      }
    }

    // Update quality slider enabled/dimmed state
    function updateQualitySliderVisibility() {
      const targetVal = targetSizeInput?.value.trim();
      const targetNum = targetVal ? parseFloat(targetVal) : 0;
      const isTargetMode = targetVal !== '' && !isNaN(targetNum) && targetNum > 0;

      if (currentFormat === 'png') {
        // PNG is lossless: quality slider does not apply
        pngNote?.classList.remove('hidden');
        qualityControl?.classList.add('opacity-40', 'pointer-events-none');
        if (qualitySlider) qualitySlider.disabled = true;
      } else {
        pngNote?.classList.add('hidden');
        if (qualitySlider) qualitySlider.disabled = false;
        if (isTargetMode) {
          qualityControl?.classList.add('opacity-40', 'pointer-events-none');
        } else {
          qualityControl?.classList.remove('opacity-40', 'pointer-events-none');
        }
      }
    }

    // Set active output format
    function setOutputFormat(format: 'webp' | 'jpg' | 'png', triggerCompression = true) {
      currentFormat = format;
      formatBtns.forEach((btn) => {
        const btnFormat = btn.getAttribute('data-format');
        if (btnFormat === format) {
          btn.className = 'format-btn px-3 py-1.5 rounded-lg transition-all duration-150 cursor-pointer bg-accent text-white shadow-xs font-bold';
        } else {
          btn.className = 'format-btn px-3 py-1.5 rounded-lg transition-all duration-150 cursor-pointer text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark';
        }
      });

      updateDownloadButtonText();
      updateQualitySliderVisibility();
      if (triggerCompression && loadedImage) {
        if (debounceTimer) clearTimeout(debounceTimer);
        runCompression();
      }
    }

    // Format selection buttons
    formatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const fmt = btn.getAttribute('data-format') as 'webp' | 'jpg' | 'png' | null;
        if (fmt && fmt !== currentFormat) {
          setOutputFormat(fmt);
        }
      });
    });

    // Clean up memory
    function cleanupState() {
      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = null;
      }
      if (compressedUrl) {
        URL.revokeObjectURL(compressedUrl);
        compressedUrl = null;
      }
      if (loadedImage) {
        loadedImage.close();
        loadedImage = null;
      }
      currentFile = null;
      compressedBlob = null;
      if (debounceTimer) clearTimeout(debounceTimer);
    }

    // Reset UI to initial empty state
    function resetUI() {
      cleanupState();
      setOutputFormat('webp', false);
      if (fileInput) fileInput.value = '';
      if (targetSizeInput) targetSizeInput.value = '';
      if (qualitySlider) qualitySlider.value = '75';
      if (qualityVal) qualityVal.textContent = '75%';
      updateQualitySliderVisibility();

      previewCard?.classList.add('hidden');
      controlsSection?.classList.add('hidden');
      dropzone?.classList.remove('hidden');
      if (resultText) resultText.textContent = '';
      clearError();
    }

    removeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      resetUI();
    });

    // Universal client-side image decoder
    async function decodeImage(file: File) {
      if ('createImageBitmap' in window) {
        const bitmap = await createImageBitmap(file);
        return {
          drawable: bitmap,
          width: bitmap.width,
          height: bitmap.height,
          close: () => bitmap.close?.(),
        };
      }

      return new Promise<{
        drawable: CanvasImageSource;
        width: number;
        height: number;
        close: () => void;
      }>((resolve, reject) => {
        const img = new Image();
        const objUrl = URL.createObjectURL(file);
        const timer = setTimeout(() => {
          URL.revokeObjectURL(objUrl);
          reject(new Error('Corrupt image'));
        }, 3000);
        img.onload = () => {
          clearTimeout(timer);
          resolve({
            drawable: img,
            width: img.naturalWidth,
            height: img.naturalHeight,
            close: () => URL.revokeObjectURL(objUrl),
          });
        };
        img.onerror = () => {
          clearTimeout(timer);
          URL.revokeObjectURL(objUrl);
          reject(new Error('Corrupt image'));
        };
        img.src = objUrl;
      });
    }

    // Draw image onto canvas, handling white background flattening for JPG
    function drawImageToCanvas(
      ctx: CanvasRenderingContext2D,
      drawable: CanvasImageSource,
      w: number,
      h: number,
      format: 'webp' | 'jpg' | 'png'
    ) {
      if (format === 'jpg') {
        // Flatten transparency onto WHITE background to prevent black-box JPEGs
        ctx.fillStyle = '#FFFFFF';
        ctx.fillRect(0, 0, w, h);
      } else {
        ctx.clearRect(0, 0, w, h);
      }
      ctx.drawImage(drawable, 0, 0, w, h);
    }

    // Convert canvas to Blob based on format
    function canvasToBlob(
      canvas: HTMLCanvasElement,
      format: 'webp' | 'jpg' | 'png',
      quality: number
    ): Promise<Blob> {
      const mime = format === 'jpg' ? 'image/jpeg' : format === 'png' ? 'image/png' : 'image/webp';
      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => {
            if (blob) resolve(blob);
            else reject(new Error('Canvas toBlob failed'));
          },
          mime,
          format === 'png' ? undefined : quality
        );
      });
    }

    // Perform target size compression
    async function compressToTarget(
      drawable: CanvasImageSource,
      origW: number,
      origH: number,
      targetBytes: number,
      format: 'webp' | 'jpg' | 'png',
      taskToken: number
    ): Promise<{ blob: Blob; reached: boolean }> {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('2D context unavailable');

      let scale = 1.0;
      let smallestBlob: Blob | null = null;
      let bestBlob: Blob | null = null;

      if (format === 'png') {
        // PNG is lossless — quality is ignored by browser.
        // Size reduction is achieved by downscaling dimensions.
        while (scale >= 0.05) {
          if (taskToken !== currentTaskToken) throw new Error('aborted');

          const currentW = Math.max(16, Math.round(origW * scale));
          const currentH = Math.max(16, Math.round(origH * scale));
          canvas.width = currentW;
          canvas.height = currentH;
          drawImageToCanvas(ctx, drawable, currentW, currentH, 'png');

          const blob = await canvasToBlob(canvas, 'png', 1.0);
          if (!smallestBlob || blob.size < smallestBlob.size) {
            smallestBlob = blob;
          }

          if (blob.size <= targetBytes) {
            bestBlob = blob;
            break;
          }

          const estimatedRatio = Math.sqrt(targetBytes / blob.size) * 0.92;
          scale = Math.min(scale * 0.8, scale * estimatedRatio);
          await new Promise((r) => setTimeout(r, 0));
        }

        if (bestBlob && bestBlob.size <= targetBytes) {
          return { blob: bestBlob, reached: true };
        }
        return { blob: smallestBlob || minBlobFallback(), reached: false };
      }

      // WebP and JPG: Binary search quality and adjust scale
      while (scale >= 0.05) {
        if (taskToken !== currentTaskToken) throw new Error('aborted');

        const currentW = Math.max(16, Math.round(origW * scale));
        const currentH = Math.max(16, Math.round(origH * scale));
        canvas.width = currentW;
        canvas.height = currentH;
        drawImageToCanvas(ctx, drawable, currentW, currentH, format);

        // Test lowest quality (0.05) to check if resolution fits under target
        const minBlob = await canvasToBlob(canvas, format, 0.05);
        if (!smallestBlob || minBlob.size < smallestBlob.size) {
          smallestBlob = minBlob;
        }

        if (minBlob.size > targetBytes) {
          const estimatedRatio = Math.sqrt(targetBytes / minBlob.size) * 0.92;
          scale = Math.min(scale * 0.75, scale * estimatedRatio);
          await new Promise((r) => setTimeout(r, 0));
          continue;
        }

        // Test high quality (0.95)
        const maxBlob = await canvasToBlob(canvas, format, 0.95);
        if (maxBlob.size <= targetBytes) {
          bestBlob = maxBlob;
          break;
        }

        // Binary search quality between 0.05 and 0.95
        let lowQ = 0.05;
        let highQ = 0.95;
        bestBlob = minBlob;

        for (let i = 0; i < 7; i++) {
          if (taskToken !== currentTaskToken) throw new Error('aborted');
          const midQ = (lowQ + highQ) / 2;
          const midBlob = await canvasToBlob(canvas, format, midQ);

          if (midBlob.size <= targetBytes) {
            bestBlob = midBlob;
            lowQ = midQ;
          } else {
            highQ = midQ;
          }
          await new Promise((r) => setTimeout(r, 0));
        }

        break;
      }

      if (bestBlob && bestBlob.size <= targetBytes) {
        return { blob: bestBlob, reached: true };
      }
      return { blob: smallestBlob || minBlobFallback(), reached: false };

      function minBlobFallback(): Blob {
        return smallestBlob || new Blob([], { type: format === 'jpg' ? 'image/jpeg' : format === 'png' ? 'image/png' : 'image/webp' });
      }
    }

    // Core compression pipeline
    async function runCompression() {
      if (!loadedImage || !currentFile) return;

      const taskToken = ++currentTaskToken;
      const format = currentFormat;
      if (compressSpinner) compressSpinner.classList.remove('hidden');
      if (resultText) resultText.textContent = i18n.controls?.compressing || 'Compressing...';

      // Yield frame so spinner paints smoothly
      await new Promise((r) => requestAnimationFrame(() => setTimeout(r, 10)));

      try {
        const origSize = currentFile.size;
        const targetVal = targetSizeInput?.value.trim();
        const targetNum = targetVal ? parseFloat(targetVal) : 0;

        let finalBlob: Blob;
        let targetReached = true;
        let isTargetMode = false;

        if (targetNum > 0) {
          isTargetMode = true;
          const targetBytes = targetNum * 1024;
          const res = await compressToTarget(
            loadedImage.drawable,
            loadedImage.width,
            loadedImage.height,
            targetBytes,
            format,
            taskToken
          );
          finalBlob = res.blob;
          targetReached = res.reached;
        } else {
          // Quality Slider Mode (or lossless PNG)
          const quality = qualitySlider ? Math.max(1, Math.min(100, parseInt(qualitySlider.value, 10))) / 100 : 0.75;
          const canvas = document.createElement('canvas');
          canvas.width = loadedImage.width;
          canvas.height = loadedImage.height;
          const ctx = canvas.getContext('2d');
          if (!ctx) throw new Error('Canvas 2D context unavailable');
          drawImageToCanvas(ctx, loadedImage.drawable, loadedImage.width, loadedImage.height, format);
          finalBlob = await canvasToBlob(canvas, format, quality);
        }

        if (taskToken !== currentTaskToken) return;

        compressedBlob = finalBlob;
        if (compressedUrl) {
          URL.revokeObjectURL(compressedUrl);
        }
        compressedUrl = URL.createObjectURL(finalBlob);

        // Update result text with active format
        const origStr = formatBytes(origSize);
        const compStr = formatBytes(finalBlob.size);
        const formatUpper = format === 'jpg' ? 'JPG' : format === 'png' ? 'PNG' : 'WebP';

        if (isTargetMode && !targetReached) {
          const closestTpl = i18n.controls?.closestPossible || 'Closest possible: {size} (target {target} KB)';
          if (resultText) {
            resultText.textContent = `${closestTpl.replace('{size}', compStr).replace('{target}', String(targetNum))} (${formatUpper})`;
          }
        } else if (finalBlob.size < origSize) {
          const savedPct = Math.round((1 - finalBlob.size / origSize) * 100);
          const savedLabel = i18n.controls?.saved || 'Saved';
          if (resultText) {
            resultText.textContent = `${origStr} → ${compStr} ${formatUpper} · ${savedLabel} ${savedPct}% ✅`;
          }
        } else {
          const biggerMsg = format !== 'webp'
            ? (i18n.controls?.biggerWarningTryWebp || 'Bigger ⚠️ try WebP instead')
            : (i18n.controls?.biggerWarning || 'Bigger ⚠️ try a lower quality or use target size');
          if (resultText) {
            resultText.textContent = `${origStr} → ${compStr} ${formatUpper} · ${biggerMsg}`;
          }
        }
      } catch (err: any) {
        if (err?.message === 'aborted') return;
        console.error('Compression error:', err);
        showError(i18n.errors?.corruptFile || 'Could not compress this image.');
      } finally {
        if (taskToken === currentTaskToken && compressSpinner) {
          compressSpinner.classList.add('hidden');
        }
      }
    }

    function scheduleCompression() {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        runCompression();
      }, 300);
    }

    // Handle incoming file selection
    async function handleFile(file: File) {
      clearError();

      // Validate format
      const isValidImage =
        file.type.startsWith('image/') ||
        /\.(jpe?g|png|webp|avif|gif|bmp|tiff|svg)$/i.test(file.name);

      if (!isValidImage) {
        showError(i18n.errors?.invalidType || 'Please select a valid JPG, PNG, WebP, or AVIF image.');
        return;
      }

      try {
        cleanupState();
        currentFile = file;

        // Decode image client-side
        loadedImage = await decodeImage(file);

        // Show image thumbnail and details
        previewUrl = URL.createObjectURL(file);
        if (previewImg) previewImg.src = previewUrl;
        if (fileNameEl) fileNameEl.textContent = file.name;
        if (originalSizeEl) originalSizeEl.textContent = formatBytes(file.size);

        // Replace dropzone with preview
        dropzone?.classList.add('hidden');
        previewCard?.classList.remove('hidden');
        controlsSection?.classList.remove('hidden');

        // Initial format is WebP
        setOutputFormat('webp', false);

        // Trigger initial compression
        runCompression();
      } catch (err) {
        console.error('Image decode error:', err);
        cleanupState();
        previewCard?.classList.add('hidden');
        controlsSection?.classList.add('hidden');
        dropzone?.classList.remove('hidden');
        showError(i18n.errors?.corruptFile || 'Could not decode this image file. It may be corrupt or unreadable.');
      }
    }

    // Dropzone triggers
    dropzone?.addEventListener('click', () => {
      fileInput?.click();
    });

    dropzone?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput?.click();
      }
    });

    fileInput?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files.length > 0) {
        handleFile(files[0]);
      }
      if (fileInput) fileInput.value = '';
    });

    // Drag & Drop
    ['dragenter', 'dragover'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.add('border-accent', 'bg-accent/5');
      });
    });

    ['dragleave', 'drop'].forEach((ev) => {
      dropzone?.addEventListener(ev, (e) => {
        e.preventDefault();
        e.stopPropagation();
        dropzone.classList.remove('border-accent', 'bg-accent/5');
      });
    });

    dropzone?.addEventListener('drop', (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt && dt.files && dt.files.length > 0) {
        handleFile(dt.files[0]);
      }
    });

    // Global Paste (Ctrl+V)
    function onPaste(e: ClipboardEvent) {
      if (!e.clipboardData) return;
      const items = e.clipboardData.items;
      for (let i = 0; i < items.length; i++) {
        if (items[i].type.indexOf('image') !== -1) {
          const file = items[i].getAsFile();
          if (file) {
            handleFile(file);
            break;
          }
        }
      }
    }
    window.addEventListener('paste', onPaste);

    // CONTROL 1: Quality slider input
    qualitySlider?.addEventListener('input', () => {
      if (qualityVal && qualitySlider) {
        qualityVal.textContent = `${qualitySlider.value}%`;
      }
      scheduleCompression();
    });

    // CONTROL 2: Target size input
    targetSizeInput?.addEventListener('input', () => {
      updateQualitySliderVisibility();
      scheduleCompression();
    });

    // DOWNLOAD BUTTON
    downloadBtn?.addEventListener('click', () => {
      if (!compressedBlob || !currentFile) return;

      const origBaseName = currentFile.name.replace(/\.[^/.]+$/, '');
      const ext = currentFormat === 'jpg' ? 'jpg' : currentFormat === 'png' ? 'png' : 'webp';
      const downloadName = `${origBaseName}-compressed.${ext}`;

      const link = document.createElement('a');
      const url = URL.createObjectURL(compressedBlob);
      link.href = url;
      link.download = downloadName;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      setTimeout(() => {
        URL.revokeObjectURL(url);
      }, 2000);
    });
  }

  // Initialize on document ready & Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initImageCompressor);
  } else {
    initImageCompressor();
  }
  document.addEventListener('astro:after-swap', initImageCompressor);
</script>

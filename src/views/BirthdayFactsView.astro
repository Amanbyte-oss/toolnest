      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {common.ui?.quickJump || 'Quick Jump'}
        </span>
        <span class="text-xs text-accent font-medium">{faqs.length} {common.ui?.answers || 'Answers'}</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {faqs.map((faq, idx) => (
          <a
            href={`#faq-item-${idx + 1}`}
            class="text-xs px-2.5 py-1 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors"
          >
            {faq.question}
          </a>
        ))}
      </div>
    </div>

    <!-- FAQ Accordion Component -->
    <Faq items={faqs} lang={lang} />
  </section>

  <!-- 7. RELATED TOOLS SECTION -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
        {common.headings?.relatedTools || 'Related Free Tools'}
      </h2>
      <a href={getLocalizedPath('/', lang)} class="text-xs font-semibold text-accent hover:underline">
        {common.links?.viewAllTools || 'View all tools'} &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {relatedTools.map((tool) => (
        <ToolCard
          title={tool.name}
          description={tool.desc}
          href={tool.href}
          anchor={tool.anchor}
          icon={tool.href.includes('age') ? 'calendar' : tool.href.includes('countdown') ? 'clock' : 'book'}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <!-- Pass localized dictionary to client script -->
  <script is:inline define:vars={{ birthdayI18n: { common, birthday, errors, data: dataNs }, pageLang: lang }}>
    window.__BIRTHDAY_I18N__ = birthdayI18n;
    window.__PAGE_LANG__ = pageLang;
  </script>
</Base>

<script>
  import { validateDate, getBirthdayFacts } from '../scripts/birthday-facts.js';
  import {
    saveHistory,
    saveLastState,
    getLastState,
    initHistoryCard,
  } from '../scripts/history.js';
  import { showToast } from '../scripts/toast.js';

  let currentFacts = null;

  function initBirthdayFacts() {
    const i18n = (window as any).__BIRTHDAY_I18N__ || {};
    const tBirthday = i18n.birthday || {};
    const tCommon = i18n.common || {};
    const tErrors = i18n.errors || {};
    const tData = i18n.data || {};
    const pageLang = (window as any).__PAGE_LANG__ || 'en';
    const localeCode = pageLang === 'ar' ? 'ar-EG' : pageLang === 'pt' ? 'pt-BR' : pageLang === 'id' ? 'id-ID' : 'en-US';

    const monthSelect = document.getElementById('dob-month') as HTMLSelectElement;
    const daySelect = document.getElementById('dob-day') as HTMLSelectElement;
    const yearSelect = document.getElementById('dob-year') as HTMLSelectElement;
    const nativeDateInput = document.getElementById('native-dob-date') as HTMLInputElement;
    const revealBtn = document.getElementById('reveal-facts-btn');
    const dobCard = document.getElementById('dob-tool');
    const errorContainer = document.getElementById('facts-date-error');
    const errorText = document.getElementById('facts-date-error-text');
    const resultsContainer = document.getElementById('facts-results-container');
    const downloadBtn = document.getElementById('download-card-btn');
    const shareBtn = document.getElementById('share-facts-btn');
    const resetBtn = document.getElementById('reset-facts-btn');

    if (!monthSelect || !daySelect || !yearSelect || !revealBtn) return;

    // Sync native calendar picker
    if (nativeDateInput) {
      nativeDateInput.addEventListener('change', () => {
        if (!nativeDateInput.value) return;
        const [y, m, d] = nativeDateInput.value.split('-').map(Number);
        if (y && m && d) {
          yearSelect.value = String(y);
          monthSelect.value = String(m);
          daySelect.value = String(d);
          clearError();
        }
      });
    }

    function syncNative() {
      if (!nativeDateInput) return;
      const y = yearSelect.value;
      const m = monthSelect.value.padStart(2, '0');
      const d = daySelect.value.padStart(2, '0');
      if (y && m && d) {
        nativeDateInput.value = `${y}-${m}-${d}`;
      }
    }

    [monthSelect, daySelect, yearSelect].forEach((el) => {
      el.addEventListener('change', () => {
        clearError();
        syncNative();
      });
    });

    function showError(msg) {
      if (!errorContainer || !errorText) return;
      errorText.textContent = msg;
      errorContainer.classList.remove('hidden');

      if (dobCard) {
        dobCard.classList.remove('animate-card-shake');
        void dobCard.offsetWidth;
        dobCard.classList.add('animate-card-shake');
        setTimeout(() => dobCard.classList.remove('animate-card-shake'), 400);
      }
    }

    function clearError() {
      if (errorContainer) errorContainer.classList.add('hidden');
    }

    // Reveal Facts Handler
    function handleReveal() {
      clearError();

      const year = parseInt(yearSelect.value, 10);
      const month = parseInt(monthSelect.value, 10);
      const day = parseInt(daySelect.value, 10);

      const validation = validateDate(year, month, day);
      if (!validation.valid) {
        showError(tBirthday.toasts?.invalidDate || validation.error || 'Please enter a valid calendar date.');
        return;
      }

      const facts = getBirthdayFacts(year, month, day);
      currentFacts = facts;

      // Localized dates
      const birthUtc = facts.birthUtc;
      const birthDate = new Date(birthUtc);
      const localizedWeekday = birthDate.toLocaleDateString(localeCode, { weekday: 'long', timeZone: 'UTC' });
      const localizedFormattedDate = birthDate.toLocaleDateString(localeCode, { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
      const localizedShortDate = birthDate.toLocaleDateString(localeCode, { month: 'short', day: 'numeric', timeZone: 'UTC' });

      // Localized Data Lookups
      const genData = tData.generations?.find((g) => year >= g.startYear && year <= g.endYear) || facts.generation;
      const zKey = facts.zodiac.id;
      const zLoc = tData.zodiac?.[zKey] || facts.zodiac;
      const stoneLoc = tData.birthstones?.[String(month)] || facts.birthstone;
      const flowerLoc = tData.birthFlowers?.[String(month)] || facts.birthFlower;
      const lpLoc = tData.lifePath?.[String(facts.lifePath.number)] || facts.lifePath;

      // Save to recent activity history and last state
      const birthdayTitle = `${tBirthday.title || 'Birthday'}: ${day} ${monthSelect.options[monthSelect.selectedIndex]?.text || ''} ${year}`;
      saveHistory('facts', {
        t: birthdayTitle,
        d: new Date().toISOString(),
        x: { year, month, day },
      });
      saveLastState('facts', { year, month, day });

      // 1. Populate Shareable Card
      const cardWeekday = document.getElementById('card-weekday');
      const cardFormattedDate = document.getElementById('card-formatted-date');
      const cardGenBadge = document.getElementById('card-generation-badge');
      const cardZodiacSymbol = document.getElementById('card-zodiac-symbol');
      const cardZodiacName = document.getElementById('card-zodiac-name');
      const cardZodiacElement = document.getElementById('card-zodiac-element');
      const cardZodiacTraits = document.getElementById('card-zodiac-traits');
      const cardStoneName = document.getElementById('card-stone-name');
      const cardStoneMeaning = document.getElementById('card-stone-meaning');
      const cardFlowerName = document.getElementById('card-flower-name');
      const cardFlowerMeaning = document.getElementById('card-flower-meaning');
      const cardDaysLived = document.getElementById('card-days-lived');

      if (cardWeekday) cardWeekday.textContent = localizedWeekday;
      if (cardFormattedDate) cardFormattedDate.textContent = localizedFormattedDate;
      if (cardGenBadge) cardGenBadge.textContent = genData.shortName || genData.name;

      if (cardZodiacSymbol) cardZodiacSymbol.textContent = facts.zodiac.symbol;
      if (cardZodiacName) cardZodiacName.textContent = zLoc.name || facts.zodiac.name;
      if (cardZodiacElement) cardZodiacElement.textContent = zLoc.element || facts.zodiac.element;

      const traits = zLoc.traits || facts.zodiac.traits || [];
      if (cardZodiacTraits) {
        cardZodiacTraits.innerHTML = traits
          .map(
            (t) =>
              `<span class="px-2 py-0.5 rounded-full text-[10px] sm:text-[11px] font-medium bg-accent/10 text-accent border border-accent/20">${t}</span>`
          )
          .join('');
      }

      if (cardStoneName) cardStoneName.textContent = stoneLoc.name;
      if (cardStoneMeaning) cardStoneMeaning.textContent = stoneLoc.meaning;

      if (cardFlowerName) cardFlowerName.textContent = flowerLoc.name;
      if (cardFlowerMeaning) cardFlowerMeaning.textContent = flowerLoc.meaning;

      const daysLivedFormatted = `${facts.milestones.daysLived.toLocaleString(localeCode)} ${tBirthday.ui?.days || tBirthday.daysRemaining || 'days'}`;
      if (cardDaysLived) cardDaysLived.textContent = daysLivedFormatted;

      // 2. Populate Famous People Section
      const famousDateHeading = document.getElementById('famous-date-heading');
      const famousGrid = document.getElementById('famous-grid');
      const leapNotice = document.getElementById('leap-day-notice');

      if (famousDateHeading) famousDateHeading.textContent = localizedShortDate;

      if (leapNotice) {
        if (facts.famous.leapDayNote) {
          leapNotice.textContent = facts.famous.leapDayNote;
          leapNotice.classList.remove('hidden');
        } else {
          leapNotice.classList.add('hidden');
        }
      }

      if (famousGrid) {
        const people = facts.famous.people || [];
        if (people.length > 0) {
          const maxVisible = 6;
          const displayPeople = people.length > maxVisible ? people.slice(0, maxVisible - 1) : people;
          const extraCount = people.length - displayPeople.length;

          let html = displayPeople
            .map(
              (p) => `
            <div class="h-[82px] card p-3 flex flex-col justify-center bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
              <div class="font-bold text-xs sm:text-sm text-primary-light dark:text-primary-dark flex items-center gap-1.5 min-w-0">
                <span class="text-accent shrink-0">★</span>
                <span class="truncate">${p.name}</span>
              </div>
              <p class="text-[11px] sm:text-xs text-secondary-light dark:text-secondary-dark line-clamp-2 leading-tight mt-0.5">
                ${p.known}
              </p>
            </div>
          `
            )
            .join('');

          if (extraCount > 0) {
            html += `
            <div class="h-[82px] card p-3 flex flex-col items-center justify-center bg-accent/5 border border-accent/25 text-center">
              <span class="text-xs sm:text-sm font-bold text-accent">+${extraCount}</span>
              <span class="text-[11px] text-secondary-light dark:text-secondary-dark">${tBirthday.ui?.historicalBornOnDay || 'historical figures born on this day'}</span>
            </div>
          `;
          }

          famousGrid.innerHTML = html;
        } else {
          famousGrid.innerHTML = `
            <div class="col-span-full card p-5 text-center text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
              ${tBirthday.ui?.noCelebrityRecords || 'No celebrity records in our offline archive for this date.'}
            </div>
          `;
        }
      }

      // 3. Populate Facts Details Grid
      const detailZodiacSymbol = document.getElementById('detail-zodiac-symbol');
      const detailZodiacElement = document.getElementById('detail-zodiac-element');
      const detailZodiacName = document.getElementById('detail-zodiac-name');
      const detailZodiacMeaning = document.getElementById('detail-zodiac-meaning');

      const detailStoneName = document.getElementById('detail-stone-name');
      const detailStoneMeaning = document.getElementById('detail-stone-meaning');

      const detailFlowerName = document.getElementById('detail-flower-name');
      const detailFlowerMeaning = document.getElementById('detail-flower-meaning');

      const detailGenYears = document.getElementById('detail-generation-years');
      const detailGenName = document.getElementById('detail-generation-name');
      const detailGenMeaning = document.getElementById('detail-generation-meaning');

      if (detailZodiacSymbol) detailZodiacSymbol.textContent = facts.zodiac.symbol;
      if (detailZodiacElement) detailZodiacElement.textContent = zLoc.element || facts.zodiac.element;
      if (detailZodiacName) detailZodiacName.textContent = zLoc.name || facts.zodiac.name;
      if (detailZodiacMeaning) detailZodiacMeaning.textContent = `${traits.join(', ')}.`;

      if (detailStoneName) detailStoneName.textContent = stoneLoc.name;
      if (detailStoneMeaning) detailStoneMeaning.textContent = stoneLoc.meaning;

      if (detailFlowerName) detailFlowerName.textContent = flowerLoc.name;
      if (detailFlowerMeaning) detailFlowerMeaning.textContent = flowerLoc.meaning;

      if (detailGenYears) detailGenYears.textContent = `${genData.startYear}–${genData.endYear}`;
      if (detailGenName) detailGenName.textContent = genData.name;
      if (detailGenMeaning) detailGenMeaning.textContent = genData.description;

      // Life Path
      const lifePathNum = document.getElementById('result-lifepath-num');
      const lifePathTitle = document.getElementById('result-lifepath-title');
      const lifePathTraits = document.getElementById('result-lifepath-traits');
      const lifePathSummary = document.getElementById('result-lifepath-summary');

      if (lifePathNum) lifePathNum.textContent = String(facts.lifePath.number);
      if (lifePathTitle) lifePathTitle.textContent = `${facts.lifePath.number} — ${lpLoc.title}`;
      if (lifePathTraits) lifePathTraits.textContent = `${tBirthday.ui?.coreTraits || 'Core Traits'}: ${lpLoc.traits}`;
      if (lifePathSummary) lifePathSummary.textContent = lpLoc.summary;

      // 4. Populate Milestones
      const milestoneDays = document.getElementById('milestone-days-count');
      const milestone10kBadge = document.getElementById('milestone-10k-badge');
      const milestone10kDate = document.getElementById('milestone-10k-date');
      const milestone10kStatus = document.getElementById('milestone-10k-status');

      const milestoneNextLabel = document.getElementById('milestone-next-label');
      const milestoneNextDate = document.getElementById('milestone-next-date');
      const milestoneNextCountdown = document.getElementById('milestone-next-countdown');

      if (milestoneDays) milestoneDays.textContent = daysLivedFormatted;

      const day10kDateStr = new Date(facts.birthUtc + 10000 * 24 * 60 * 60 * 1000).toLocaleDateString(localeCode, {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });

      if (milestone10kDate) milestone10kDate.textContent = day10kDateStr;
      if (milestone10kBadge && milestone10kStatus) {
        if (facts.milestones.day10k.isPassed) {
          milestone10kBadge.textContent = tBirthday.ui?.celebrated || 'Celebrated';
          milestone10kBadge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400';
          milestone10kStatus.textContent = day10kDateStr;
        } else {
          milestone10kBadge.textContent = tBirthday.ui?.upcoming || 'Upcoming';
          milestone10kBadge.className = 'text-[11px] px-2.5 py-0.5 rounded-full font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400';
          milestone10kStatus.textContent = day10kDateStr;
        }
      }

      const nextMilestoneDateStr = new Date(facts.birthUtc + facts.milestones.nextMilestone.milestone * 24 * 60 * 60 * 1000).toLocaleDateString(localeCode, {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC',
      });

      if (milestoneNextLabel) milestoneNextLabel.textContent = `${facts.milestones.nextMilestone.milestone.toLocaleString(localeCode)} ${tBirthday.ui?.dayLandmark || 'Landmark'}`;
      if (milestoneNextDate) milestoneNextDate.textContent = nextMilestoneDateStr;
      if (milestoneNextCountdown) milestoneNextCountdown.textContent = nextMilestoneDateStr;

      // 5. Reveal Results with Staggered Fade-Up
      if (resultsContainer) {
        resultsContainer.classList.remove('hidden');

        const animSections = resultsContainer.querySelectorAll('.result-section-anim');
        animSections.forEach((sec: HTMLElement, idx) => {
          sec.classList.remove('animate-fade-slide-up');
          void sec.offsetWidth;
          sec.style.animationDelay = `${idx * 50}ms`;
          sec.classList.add('animate-fade-slide-up');
        });

        const headerOffset = 80;
        const rect = resultsContainer.getBoundingClientRect();
        const targetScrollY = rect.top + window.pageYOffset - headerOffset;
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        window.scrollTo({
          top: Math.max(0, targetScrollY),
          behavior: prefersReduced ? 'auto' : 'smooth',
        });
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (typeof (window as any).confetti === 'function' && !prefersReducedMotion) {
        (window as any).confetti({
          particleCount: 70,
          spread: 60,
          origin: { y: 0.6 },
          disableForReducedMotion: true,
        });
      }
    }

    revealBtn.addEventListener('click', handleReveal);

    // Save Card as Image via html-to-image
    if (downloadBtn) {
      downloadBtn.addEventListener('click', async () => {
        const cardElement = document.getElementById('shareable-card');
        if (!cardElement || !(window as any).htmlToImage) {
          showToast(tCommon.toasts?.errorOccurred || 'Image generator is initializing. Please try again.');
          return;
        }

        try {
          downloadBtn.setAttribute('disabled', 'true');
          showToast(tCommon.toasts?.loaded || 'Rendering celebration card...');

          const dataUrl = await (window as any).htmlToImage.toPng(cardElement, {
            quality: 1,
            pixelRatio: 2,
            cacheBust: true,
          });

          const link = document.createElement('a');
          link.download = `toolnest-birthday-card-${yearSelect.value}-${monthSelect.value}-${daySelect.value}.png`;
          link.href = dataUrl;
          link.click();

          showToast(tBirthday.toasts?.cardCopied || 'Card saved to your device!');
        } catch (error) {
          console.error('Image capture error:', error);
          showToast(tCommon.toasts?.errorOccurred || 'Unable to export image. Try taking a screenshot!');
        } finally {
          downloadBtn.removeAttribute('disabled');
        }
      });
    }

    // Share Facts Handler
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        if (!currentFacts) return;
        const f = currentFacts;
        const birthDate = new Date(f.birthUtc);
        const localizedWeekday = birthDate.toLocaleDateString(localeCode, { weekday: 'long', timeZone: 'UTC' });
        const localizedFormattedDate = birthDate.toLocaleDateString(localeCode, { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
        const zKey = f.zodiac.id;
        const zLoc = tData.zodiac?.[zKey] || f.zodiac;
        const stoneLoc = tData.birthstones?.[String(f.month)] || f.birthstone;
        const flowerLoc = tData.birthFlowers?.[String(f.month)] || f.birthFlower;
        const genData = tData.generations?.find((g) => f.year >= g.startYear && f.year <= g.endYear) || f.generation;

        const shareText = [
          `🎉 ${tBirthday.title || 'My Birthday Facts via ToolNest'}:`,
          `${tBirthday.ui?.bornOn || 'Born on'} ${localizedWeekday} (${localizedFormattedDate})`,
          `${tBirthday.ui?.zodiacSign || 'Zodiac'}: ${f.zodiac.symbol} ${zLoc.name || f.zodiac.name} (${zLoc.element || f.zodiac.element})`,
          `${tBirthday.ui?.birthstone || 'Birthstone'}: ${stoneLoc.name} • ${tBirthday.ui?.birthFlower || 'Flower'}: ${flowerLoc.name}`,
          `${tBirthday.ui?.generation || 'Generation'}: ${genData.name}`,
          `${tBirthday.ui?.daysOnEarth || 'Alive for'}: ${f.milestones.daysLived.toLocaleString(localeCode)} ${tBirthday.ui?.days || tBirthday.daysRemaining || 'days'}`,
          `${window.location.href}`,
        ].join('\n');

        if (navigator.share) {
          try {
            await navigator.share({
              title: `${tBirthday.title || 'Birthday Facts'} • ToolNest`,
              text: shareText,
              url: window.location.href,
            });
          } catch (err) {
            // Cancelled
          }
        } else {
          try {
            await navigator.clipboard.writeText(shareText);
            showToast(tBirthday.toasts?.factsCopied || 'Summary copied to clipboard!');
          } catch (e) {
            showToast(tCommon.toasts?.errorOccurred || 'Unable to share on this browser.');
          }
        }
      });
    }

    // Reset Form Handler
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (resultsContainer) resultsContainer.classList.add('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        daySelect.focus();
      });
    }

    // Restore from history
    function restoreFacts(data) {
      if (!data || !data.year) return;
      yearSelect.value = String(data.year);
      monthSelect.value = String(data.month);
      daySelect.value = String(data.day);
      syncNative();
      handleReveal();
    }

    // Prefill from last state if available
    const last = getLastState('facts');
    if (last && last.year) {
      yearSelect.value = String(last.year);
      monthSelect.value = String(last.month);
      daySelect.value = String(last.day);
      syncNative();
    }

    initHistoryCard({ toolId: 'facts', onRestore: restoreFacts });
  }

  initBirthdayFacts();
  document.addEventListener('astro:after-swap', initBirthdayFacts);
</script>

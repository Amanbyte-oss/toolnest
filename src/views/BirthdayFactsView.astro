---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const birthday = getNamespace(lang, 'birthday');
const errors = getNamespace(lang, 'errors');
const faqNs = getNamespace(lang, 'faq');
const dataNs = getNamespace(lang, 'data');
const t = { birthday, common, errors, nav: common.nav, siteName: common.siteName, data: dataNs };

const currentYear = new Date().getFullYear();
const currentMonth = new Date().getMonth() + 1;
const currentDay = new Date().getDate();
const localeCode = lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US';
const lastUpdatedDate = new Date().toLocaleDateString(localeCode, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Month names using native Intl
const monthFormatter = new Intl.DateTimeFormat(localeCode, { month: 'long' });
const monthNames = Array.from({ length: 12 }, (_, i) => monthFormatter.format(new Date(2024, i, 1)));

// Years array descending from current year down to 1920
const years = Array.from({ length: currentYear - 1920 + 1 }, (_, i) => currentYear - i);
const days = Array.from({ length: 31 }, (_, i) => i + 1);

// Localized FAQs
const faqs = (faqNs.birthday || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'birthday-facts');

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${getLocalizedPath('/birthday-facts', lang)}#app`,
  name: t.birthday.title,
  url: `https://toolnest.pages.dev${getLocalizedPath('/birthday-facts', lang)}`,
  description: t.birthday.subtitle,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.birthday.howTo.title,
  description: t.birthday.howTo.subtitle,
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: t.birthday.howTo.s1Title,
      text: t.birthday.howTo.s1Desc,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: t.birthday.howTo.s2Title,
      text: t.birthday.howTo.s2Desc,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: t.birthday.howTo.s3Title,
      text: t.birthday.howTo.s3Desc,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const zodiacRows = [
  { monthIdx: 0, signs: 'Capricorn • Aquarius', range: 'Dec 22 – Jan 19 / Jan 20 – Feb 18', element: 'Earth / Air', elementColor: 'bg-amber-500/10 text-amber-600 dark:text-amber-400', planet: 'Saturn / Uranus' },
  { monthIdx: 1, signs: 'Aquarius • Pisces', range: 'Jan 20 – Feb 18 / Feb 19 – Mar 20', element: 'Air / Water', elementColor: 'bg-sky-500/10 text-sky-600 dark:text-sky-400', planet: 'Uranus / Neptune' },
  { monthIdx: 2, signs: 'Pisces • Aries', range: 'Feb 19 – Mar 20 / Mar 21 – Apr 19', element: 'Water / Fire', elementColor: 'bg-red-500/10 text-red-600 dark:text-red-400', planet: 'Neptune / Mars' },
  { monthIdx: 3, signs: 'Aries • Taurus', range: 'Mar 21 – Apr 19 / Apr 20 – May 20', element: 'Fire / Earth', elementColor: 'bg-orange-500/10 text-orange-600 dark:text-orange-400', planet: 'Mars / Venus' },
  { monthIdx: 4, signs: 'Taurus • Gemini', range: 'Apr 20 – May 20 / May 21 – Jun 20', element: 'Earth / Air', elementColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400', planet: 'Venus / Mercury' },
  { monthIdx: 5, signs: 'Gemini • Cancer', range: 'May 21 – Jun 20 / Jun 21 – Jul 22', element: 'Air / Water', elementColor: 'bg-blue-500/10 text-blue-600 dark:text-blue-400', planet: 'Mercury / Moon' },
  { monthIdx: 6, signs: 'Cancer • Leo', range: 'Jun 21 – Jul 22 / Jul 23 – Aug 22', element: 'Water / Fire', elementColor: 'bg-yellow-500/10 text-yellow-600 dark:text-yellow-400', planet: 'Moon / Sun' },
  { monthIdx: 7, signs: 'Leo • Virgo', range: 'Jul 23 – Aug 22 / Aug 23 – Sep 22', element: 'Fire / Earth', elementColor: 'bg-amber-500/10 text-amber-600 dark:text-amber-400', planet: 'Sun / Mercury' },
  { monthIdx: 8, signs: 'Virgo • Libra', range: 'Aug 23 – Sep 22 / Sep 23 – Oct 22', element: 'Earth / Air', elementColor: 'bg-teal-500/10 text-teal-600 dark:text-teal-400', planet: 'Mercury / Venus' },
  { monthIdx: 9, signs: 'Libra • Scorpio', range: 'Sep 23 – Oct 22 / Oct 23 – Nov 21', element: 'Air / Water', elementColor: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400', planet: 'Venus / Pluto' },
  { monthIdx: 10, signs: 'Scorpio • Sagittarius', range: 'Oct 23 – Nov 21 / Nov 22 – Dec 21', element: 'Water / Fire', elementColor: 'bg-purple-500/10 text-purple-600 dark:text-purple-400', planet: 'Pluto / Jupiter' },
  { monthIdx: 11, signs: 'Sagittarius • Capricorn', range: 'Nov 22 – Dec 21 / Dec 22 – Jan 19', element: 'Fire / Earth', elementColor: 'bg-rose-500/10 text-rose-600 dark:text-rose-400', planet: 'Jupiter / Saturn' },
];
---

<Base
  metaKey="birthday"
  canonicalPath={getLocalizedPath('/birthday-facts', lang)}
  ogImage="/og/birthday-facts.svg"
  breadcrumbs={[{ name: common.nav.home, item: getLocalizedPath('/', lang) }, { name: common.nav.birthdayFacts, item: getLocalizedPath('/birthday-facts', lang) }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
  lang={lang}
>
  <!-- CDN Scripts for Confetti and Client-Side Card Image Generation -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>

  <!-- Scoped Styles for Shake Animation & Card Sizing -->
  <style>
    @keyframes cardShake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .animate-card-shake {
      animation: cardShake 320ms cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }
    @media (prefers-reduced-motion: reduce) {
      .animate-card-shake {
        animation: none !important;
      }
    }
    .shareable-card-container {
      container-type: inline-size;
      container-name: sharecard;
    }
  </style>

  <!-- 1. PAGE HEADER (H1 + one-line subtext) -->
  <header class="text-center py-4 sm:py-6 space-y-2">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span>{t.birthday.ui.personalDossier || 'Personal Birthday Dossier'}</span>
    </div>
    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.birthday.title}
    </h1>
    <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      {t.birthday.subtitle}
    </p>
  </header>

  <!-- 2. INPUT CARD -->
  <section
    id="dob-tool"
    class="card max-w-xl mx-auto p-5 sm:p-8 space-y-5 transition-all duration-200"
    aria-labelledby="dob-input-heading"
  >
    <div class="flex items-center justify-between border-b border-border-light dark:border-border-dark pb-3">
      <h2 id="dob-input-heading" class="text-sm sm:text-base font-bold text-primary-light dark:text-primary-dark">
        {t.birthday.ui.selectDob || t.birthday.inputDateLabel || 'Select Your Date of Birth'}
      </h2>
      <span class="text-xs text-secondary-light dark:text-secondary-dark font-medium">
        1920 – {currentYear}
      </span>
    </div>

    <div class="space-y-4">
      <div class="flex items-start gap-2 sm:gap-3.5">
        <!-- Day Dropdown -->
        <div class="flex-1 min-w-0 space-y-1.5">
          <label for="dob-day" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {t.birthday.ui.day || 'Day'}
          </label>
          <select
            id="dob-day"
            class="w-full min-h-[48px] text-base px-2 sm:px-3 py-2.5 rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-primary-light dark:text-primary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent cursor-pointer font-medium transition-colors"
          >
            {days.map((d) => (
              <option value={d} selected={d === 1}>
                {d}
              </option>
            ))}
          </select>
        </div>

        <!-- Month Dropdown -->
        <div class="flex-1 min-w-0 space-y-1.5">
          <label for="dob-month" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {t.birthday.ui.month || 'Month'}
          </label>
          <select
            id="dob-month"
            class="w-full min-h-[48px] text-base px-2 sm:px-3 py-2.5 rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-primary-light dark:text-primary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent cursor-pointer font-medium transition-colors"
          >
            {monthNames.map((name, index) => (
              <option value={index + 1} selected={index + 1 === 1}>
                {name}
              </option>
            ))}
          </select>
        </div>

        <!-- Year Dropdown -->
        <div class="flex-1 min-w-0 space-y-1.5">
          <label for="dob-year" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
            {t.birthday.ui.year || 'Year'}
          </label>
          <select
            id="dob-year"
            class="w-full min-h-[48px] text-base px-2 sm:px-3 py-2.5 rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark text-primary-light dark:text-primary-dark focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent cursor-pointer font-medium transition-colors"
          >
            {years.map((y) => (
              <option value={y} selected={y === 1995}>
                {y}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Inline Validation Error -->
      <div
        id="facts-date-error"
        class="hidden rounded-xl border border-red-500/30 bg-red-500/10 dark:bg-red-500/15 p-3 text-xs sm:text-sm text-red-600 dark:text-red-400 font-medium flex items-center gap-2"
        role="alert"
        aria-live="polite"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span id="facts-date-error-text">{t.birthday.toasts.invalidDate}</span>
      </div>

      <!-- Footer Action Area -->
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 pt-1">
        <div class="flex items-center gap-2 text-xs text-secondary-light dark:text-secondary-dark">
          <label for="native-dob-date" class="cursor-pointer hover:text-accent transition-colors">
            {t.birthday.ui.orPickCalendar || 'Or pick from calendar:'}
          </label>
          <input
            type="date"
            id="native-dob-date"
            value="1995-01-01"
            max={`${currentYear}-${String(currentMonth).padStart(2, '0')}-${String(currentDay).padStart(2, '0')}`}
            min="1920-01-01"
            class="rounded-lg border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark px-2.5 py-1 text-xs text-primary-light dark:text-primary-dark focus:outline-none focus:border-accent"
            aria-label="Native date picker"
          />
        </div>

        <div class="sticky bottom-3 z-20 lg:static lg:z-auto pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))] lg:pb-0 bg-surface-light/95 dark:bg-surface-dark/95 lg:bg-transparent backdrop-blur-md lg:backdrop-blur-none -mx-2 px-2 lg:mx-0 lg:px-0">
          <button
            id="reveal-facts-btn"
            type="button"
            class="btn-primary w-full lg:w-auto px-7 py-3 text-sm sm:text-base font-bold shadow-md shadow-accent/20 cursor-pointer justify-center"
            aria-describedby="facts-date-error"
          >
            {t.birthday.ui.revealFacts || t.birthday.revealBtn || 'Reveal My Facts'}
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RESULTS CONTAINER -->
  <div id="facts-results-container" class="hidden mt-10 space-y-12 sm:space-y-14 scroll-mt-24">
    
    <!-- 3A. SHAREABLE RESULT CARD & ACTIONS -->
    <section class="result-section-anim flex flex-col items-center space-y-4" aria-label="Personal Birthday Card">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
          {t.birthday.ui.personalCard || 'Your Personal Birthday Card'}
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          {t.birthday.ui.cardSubtitle || 'Share your celebration sticker or save as a crisp high-res image.'}
        </p>
      </div>

      <!-- Centerpiece Shareable Card -->
      <div class="shareable-card-container w-full max-w-[420px] mx-auto px-1 sm:px-0">
        <div
          id="shareable-card"
          class="w-full aspect-[4/5] rounded-3xl border-2 border-slate-200/90 bg-white text-slate-900 p-4 sm:p-5 shadow-xl relative overflow-hidden flex flex-col justify-between ring-1 ring-black/5 select-none"
        >
          <!-- Top decorative gradient line -->
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-accent via-indigo-400 to-purple-500"></div>

          <!-- Card Header -->
          <div class="text-center space-y-1 pt-1">
            <div class="text-2xl sm:text-3xl leading-none" id="card-emoji">🎂</div>
            <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-accent/10 text-accent mx-auto" id="card-generation-badge">
              {t.birthday.ui.generation || 'Generation'}
            </div>
            <h3 class="text-base sm:text-xl font-extrabold text-slate-900 tracking-tight leading-tight">
              {t.birthday.ui.bornOn || 'Born on'} <span id="card-weekday" class="text-accent">Wednesday</span>
            </h3>
            <p id="card-formatted-date" class="text-[11px] sm:text-xs font-semibold text-slate-500">
              January 1, 1995
            </p>
          </div>

          <!-- Zodiac Row -->
          <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-1">
            <div class="flex items-center justify-center gap-1.5 sm:gap-2">
              <span id="card-zodiac-symbol" class="text-xl leading-none">♈</span>
              <span id="card-zodiac-name" class="text-xs sm:text-sm font-bold text-slate-900">Aries</span>
              <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-md bg-white border border-slate-200 font-semibold text-slate-600" id="card-zodiac-element">
                Fire
              </span>
            </div>
            <div id="card-zodiac-traits" class="flex flex-wrap items-center justify-center gap-1">
            </div>
          </div>

          <!-- Mini Cards: Birthstone + Birth Flower -->
          <div class="grid grid-cols-2 gap-2">
            <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-0.5 min-w-0">
              <span class="text-base sm:text-lg block leading-none">💎</span>
              <span class="text-[9px] sm:text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
                {t.birthday.ui.birthstone || 'Birthstone'}
              </span>
              <span id="card-stone-name" class="text-xs sm:text-sm font-bold text-slate-900 block truncate">
                Garnet
              </span>
              <p id="card-stone-meaning" class="text-[10px] sm:text-[11px] text-slate-500 line-clamp-1 leading-tight">
                Symbolizes protection & vitality.
              </p>
            </div>

            <div class="p-2 sm:p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center space-y-0.5 min-w-0">
              <span class="text-base sm:text-lg block leading-none">🌸</span>
              <span class="text-[9px] sm:text-[10px] uppercase font-bold text-slate-400 block tracking-wider">
                {t.birthday.ui.birthFlower || 'Birth Flower'}
              </span>
              <span id="card-flower-name" class="text-xs sm:text-sm font-bold text-slate-900 block truncate">
                Carnation
              </span>
              <p id="card-flower-meaning" class="text-[10px] sm:text-[11px] text-slate-500 line-clamp-1 leading-tight">
                Symbolizes devotion & love.
              </p>
            </div>
          </div>

          <!-- Days on Earth line -->
          <div class="py-1.5 sm:py-2 px-3 rounded-xl bg-accent/5 border border-accent/15 flex items-center justify-between">
            <span class="text-[10px] sm:text-xs font-semibold text-slate-600">
              {t.birthday.ui.daysOnEarth || 'Days on Earth:'}
            </span>
            <span class="text-xs sm:text-sm font-black text-accent tracking-tight" id="card-days-lived">
              0
            </span>
          </div>

          <!-- Card Watermark Footer -->
          <div class="pt-1.5 border-t border-slate-200/80 flex items-center justify-between text-[10px] sm:text-[11px] text-slate-400">
            <span class="font-bold text-slate-700">{t.birthday.cardWatermark}</span>
            <span>toolnest.pages.dev</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons Row -->
      <div class="w-full max-w-[420px] mx-auto flex flex-col sm:flex-row items-center gap-2.5 pt-2">
        <button
          id="download-card-btn"
          type="button"
          class="btn-primary w-full sm:flex-1 py-3 text-xs sm:text-sm font-semibold justify-center gap-2 cursor-pointer shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>{t.birthday.ui.saveCardImage || 'Save Card as Image'}</span>
        </button>

        <button
          id="share-facts-btn"
          type="button"
          class="btn-secondary w-full sm:flex-1 py-3 text-xs sm:text-sm font-semibold justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
          </svg>
          <span>{t.birthday.ui.shareFacts || 'Share Facts'}</span>
        </button>

        <button
          id="reset-facts-btn"
          type="button"
          class="btn-secondary w-full sm:w-auto px-4 py-3 text-xs sm:text-sm font-medium justify-center shrink-0 cursor-pointer"
        >
          {t.birthday.ui.calculateAnother || 'Calculate Another'}
        </button>
      </div>
    </section>

    <!-- 3B. FAMOUS BIRTHDAYS -->
    <section id="famous-section" class="result-section-anim space-y-4 pt-6 border-t border-border-light dark:border-border-dark" aria-labelledby="famous-heading">
      <div class="space-y-1 text-center sm:text-left">
        <h2 id="famous-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark flex items-center justify-center sm:justify-start gap-2">
          <span>🌟</span>
          <span>{t.birthday.ui.famousBirthdays || 'Famous Birthdays'} (<span id="famous-date-heading">Date</span>)</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          {t.birthday.ui.famousSubtitle || 'Notable icons, visionaries, and historical figures who share your birthday.'}
        </p>
      </div>

      <div id="leap-day-notice" class="hidden p-3 rounded-xl bg-accent/10 border border-accent/20 text-xs text-accent font-medium"></div>

      <div id="famous-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      </div>
    </section>

    <!-- 3C. FACTS GRID -->
    <section id="facts-grid-section" class="result-section-anim space-y-4 pt-6 border-t border-border-light dark:border-border-dark" aria-labelledby="facts-grid-heading">
      <div class="space-y-1 text-center sm:text-left">
        <h2 id="facts-grid-heading" class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark flex items-center justify-center sm:justify-start gap-2">
          <span>✨</span>
          <span>{t.birthday.ui.archetypesHeading || 'Birthday Dossier & Archetypes'}</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
          {t.birthday.ui.archetypesSubtitle || 'Astrological, mineralogical, botanical, and demographic facets linked to your birth date.'}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1: Zodiac Sign -->
        <div class="card p-5 flex flex-col justify-between min-h-[170px] space-y-2 border border-border-light dark:border-border-dark">
          <div>
            <div class="flex items-center justify-between mb-2">

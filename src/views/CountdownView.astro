---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import relatedLinksData from '../data/related-links.json';
import { PRESET_EMOJIS } from '../scripts/countdown.js';
import CountdownShareCard from '../components/CountdownShareCard.astro';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const countdown = getNamespace(lang, 'countdown');
const errors = getNamespace(lang, 'errors');
const faqNs = getNamespace(lang, 'faq');
const t = { countdown, common, errors, nav: common.nav, siteName: common.siteName };

const localeCode = lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US';
const lastUpdatedDate = new Date().toLocaleDateString(localeCode, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Localized FAQs
const faqs = (faqNs.countdown || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'countdown');

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${getLocalizedPath('/countdown', lang)}#app`,
  name: t.countdown.title,
  url: `https://toolnest.pages.dev${getLocalizedPath('/countdown', lang)}`,
  description: t.countdown.subtitle,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.countdown.howTo.title,
  description: t.countdown.howTo.subtitle,
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: t.countdown.howTo.s1Title,
      text: t.countdown.howTo.s1Desc,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: t.countdown.howTo.s2Title,
      text: t.countdown.howTo.s2Desc,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: t.countdown.howTo.s3Title,
      text: t.countdown.howTo.s3Desc,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  metaKey="countdown"
  canonicalPath={getLocalizedPath('/countdown', lang)}
  ogImage="/og/countdown.svg"
  breadcrumbs={[{ name: common.nav.home, item: getLocalizedPath('/', lang) }, { name: common.nav.countdown, item: getLocalizedPath('/countdown', lang) }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
  lang={lang}
>
  <script is:inline src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>

  <!-- Hidden Share Card for 1080x1350 PNG export -->
  <CountdownShareCard id="creator-share-card" lang={lang} />

  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <span>⏳</span>
      <span>{t.countdown.ui?.liveTimerTitle || 'Shareable Event Timer'}</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.countdown.title}
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      {t.countdown.subtitle}
    </p>
  </header>

  <!-- QUICK TEMPLATES & COUNTDOWN IDEAS -->
  <section class="mt-6 space-y-2" aria-labelledby="templates-heading">
    <div class="flex items-center justify-between">
      <span id="templates-heading" class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
        {lang === 'ar' ? 'أفكار العد التنازلي الشائعة (انقر للتعبئة)' : lang === 'pt' ? 'Ideias Populares de Contagem (Clique para Preencher)' : lang === 'id' ? 'Ide Hitung Mundur Populer (Klik untuk Mengisi)' : 'Popular Countdown Ideas (Click to Prefill)'}
      </span>
      <span class="text-[11px] text-accent font-medium">10 {lang === 'ar' ? 'نماذج سريعة' : lang === 'pt' ? 'Modelos Rápidos' : lang === 'id' ? 'Templat Cepat' : 'Quick Presets'}</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-template="newyear"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎆</span>
        <span>{t.countdown.ui?.presetNewYear || 'New Year'}</span>
      </button>
      <button
        type="button"
        data-template="christmas"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎄</span>
        <span>{t.countdown.ui?.presetChristmas || 'Christmas'}</span>
      </button>
      <button
        type="button"
        data-template="halloween"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎃</span>
        <span>{t.countdown.ui?.presetHalloween || 'Halloween'}</span>
      </button>
      <button
        type="button"
        data-template="summersolstice"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>☀️</span>
        <span>{t.countdown.ui?.presetSummer || 'Summer Solstice'}</span>
      </button>
      <button
        type="button"
        data-template="friday5pm"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🍻</span>
        <span>{lang === 'ar' ? 'الجمعة القادمة 5 مساءً' : lang === 'pt' ? 'Próxima Sexta 17h' : lang === 'id' ? 'Jumat Depan 17:00' : 'Next Friday 5 PM'}</span>
      </button>
      <button
        type="button"
        data-template="fullmoon"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🌕</span>
        <span>{lang === 'ar' ? 'البدر القادم' : lang === 'pt' ? 'Próxima Lua Cheia' : lang === 'id' ? 'Bulan Purnama Berikutnya' : 'Next Full Moon'}</span>
      </button>
      <button
        type="button"
        data-template="graduation"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎓</span>
        <span>{lang === 'ar' ? 'التخرج' : lang === 'pt' ? 'Formatura' : lang === 'id' ? 'Kelulusan' : 'Graduation'}</span>
      </button>
      <button
        type="button"
        data-template="birthday"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🎂</span>
        <span>{t.countdown.ui?.presetBirthday || 'Birthday'}</span>
      </button>
      <button
        type="button"
        data-template="vacation"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>✈️</span>
        <span>{lang === 'ar' ? 'الإجازة الصيفية' : lang === 'pt' ? 'Férias de Verão' : lang === 'id' ? 'Liburan Musim Panas' : 'Summer Vacation'}</span>
      </button>
      <button
        type="button"
        data-template="productlaunch"
        class="template-btn px-3 py-1.5 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark text-xs font-medium text-primary-light dark:text-primary-dark hover:border-accent transition-colors min-h-[40px] flex items-center gap-1.5 cursor-pointer"
      >
        <span>🚀</span>
        <span>{lang === 'ar' ? 'إطلاق المنتج' : lang === 'pt' ? 'Lançamento de Produto' : lang === 'id' ? 'Peluncuran Produk' : 'Product Launch'}</span>
      </button>
    </div>
  </section>

  <!-- CREATOR INPUT CARD -->
  <section class="card mt-6 space-y-6" aria-labelledby="creator-form-heading">
    <div class="border-b border-border-light dark:border-border-dark pb-3 flex items-center justify-between">
      <h2 id="creator-form-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
        {t.countdown.ui?.createCountdownHeading || 'Event Details'}
      </h2>
      <span class="text-xs text-secondary-light dark:text-secondary-dark">
        {lang === 'ar' ? 'يتم حفظ جميع البيانات في الرابط' : lang === 'pt' ? 'Todos os dados ficam salvos no link' : lang === 'id' ? 'Semua data tersimpan di tautan' : 'All data is preserved in the link'}
      </span>
    </div>

    <!-- Event Title Input -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-between">
        <label for="event-title-input" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {t.countdown.eventTitleLabel || 'Event Title'}
        </label>
        <span id="title-char-count" class="text-xs text-secondary-light dark:text-secondary-dark">
          0 / 60
        </span>
      </div>
      <input
        id="event-title-input"
        type="text"
        maxlength="60"
        class="input-base text-base"
        placeholder={t.countdown.eventTitlePlaceholder || 'e.g. Vacation, Birthday, Product Launch...'}
        value="Trip to Hawaii"
        autocomplete="off"
      />
    </div>

    <!-- Target Date & Time Input -->
    <div class="space-y-1.5">
      <label for="event-datetime-input" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        {t.countdown.targetDateLabel || 'Target Date & Time (Local Time)'}
      </label>
      <input
        id="event-datetime-input"
        type="datetime-local"
        class="input-base text-base cursor-pointer"
        aria-describedby="datetime-error-msg"
      />
      <!-- Inline Error Alert -->
      <div
        id="datetime-error-msg"
        class="hidden text-xs text-error font-medium items-center gap-1.5 pt-1"
        role="alert"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span>{t.countdown.toasts?.invalidDate || 'Target date and time must be in the future.'}</span>
      </div>
    </div>

    <!-- Emoji Picker Row -->
    <div class="space-y-2">
      <label class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        {t.countdown.ui?.chooseEmoji || 'Pick an Event Emoji'}
      </label>
      <div class="flex flex-wrap items-center gap-2.5" id="emoji-picker-container">
        {PRESET_EMOJIS.map((emoji, idx) => (
          <button
            type="button"
            data-emoji={emoji}
            class={`emoji-btn w-11 h-11 rounded-xl text-xl flex items-center justify-center border transition-all cursor-pointer select-none ${
              idx === 0
                ? 'border-accent bg-accent/15 ring-2 ring-accent'
                : 'border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark hover:border-accent'
            }`}
            aria-label={`Select ${emoji} emoji`}
          >
            {emoji}
          </button>
        ))}
      </div>
    </div>

    <!-- LIVE PREVIEW CARD -->
    <div class="pt-4 border-t border-border-light dark:border-border-dark space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {lang === 'ar' ? 'معاينة حية' : lang === 'pt' ? 'Prévia ao Vivo' : lang === 'id' ? 'Pratinjau Langsung' : 'Live Preview'}
        </span>
        <span class="text-[11px] text-accent font-medium flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>{lang === 'ar' ? 'يعمل لحظيًا' : lang === 'pt' ? 'Atualizando em tempo real' : lang === 'id' ? 'Berjalan langsung' : 'Ticking live'}</span>
        </span>
      </div>

      <div class="p-5 rounded-2xl border border-border-light dark:border-border-dark bg-gradient-to-b from-surface-light to-bg-light dark:from-surface-dark dark:to-bg-dark shadow-sm text-center space-y-3">
        <div class="flex items-center justify-center gap-2">
          <span id="preview-emoji" class="text-2xl">🎉</span>
          <h3 id="preview-title" class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark truncate max-w-xs">
            Trip to Hawaii
          </h3>
        </div>

        <div class="grid grid-cols-4 gap-2 max-w-xs mx-auto">
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-days" class="font-mono text-xl sm:text-2xl font-black text-accent block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">{t.countdown.daysRemaining || 'Days'}</span>
          </div>
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-hours" class="font-mono text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">{t.countdown.hoursRemaining || 'Hours'}</span>
          </div>
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-minutes" class="font-mono text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">{t.countdown.minutesRemaining || 'Mins'}</span>
          </div>
          <div class="p-2 rounded-xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
            <span id="preview-seconds" class="font-mono text-xl sm:text-2xl font-black text-primary-light dark:text-primary-dark block tabular-nums">00</span>
            <span class="text-[9px] uppercase tracking-wider text-secondary-light dark:text-secondary-dark font-semibold">{t.countdown.secondsRemaining || 'Secs'}</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2 pt-1 border-t border-border-light/60 dark:border-border-dark/60 mt-3">
          <button
            id="preview-download-image-btn"
            type="button"
            class="btn-secondary py-1.5 px-3 text-xs font-semibold gap-1.5 cursor-pointer flex items-center justify-center transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
            aria-label="Download preview image"
          >
            <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Download PNG</span>
          </button>
          <button
            id="preview-share-image-btn"
            type="button"
            class="btn-secondary py-1.5 px-3 text-xs font-semibold gap-1.5 cursor-pointer flex items-center justify-center transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
            aria-label="Share preview image"
          >
            <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
              <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
            </svg>
            <span>{common.buttons.share || common.share || 'Share'}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Desktop Create Button -->
    <div class="pt-2">
      <button
        id="create-countdown-btn"
        type="button"
        class="btn-primary w-full sm:w-auto sm:px-8 py-3.5 text-base font-bold shadow-md shadow-accent/20 cursor-pointer"
      >
        {t.countdown.createBtn || 'Create Countdown Link'}
      </button>
    </div>

    <!-- Sticky Mobile Button -->
    <div class="sm:hidden fixed bottom-3 inset-x-4 z-30 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))]">
      <button
        id="mobile-create-countdown-btn"
        type="button"
        class="btn-primary w-full py-3.5 text-base font-bold shadow-xl shadow-accent/25 flex items-center justify-center gap-2 cursor-pointer"
        style="touch-action: manipulation;"
      >
        <span>⏳</span>
        <span>{t.countdown.createBtn || 'CREATE COUNTDOWN LINK'}</span>
      </button>
    </div>
  </section>

  <!-- GENERATED LINK OUTPUT CARD -->
  <section
    id="created-link-section"
    class="hidden mt-8 card space-y-4 border-2 border-accent/40 scroll-mt-20"
    aria-labelledby="share-link-heading"
  >
    <div class="flex items-center gap-2 text-emerald-500 font-bold text-sm">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <h3 id="share-link-heading" class="text-base text-primary-light dark:text-primary-dark">
        {lang === 'ar' ? 'رابط العد التنازلي جاهز!' : lang === 'pt' ? 'Seu link de contagem regressiva está pronto!' : lang === 'id' ? 'Tautan hitung mundur Anda sudah siap!' : 'Your Countdown Link is Ready!'}
      </h3>
    </div>
    <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
      {lang === 'ar' ? 'يمكن لأي شخص لديه هذا الرابط رؤية العد التنازلي اللحظي بتوقيته المحلي.' : lang === 'pt' ? 'Qualquer pessoa com este link pode ver a contagem em tempo real em seu horário local.' : lang === 'id' ? 'Siapa pun yang memiliki tautan ini dapat melihat hitung mundur langsung sesuai waktu lokal mereka.' : 'Anyone with this URL can view your live ticking countdown in their local time.'}
    </p>

    <!-- Readonly Link Box with Copy Button -->
    <div class="flex items-center gap-2">
      <input
        id="generated-url-input"
        type="text"
        readonly
        class="input-base text-xs font-mono text-secondary-light dark:text-secondary-dark select-all"
        aria-label="Generated Countdown Link"
      />
      <button
        id="copy-generated-url-btn"
        type="button"
        class="btn-primary shrink-0 py-2.5 px-4 text-xs font-semibold gap-1.5 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span>{common.buttons.copy || 'Copy Link'}</span>
      </button>
    </div>

    <!-- Image Actions -->
    <div class="pt-2 border-t border-border-light/60 dark:border-border-dark/60">
      <div class="text-xs font-medium text-secondary-light dark:text-secondary-dark mb-2.5 flex items-center gap-1.5">
        <span>📸</span>
        <span>{lang === 'ar' ? 'مشاركة كصورة (بطاقة الحالة / القصة 1080×1350)' : lang === 'pt' ? 'Compartilhar como Imagem (Card 1080×1350)' : lang === 'id' ? 'Bagikan sebagai Gambar (Kartu Story / Status 1080×1350)' : 'Share as Image (1080×1350 Story / Status Card)'}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <button
          id="creator-download-image-btn"
          type="button"
          class="btn-secondary min-h-[48px] py-3 px-4 text-xs sm:text-sm font-bold gap-2 cursor-pointer flex items-center justify-center border-border-light dark:border-border-dark w-full transition-all duration-150 hover:-translate-y-0.5 active:scale-95"
          aria-label="Download countdown image card"
        >
          <svg class="w-4 h-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">

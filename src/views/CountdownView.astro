<script>
  import {
    encodeCountdown,
    getTimeRemaining,
    toDatetimeLocal,
    getPresetTemplate,
  } from '../scripts/countdown.js';
  import {
    saveHistory,
    saveLastState,
    getLastState,
    initHistoryCard,
  } from '../scripts/history.js';
  import {
    handleDownloadImage,
    handleShareImage,
  } from '../scripts/countdown-share.js';
  import { showToast } from '../scripts/toast.js';

  function initCountdownCreator() {
    const i18n = (window as any).__COUNTDOWN_I18N__ || {};
    const tCountdown = i18n.countdown || {};
    const tCommon = i18n.common || {};
    const tErrors = i18n.errors || {};
    const currentLang = (window as any).__PAGE_LANG__ || document.documentElement.lang || 'en';

    const titleInput = document.getElementById('event-title-input') as HTMLInputElement;
    const charCounter = document.getElementById('title-char-count');
    const datetimeInput = document.getElementById('event-datetime-input') as HTMLInputElement;
    const datetimeError = document.getElementById('datetime-error-msg');
    const emojiButtons = document.querySelectorAll('.emoji-btn');
    const createBtn = document.getElementById('create-countdown-btn') as HTMLButtonElement;
    const mobileCreateBtn = document.getElementById('mobile-create-countdown-btn') as HTMLButtonElement;

    // Live preview elements
    const previewEmoji = document.getElementById('preview-emoji');
    const previewTitle = document.getElementById('preview-title');
    const previewDays = document.getElementById('preview-days');
    const previewHours = document.getElementById('preview-hours');
    const previewMinutes = document.getElementById('preview-minutes');
    const previewSeconds = document.getElementById('preview-seconds');

    // Generated section elements
    const createdSection = document.getElementById('created-link-section');
    const generatedUrlInput = document.getElementById('generated-url-input') as HTMLInputElement;
    const copyUrlBtn = document.getElementById('copy-generated-url-btn');
    const openViewerLink = document.getElementById('open-viewer-link') as HTMLAnchorElement;
    const shareGeneratedBtn = document.getElementById('share-generated-btn');

    if (!titleInput || !datetimeInput || !createBtn) return;

    let selectedEmoji = '🎉';
    let tickerInterval: any = null;
    let currentCreatedIso: string | null = null;

    // Image export elements
    const creatorShareCard = document.getElementById('creator-share-card');
    const creatorDownloadBtn = document.getElementById('creator-download-image-btn');
    const creatorShareBtn = document.getElementById('creator-share-image-btn');
    const previewDownloadBtn = document.getElementById('preview-download-image-btn');
    const previewShareBtn = document.getElementById('preview-share-image-btn');

    function getCreatorEventData() {
      const title = titleInput.value.trim() || 'My Event';
      const targetDate = datetimeInput.value ? new Date(datetimeInput.value) : new Date();
      return {
        title,
        date: targetDate,
        emoji: selectedEmoji,
        createdAt: currentCreatedIso,
        timestamp: targetDate.getTime(),
      };
    }

    // Default target date: 7 days from now at 12:00 PM
    if (!datetimeInput.value) {
      const defaultDate = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
      defaultDate.setHours(12, 0, 0, 0);
      datetimeInput.value = toDatetimeLocal(defaultDate);
    }

    // Emoji selection
    emojiButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        emojiButtons.forEach((b) => {
          b.classList.remove('border-accent', 'bg-accent/15', 'ring-2', 'ring-accent');
          b.classList.add('border-border-light', 'dark:border-border-dark', 'bg-input-light', 'dark:bg-input-dark');
        });
        btn.classList.remove('border-border-light', 'dark:border-border-dark', 'bg-input-light', 'dark:bg-input-dark');
        btn.classList.add('border-accent', 'bg-accent/15', 'ring-2', 'ring-accent');
        selectedEmoji = btn.getAttribute('data-emoji') || '🎉';
        if (previewEmoji) previewEmoji.textContent = selectedEmoji;
      });
    });

    // Template buttons
    document.querySelectorAll('.template-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-template');
        if (key === 'birthday') {
          titleInput.value = 'My Birthday!';
          showToast(tCountdown.toasts?.invalidDate || 'Select your upcoming birthday date & time.');
          datetimeInput.focus();
          return;
        }

        const template = getPresetTemplate(key);
        if (template) {
          titleInput.value = template.title;
          datetimeInput.value = template.date;
          selectedEmoji = template.emoji;

          // Highlight matching emoji button
          emojiButtons.forEach((b) => {
            if (b.getAttribute('data-emoji') === template.emoji) {
              (b as HTMLButtonElement).click();
            }
          });

          updatePreview();
          showToast(tCommon.toasts?.loaded || 'Preset loaded.');
        }
      });
    });

    // Character counter & Title sync
    function updateTitle() {
      const text = titleInput.value.trim() || 'My Event';
      if (charCounter) charCounter.textContent = `${titleInput.value.length} / 60`;
      if (previewTitle) previewTitle.textContent = text;
    }
    titleInput.addEventListener('input', updateTitle);
    updateTitle();

    // Date validation
    function validateDatetime() {
      if (!datetimeInput.value) return false;
      const targetTime = new Date(datetimeInput.value).getTime();
      const isValid = !isNaN(targetTime) && targetTime > Date.now();

      if (datetimeError) {
        if (!isValid) {
          datetimeError.classList.remove('hidden');
          datetimeError.classList.add('flex');
        } else {
          datetimeError.classList.add('hidden');
          datetimeError.classList.remove('flex');
        }
      }
      return isValid;
    }
    datetimeInput.addEventListener('input', () => {
      validateDatetime();
      updatePreview();
    });

    // Update Live Preview Ticker
    function updatePreview() {
      if (!datetimeInput.value) return;
      const rem = getTimeRemaining(datetimeInput.value);

      if (previewDays) previewDays.textContent = rem.formattedDays;
      if (previewHours) previewHours.textContent = rem.formattedHours;
      if (previewMinutes) previewMinutes.textContent = rem.formattedMinutes;
      if (previewSeconds) previewSeconds.textContent = rem.formattedSeconds;
    }

    if (tickerInterval) clearInterval(tickerInterval);
    tickerInterval = setInterval(updatePreview, 1000);
    updatePreview();

    // Create Countdown Handler
    function handleCreate() {
      if (!validateDatetime()) {
        showToast(tCountdown.toasts?.invalidDate || 'Please pick a date in the future.');
        datetimeInput.focus();
        return;
      }

      const title = titleInput.value.trim() || 'My Event';
      const isoDate = new Date(datetimeInput.value).toISOString();

      currentCreatedIso = new Date().toISOString();

      const encoded = encodeCountdown({
        t: title,
        d: isoDate,
        e: selectedEmoji,
        c: currentCreatedIso,
      });

      const localizedViewPath = (currentLang === 'en' ? '/countdown/view' : `/${currentLang}/countdown/view`);
      const fullUrl = `${window.location.origin}${localizedViewPath}?c=${encoded}`;

      // Update output elements
      if (generatedUrlInput) generatedUrlInput.value = fullUrl;
      if (openViewerLink) openViewerLink.href = `${localizedViewPath}?c=${encoded}`;

      if (createdSection) {
        createdSection.classList.remove('hidden');
        createdSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // Save to recent activity history and last state
      const targetObj = new Date(datetimeInput.value);
      const formattedDate = targetObj.toLocaleDateString([], {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      });
      saveHistory('countdown', {
        t: `${tCountdown.title || 'Countdown'}: ${title} — ${formattedDate}`,
        d: new Date().toISOString(),
        x: {
          title,
          targetIso: isoDate,
          emoji: selectedEmoji,
          url: `${localizedViewPath}?c=${encoded}`,
        },
      });
      saveLastState('countdown', {
        title,
        targetIso: isoDate,
        emoji: selectedEmoji,
      });

      // Auto-copy to clipboard
      navigator.clipboard
        .writeText(fullUrl)
        .then(() => {
          showToast(tCountdown.toasts?.linkCopied || 'Link copied — share it anywhere!');
        })
        .catch(() => {
          showToast(tCountdown.toasts?.linkCopied || 'Countdown created! Copy link below.');
        });
    }

    createBtn.addEventListener('click', handleCreate);
    if (mobileCreateBtn) mobileCreateBtn.addEventListener('click', handleCreate);

    // Copy Link Action
    if (copyUrlBtn) {
      copyUrlBtn.addEventListener('click', async () => {
        if (!generatedUrlInput || !generatedUrlInput.value) return;
        try {
          await navigator.clipboard.writeText(generatedUrlInput.value);
          showToast(tCountdown.toasts?.linkCopied || 'Countdown link copied to clipboard!');
        } catch (e) {
          showToast(tCommon.toasts?.errorOccurred || 'Unable to copy.');
        }
      });
    }

    // Share Generated Action
    if (shareGeneratedBtn) {
      shareGeneratedBtn.addEventListener('click', async () => {
        if (!generatedUrlInput || !generatedUrlInput.value) return;
        const title = titleInput.value.trim() || 'My Event';
        const shareData = {
          title: `⏳ ${tCountdown.title || 'Countdown'}: ${title}`,
          text: `Track this live countdown with me: "${title}"`,
          url: generatedUrlInput.value,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {
            // Cancelled
          }
        } else {
          try {
            await navigator.clipboard.writeText(generatedUrlInput.value);
            showToast(tCountdown.toasts?.linkCopied || 'Countdown link copied to clipboard!');
          } catch (e) {
            showToast(tCommon.toasts?.errorOccurred || 'Unable to share.');
          }
        }
      });
    }

    // Image Export Actions
    if (creatorDownloadBtn) {
      creatorDownloadBtn.addEventListener('click', () => {
        handleDownloadImage({
          cardEl: creatorShareCard,
          getEventData: getCreatorEventData,
          toastFn: showToast,
          buttonEl: creatorDownloadBtn,
        });
      });
    }

    if (creatorShareBtn) {
      creatorShareBtn.addEventListener('click', () => {
        handleShareImage({
          cardEl: creatorShareCard,
          getEventData: getCreatorEventData,
          shareUrl: generatedUrlInput && generatedUrlInput.value ? generatedUrlInput.value : window.location.href,
          toastFn: showToast,
          buttonEl: creatorShareBtn,
        });
      });
    }

    if (previewDownloadBtn) {
      previewDownloadBtn.addEventListener('click', () => {
        handleDownloadImage({
          cardEl: creatorShareCard,
          getEventData: getCreatorEventData,
          toastFn: showToast,
          buttonEl: previewDownloadBtn,
        });
      });
    }

    if (previewShareBtn) {
      previewShareBtn.addEventListener('click', () => {
        handleShareImage({
          cardEl: creatorShareCard,
          getEventData: getCreatorEventData,
          shareUrl: generatedUrlInput && generatedUrlInput.value ? generatedUrlInput.value : window.location.href,
          toastFn: showToast,
          buttonEl: previewShareBtn,
        });
      });
    }

    // Restore from history
    function restoreCountdown(data: any) {
      if (!data) return;
      if (data.url) {
        window.location.href = data.url;
        return;
      }
      if (data.title) {
        titleInput.value = data.title;
        if (charCounter) charCounter.textContent = `${data.title.length} / 60`;
        if (previewTitle) previewTitle.textContent = data.title;
      }
      if (data.targetIso) {
        const d = new Date(data.targetIso);
        if (d.getTime() > Date.now()) {
          datetimeInput.value = toDatetimeLocal(d);
        }
      }
      if (data.emoji) {
        selectedEmoji = data.emoji;
        emojiButtons.forEach((btn) => {
          if (btn.getAttribute('data-emoji') === selectedEmoji) {
            btn.classList.add('border-accent', 'bg-accent/15', 'ring-2', 'ring-accent');
            btn.classList.remove('border-border-light', 'dark:border-border-dark', 'bg-input-light', 'dark:bg-input-dark');
          } else {
            btn.classList.remove('border-accent', 'bg-accent/15', 'ring-2', 'ring-accent');
            btn.classList.add('border-border-light', 'dark:border-border-dark', 'bg-input-light', 'dark:bg-input-dark');
          }
        });
        if (previewEmoji) previewEmoji.textContent = selectedEmoji;
      }
      updatePreview();
      showToast(tCountdown.toasts?.loaded || 'Loaded countdown event.');
    }

    const lastCountdown = getLastState('countdown');
    if (lastCountdown && lastCountdown.title) {
      titleInput.value = lastCountdown.title;
      if (charCounter) charCounter.textContent = `${lastCountdown.title.length} / 60`;
      if (previewTitle) previewTitle.textContent = lastCountdown.title;
      if (lastCountdown.targetIso) {
        const d = new Date(lastCountdown.targetIso);
        if (d.getTime() > Date.now()) {
          datetimeInput.value = toDatetimeLocal(d);
        }
      }
    }

    initHistoryCard({ toolId: 'countdown', onRestore: restoreCountdown });
  }

  initCountdownCreator();
  document.addEventListener('astro:after-swap', initCountdownCreator);
</script>

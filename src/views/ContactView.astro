---
import Base from '../layouts/Base.astro';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const contact = getNamespace(lang, 'contact');
const errors = getNamespace(lang, 'errors');

const t = {
  contact,
  common,
  errors,
  nav: common.nav,
  siteName: common.siteName,
};

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: contact.title || 'Contact ToolNest',
  url: `https://toolnest.pages.dev${getLocalizedPath('/contact', lang)}`,
  description: contact.metaDesc,
  mainEntity: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
    email: 'hello@toolnest.dev',
  },
};
---

<Base
  metaKey="contact"
  canonicalPath={getLocalizedPath('/contact', lang)}
  ogImage="/og/share-banner.svg"
  breadcrumbs={[{ name: t.nav.contact, item: getLocalizedPath('/contact', lang) }]}
  extraSchemas={[contactSchema]}
  lang={lang}
>
  <article class="space-y-10 max-w-2xl mx-auto">
    <!-- Header -->
    <header class="space-y-3 text-center sm:text-left rtl:sm:text-right">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
        <span>💬</span>
        <span>{t.contact.badge}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        {t.contact.heading}
      </h1>
      <p class="text-base text-secondary-light dark:text-secondary-dark leading-relaxed">
        {t.contact.subheading}
      </p>
    </header>

    <!-- Quick Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="card p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
          ✉️
        </div>
        <h2 class="text-sm font-bold text-primary-light dark:text-primary-dark">{t.contact.emailTitle}</h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark">{t.contact.emailDesc}</p>
        <a
          href="mailto:hello@toolnest.dev"
          class="inline-block text-xs font-bold text-accent hover:underline pt-1 min-h-[44px] flex items-center"
        >
          hello@toolnest.dev &rarr;
        </a>
      </div>

      <div class="card p-5 space-y-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold text-base">
          ⚡
        </div>
        <h2 class="text-sm font-bold text-primary-light dark:text-primary-dark">{t.contact.responseTitle}</h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark">{t.contact.responseDesc}</p>
        <span class="inline-block text-xs font-semibold text-secondary-light dark:text-secondary-dark pt-1 min-h-[44px] flex items-center">
          {t.contact.responseHours}
        </span>
      </div>
    </div>

    <!-- Contact Form Section -->
    <section class="card p-6 sm:p-8 space-y-6" aria-labelledby="form-heading">
      <div class="space-y-1">
        <h2 id="form-heading" class="text-lg font-bold text-primary-light dark:text-primary-dark">
          {t.contact.formTitle}
        </h2>
        <p class="text-xs text-secondary-light dark:text-secondary-dark">
          {t.contact.formSubtitle}
        </p>
      </div>

      <form id="contact-form" class="space-y-4" novalidate>
        <!-- Web3Forms Access Key (Can be replaced with real user key in Cloudflare/env) -->
        <input type="hidden" name="access_key" value="ea82c0ef-f155-4688-9dbe-d069da5c065f" />
        <input type="hidden" name="from_name" value="ToolNest Contact Form" />

        <!-- Spam Protection: Honeypot field (hidden from real users, bots fill it) -->
        <input
          type="checkbox"
          name="botcheck"
          id="botcheck"
          class="hidden"
          style="display:none !important;"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Name Field -->
          <div class="space-y-1.5">
            <label for="contact-name" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
              {t.contact.nameLabel} <span class="text-accent">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              minlength="2"
              class="input-base text-sm min-h-[44px] px-3.5 w-full rounded-xl"
              placeholder="Alex"
              autocomplete="name"
            />
            <p id="name-error" class="hidden text-[11px] font-medium text-rose-500 pt-0.5" role="alert"></p>
          </div>

          <!-- Email Field -->
          <div class="space-y-1.5">
            <label for="contact-email" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
              {t.contact.emailLabel} <span class="text-accent">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              class="input-base text-sm min-h-[44px] px-3.5 w-full rounded-xl"
              placeholder="alex@example.com"
              autocomplete="email"
            />
            <p id="email-error" class="hidden text-[11px] font-medium text-rose-500 pt-0.5" role="alert"></p>
          </div>
        </div>

        <!-- Subject Dropdown -->
        <div class="space-y-1.5">
          <label for="contact-subject" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
            {t.contact.subjectLabel} <span class="text-accent">*</span>
          </label>
          <select
            id="contact-subject"
            name="subject"
            required
            class="input-base text-sm min-h-[44px] px-3.5 w-full rounded-xl bg-surface-light dark:bg-surface-dark cursor-pointer"
          >
            <option value="" disabled selected>{t.contact.subjectPlaceholder || 'Select a topic...'}</option>
            <option value="Bug">{t.contact.subjectBug || 'Report a Bug'}</option>
            <option value="Suggestion">{t.contact.subjectSuggestion || 'Feature Suggestion'}</option>
            <option value="New Tool">{t.contact.subjectNewTool || 'New Tool Idea'}</option>
            <option value="Other">{t.contact.subjectOther || 'General Inquiry / Other'}</option>
          </select>
          <p id="subject-error" class="hidden text-[11px] font-medium text-rose-500 pt-0.5" role="alert"></p>
        </div>

        <!-- Message Field -->
        <div class="space-y-1.5">
          <label for="contact-message" class="block text-xs font-semibold text-primary-light dark:text-primary-dark">
            {t.contact.messageLabel} <span class="text-accent">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="4"
            minlength="10"
            class="input-base text-sm p-3.5 w-full resize-y rounded-xl"
            placeholder="Your message..."
          ></textarea>
          <p id="message-error" class="hidden text-[11px] font-medium text-rose-500 pt-0.5" role="alert"></p>
        </div>

        <!-- Spam Protection: Cloudflare Turnstile Container -->
        <div class="pt-1">
          <div
            class="cf-turnstile"
            data-sitekey="1x00000000000000000000AA"
            data-theme="auto"
            data-size="flexible"
          ></div>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button
            type="submit"
            id="contact-submit-btn"
            class="btn-primary w-full sm:w-auto min-h-[44px] py-2.5 px-6 text-sm font-bold shadow-xs cursor-pointer flex items-center justify-center gap-2"
          >
            <span id="submit-text">{t.contact.submitBtn}</span>
            <span id="submit-spinner" class="hidden animate-spin text-sm">⏳</span>
          </button>
        </div>

        <!-- Success Message State -->
        <div
          id="contact-success-msg"
          class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-xs sm:text-sm font-medium space-y-1"
          role="status"
        >
          <p class="font-bold flex items-center gap-1.5">
            <span>✅</span>
            <span>{t.contact.successMsg}</span>
          </p>
          <p class="text-xs opacity-90">
            We've received your inquiry and will reply to your email shortly.
          </p>
        </div>

        <!-- Error / Retry Message State -->
        <div
          id="contact-error-msg"
          class="hidden p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-700 dark:text-rose-300 text-xs sm:text-sm font-medium space-y-2"
          role="alert"
        >
          <p class="font-bold flex items-center gap-1.5">
            <span>⚠️</span>
            <span>{t.contact.errorRetry}</span>
          </p>
          <div class="pt-1">
            <button
              type="button"
              id="mailto-fallback-btn"
              class="btn-secondary text-xs py-1.5 px-3 font-semibold rounded-lg"
            >
              Open Direct Email Client &rarr;
            </button>
          </div>
        </div>
      </form>
    </section>
  </article>

  <!-- Cloudflare Turnstile API Script (loaded asynchronously) -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script is:inline define:vars={{
    requiredMsg: t.errors.required || 'This field is required.',
    invalidEmailMsg: t.errors.invalidEmail || 'Please enter a valid email address.',
    tooShortMsg: t.errors.tooShort || 'Please provide at least 10 characters.',
    sendingText: t.contact.sendingBtn || 'Sending...',
    submitTextVal: t.contact.submitBtn || 'Send Message',
  }}>
    document.addEventListener('DOMContentLoaded', function () {
      var form = document.getElementById('contact-form');
      var nameInput = document.getElementById('contact-name');
      var emailInput = document.getElementById('contact-email');
      var subjectInput = document.getElementById('contact-subject');
      var messageInput = document.getElementById('contact-message');
      var botcheck = document.getElementById('botcheck');
      var submitBtn = document.getElementById('contact-submit-btn');
      var submitText = document.getElementById('submit-text');
      var submitSpinner = document.getElementById('submit-spinner');
      var successMsg = document.getElementById('contact-success-msg');
      var errorMsg = document.getElementById('contact-error-msg');
      var mailtoFallbackBtn = document.getElementById('mailto-fallback-btn');

      var nameError = document.getElementById('name-error');
      var emailError = document.getElementById('email-error');
      var subjectError = document.getElementById('subject-error');
      var messageError = document.getElementById('message-error');

      function clearErrors() {
        [nameError, emailError, subjectError, messageError].forEach(function (el) {
          if (el) {
            el.textContent = '';
            el.classList.add('hidden');
          }
        });
        if (errorMsg) errorMsg.classList.add('hidden');
      }

      function showError(inputEl, errorEl, msg) {
        if (errorEl) {
          errorEl.textContent = msg;
          errorEl.classList.remove('hidden');
        }
        if (inputEl) {
          inputEl.focus();
        }
      }

      function triggerMailto() {
        var name = nameInput ? nameInput.value.trim() : '';
        var subject = subjectInput ? subjectInput.value.trim() : 'ToolNest Inquiry';
        var message = messageInput ? messageInput.value.trim() : '';
        var email = emailInput ? emailInput.value.trim() : '';
        var body = 'From: ' + name + ' (' + email + ')\n\n' + message;
        var url = 'mailto:hello@toolnest.dev?subject=' + encodeURIComponent('[' + subject + '] Inquiry from ' + name) + '&body=' + encodeURIComponent(body);
        window.location.href = url;
      }

      if (mailtoFallbackBtn) {
        mailtoFallbackBtn.addEventListener('click', triggerMailto);
      }

      if (form) {
        form.addEventListener('submit', async function (e) {
          e.preventDefault();
          clearErrors();

          // 1. Check honeypot spam bot
          if (botcheck && botcheck.checked) {
            // Silently pretend success to trick bots
            if (successMsg) successMsg.classList.remove('hidden');
            form.reset();
            return;
          }

          // 2. Client-side validation
          var name = nameInput ? nameInput.value.trim() : '';
          var email = emailInput ? emailInput.value.trim() : '';
          var subject = subjectInput ? subjectInput.value.trim() : '';
          var message = messageInput ? messageInput.value.trim() : '';

          if (!name || name.length < 2) {
            showError(nameInput, nameError, requiredMsg);
            return;
          }

          var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!email || !emailPattern.test(email)) {
            showError(emailInput, emailError, invalidEmailMsg);
            return;
          }

          if (!subject) {
            showError(subjectInput, subjectError, requiredMsg);
            return;
          }

          if (!message || message.length < 10) {
            showError(messageInput, messageError, tooShortMsg);
            return;
          }

          // 3. UI Sending state
          if (submitBtn) submitBtn.disabled = true;
          if (submitText) submitText.textContent = sendingText;
          if (submitSpinner) submitSpinner.classList.remove('hidden');

          try {
            var formData = new FormData(form);
            var response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              body: formData,
            });

            var result = await response.json();

            if (response.ok && result.success) {
              if (successMsg) successMsg.classList.remove('hidden');
              form.reset();
            } else {
              // API or network failure fallback
              if (errorMsg) errorMsg.classList.remove('hidden');
            }
          } catch (err) {
            // Offline or request blocked by adblocker: trigger fallback
            if (errorMsg) errorMsg.classList.remove('hidden');
          } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.textContent = submitTextVal;
            if (submitSpinner) submitSpinner.classList.add('hidden');
          }
        });
      }
    });
  </script>
</Base>

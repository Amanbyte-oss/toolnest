            href={tool.href}
            anchor={tool.anchor}
            icon={tool.href.includes('image-to-pdf') ? 'pdf' : tool.href.includes('compressor') ? 'image' : tool.href.includes('converter') ? 'convert' : 'clock'}
            lang={lang}
          />
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <Faq faqs={faqs} lang={lang} />
  </div>

  <style>

---
/**
 * src/views/PdfMergeView.astro
 * 100% Client-Side PDF Merge Tool for ToolNest.
 * 
 * Features:
 * - 100% browser-based merging using pdf-lib (zero server uploads, complete privacy).
 * - Lazy isolated PDF.js thumbnails with web worker.
 * - Drag & drop, file browser, and Ctrl+V clipboard paste.
 * - Touch-friendly drag-to-reorder cards with touch fallback buttons.
 * - Page-level merging modal: visual page thumbnails + range syntax (e.g. 1-3, 7, 10-12).
 * - Per-file page sorting (reverse order) and rotation (90°/180°/270°).
 * - Interleave mode: alternating pages from 2 files (odd/even scan reunification).
 * - PDF Bookmarks / Outlines generation with editable chapter titles.
 * - Live estimated output size calculation.
 * - Friendly encrypted / password-protected and corrupt PDF detection.
 * - Memory safe: sequential document processing, doc destruction, >100MB warning.
 * - Merged preview with first-page thumbnail before download.
 * - Full i18n (en, pt, id, ar) with RTL mirroring and mobile optimization down to 360px.
 */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import { getNamespace, getLocalizedPath, type Lang, isRtlLang } from '../i18n';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const mergeNs = getNamespace(lang, 'pdfMerge');
const faqNs = getNamespace(lang, 'faq');
const t = { merge: mergeNs, common, nav: common.nav, siteName: common.siteName };

const isRtl = isRtlLang(lang);
const canonicalPath = getLocalizedPath('/pdf-merge', lang);

// Localized FAQs
const faqs = (faqNs.pdfMerge || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'pdf-merge');

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${canonicalPath}#app`,
  name: t.merge.title,
  url: `https://toolnest.pages.dev${canonicalPath}`,
  description: t.merge.subtitle,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires modern browser with HTML5 Canvas and JavaScript support. Merges 100% client-side without server uploads.',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  metaKey="pdfMerge"
  canonicalPath={canonicalPath}
  ogImage="/og/home.svg"
  breadcrumbs={[
    { name: common.nav.home, item: getLocalizedPath('/', lang) },
    { name: common.nav.pdfMerge || 'PDF Merge', item: canonicalPath },
  ]}
  extraSchemas={[webAppSchema, faqSchema]}
  lang={lang}
>
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Header with Trust Badges -->
    <header class="space-y-4 text-center">
      <div class="inline-flex flex-wrap items-center justify-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{t.merge.privacyBadge}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark">
          ✨ {lang === 'ar' ? 'بدون علامة مائية' : lang === 'pt' ? 'Sem marca d\'água' : lang === 'id' ? 'Tanpa watermark' : 'No Watermark'}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
        {t.merge.title}
      </h1>

      <p class="text-base sm:text-lg text-secondary-light dark:text-secondary-dark max-w-2xl mx-auto leading-relaxed">
        {t.merge.subtitle}
      </p>
    </header>

    <!-- Hidden native file input -->
    <input
      type="file"
      id="pdf-file-input"
      accept="application/pdf,.pdf"
      multiple
      class="hidden"
      aria-label="Upload PDF files"
    />

    <!-- Toast Notification -->
    <div
      id="pdf-toast"
      class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-3 rounded-2xl bg-surface-dark/95 text-white border border-border-dark shadow-2xl flex items-center gap-3 text-sm transition-all duration-200 backdrop-blur-md max-w-[90vw]"
      role="status"
      aria-live="polite"
    >
      <span id="pdf-toast-msg" class="truncate max-w-[260px] sm:max-w-md"></span>
      <button
        id="pdf-toast-undo"
        type="button"
        class="hidden px-2.5 py-1 rounded-lg bg-accent text-white font-bold text-xs hover:bg-accent-hover transition-colors shrink-0"
      >
        {t.merge.toolbar.undo}
      </button>
    </div>

    <!-- MAIN APP CONTAINER -->
    <main class="space-y-6">
      <!-- Cross-Link Banner to Image-to-PDF -->
      <aside class="p-3.5 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark shadow-xs flex items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2 text-secondary-light dark:text-secondary-dark min-w-0">
          <span class="text-base shrink-0">📷</span>
          <span class="truncate">
            {lang === 'ar' ? 'هل تريد تحويل صور أو مستندات مصورة إلى PDF أولاً؟' : lang === 'pt' ? 'Precisa converter fotos ou digitalizações em PDF?' : lang === 'id' ? 'Perlu mengubah foto atau dokumen pindaian jadi PDF?' : 'Need to convert photos or document scans to PDF?'}
          </span>
        </div>
        <a
          href={getLocalizedPath('/image-to-pdf', lang)}
          class="font-bold text-accent hover:underline inline-flex items-center gap-1 shrink-0"
        >
          <span>{lang === 'ar' ? 'تحويل الصور إلى PDF ←' : lang === 'pt' ? 'Imagem para PDF →' : lang === 'id' ? 'Gambar ke PDF →' : 'Try Image to PDF →'}</span>
        </a>
      </aside>

      <!-- 1. EMPTY STATE DROPZONE -->
      <section
        id="pdf-dropzone"
        class="group relative rounded-3xl border-2 border-dashed border-border-light dark:border-border-dark hover:border-accent dark:hover:border-accent bg-surface-light dark:bg-surface-dark p-8 sm:p-14 text-center cursor-pointer transition-all duration-200 shadow-sm hover:shadow-md focus:outline-none focus:ring-4 focus:ring-accent/20"
        tabindex="0"
        role="button"
        aria-label={t.merge.dropzone.title}
      >
        <div class="max-w-md mx-auto space-y-4 pointer-events-none">
          <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-3xl bg-accent/10 dark:bg-accent/20 flex items-center justify-center text-accent group-hover:scale-105 transition-transform duration-200 shadow-inner">
            <svg class="w-8 h-8 sm:w-10 sm:h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
          </div>

          <div class="space-y-1">
            <h2 class="text-lg sm:text-xl font-bold text-primary-light dark:text-primary-dark">
              {t.merge.dropzone.title}
            </h2>
            <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
              {t.merge.dropzone.subtitle}
            </p>
          </div>

          <div class="pt-2 flex flex-wrap items-center justify-center gap-3 pointer-events-auto">
            <button
              type="button"
              id="pdf-browse-btn"
              class="btn-primary inline-flex items-center gap-2 text-sm font-bold shadow-md shadow-accent/20 active:scale-95 transition-transform"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <span>{t.merge.dropzone.browseBtn}</span>
            </button>
          </div>

          <p class="text-[11px] sm:text-xs text-secondary-light/70 dark:text-secondary-dark/70">
            {t.merge.dropzone.pasteHint}
          </p>
        </div>
      </section>

      <!-- 2. WORKSPACE SECTION (Rendered when PDFs are loaded) -->
      <section id="pdf-workspace" class="hidden space-y-6">
        <!-- Top Toolbar & Global Actions -->
        <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark shadow-xs">
          <!-- Left: Add more files button -->
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="pdf-tb-add"
              class="btn-primary text-xs px-3.5 py-2 font-bold inline-flex items-center gap-1.5 shadow-xs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"/>
                <line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <span>{t.merge.toolbar.addMore}</span>
            </button>

            <!-- Mode Switcher: Normal vs Interleave -->
            <div class="inline-flex p-0.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-xs font-semibold" role="radiogroup" aria-label="Merge mode">
              <button
                type="button"
                id="pdf-mode-normal"
                class="px-2.5 py-1 rounded-lg text-white bg-accent font-bold transition-all shadow-xs"
                role="radio"
                aria-checked="true"
              >
                {t.merge.toolbar.modeNormal}
              </button>
              <button
                type="button"
                id="pdf-mode-interleave"
                class="px-2.5 py-1 rounded-lg text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark transition-all"
                role="radio"
                aria-checked="false"
                title={t.merge.toolbar.interleaveHint}
              >
                {t.merge.toolbar.modeInterleave}
              </button>
            </div>
          </div>

          <!-- Right: Sort & Reorder Actions -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <button
              type="button"
              id="pdf-tb-sort"
              class="px-2.5 py-1.5 rounded-xl border border-border-light dark:border-border-dark text-xs font-medium text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent/40 transition-colors"
              title={t.merge.toolbar.sortName}
            >
              🔤 <span class="hidden sm:inline">{t.merge.toolbar.sortName}</span>
            </button>

            <button
              type="button"
              id="pdf-tb-reverse"
              class="px-2.5 py-1.5 rounded-xl border border-border-light dark:border-border-dark text-xs font-medium text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent/40 transition-colors"
              title={t.merge.toolbar.reverseFiles}
            >
              ⇄ <span class="hidden sm:inline">{t.merge.toolbar.reverseFiles}</span>
            </button>

            <button
              type="button"
              id="pdf-tb-select-all"
              class="px-2.5 py-1.5 rounded-xl border border-border-light dark:border-border-dark text-xs font-medium text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent/40 transition-colors"
              title={t.merge.toolbar.selectAllPages}
            >
              ✓ <span class="hidden sm:inline">{t.merge.toolbar.selectAllPages}</span>
            </button>

            <button
              type="button"
              id="pdf-tb-clear"
              class="px-2.5 py-1.5 rounded-xl border border-rose-500/20 text-xs font-medium text-rose-500 hover:bg-rose-500/10 transition-colors"
              title={t.merge.toolbar.clearAll}
            >
              ✕ <span class="hidden sm:inline">{t.merge.toolbar.clearAll}</span>
            </button>
          </div>
        </div>

        <!-- Interleave Mode Banner (Visible when Interleave Mode is active) -->
        <div id="pdf-interleave-banner" class="hidden p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs flex items-center gap-2">
          <span class="text-base shrink-0">🔀</span>
          <span>{t.merge.toolbar.interleaveHint}</span>
        </div>

        <!-- Document Cards List (Drag & Drop Reordering) -->
        <div id="pdf-file-list" class="space-y-3" role="list">
          <!-- Dynamically populated by client script -->
        </div>

        <!-- Bottom Options Bar: Bookmarks & Live Totals -->
        <div class="p-4 sm:p-5 rounded-2xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark shadow-sm space-y-4">
          <!-- Bookmarks Checkbox Option -->
          <div class="flex items-center justify-between gap-3 text-xs sm:text-sm">
            <label class="inline-flex items-center gap-2.5 cursor-pointer select-none">
              <input
                type="checkbox"
                id="pdf-bookmarks-opt"
                checked
                class="w-4 h-4 rounded border-border-light dark:border-border-dark text-accent focus:ring-accent accent-accent cursor-pointer"
              />
              <span class="font-semibold text-primary-light dark:text-primary-dark">
                📑 {t.merge.toolbar.bookmarksToggle}
              </span>
            </label>
            <span class="text-xs text-secondary-light dark:text-secondary-dark">
              {lang === 'ar' ? 'فهرس الفصول' : lang === 'pt' ? 'Sumário interativo' : lang === 'id' ? 'Daftar isi interaktif' : 'Interactive outline'}
            </span>
          </div>

          <!-- Progress Bar (Visible during merge) -->
          <div id="pdf-progress-container" class="hidden space-y-2 pt-2 border-t border-border-light dark:border-border-dark">
            <div class="flex items-center justify-between text-xs font-semibold text-secondary-light dark:text-secondary-dark">
              <span id="pdf-progress-label">{t.merge.merge.preparing}</span>
              <span id="pdf-progress-pct">0%</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
              <div
                id="pdf-progress-bar"
                class="h-full bg-accent rounded-full transition-all duration-200"
                style="width: 0%"
              ></div>
            </div>
          </div>

          <!-- Big Merge & Download Button -->
          <div class="pt-2">
            <button
              type="button"
              id="pdf-merge-btn"
              class="w-full btn-primary py-3.5 sm:py-4 px-6 text-sm sm:text-base font-extrabold shadow-lg shadow-accent/25 flex items-center justify-center gap-2 active:scale-[0.99] transition-transform"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="12" y1="18" x2="12" y2="12"/>
                <line x1="9" y1="15" x2="15" y2="15"/>
              </svg>
              <span id="pdf-merge-btn-text">{t.merge.merge.btnDisabled}</span>
            </button>
          </div>
        </div>
      </section>

      <!-- 3. SUCCESS / MERGED PREVIEW SECTION (Rendered after successful merge) -->
      <section id="pdf-preview-section" class="hidden space-y-6">
        <div class="p-6 sm:p-8 rounded-3xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark shadow-md text-center space-y-6">
          <div class="w-16 h-16 mx-auto rounded-3xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>

          <div class="space-y-1.5">
            <h2 class="text-xl sm:text-2xl font-bold text-primary-light dark:text-primary-dark">
              {t.merge.preview.title}
            </h2>
            <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark">
              {t.merge.preview.subtitle}
            </p>
            <p id="pdf-preview-stats" class="text-xs font-semibold text-accent pt-1"></p>
          </div>

          <!-- Merged First Page Thumbnail Container -->
          <div class="max-w-xs mx-auto p-3 rounded-2xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark shadow-inner">
            <div class="relative aspect-[1/1.3] w-full rounded-xl overflow-hidden bg-slate-200 dark:bg-slate-800 flex items-center justify-center">
              <canvas id="pdf-output-canvas" class="max-w-full max-h-full object-contain shadow-xs"></canvas>
            </div>
            <p class="text-[11px] text-secondary-light dark:text-secondary-dark mt-2">
              {lang === 'ar' ? 'معاينة الصفحة الأولى من المستند المدمج' : lang === 'pt' ? 'Prévia da primeira página do arquivo combinado' : lang === 'id' ? 'Pratinjau halaman pertama dokumen gabungan' : 'First page preview of merged document'}
            </p>
          </div>

          <!-- Download Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2 max-w-md mx-auto">
            <button
              type="button"
              id="pdf-download-again-btn"
              class="w-full sm:w-auto btn-primary py-3 px-6 text-sm font-bold shadow-md shadow-accent/20 inline-flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>{t.merge.preview.downloadBtn}</span>
            </button>

            <button
              type="button"
              id="pdf-back-edit-btn"
              class="w-full sm:w-auto px-5 py-3 rounded-xl border border-border-light dark:border-border-dark hover:bg-slate-100 dark:hover:bg-slate-800 text-xs sm:text-sm font-bold text-secondary-light dark:text-secondary-dark transition-colors inline-flex items-center justify-center gap-1.5"
            >
              <span>←</span>
              <span>{t.merge.preview.backToEdit}</span>
            </button>
          </div>
        </div>
      </section>
    </main>

    <!-- PAGE SELECTION MODAL -->
    <div
      id="pdf-page-modal"
      class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 overflow-y-auto transition-opacity duration-200"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pdf-modal-title"
    >
      <div class="relative w-full max-w-2xl bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark rounded-3xl shadow-2xl p-5 sm:p-6 space-y-5 max-h-[90vh] flex flex-col my-auto">
        <!-- Modal Header -->
        <div class="flex items-start justify-between gap-3 border-b border-border-light dark:border-border-dark pb-3.5">
          <div class="space-y-1 min-w-0">
            <h3 id="pdf-modal-title" class="text-base sm:text-lg font-bold text-primary-light dark:text-primary-dark truncate">
              {t.merge.modal.title}
            </h3>
            <p class="text-xs text-secondary-light dark:text-secondary-dark">
              {t.merge.modal.subtitle}
            </p>
          </div>
          <button
            type="button"
            id="pdf-modal-close-x"
            class="p-1.5 rounded-xl border border-border-light dark:border-border-dark hover:bg-slate-100 dark:hover:bg-slate-800 text-secondary-light dark:text-secondary-dark transition-colors"
            aria-label={t.merge.modal.close}
          >
            ✕
          </button>
        </div>

        <!-- Range Input Field with Bi-directional Sync -->
        <div class="space-y-1.5">
          <label for="pdf-modal-range-input" class="text-xs font-semibold text-primary-light dark:text-primary-dark flex items-center justify-between">
            <span>{t.merge.modal.rangeLabel}</span>
            <span id="pdf-modal-selected-count" class="text-accent font-bold"></span>
          </label>
          <div class="relative">
            <input
              type="text"
              id="pdf-modal-range-input"
              class="input-base w-full text-xs sm:text-sm px-3.5 py-2.5 rounded-xl"
              placeholder={t.merge.modal.rangePlaceholder}
              aria-label={t.merge.modal.rangeLabel}
            />
          </div>
        </div>

        <!-- Modal Quick Actions -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs">
          <button
            type="button"
            id="pdf-modal-select-all"
            class="px-2.5 py-1 rounded-lg border border-border-light dark:border-border-dark hover:bg-slate-100 dark:hover:bg-slate-800 font-medium"
          >
            {t.merge.modal.selectAll}
          </button>
          <button
            type="button"
            id="pdf-modal-select-none"
            class="px-2.5 py-1 rounded-lg border border-border-light dark:border-border-dark hover:bg-slate-100 dark:hover:bg-slate-800 font-medium"
          >
            {t.merge.modal.selectNone}
          </button>
          <button
            type="button"
            id="pdf-modal-invert"
            class="px-2.5 py-1 rounded-lg border border-border-light dark:border-border-dark hover:bg-slate-100 dark:hover:bg-slate-800 font-medium"
          >
            {t.merge.modal.invert}
          </button>
          <button
            type="button"
            id="pdf-modal-rotate-selected"
            class="px-2.5 py-1 rounded-lg border border-border-light dark:border-border-dark hover:text-accent font-medium inline-flex items-center gap-1"
          >
            <span>⟳</span>
            <span>{t.merge.modal.rotateSelected}</span>
          </button>
          <button
            type="button"
            id="pdf-modal-reverse-order"
            class="px-2.5 py-1 rounded-lg border border-border-light dark:border-border-dark hover:text-accent font-medium inline-flex items-center gap-1"
          >
            <span>⇄</span>
            <span>{t.merge.modal.reverseOrder}</span>
          </button>
        </div>

        <!-- Page Thumbnails Scrollable Grid -->
        <div
          id="pdf-modal-grid"
          class="flex-1 overflow-y-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 p-1 min-h-[160px]"
        >
          <!-- Dynamically populated page cards with thumbnails -->
        </div>

        <!-- Modal Footer -->
        <div class="border-t border-border-light dark:border-border-dark pt-3 flex items-center justify-end gap-2">
          <button
            type="button"
            id="pdf-modal-done-btn"
            class="btn-primary py-2 px-5 text-xs sm:text-sm font-bold shadow-xs cursor-pointer"

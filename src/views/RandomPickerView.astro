---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import HistoryCard from '../components/HistoryCard.astro';
import { getLocalizedRelatedLinks } from '../i18n/relatedLinks';
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const picker = getNamespace(lang, 'picker');
const errors = getNamespace(lang, 'errors');
const faqNs = getNamespace(lang, 'faq');
const t = { picker, common, errors, nav: common.nav, siteName: common.siteName };

const localeCode = lang === 'ar' ? 'ar-EG' : lang === 'pt' ? 'pt-BR' : lang === 'id' ? 'id-ID' : 'en-US';
const lastUpdatedDate = new Date().toLocaleDateString(localeCode, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Comprehensive Localized FAQ definitions
const faqs = (faqNs.picker || []).map((f: any) => ({
  question: f.question || f.q,
  answer: f.answer || f.a,
}));

const relatedTools = getLocalizedRelatedLinks(lang, 'random-picker');

// JSON-LD Schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `https://toolnest.pages.dev${getLocalizedPath('/random-picker', lang)}#app`,
  name: t.picker.title,
  url: `https://toolnest.pages.dev${getLocalizedPath('/random-picker', lang)}`,
  description: t.picker.subtitle,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ToolNest',
    url: 'https://toolnest.pages.dev',
  },
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t.picker.howTo.title,
  description: t.picker.howTo.subtitle,
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: t.picker.howTo.s1Title,
      text: t.picker.howTo.s1Desc,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: t.picker.howTo.s2Title,
      text: t.picker.howTo.s2Desc,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: t.picker.howTo.s3Title,
      text: t.picker.howTo.s3Desc,
    },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<Base
  metaKey="picker"
  canonicalPath={getLocalizedPath('/random-picker', lang)}
  ogImage="/og/random-picker.svg"
  breadcrumbs={[{ name: common.nav.home, item: getLocalizedPath('/', lang) }, { name: common.nav.randomPicker, item: getLocalizedPath('/random-picker', lang) }]}
  extraSchemas={[webAppSchema, howToSchema, faqSchema]}
  lang={lang}
>
  <!-- CDN Confetti Loader for Winner Celebration -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js"></script>

  <!-- Page Header -->
  <header class="text-center py-4 sm:py-6 space-y-3">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent dark:bg-accent/20">
      <span>🎯</span>
      <span>{t.picker.ui?.cryptoSortition || 'Cryptographically Fair Randomizer'}</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-primary-light dark:text-primary-dark">
      {t.picker.title}
    </h1>
    <p class="text-base text-secondary-light dark:text-secondary-dark max-w-lg mx-auto leading-relaxed">
      {t.picker.subtitle}
    </p>
  </header>

  <!-- KEY TAKEAWAYS -->
  <aside class="card mt-4 p-4 sm:p-5 border-l-4 border-accent bg-accent/5 space-y-2" aria-label="Key Takeaways">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-accent">
      <span>⚡</span>
      <span>{t.picker.ui?.keyTakeawaysTitle || 'Quick Answer & Key Takeaways'}</span>
    </div>
    <ul class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark space-y-1.5 list-disc list-inside leading-relaxed">
      <li>{t.picker.ui?.kt1}</li>
      <li>{t.picker.ui?.kt2}</li>
      <li>{t.picker.ui?.kt3}</li>
    </ul>
  </aside>

  <!-- MAIN INPUT CARD -->
  <section class="card mt-6 space-y-5" aria-labelledby="picker-input-heading">
    <div class="flex items-center justify-between border-b border-border-light dark:border-border-dark pb-3">
      <h2 id="picker-input-heading" class="text-base font-bold text-primary-light dark:text-primary-dark">
        {t.picker.ui?.pasteListLabel || t.picker.itemsLabel || 'Enter Items or Names'}
      </h2>
      <button
        id="clear-input-btn"
        type="button"
        class="text-xs text-secondary-light dark:text-secondary-dark hover:text-error transition-colors cursor-pointer"
      >
        {t.picker.ui?.clearListBtn || 'Clear List'}
      </button>
    </div>

    <!-- Textarea Area -->
    <div class="space-y-2">
      <label for="items-textarea" class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
        {t.picker.itemsLabel || 'One entry per line or comma-separated:'}
      </label>
      <textarea
        id="items-textarea"
        rows="7"
        class="input-base text-base font-normal resize-y min-h-[140px] leading-relaxed"
        placeholder="Alice&#10;Bob&#10;Charlie&#10;Diana&#10;Evan&#10;Fiona"
        aria-describedby="items-counter-status duplicate-warning"
      >Alice
Bob
Charlie
Diana
Evan
Fiona</textarea>
    </div>

    <!-- Status Bar: Item Count & Duplicate Warnings -->
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs" id="items-counter-status">
      <div class="flex items-center gap-2">
        <span class="font-bold text-primary-light dark:text-primary-dark" id="items-count-display">
          6 items (6 unique)
        </span>
      </div>

      <!-- Duplicate Alert with Quick-Fix Button -->
      <div id="duplicate-warning" class="hidden items-center gap-2 text-amber-600 dark:text-amber-400 font-medium">
        <span id="duplicate-count-text">0 duplicates</span>
        <button
          id="remove-duplicates-btn"
          type="button"
          class="underline font-bold hover:text-primary-light dark:hover:text-primary-dark cursor-pointer"
        >
          {t.picker.ui?.removeDuplicatesBtn || 'Remove duplicates'}
        </button>
      </div>
    </div>

    <!-- Settings & Controls Grid -->
    <div class="pt-3 border-t border-border-light dark:border-border-dark grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Winner Count Stepper -->
      <div class="space-y-1.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {t.picker.ui?.numWinners || t.picker.numWinners || 'Number of Winners'}
        </label>
        <div class="flex items-center gap-3">
          <div class="inline-flex items-center rounded-xl border border-border-light dark:border-border-dark bg-input-light dark:bg-input-dark p-1">
            <button
              id="stepper-minus-btn"
              type="button"
              class="w-10 h-10 flex items-center justify-center rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark font-bold text-base text-primary-light dark:text-primary-dark hover:border-accent active:scale-95 transition-all cursor-pointer select-none"
              aria-label="Decrease winners"
            >
              −
            </button>
            <span
              id="winners-count-display"
              class="w-12 text-center text-base font-extrabold text-primary-light dark:text-primary-dark"
              aria-live="polite"
            >
              1
            </span>
            <button
              id="stepper-plus-btn"
              type="button"
              class="w-10 h-10 flex items-center justify-center rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark font-bold text-base text-primary-light dark:text-primary-dark hover:border-accent active:scale-95 transition-all cursor-pointer select-none"
              aria-label="Increase winners"
            >
              +
            </button>
          </div>
          <span class="text-xs text-secondary-light dark:text-secondary-dark" id="stepper-hint">
            {lang === 'ar' ? 'الحد الأقصى 10' : lang === 'pt' ? 'Máx 10' : lang === 'id' ? 'Maks 10' : 'Max 10'}
          </span>
        </div>
      </div>

      <!-- Toggles Column -->
      <div class="space-y-2.5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {lang === 'ar' ? 'خيارات السحب' : lang === 'pt' ? 'Opções de Sorteio' : lang === 'id' ? 'Opsi Undian' : 'Pick Options'}
        </label>

        <!-- Toggle: Remove winners after pick -->
        <label class="flex items-center gap-2.5 cursor-pointer min-h-[36px] select-none">
          <input
            type="checkbox"
            id="toggle-remove-winners"
            class="sr-only peer"
          />
          <div class="w-9 h-5 bg-border-light dark:bg-border-dark peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent relative"></div>
          <span class="text-xs sm:text-sm font-medium text-primary-light dark:text-primary-dark">
            {t.picker.ui?.removeWinnerAfterPick || 'Remove winners after pick'}
          </span>
        </label>

        <!-- Toggle: Case-insensitive duplicates -->
        <label class="flex items-center gap-2.5 cursor-pointer min-h-[36px] select-none">
          <input
            type="checkbox"
            id="toggle-case-insensitive"
            checked
            class="sr-only peer"
          />
          <div class="w-9 h-5 bg-border-light dark:bg-border-dark peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-accent relative"></div>
          <span class="text-xs sm:text-sm font-medium text-primary-light dark:text-primary-dark">
            {lang === 'ar' ? 'تجاهل حالة الأحرف للمكررات' : lang === 'pt' ? 'Ignorar maiúsculas/minúsculas' : lang === 'id' ? 'Abaikan huruf besar/kecil' : 'Case-insensitive duplicates'}
          </span>
        </label>
      </div>
    </div>

    <!-- Actions Row -->
    <div class="pt-3 border-t border-border-light dark:border-border-dark flex flex-col sm:flex-row items-center gap-3">
      <button
        id="shuffle-list-btn"
        type="button"
        class="btn-secondary w-full sm:w-auto py-3 px-5 text-xs sm:text-sm font-semibold gap-1.5 cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"/>
          <line x1="4" y1="20" x2="21" y2="3"/>
          <polyline points="21 16 21 21 16 21"/>
          <line x1="15" y1="15" x2="21" y2="21"/>
          <line x1="4" y1="4" x2="9" y2="9"/>
        </svg>
        <span>{t.picker.ui?.shuffleListBtn || 'Shuffle List'}</span>
      </button>

      <button
        id="pick-winner-btn"
        type="button"
        class="btn-primary w-full sm:w-auto sm:px-8 py-3.5 text-base font-bold shadow-md shadow-accent/20 cursor-pointer"
      >
        {t.picker.ui?.pickWinnerBtn || t.picker.pickWinnerBtn || 'Pick Winner(s)'}
      </button>
    </div>

    <!-- Sticky Mobile Button -->
    <div class="sm:hidden fixed bottom-3 inset-x-4 z-30 pb-[calc(0.5rem+env(safe-area-inset-bottom,0))]">
      <button
        id="mobile-pick-winner-btn"
        type="button"
        class="btn-primary w-full py-3.5 text-base font-bold shadow-xl shadow-accent/25 flex items-center justify-center gap-2 cursor-pointer"
        style="touch-action: manipulation;"
      >
        <span>🎯</span>
        <span>{t.picker.ui?.pickWinnerBtn || t.picker.pickWinnerBtn || 'PICK WINNER(S)'}</span>
      </button>
    </div>
  </section>

  <!-- RESULTS SECTION -->
  <section
    id="results-section"
    class="hidden mt-8 card space-y-6 text-center scroll-mt-20"
    aria-live="polite"
    aria-labelledby="results-heading"
  >
    <div class="space-y-1">
      <div class="text-3xl sm:text-4xl animate-bounce" id="results-icon">🎉</div>
      <h2 id="results-heading" class="text-xs uppercase tracking-wider font-semibold text-secondary-light dark:text-secondary-dark">
        {lang === 'ar' ? 'الفائز (الفائزون) المختار' : lang === 'pt' ? 'Vencedor(es) Selecionado(s)' : lang === 'id' ? 'Pemenang Terpilih' : 'Selected Winner(s)'}
      </h2>
    </div>

    <!-- Shuffling Cycling Animation Box -->
    <div
      id="shuffle-animation-box"
      class="hidden py-6 rounded-2xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark"
    >
      <div class="text-xs text-secondary-light dark:text-secondary-dark mb-1">
        {lang === 'ar' ? 'جارٍ السحب بإنتروبيا تشفيرية...' : lang === 'pt' ? 'Sorteando com entropia criptográfica...' : lang === 'id' ? 'Mengundi dengan entropi kriptografi...' : 'Drawing with cryptographic entropy...'}
      </div>
      <div
        id="cycling-name-display"
        class="text-2xl sm:text-3xl font-black text-accent tracking-tight animate-pulse truncate max-w-sm mx-auto px-4"
      >
        {lang === 'ar' ? 'جارٍ الاختيار...' : lang === 'pt' ? 'Selecionando...' : lang === 'id' ? 'Memilih...' : 'Selecting...'}
      </div>
    </div>

    <!-- Final Winners Container -->
    <div id="final-winners-box" class="space-y-4">
      <div id="winners-list" class="flex flex-col items-center gap-2.5">
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
        <button
          id="copy-winners-btn"
          type="button"
          class="btn-primary py-2.5 px-5 text-xs sm:text-sm font-semibold gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span>{common.buttons.copy || 'Copy Winner(s)'}</span>
        </button>

        <button
          id="share-winners-btn"
          type="button"
          class="btn-secondary py-2.5 px-5 text-xs sm:text-sm font-semibold gap-1.5 cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
            <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
          </svg>
          <span>{common.buttons.share || common.share || 'Share'}</span>
        </button>

        <button
          id="pick-again-btn"
          type="button"
          class="btn-secondary py-2.5 px-5 text-xs sm:text-sm font-semibold cursor-pointer"
        >
          {lang === 'ar' ? 'السحب مرة أخرى' : lang === 'pt' ? 'Sortear Novamente' : lang === 'id' ? 'Undi Lagi' : 'Pick Again'}
        </button>
      </div>

      <p id="remaining-count-notice" class="text-xs text-secondary-light dark:text-secondary-dark italic pt-1 hidden"></p>
    </div>
  </section>

  <!-- Recent Activity History Card -->
  <div class="mt-8">
    <HistoryCard toolId="picker" title={lang === 'ar' ? 'عمليات السحب الأخيرة' : lang === 'pt' ? 'Sorteios Recentes' : lang === 'id' ? 'Undian Terakhir' : 'Recent Draws'} icon="🎲" lang={lang} />
  </div>

  <!-- WINNER REVEAL MODAL DIALOG -->
  <div
    id="winner-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-winner-title"
  >
    <div
      class="w-full max-w-sm rounded-3xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark p-6 sm:p-8 text-center space-y-5 shadow-2xl transform scale-95 transition-transform duration-200"
      id="modal-card"
    >
      <div class="w-14 h-14 mx-auto rounded-2xl bg-accent/10 text-accent flex items-center justify-center animate-bounce shadow-sm">
        <span class="text-3xl">🎉</span>
      </div>

      <div class="space-y-1.5">
        <span id="modal-winner-title" class="text-xs uppercase tracking-wider font-semibold text-secondary-light dark:text-secondary-dark block">
          {lang === 'ar' ? 'تم اختيار الفائز!' : lang === 'pt' ? 'Vencedor Selecionado!' : lang === 'id' ? 'Pemenang Terpilih!' : 'Winner Selected!'}
        </span>
        <div id="modal-winner-list" class="space-y-2 pt-1 max-h-48 overflow-y-auto custom-scrollbar">
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-col gap-2 pt-2">
        <button
          id="modal-pick-again-btn"
          type="button"
          class="btn-primary w-full py-3 text-sm font-bold shadow-md shadow-accent/20 cursor-pointer"
        >
          {lang === 'ar' ? 'السحب مرة أخرى 🎯' : lang === 'pt' ? 'Sortear Novamente 🎯' : lang === 'id' ? 'Undi Lagi 🎯' : 'Pick Again 🎯'}
        </button>

        <div class="flex gap-2">
          <button
            id="modal-copy-btn"
            type="button"
            class="btn-secondary flex-1 py-2.5 text-xs font-semibold cursor-pointer"
          >
            {common.buttons.copy || 'Copy'}
          </button>
          <button
            id="modal-share-btn"
            type="button"
            class="btn-secondary flex-1 py-2.5 text-xs font-semibold cursor-pointer"
          >
            {common.buttons.share || common.share || 'Share'}
          </button>
        </div>

        <button
          id="modal-close-btn"
          type="button"
          class="text-xs text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark pt-1 cursor-pointer"
        >
          {common.buttons.cancel || 'Close'}
        </button>
      </div>
    </div>
  </div>

  <!-- HOW TO USE -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark space-y-10">
    <div class="space-y-4">
      <div class="space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
          {t.picker.howTo.title}
        </h2>
        <p class="text-sm text-secondary-light dark:text-secondary-dark">
          {t.picker.howTo.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card space-y-2 p-5">
          <div class="w-8 h-8 rounded-xl bg-accent text-white flex items-center justify-center text-sm font-bold shadow-sm">
            1
          </div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            {t.picker.howTo.s1Title}
          </h3>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.howTo.s1Desc}
          </p>
        </div>

        <div class="card space-y-2 p-5">
          <div class="w-8 h-8 rounded-xl bg-accent text-white flex items-center justify-center text-sm font-bold shadow-sm">
            2
          </div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            {t.picker.howTo.s2Title}
          </h3>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.howTo.s2Desc}
          </p>
        </div>

        <div class="card space-y-2 p-5">
          <div class="w-8 h-8 rounded-xl bg-accent text-white flex items-center justify-center text-sm font-bold shadow-sm">
            3
          </div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">
            {t.picker.howTo.s3Title}
          </h3>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.howTo.s3Desc}
          </p>
        </div>
      </div>
    </div>

    <!-- Methodology -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card p-6 space-y-3">
        <h2 class="text-lg font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
          <span>🔒</span>
          <span>{t.picker.methodology.m1Title}</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
          {t.picker.methodology.m1Desc}
        </p>
      </div>

      <div class="card p-6 space-y-3">
        <h2 class="text-lg font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
          <span>👥</span>
          <span>{t.picker.methodology.m2Title}</span>
        </h2>
        <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
          {t.picker.methodology.m2Desc}
        </p>
      </div>
    </div>

    <!-- USE CASES SECTION -->
    <section class="space-y-4" aria-labelledby="use-cases-heading">
      <h2 id="use-cases-heading" class="text-lg sm:text-xl font-bold text-primary-light dark:text-primary-dark flex items-center gap-2">
        <span>💡</span>
        <span>{t.picker.useCases.title}</span>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card p-5 space-y-2">
          <div class="text-2xl">👩‍🏫</div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">{t.picker.useCases.u1Title}</h3>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.useCases.u1Desc}
          </p>
        </div>
        <div class="card p-5 space-y-2">
          <div class="text-2xl">🎟️</div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">{t.picker.useCases.u2Title}</h3>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.useCases.u2Desc}
          </p>
        </div>
        <div class="card p-5 space-y-2">
          <div class="text-2xl">⚽</div>
          <h3 class="text-base font-bold text-primary-light dark:text-primary-dark">{t.picker.useCases.u3Title}</h3>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.useCases.u3Desc}
          </p>
        </div>
      </div>
    </section>

    <!-- DID YOU KNOW? FACT STRIP -->
    <section class="card p-5 sm:p-6 border-accent/20 bg-accent/5 space-y-3" aria-labelledby="trivia-strip-heading">
      <div class="flex items-center gap-2">
        <span class="text-lg">🧠</span>
        <h2 id="trivia-strip-heading" class="text-sm font-bold uppercase tracking-wider text-accent">
          {t.picker.trivia.title}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-1">
        <div class="space-y-1">
          <span class="text-xs font-bold text-primary-light dark:text-primary-dark flex items-center gap-1.5">
            <span>🔐</span> {t.picker.trivia.t1Title}
          </span>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.trivia.t1Desc}
          </p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-bold text-primary-light dark:text-primary-dark flex items-center gap-1.5">
            <span>🏛️</span> {t.picker.trivia.t2Title}
          </span>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.trivia.t2Desc}
          </p>
        </div>
        <div class="space-y-1">
          <span class="text-xs font-bold text-primary-light dark:text-primary-dark flex items-center gap-1.5">
            <span>🔀</span> {t.picker.trivia.t3Title}
          </span>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {t.picker.trivia.t3Desc}
          </p>
        </div>
      </div>
    </section>

    <!-- Methodology & Entropy Guarantee (E-E-A-T) -->
    <div class="card p-5 border-border-light dark:border-border-dark space-y-2 bg-bg-light/50 dark:bg-bg-dark/50">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark flex items-center gap-1.5">
          <span>📐</span>
          <span>{t.picker.methodology.noteTitle}</span>
        </h3>
        <span class="text-[11px] text-secondary-light dark:text-secondary-dark">
          {common.ui?.lastUpdated || 'Last updated'}: {lastUpdatedDate}
        </span>
      </div>
      <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
        {t.picker.methodology.noteDesc}
      </p>
    </div>
  </section>

  <!-- COMMON QUESTIONS QUICK-JUMP BAR -->
  <section class="mt-12 space-y-3" id="faq-section">
    <div class="card p-4 space-y-2.5 bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark">
          {common.ui?.quickJump || 'Quick Jump'}
        </span>
        <span class="text-xs text-accent font-medium">{faqs.length} {common.ui?.answers || 'Answers'}</span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {faqs.map((faq, idx) => (
          <a
            href={`#faq-item-${idx + 1}`}
            class="text-xs px-2.5 py-1 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:text-accent hover:border-accent transition-colors"
          >
            {faq.question}
          </a>
        ))}
      </div>
    </div>

    <!-- FAQ SECTION ACCORDION -->
    <Faq items={faqs} lang={lang} />
  </section>

  <!-- RELATED TOOLS SECTION -->
  <section class="mt-14 pt-10 border-t border-border-light dark:border-border-dark space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-lg sm:text-xl font-bold tracking-tight text-primary-light dark:text-primary-dark">
        {common.headings?.relatedTools || 'Related Free Tools'}
      </h2>
      <a href={getLocalizedPath('/', lang)} class="text-xs font-semibold text-accent hover:underline">
        {common.links?.viewAllTools || 'View all tools'} &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {relatedTools.map((tool) => (
        <ToolCard
          title={tool.name}
          description={tool.desc}
          href={tool.href}
          anchor={tool.anchor}
          icon={tool.href.includes('compressor') ? 'image' : tool.href.includes('converter') ? 'convert' : tool.href.includes('countdown') ? 'clock' : 'calendar'}
          lang={lang}
        />
      ))}
    </div>
  </section>

  <!-- Toast notification handled globally via src/components/Toast.astro and src/scripts/toast.js -->
  <script is:inline define:vars={{ pickerI18n: { common, picker, errors }, pageLang: lang }}>
    window.__PICKER_I18N__ = pickerI18n;
    window.__PAGE_LANG__ = pageLang;
  </script>
</Base>

<script>
  import {
    parseItems,
    analyzeDuplicates,
    pickWinners,
    shuffleList,
    removeWinnersFromText,
  } from '../scripts/random-picker.js';
  import {
    saveHistory,
    saveLastState,
    getLastState,
    initHistoryCard,
  } from '../scripts/history.js';
  import { showToast } from '../scripts/toast.js';

  function initRandomPicker() {
    const i18n = (window as any).__PICKER_I18N__ || {};
    const tPicker = i18n.picker || {};
    const tCommon = i18n.common || {};
    const tErrors = i18n.errors || {};

    const textarea = document.getElementById('items-textarea') as HTMLTextAreaElement;
    const clearBtn = document.getElementById('clear-input-btn');
    const countDisplay = document.getElementById('items-count-display');
    const duplicateWarning = document.getElementById('duplicate-warning');
    const duplicateCountText = document.getElementById('duplicate-count-text');
    const removeDuplicatesBtn = document.getElementById('remove-duplicates-btn');
    const stepperMinus = document.getElementById('stepper-minus-btn');
    const stepperPlus = document.getElementById('stepper-plus-btn');
    const winnersCountDisplay = document.getElementById('winners-count-display');
    const toggleRemoveWinners = document.getElementById('toggle-remove-winners') as HTMLInputElement;
    const toggleCaseInsensitive = document.getElementById('toggle-case-insensitive') as HTMLInputElement;
    const shuffleListBtn = document.getElementById('shuffle-list-btn');
    const pickBtn = document.getElementById('pick-winner-btn') as HTMLButtonElement;
    const mobilePickBtn = document.getElementById('mobile-pick-winner-btn') as HTMLButtonElement;

    // Results Elements
    const resultsSection = document.getElementById('results-section');
    const shuffleAnimBox = document.getElementById('shuffle-animation-box');
    const cyclingNameDisplay = document.getElementById('cycling-name-display');
    const finalWinnersBox = document.getElementById('final-winners-box');
    const winnersList = document.getElementById('winners-list');
    const copyWinnersBtn = document.getElementById('copy-winners-btn');
    const shareWinnersBtn = document.getElementById('share-winners-btn');
    const pickAgainBtn = document.getElementById('pick-again-btn');
    const remainingCountNotice = document.getElementById('remaining-count-notice');

    // Modal Elements
    const winnerModal = document.getElementById('winner-modal');
    const modalCard = document.getElementById('modal-card');
    const modalWinnerList = document.getElementById('modal-winner-list');
    const modalPickAgainBtn = document.getElementById('modal-pick-again-btn');
    const modalCopyBtn = document.getElementById('modal-copy-btn');
    const modalShareBtn = document.getElementById('modal-share-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');

    if (!textarea || !pickBtn) return;

    let winnersCount = 1;
    let isPicking = false;
    let currentWinners: string[] = [];

    function updateCounts() {
      const rawText = textarea.value;
      const items = parseItems(rawText);
      const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
      const analysis = analyzeDuplicates(items, isCaseInsensitive);

      if (countDisplay) {
        countDisplay.textContent = `${analysis.totalCount} items (${analysis.uniqueCount} unique)`;
      }

      if (duplicateWarning && duplicateCountText) {
        if (analysis.duplicateCount > 0) {
          duplicateCountText.textContent = `${analysis.duplicateCount} duplicates`;
          duplicateWarning.classList.remove('hidden');
          duplicateWarning.classList.add('flex');
        } else {
          duplicateWarning.classList.add('hidden');
          duplicateWarning.classList.remove('flex');
        }
      }

      const maxAllowed = Math.max(1, Math.min(10, analysis.uniqueCount || 1));
      if (winnersCount > maxAllowed) {
        winnersCount = maxAllowed;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }
    }

    textarea.addEventListener('input', updateCounts);
    if (toggleCaseInsensitive) toggleCaseInsensitive.addEventListener('change', updateCounts);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (isPicking) return;
        textarea.value = '';
        updateCounts();
        textarea.focus();
        showToast(tPicker.toasts?.itemsCleared || 'List cleared.');
      });
    }

    if (removeDuplicatesBtn) {
      removeDuplicatesBtn.addEventListener('click', () => {
        if (isPicking) return;
        const items = parseItems(textarea.value);
        const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
        const analysis = analyzeDuplicates(items, isCaseInsensitive);
        textarea.value = analysis.unique.join('\n');
        updateCounts();
        showToast(tPicker.toasts?.duplicatesRemoved || `Removed ${analysis.duplicateCount} duplicates.`);
      });
    }

    if (stepperMinus) {
      stepperMinus.addEventListener('click', () => {
        if (isPicking) return;
        if (winnersCount > 1) {
          winnersCount--;
          if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
        }
      });
    }

    if (stepperPlus) {
      stepperPlus.addEventListener('click', () => {
        if (isPicking) return;
        const items = parseItems(textarea.value);
        const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
        const analysis = analyzeDuplicates(items, isCaseInsensitive);
        const maxAllowed = Math.min(10, analysis.uniqueCount || 1);

        if (winnersCount < maxAllowed) {
          winnersCount++;
          if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
        } else {
          showToast(tPicker.emptyError || `Max ${maxAllowed} winners.`);
        }
      });
    }

    if (shuffleListBtn) {
      shuffleListBtn.addEventListener('click', () => {
        if (isPicking) return;
        const items = parseItems(textarea.value);
        if (items.length < 2) {
          showToast(tPicker.emptyError || 'Add at least 2 items to shuffle.');
          return;
        }
        const shuffled = shuffleList(items);
        textarea.value = shuffled.join('\n');
        updateCounts();
        showToast(tCommon.toasts?.loaded || 'List shuffled.');
      });
    }

    function handlePick() {
      if (isPicking) return;
      const rawText = textarea.value;
      const items = parseItems(rawText);
      const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
      const analysis = analyzeDuplicates(items, isCaseInsensitive);

      if (analysis.uniqueCount === 0) {
        showToast(tErrors.requiredField || 'Please enter at least one item.');
        return;
      }

      if (winnersCount > analysis.uniqueCount) {
        winnersCount = analysis.uniqueCount;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }

      isPicking = true;
      pickBtn.setAttribute('disabled', 'true');
      if (mobilePickBtn) mobilePickBtn.setAttribute('disabled', 'true');

      if (resultsSection) resultsSection.classList.remove('hidden');
      if (shuffleAnimBox) shuffleAnimBox.classList.remove('hidden');
      if (finalWinnersBox) finalWinnersBox.classList.add('hidden');

      resultsSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      let interval = 70;
      const duration = 1400;
      const startTime = performance.now();
      const pool = analysis.unique;

      function cycleStep() {
        const elapsed = performance.now() - startTime;
        const randomIdx = Math.floor(Math.random() * pool.length);
        if (cyclingNameDisplay) {
          cyclingNameDisplay.textContent = pool[randomIdx];
        }

        if (elapsed < duration) {
          interval += 12;
          setTimeout(cycleStep, interval);
        } else {
          const winners = pickWinners(pool, winnersCount);
          currentWinners = winners;
          finishPick(winners, analysis.uniqueCount);
        }
      }

      cycleStep();
    }

    function finishPick(winners: string[], totalUnique: number) {
      if (shuffleAnimBox) shuffleAnimBox.classList.add('hidden');
      if (finalWinnersBox) finalWinnersBox.classList.remove('hidden');

      if (winnersList) {
        winnersList.innerHTML = winners
          .map((w, idx) => {
            const numBadge =
              winners.length > 1
                ? `<span class="w-6 h-6 rounded-full bg-accent/15 text-accent text-xs font-black flex items-center justify-center shrink-0">#${idx + 1}</span>`
                : '';
            return `
            <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-surface-light dark:bg-surface-dark border-2 border-accent/40 shadow-lg text-lg sm:text-xl font-extrabold text-primary-light dark:text-primary-dark">
              ${numBadge}
              <span class="tracking-tight text-accent break-all">${w}</span>
            </div>
          `;
          })
          .join('');
      }

      if (modalWinnerList && winnerModal && modalCard) {
        modalWinnerList.innerHTML = winners
          .map((w, idx) => {
            const prefix = winners.length > 1 ? `#${idx + 1} ` : '';
            return `<div class="p-3 rounded-2xl bg-accent/10 dark:bg-accent/15 border border-accent/30 font-black text-base sm:text-lg text-accent break-all">${prefix}${w}</div>`;
          })
          .join('');

        winnerModal.classList.remove('opacity-0', 'pointer-events-none');
        winnerModal.classList.add('opacity-100', 'pointer-events-auto');
        modalCard.classList.remove('scale-95');
        modalCard.classList.add('scale-100');
        if (modalPickAgainBtn) modalPickAgainBtn.focus();
      }

      const safeRaw = textarea.value.length > 5000 ? textarea.value.slice(0, 5000) : textarea.value;

      saveHistory('picker', {
        t: `${tPicker.title || 'Picker'}: ${winners.join(', ')}`,
        d: new Date().toISOString(),
        x: {
          rawInput: safeRaw,
          winnerCount: winnersCount,
          removeWinners: toggleRemoveWinners ? toggleRemoveWinners.checked : false,
          caseInsensitive: toggleCaseInsensitive ? toggleCaseInsensitive.checked : true,
        },
      });
      saveLastState('picker', {
        rawInput: safeRaw,
        winnerCount: winnersCount,
        removeWinners: toggleRemoveWinners ? toggleRemoveWinners.checked : false,
        caseInsensitive: toggleCaseInsensitive ? toggleCaseInsensitive.checked : true,
      });

      if (typeof (window as any).confetti === 'function') {
        (window as any).confetti({
          particleCount: 90,
          spread: 75,
          origin: { y: 0.6 },
        });
      }

      if (toggleRemoveWinners && toggleRemoveWinners.checked) {
        const isCaseInsensitive = toggleCaseInsensitive ? toggleCaseInsensitive.checked : true;
        const newText = removeWinnersFromText(textarea.value, winners, isCaseInsensitive);
        textarea.value = newText;
        updateCounts();

        const remainingItems = parseItems(newText);
        if (remainingCountNotice) {
          remainingCountNotice.textContent = `${remainingItems.length} remaining.`;
          remainingCountNotice.classList.remove('hidden');
        }
      } else {
        if (remainingCountNotice) remainingCountNotice.classList.add('hidden');
      }

      isPicking = false;
      pickBtn.removeAttribute('disabled');
      if (mobilePickBtn) mobilePickBtn.removeAttribute('disabled');
    }

    pickBtn.addEventListener('click', handlePick);
    if (mobilePickBtn) mobilePickBtn.addEventListener('click', handlePick);
    if (pickAgainBtn) pickAgainBtn.addEventListener('click', handlePick);

    if (copyWinnersBtn) {
      copyWinnersBtn.addEventListener('click', async () => {
        if (currentWinners.length === 0) return;
        const textToCopy = currentWinners.join('\n');
        try {
          await navigator.clipboard.writeText(textToCopy);
          showToast(tCommon.toasts?.copied || 'Copied to clipboard!');
        } catch (e) {
          showToast(tCommon.toasts?.errorOccurred || 'Unable to copy.');
        }
      });
    }

    if (shareWinnersBtn) {
      shareWinnersBtn.addEventListener('click', async () => {
        if (currentWinners.length === 0) return;
        const shareData = {
          title: `${tPicker.title || 'Random Picker'} • ToolNest`,
          text: `🎉 Selected winner:\n${currentWinners.join('\n')}\n\nToolNest:`,
          url: window.location.href,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (e) {}
        } else {
          try {
            await navigator.clipboard.writeText(`${shareData.text} ${shareData.url}`);
            showToast(tCommon.toasts?.copied || 'Result copied to clipboard!');
          } catch (e) {
            showToast(tCommon.toasts?.errorOccurred || 'Unable to share.');
          }
        }
      });
    }

    function closeModal() {
      if (!winnerModal || !modalCard) return;
      winnerModal.classList.remove('opacity-100', 'pointer-events-auto');
      winnerModal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
    }

    modalCloseBtn?.addEventListener('click', closeModal);
    winnerModal?.addEventListener('click', (e) => {
      if (e.target === winnerModal) closeModal();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && winnerModal && !winnerModal.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });

    modalPickAgainBtn?.addEventListener('click', () => {
      closeModal();
      handlePick();
    });

    modalCopyBtn?.addEventListener('click', async () => {
      if (currentWinners.length === 0) return;
      try {
        await navigator.clipboard.writeText(currentWinners.join('\n'));
        showToast(tCommon.toasts?.copied || 'Copied to clipboard!');
      } catch (e) {
        showToast(tCommon.toasts?.errorOccurred || 'Unable to copy.');
      }
    });

    modalShareBtn?.addEventListener('click', async () => {
      if (currentWinners.length === 0) return;
      const shareData = {
        title: `${tPicker.title || 'Random Picker'} • ToolNest`,
        text: `🎉 Selected winner:\n${currentWinners.join('\n')}\n\nToolNest:`,
        url: window.location.href,
      };
      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (e) {}
      } else {
        try {
          await navigator.clipboard.writeText(`${shareData.text} ${shareData.url}`);
          showToast(tCommon.toasts?.copied || 'Result copied to clipboard!');
        } catch (e) {
          showToast(tCommon.toasts?.errorOccurred || 'Unable to share.');
        }
      }
    });

    toggleRemoveWinners?.addEventListener('change', () => {
      const last = getLastState('picker') || {};
      saveLastState('picker', { ...last, removeWinners: toggleRemoveWinners.checked });
    });
    toggleCaseInsensitive?.addEventListener('change', () => {
      const last = getLastState('picker') || {};
      saveLastState('picker', { ...last, caseInsensitive: toggleCaseInsensitive.checked });
    });

    function restorePicker(data: any) {
      if (!data) return;
      if (typeof data.rawInput === 'string') {
        textarea.value = data.rawInput;
      }
      if (data.winnerCount) {
        winnersCount = data.winnerCount;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }
      if (toggleRemoveWinners && data.removeWinners !== undefined) {
        toggleRemoveWinners.checked = !!data.removeWinners;
      }
      if (toggleCaseInsensitive && data.caseInsensitive !== undefined) {
        toggleCaseInsensitive.checked = data.caseInsensitive !== false;
      }
      updateCounts();
      showToast(tCommon.toasts?.loaded || 'Restored picker list.');
    }

    const lastPicker = getLastState('picker');
    if (lastPicker) {
      if (typeof lastPicker.rawInput === 'string' && lastPicker.rawInput.trim()) {
        textarea.value = lastPicker.rawInput;
      }
      if (lastPicker.winnerCount) {
        winnersCount = lastPicker.winnerCount;
        if (winnersCountDisplay) winnersCountDisplay.textContent = String(winnersCount);
      }
      if (toggleRemoveWinners && lastPicker.removeWinners !== undefined) {
        toggleRemoveWinners.checked = !!lastPicker.removeWinners;
      }
      if (toggleCaseInsensitive && lastPicker.caseInsensitive !== undefined) {
        toggleCaseInsensitive.checked = lastPicker.caseInsensitive !== false;
      }
    }

    initHistoryCard({ toolId: 'picker', onRestore: restorePicker });
    updateCounts();
  }

  initRandomPicker();
  document.addEventListener('astro:after-swap', initRandomPicker);
</script>

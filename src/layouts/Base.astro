---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo, { type BreadcrumbItem } from '../components/Seo.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BackToTop from '../components/BackToTop.astro';
import Toast from '../components/Toast.astro';
import { getLangFromPath, isRtlLang, type Lang, getTranslations } from '../i18n';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  metaKey?: string;
  canonicalPath?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  extraSchemas?: Record<string, any>[];
  maxWidthClass?: string;
  noindex?: boolean;
  lang?: Lang;
}

const currentPath = Astro.url.pathname;
const detectedLang = getLangFromPath(currentPath);
const {
  lang = detectedLang,
  title,
  description,
  metaKey,
  canonicalPath,
  ogImage = '/favicon.svg',
  breadcrumbs = [],
  extraSchemas = [],
  maxWidthClass = 'max-w-3xl',
  noindex = false,
} = Astro.props;

const t = getTranslations(lang);
const defaultTitle = `${t.common?.siteName || t.siteName} — ${t.common?.tagline || t.tagline}`;
const defaultDescription = t.common?.description || t.description;

const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const isRtl = isRtlLang(lang);
---

<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Color (light: #F4F5F7, dark: #111315) -->
    <meta name="theme-color" content="#F4F5F7" id="theme-color-meta" />

    <!-- Anti-FOUC Inline Theme Initialization -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('no-transition');
        try {
          var stored = localStorage.getItem('toolnest_theme') || localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = stored === 'dark' || (!stored && prefersDark);
          
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }

          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', isDark ? '#111315' : '#F4F5F7');
        } catch (e) {}

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove('no-transition');
          });
        });
      })();
    </script>

    <style is:global>
      .no-transition,
      .no-transition *,
      .no-transition *::before,
      .no-transition *::after {
        transition: none !important;
      }
    </style>

    <!-- SEO, Hreflang & Structured Data -->
    <Seo
      title={pageTitle}
      description={pageDescription}
      canonicalPath={canonicalPath || currentPath}
      ogImage={ogImage}
      breadcrumbs={breadcrumbs}
      extraSchemas={extraSchemas}
      noindex={noindex}
      lang={lang}
      metaKey={metaKey}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark antialiased transition-colors duration-150">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-accent focus:text-white focus:font-semibold focus:rounded-xl focus:shadow-lg focus:outline-none"
    >
      Skip to main content
    </a>

    <Header lang={lang} />

    <main
      id="main-content"
      tabindex="-1"
      class:list={['flex-1 w-full mx-auto px-4 py-6 sm:py-10 focus:outline-none', maxWidthClass]}
    >
      {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} lang={lang} />}
      <slot />
    </main>

    <Footer lang={lang} />
    <BackToTop />
    <Toast />
  </body>
</html>

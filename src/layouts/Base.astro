---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LocalizedHead, { type BreadcrumbItem } from '../components/LocalizedHead.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BackToTop from '../components/BackToTop.astro';
import Toast from '../components/Toast.astro';
import { getLangFromPath, isRtlLang, type Lang, getNamespace } from '../i18n';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  metaKey?: string;
  canonicalPath?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  extraSchemas?: Record<string, any>[];
  maxWidthClass?: string;
  noindex?: boolean;
  lang?: Lang;
}

const currentPath = Astro.url.pathname;
const detectedLang = getLangFromPath(currentPath);
const {
  lang = detectedLang,
  title,
  description,
  metaKey,
  canonicalPath,
  ogImage = '/favicon.svg',
  breadcrumbs = [],
  extraSchemas = [],
  maxWidthClass = 'max-w-3xl',
  noindex = false,
} = Astro.props;

const common = getNamespace(lang, 'common');
const offline = getNamespace(lang, 'offline');
const defaultTitle = `${common.siteName} — ${common.tagline}`;
const defaultDescription = common.description;

const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
const isRtl = isRtlLang(lang);
---

<!doctype html>
<html lang={lang} dir={isRtl ? 'rtl' : 'ltr'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Color (light: #F4F5F7, dark: #111315) -->
    <meta name="theme-color" content="#F4F5F7" id="theme-color-meta" />

    <!-- Anti-FOUC Inline Theme Initialization -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('no-transition');
        try {
          var stored = localStorage.getItem('toolnest_theme') || localStorage.getItem('theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var isDark = stored === 'dark' || (!stored && prefersDark);
          
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }

          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', isDark ? '#111315' : '#F4F5F7');
        } catch (e) {}

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            document.documentElement.classList.remove('no-transition');
          });
        });
      })();
    </script>

    <style is:global>
      .no-transition,
      .no-transition *,
      .no-transition *::before,
      .no-transition *::after {
        transition: none !important;
      }
    </style>

    <!-- SEO, Hreflang & Structured Data -->
    <LocalizedHead
      title={title}
      description={description}
      metaKey={metaKey}
      canonicalPath={canonicalPath || currentPath}
      ogImage={ogImage}
      breadcrumbs={breadcrumbs}
      extraSchemas={extraSchemas}
      noindex={noindex}
      lang={lang}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark antialiased transition-colors duration-150 overflow-x-clip w-full max-w-full">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:px-4 focus:py-2.5 focus:bg-accent focus:text-white focus:font-semibold focus:rounded-xl focus:shadow-lg focus:outline-none"
    >
      {common.skipToContent || 'Skip to main content'}
    </a>

    <Header lang={lang} />

    <main
      id="main-content"
      tabindex="-1"
      class:list={['flex-1 w-full max-w-full min-w-0 mx-auto px-4 py-6 sm:py-10 focus:outline-none overflow-x-clip', maxWidthClass]}
    >
      {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} lang={lang} />}
      <slot />
    </main>

    <Footer lang={lang} />
    <BackToTop />
    <Toast />

    <!-- Offline Notification Banner -->
    <div
      id="offline-banner"
      class="hidden fixed bottom-4 start-4 end-4 sm:start-auto sm:end-4 z-50 p-3.5 max-w-md rounded-2xl bg-amber-500 text-black font-semibold text-xs sm:text-sm shadow-xl flex items-center justify-between gap-3 border border-amber-600/30"
      role="status"
      aria-live="polite"
    >
      <div class="flex items-center gap-2.5">
        <span class="text-base shrink-0">⚡</span>
        <span>{offline?.banner || "You are offline — ToolNest client-side tools continue to work without internet!"}</span>
      </div>
      <button
        type="button"
        id="offline-banner-close"
        class="w-7 h-7 rounded-lg bg-black/10 hover:bg-black/20 flex items-center justify-center shrink-0 text-black transition-colors"
        aria-label="Dismiss offline banner"
      >
        ✕
      </button>
    </div>

    <script is:inline>
      (function () {
        function updateOnlineStatus() {
          var banner = document.getElementById('offline-banner');
          if (!banner) return;
          if (navigator.onLine === false) {
            banner.classList.remove('hidden');
          } else {
            banner.classList.add('hidden');
          }
        }
        window.addEventListener('online', updateOnlineStatus);
        window.addEventListener('offline', updateOnlineStatus);
        document.addEventListener('DOMContentLoaded', function () {
          updateOnlineStatus();
          var closeBtn = document.getElementById('offline-banner-close');
          if (closeBtn) {
            closeBtn.addEventListener('click', function () {
              var banner = document.getElementById('offline-banner');
              if (banner) banner.classList.add('hidden');
            });
          }
        });
      })();
    </script>
  </body>
</html>

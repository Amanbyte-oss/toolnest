---
const currentYear = new Date().getFullYear();

const toolLinks = [
  { name: 'Age Calculator', href: '/age-calculator' },
  { name: 'Birthday Facts', href: '/birthday-facts' },
  { name: 'Decision Wheel', href: '/decision-wheel' },
  { name: 'Random Picker', href: '/random-picker' },
  { name: 'Countdown', href: '/countdown' },
  { name: 'Name Meanings', href: '/name-meaning' },
  { name: 'Names Directory', href: '/names' },
];

const siteLinks = [
  { name: 'About ToolNest', href: '/about' },
  { name: 'Contact Us', href: '/contact' },
  { name: 'Privacy Policy', href: '/privacy-policy' },
  { name: 'Sitemap', href: '/sitemap-index.xml' },
];
---

<footer class="w-full border-t border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark transition-colors duration-150 mt-auto">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand Description -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <a href="/" class="inline-flex items-center gap-2 text-base font-bold text-primary-light dark:text-primary-dark">
          <span class="w-7 h-7 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </span>
          <span>ToolNest</span>
        </a>
        <p class="text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
          Fast, mobile-first, privacy-focused client-side utilities. No tracking, zero databases, 100% static.
        </p>
      </div>

      <!-- Col 2: Tools (5 links) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark">
          Tools
        </h3>
        <ul class="space-y-2 text-sm">
          {toolLinks.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Site (About, Privacy, etc.) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark">
          Site
        </h3>
        <ul class="space-y-2 text-sm">
          {siteLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Platform & Privacy Note -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark">
          Architecture
        </h3>
        <div class="p-3.5 rounded-xl bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark space-y-1.5 text-xs text-secondary-light dark:text-secondary-dark">
          <div class="flex items-center gap-1.5 font-medium text-primary-light dark:text-primary-dark">
            <span class="w-2 h-2 rounded-full bg-success"></span>
            <span>Edge Ready</span>
          </div>
          <p>Built with Astro + Tailwind CSS. Deployed on Cloudflare Pages static edge network.</p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="pt-6 border-t border-border-light dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary-light dark:text-secondary-dark">
      <p>&copy; {currentYear} ToolNest. All rights reserved.</p>
      <p class="flex items-center gap-3">
        <span>Static Web Applications</span>
        <span>•</span>
        <span>Client-Side Calculations</span>
      </p>
    </div>
  </div>
</footer>

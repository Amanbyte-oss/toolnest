---
import {
  getNamespace,
  getLocalizedPath,
  type Lang,
  LANGUAGES,
  LOCALES,
} from '../i18n';

export interface Props {
  lang?: Lang;
}

const currentPath = Astro.url.pathname;
const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const newsletter = getNamespace(lang, 'newsletter');
const currentYear = new Date().getFullYear();

const toolLinks = [
  { name: common.nav?.imageToPdf || 'Image to PDF', href: getLocalizedPath('/image-to-pdf', lang) },
  { name: common.nav?.pdfMerge || 'PDF Merge', href: getLocalizedPath('/pdf-merge', lang) },
  { name: common.nav?.imageCompressor || 'Image Compressor', href: getLocalizedPath('/image-compressor', lang) },
  { name: common.nav?.imageConverter || 'Image Converter', href: getLocalizedPath('/image-converter', lang) },
  { name: common.nav?.ageCalculator || 'Age Calculator', href: getLocalizedPath('/age-calculator', lang) },
  { name: common.nav?.birthdayFacts || 'Birthday Facts', href: getLocalizedPath('/birthday-facts', lang) },
  { name: common.nav?.randomPicker || 'Random Picker', href: getLocalizedPath('/random-picker', lang) },
  { name: common.nav?.countdown || 'Countdown Timer', href: getLocalizedPath('/countdown', lang) },
];

const siteLinks = [
  { name: common.nav?.about || 'About', href: getLocalizedPath('/about', lang) },
  { name: common.nav?.contact || 'Contact', href: getLocalizedPath('/contact', lang) },
  { name: common.nav?.faq || 'FAQ', href: getLocalizedPath('/faq', lang) },
  { name: common.nav?.sitemap || 'HTML Sitemap', href: getLocalizedPath('/sitemap-page', lang) },
];

const legalLinks = [
  { name: common.nav?.privacy || 'Privacy Policy', href: getLocalizedPath('/privacy-policy', lang) },
  { name: common.nav?.terms || 'Terms of Service', href: getLocalizedPath('/terms-of-service', lang) },
];
---

<footer class="w-full border-t border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark transition-colors duration-150 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-12">
    <!-- Newsletter / Updates Subscription Card -->
    <div class="card p-6 sm:p-8 bg-gradient-to-br from-accent/5 via-surface-light to-surface-light dark:from-accent/10 dark:via-surface-dark dark:to-surface-dark border border-accent/20">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="space-y-1.5 max-w-md">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-accent uppercase tracking-wider">
            <span>📬</span>
            <span>{newsletter?.title || 'Stay Updated with New Tools'}</span>
          </div>
          <p class="text-xs sm:text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
            {newsletter?.desc || 'Subscribe for occasional updates when we launch new free, private utilities. Zero spam.'}
          </p>
        </div>

        <form id="footer-newsletter-form" class="w-full lg:max-w-md space-y-2" novalidate>
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              id="newsletter-email"
              name="email"
              required
              class="input-base text-sm min-h-[44px] px-3.5 flex-1 rounded-xl"
              placeholder={newsletter?.placeholder || 'Your email address...'}
              aria-label={newsletter?.placeholder || 'Your email address...'}
              autocomplete="email"
            />
            <button
              type="submit"
              id="newsletter-submit-btn"
              class="btn-primary min-h-[44px] py-2.5 px-5 text-sm font-bold shadow-xs cursor-pointer shrink-0"
            >
              {newsletter?.button || 'Subscribe'}
            </button>
          </div>

          <p id="newsletter-error" class="hidden text-xs font-semibold text-rose-500 pt-0.5" role="alert"></p>
          <p id="newsletter-success" class="hidden text-xs font-semibold text-emerald-600 dark:text-emerald-400 pt-0.5" role="status"></p>

          <p class="text-[11px] text-secondary-light dark:text-secondary-dark">
            Zero spam. Read our
            <a href={getLocalizedPath('/privacy-policy', lang)} class="underline hover:text-accent font-medium">
              {newsletter?.privacyLinkLabel || 'Privacy Policy'}
            </a>.
          </p>
        </form>
      </div>
    </div>

    <!-- 4 Main Footer Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Col 1: Tools (All with short labels) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark flex items-center gap-1.5">
          <span>🛠️</span>
          <span>{common.nav?.toolsDropdown || 'Tools'}</span>
        </h3>
        <ul class="space-y-2 text-sm">
          {toolLinks.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors block py-0.5 min-h-[28px]"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Site Links (About, Contact, FAQ, HTML Sitemap) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark flex items-center gap-1.5">
          <span>🧭</span>
          <span>{common.siteName}</span>
        </h3>
        <ul class="space-y-2 text-sm">
          {siteLinks.map((site) => (
            <li>
              <a
                href={site.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors block py-0.5 min-h-[28px]"
              >
                {site.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Legal & Trust (Privacy, Terms, 100% Client-Side badge) -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark flex items-center gap-1.5">
          <span>⚖️</span>
          <span>{common.badgePrivacy || 'Privacy & Legal'}</span>
        </h3>
        <ul class="space-y-2 text-sm">
          {legalLinks.map((legal) => (
            <li>
              <a
                href={legal.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors block py-0.5 min-h-[28px]"
              >
                {legal.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-2">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>{common.privacyBadge100 || '100% Client-Side Privacy'}</span>
          </div>
        </div>
      </div>

      <!-- Col 4: Language Switcher + short tagline + brand info -->
      <div class="space-y-4">
        <div class="space-y-1.5">
          <a href={getLocalizedPath('/', lang)} class="inline-flex items-center gap-2 text-base font-bold text-primary-light dark:text-primary-dark">
            <span class="w-6 h-6 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent">
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
              </svg>
            </span>
            <span>ToolNest</span>
          </a>
          <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
            {common.footerTagline || 'Fast, private online utilities running 100% on your device.'}
          </p>
        </div>

        <!-- Language Selector Pills in Footer -->
        <div class="space-y-1.5">
          <span class="text-[11px] font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark block">
            {common.nav?.switchLanguage || 'Language'}
          </span>
          <div class="grid grid-cols-2 gap-1.5">
            {LOCALES.map((code) => {
              const item = LANGUAGES[code];
              const isSelected = code === lang;
              const targetUrl = getLocalizedPath(currentPath, code);
              return (
                <a
                  href={targetUrl}
                  data-lang={code}
                  class:list={[
                    'lang-option flex items-center gap-1.5 px-2 py-1.5 rounded-lg text-xs font-medium border transition-colors min-h-[36px]',
                    isSelected
                      ? 'border-accent bg-accent/10 text-accent font-semibold'
                      : 'border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:border-accent hover:text-primary-light dark:hover:text-primary-dark',
                  ]}
                  aria-current={isSelected ? 'true' : undefined}
                >
                  <span class="text-sm">{item.flag}</span>
                  <span class="truncate">{item.nativeName}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Copyright -->
    <div class="pt-8 border-t border-border-light dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary-light dark:text-secondary-dark">
      <p>&copy; {currentYear} ToolNest. {common.footerCopyright}</p>
      <div class="flex items-center gap-4 flex-wrap justify-center">
        <a href={getLocalizedPath('/privacy-policy', lang)} class="hover:text-accent transition-colors">
          {common.nav?.privacy || 'Privacy Policy'}
        </a>
        <span>&bull;</span>
        <a href={getLocalizedPath('/terms-of-service', lang)} class="hover:text-accent transition-colors">
          {common.nav?.terms || 'Terms of Service'}
        </a>
        <span>&bull;</span>
        <a href={getLocalizedPath('/contact', lang)} class="hover:text-accent transition-colors">
          {common.nav?.contact || 'Contact'}
        </a>
        <span>&bull;</span>
        <a href="/sitemap.xml" class="hover:text-accent transition-colors">
          XML Sitemap
        </a>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{
    newsletterSuccessMsg: newsletter?.success || "Thank you! You're on the list for new tool releases.",
    newsletterErrorMsg: newsletter?.error || "Please enter a valid email address.",
    alreadySubscribedMsg: newsletter?.alreadySubscribed || "You're already subscribed for updates!",
  }}>
    document.addEventListener('DOMContentLoaded', function () {
      var form = document.getElementById('footer-newsletter-form');
      var emailInput = document.getElementById('newsletter-email');
      var errorEl = document.getElementById('newsletter-error');
      var successEl = document.getElementById('newsletter-success');

      if (form && emailInput) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          if (errorEl) errorEl.classList.add('hidden');
          if (successEl) successEl.classList.add('hidden');

          var email = (emailInput.value || '').trim();
          var pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

          if (!email || !pattern.test(email)) {
            if (errorEl) {
              errorEl.textContent = newsletterErrorMsg;
              errorEl.classList.remove('hidden');
            }
            emailInput.focus();
            return;
          }

          try {
            var existing = localStorage.getItem('toolnest_subscribers') || '';
            if (existing.indexOf(email) !== -1) {
              if (successEl) {
                successEl.textContent = alreadySubscribedMsg;
                successEl.classList.remove('hidden');
              }
              return;
            }
            localStorage.setItem('toolnest_subscribers', existing + ',' + email);
          } catch (e) {}

          // Send submission to Web3Forms free endpoint
          try {
            var formData = new FormData();
            formData.append('access_key', 'ea82c0ef-f155-4688-9dbe-d069da5c065f');
            formData.append('subject', 'New ToolNest Newsletter Subscriber');
            formData.append('email', email);
            fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              body: formData,
            }).catch(function () {});
          } catch (e) {}

          if (successEl) {
            successEl.textContent = newsletterSuccessMsg;
            successEl.classList.remove('hidden');
          }
          emailInput.value = '';
        });
      }
    });
  </script>
</footer>

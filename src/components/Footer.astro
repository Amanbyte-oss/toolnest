---
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');
const namesNs = getNamespace(lang, 'names');
const currentYear = new Date().getFullYear();

const toolLinks = [
  { name: common.nav.imageCompressor, href: getLocalizedPath('/image-compressor', lang) },
  { name: common.nav.imageConverter, href: getLocalizedPath('/image-converter', lang) },
  { name: common.nav.ageCalculator, href: getLocalizedPath('/age-calculator', lang) },
  { name: common.nav.birthdayFacts, href: getLocalizedPath('/birthday-facts', lang) },
  { name: common.nav.decisionWheel, href: getLocalizedPath('/decision-wheel', lang) },
  { name: common.nav.randomPicker, href: getLocalizedPath('/random-picker', lang) },
  { name: common.nav.countdown, href: getLocalizedPath('/countdown', lang) },
  { name: common.nav.nameMeaning, href: getLocalizedPath('/name-meaning', lang) },
  { name: namesNs.title, href: getLocalizedPath('/names', lang) },
];

const siteLinks = [
  { name: common.nav.about, href: getLocalizedPath('/about', lang) },
  { name: common.nav.contact, href: getLocalizedPath('/contact', lang) },
  { name: common.nav.privacy, href: getLocalizedPath('/privacy-policy', lang) },
  { name: common.sitemap || 'Sitemap', href: '/sitemap-index.xml' },
];
---

<footer class="w-full border-t border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark transition-colors duration-150 mt-auto">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand Description -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <a href={getLocalizedPath('/', lang)} class="inline-flex items-center gap-2 text-base font-bold text-primary-light dark:text-primary-dark">
          <span class="w-7 h-7 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </span>
          <span>ToolNest</span>
        </a>
        <p class="text-sm text-secondary-light dark:text-secondary-dark leading-relaxed">
          {common.footerTagline}
        </p>
      </div>

      <!-- Col 2: Tools -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark">
          {common.buttons.options}
        </h3>
        <ul class="space-y-2 text-sm">
          {toolLinks.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors"
              >
                {tool.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Site -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark">
          {common.siteName}
        </h3>
        <ul class="space-y-2 text-sm">
          {siteLinks.map((site) => (
            <li>
              <a
                href={site.href}
                class="text-secondary-light dark:text-secondary-dark hover:text-accent dark:hover:text-accent transition-colors"
              >
                {site.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Privacy & Standards -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark">
          {common.badgePrivacy}
        </h3>
        <p class="text-xs text-secondary-light dark:text-secondary-dark leading-relaxed">
          {common.description}
        </p>
        <div class="flex items-center gap-2 pt-1 text-xs text-secondary-light dark:text-secondary-dark">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{common.privacyBadge100 || '100% Client-Side Privacy'}</span>
        </div>
      </div>
    </div>

    <!-- Bottom Bar: Copyright -->
    <div class="pt-8 border-t border-border-light dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-secondary-light dark:text-secondary-dark">
      <p>&copy; {currentYear} {common.footerCopyright}</p>
      <div class="flex items-center gap-4">
        <a href={getLocalizedPath('/privacy-policy', lang)} class="hover:text-accent transition-colors">
          {common.nav.privacy}
        </a>
        <span>&bull;</span>
        <a href={getLocalizedPath('/contact', lang)} class="hover:text-accent transition-colors">
          {common.nav.contact}
        </a>
      </div>
    </div>
  </div>
</footer>

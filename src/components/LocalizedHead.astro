---
/**
 * src/components/LocalizedHead.astro
 * SEO head manager with automatic hreflang generation, translated titles/meta, canonical mapping, and JSON-LD.
 */
import {
  getLocalizedPath,
  getCanonicalPath,
  type Lang,
  DEFAULT_LANG,
  getNamespace,
} from '../i18n';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface Props {
  title?: string;
  description?: string;
  metaKey?: string;
  canonicalPath?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: BreadcrumbItem[];
  extraSchemas?: Record<string, any>[];
  noindex?: boolean;
  lang?: Lang;
}

const {
  title: titleProp,
  description: descProp,
  metaKey,
  canonicalPath = Astro.url.pathname,
  ogImage = '/og/share-banner.svg',
  type = 'website',
  breadcrumbs = [],
  extraSchemas = [],
  noindex = false,
  lang = 'en',
} = Astro.props;

// Production site URL (single source of truth)
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://toolnest.pages.dev';

// Load metadata namespace
const metaNs = getNamespace(lang, 'meta') as any;
const commonNs = getNamespace(lang, 'common') as any;

let resolvedTitle = titleProp;
let resolvedDesc = descProp;

if (!resolvedTitle && metaKey && metaNs[metaKey]?.title) {
  resolvedTitle = metaNs[metaKey].title;
}
if (!resolvedDesc && metaKey && metaNs[metaKey]?.description) {
  resolvedDesc = metaNs[metaKey].description;
}

const defaultTitle = `${commonNs.siteName} — ${commonNs.tagline}`;
const defaultDescription = commonNs.description;

const rawTitle = resolvedTitle || defaultTitle;
const rawDesc = resolvedDesc || defaultDescription;

// Ensure title contains site name and conforms to length guidelines
const siteName = commonNs.siteName || 'ToolNest';
const fullTitle = rawTitle.includes(siteName) ? rawTitle : `${rawTitle} | ${siteName}`;
const formattedTitle = fullTitle.length > 65 ? `${fullTitle.slice(0, 62)}...` : fullTitle;
const formattedDescription = rawDesc.length > 160 ? `${rawDesc.slice(0, 157)}...` : rawDesc;

// Canonical URL calculation:
// On /en/*, canonical URL points to bare URL (e.g. /birthday-facts)
const cleanPath = getCanonicalPath(canonicalPath);
const canonicalUrl = new URL(cleanPath, siteUrl).toString();
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();

const ogLocaleMap: Record<Lang, string> = {
  en: 'en_US',
  pt: 'pt_BR',
  id: 'id_ID',
  ar: 'ar_EG',
};
const ogLocale = ogLocaleMap[lang] || 'en_US';

const isHomePage = cleanPath === '/' || cleanPath === '' || cleanPath === '/pt/' || cleanPath === '/id/' || cleanPath === '/ar/';

// Organization schema
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: siteName,
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/favicon.svg`,
  },
  sameAs: [],
};

// WebSite schema with SearchAction
const websiteJsonLd = isHomePage
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: siteName,
      url: siteUrl,
      description: formattedDescription,
      inLanguage: lang,
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    }
  : null;

const homeGraphJsonLd = isHomePage
  ? {
      '@context': 'https://schema.org',
      '@graph': [organizationJsonLd, websiteJsonLd],
    }
  : null;

// Breadcrumbs schema
const homePath = getLocalizedPath('/', lang);
const filteredBreadcrumbs = breadcrumbs.filter((b) => b.item !== homePath && b.item !== '/');
const isNonToolPage = filteredBreadcrumbs.some((b) => 
  b.item.includes('about') || b.item.includes('contact') || b.item.includes('privacy') || 
  b.item.includes('terms') || b.item.includes('faq') || b.item.includes('sitemap')
);
const middleCrumb = (!isNonToolPage && filteredBreadcrumbs.length === 1)
  ? [{ name: commonNs.nav?.toolsDropdown || 'Tools', item: `${siteUrl}${getLocalizedPath('/sitemap-page', lang)}` }]
  : [];

const breadcrumbsList = [
  { name: commonNs.nav.home, item: `${siteUrl}${homePath}` },
  ...middleCrumb,
  ...filteredBreadcrumbs.map((b) => ({
    name: b.name,
    item: b.item.startsWith('http') ? b.item : new URL(b.item.startsWith('/') ? b.item : `/${b.item}`, siteUrl).toString(),
  })),
];

const breadcrumbJsonLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbsList.map((crumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: crumb.name,
          item: crumb.item,
        })),
      }
    : null;
---

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={formattedDescription} />
<link rel="canonical" href={canonicalUrl} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

{!noindex && (
  <>
    <!-- Reciprocal Hreflang Alternates (SEO Critical - Absolute URLs) -->
    <link rel="alternate" hreflang="en" href={`${siteUrl}${getLocalizedPath(cleanPath, 'en')}`} />
    <link rel="alternate" hreflang="pt" href={`${siteUrl}${getLocalizedPath(cleanPath, 'pt')}`} />
    <link rel="alternate" hreflang="id" href={`${siteUrl}${getLocalizedPath(cleanPath, 'id')}`} />
    <link rel="alternate" hreflang="ar" href={`${siteUrl}${getLocalizedPath(cleanPath, 'ar')}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${getLocalizedPath(cleanPath, 'en')}`} />
  </>
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={formattedDescription} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={formattedDescription} />
<meta name="twitter:image" content={absoluteOgImage} />

<!-- Structured Data (JSON-LD) -->
{isHomePage && homeGraphJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(homeGraphJsonLd)} />
)}

{breadcrumbJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
)}

{extraSchemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

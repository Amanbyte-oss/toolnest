---
/**
 * Header.astro
 * Responsive header with desktop navigation, language switcher dropdown,
 * theme toggle, and fully accessible mobile slide-in drawer menu.
 */
import {
  LANGUAGES,
  type Lang,
  getNamespace,
  getLocalizedPath,
  getLangFromPath,
  LOCALES,
} from '../i18n';

export interface Props {
  lang?: Lang;
}

const currentPath = Astro.url.pathname;
const detectedLang = getLangFromPath(currentPath);
const lang: Lang = Astro.props.lang || detectedLang;
const common = getNamespace(lang, 'common');
const t = common;
const currentLangMeta = LANGUAGES[lang] || LANGUAGES.en;

interface ToolNavItem {
  name: string;
  href: string;
  emoji: string;
}

const navTools: ToolNavItem[] = [
  { name: t.nav.imageCompressor, href: getLocalizedPath('/image-compressor', lang), emoji: '🗜️' },
  { name: t.nav.ageCalculator, href: getLocalizedPath('/age-calculator', lang), emoji: '🎂' },
  { name: t.nav.birthdayFacts, href: getLocalizedPath('/birthday-facts', lang), emoji: '🎉' },
  { name: t.nav.decisionWheel, href: getLocalizedPath('/decision-wheel', lang), emoji: '🎡' },
  { name: t.nav.randomPicker, href: getLocalizedPath('/random-picker', lang), emoji: '🎲' },
  { name: t.nav.countdown, href: getLocalizedPath('/countdown', lang), emoji: '⏳' },
  { name: t.nav.nameMeaning, href: getLocalizedPath('/name-meaning', lang), emoji: '🏷️' },
];

const homeHref = getLocalizedPath('/', lang);
const currentNormalizedPath = currentPath.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 w-full border-b border-border-light dark:border-border-dark bg-bg-light/90 dark:bg-bg-dark/90 backdrop-blur-md transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a 
      href={homeHref} 
      class="group inline-flex items-center gap-2.5 text-lg font-bold tracking-tight text-primary-light dark:text-primary-dark hover:opacity-90 focus-visible:rounded-lg shrink-0"
      aria-label={`${t.siteName} ${t.nav.home}`}
    >
      <span class="w-8 h-8 rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent shadow-sm group-hover:border-accent transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </span>
      <span>ToolNest</span>
    </a>

    <!-- Desktop Navigation (>= md breakpoint) -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1 flex-nowrap whitespace-nowrap overflow-x-auto" aria-label="Main Navigation">
      {navTools.map((tool) => {
        const isActive = currentNormalizedPath === tool.href.replace(/\/$/, '');
        return (
          <a
            href={tool.href}
            class:list={[
              'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm rounded-lg font-medium transition-colors duration-150 flex items-center shrink-0 min-h-[36px]',
              isActive
                ? 'text-accent bg-accent/10 dark:bg-accent/15 font-semibold'
                : 'text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {tool.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Language Switcher, Theme Toggle & Mobile Menu Trigger) -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Language Switcher Dropdown (Desktop >= sm) -->
      <div class="relative hidden sm:block" id="lang-switcher-container">
        <button
          id="lang-dropdown-btn"
          type="button"
          class="h-10 px-3 rounded-xl flex items-center gap-2 text-xs font-semibold text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t.nav.switchLanguage}
          title={t.nav.switchLanguage}
        >
          <svg class="w-4 h-4 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>{currentLangMeta.nativeName}</span>
          <svg class="w-3.5 h-3.5 text-secondary-light dark:text-secondary-dark opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          class="hidden absolute end-0 mt-1.5 w-44 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-xl p-1.5 z-50 transition-all duration-150"
          role="menu"
          aria-orientation="vertical"
        >
          {LOCALES.map((localeCode) => {
            const item = LANGUAGES[localeCode];
            const isSelected = localeCode === lang;
            const targetUrl = getLocalizedPath(currentPath, localeCode);
            return (
              <a
                href={targetUrl}
                data-lang={localeCode}
                class:list={[
                  'lang-option flex items-center justify-between w-full px-3 py-2 rounded-lg text-xs font-medium transition-colors',
                  isSelected
                    ? 'bg-accent/10 text-accent font-semibold'
                    : 'text-primary-light dark:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
                ]}
                role="menuitem"
              >
                <div class="flex items-center gap-2">
                  <span class="text-sm">{item.flag}</span>
                  <span>{item.nativeName}</span>
                </div>
                {isSelected && (
                  <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Dark / Light Mode Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent relative overflow-hidden"
        aria-label={t.switchTheme || 'Switch theme'}
        title={t.switchTheme || 'Switch theme'}
      >
        <svg
          id="theme-icon-sun"
          class="w-5 h-5 text-amber-400 absolute transition-all duration-150 transform scale-0 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100 pointer-events-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          id="theme-icon-moon"
          class="w-5 h-5 text-secondary-light dark:text-secondary-dark absolute transition-all duration-150 transform scale-100 rotate-0 opacity-100 dark:scale-0 dark:-rotate-90 dark:opacity-0 pointer-events-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden w-11 h-11 min-h-[44px] min-w-[44px] sm:w-12 sm:h-12 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label={t.openMenu || 'Open menu'}
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <div class="w-5 h-3.5 flex flex-col justify-between pointer-events-none relative" aria-hidden="true">
          <span class="hamburger-line-top w-5 h-0.5 bg-current rounded-full transition-transform duration-250 ease-out origin-center"></span>
          <span class="hamburger-line-mid w-5 h-0.5 bg-current rounded-full transition-all duration-200 ease-out origin-center"></span>
          <span class="hamburger-line-bot w-5 h-0.5 bg-current rounded-full transition-transform duration-250 ease-out origin-center"></span>
        </div>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Backdrop Overlay (Rendered outside <header> to escape backdrop-filter containing block trap) -->
<div
  id="mobile-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] md:hidden"
  aria-hidden="true"
></div>

<!-- Mobile Slide-In Navigation Drawer (Rendered outside <header> for true viewport height and full stacking context) -->
<aside
  id="mobile-drawer"
  class="fixed top-0 bottom-0 bg-surface-light dark:bg-surface-dark border-s border-border-light dark:border-border-dark z-[70] shadow-2xl md:hidden flex flex-col overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t.openMenu || 'Navigation Menu'}
  aria-hidden="true"
>
  <!-- Drawer Header -->
  <div class="h-16 px-4 border-b border-border-light dark:border-border-dark flex items-center justify-between shrink-0 bg-surface-light dark:bg-surface-dark">
    <a 
      href={homeHref} 
      class="drawer-nav-link inline-flex items-center gap-2 text-base font-bold tracking-tight text-primary-light dark:text-primary-dark hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent rounded-lg min-h-[44px]"
      aria-label={`${t.siteName} ${t.nav.home}`}
    >
      <span class="w-8 h-8 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent shadow-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </span>
      <span>ToolNest</span>
    </a>

    <!-- Close Drawer Button (44px+ touch target) -->
    <button
      id="mobile-menu-close"
      type="button"
      class="w-11 h-11 min-h-[44px] min-w-[44px] rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
      aria-label={t.close || 'Close menu'}
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Drawer Navigation Links & Controls -->
  <div class="flex-1 overflow-y-auto px-3 py-4 space-y-4">
    <!-- Language Switcher inside Mobile Drawer (Accessible 44px+ touch targets) -->
    <div class="space-y-2 pb-4 border-b border-border-light dark:border-border-dark">
      <span class="text-[11px] font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark px-1 block">
        {t.nav.switchLanguage}
      </span>
      <div class="grid grid-cols-2 gap-2">
        {LOCALES.map((localeCode) => {
          const item = LANGUAGES[localeCode];
          const isSelected = localeCode === lang;
          const targetUrl = getLocalizedPath(currentPath, localeCode);
          return (
            <a
              href={targetUrl}
              data-lang={localeCode}
              class:list={[
                'lang-option flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-xs font-medium border transition-colors min-h-[44px]',
                isSelected
                  ? 'border-accent bg-accent/10 text-accent font-semibold'
                  : 'border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:border-accent hover:text-primary-light dark:hover:text-primary-dark',
              ]}
              aria-current={isSelected ? 'true' : undefined}
            >
              <span class="text-base shrink-0">{item.flag}</span>
              <span class="truncate">{item.nativeName}</span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Tool Navigation Links -->
    <nav class="space-y-1.5" aria-label="Mobile Navigation">
      {navTools.map((tool) => {
        const isActive = currentNormalizedPath === tool.href.replace(/\/$/, '');
        return (
          <a
            href={tool.href}
            class:list={[
              'drawer-nav-link flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium transition-colors min-h-[48px]',
              isActive
                ? 'bg-accent text-white font-semibold shadow-sm shadow-accent/20'
                : 'text-primary-light dark:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="text-lg shrink-0">{tool.emoji}</span>
            <span class="truncate">{tool.name}</span>
          </a>
        );
      })}
    </nav>

    <!-- Footer Links inside Drawer (Accessible 44px+ touch targets) -->
    <div class="pt-4 border-t border-border-light dark:border-border-dark space-y-2 text-xs text-secondary-light dark:text-secondary-dark px-1">
      <div class="flex items-center justify-between gap-1">
        <a href={getLocalizedPath('/about', lang)} class="drawer-nav-link hover:text-accent transition-colors px-2 py-3 min-h-[44px] flex items-center">
          {t.nav.about}
        </a>
        <a href={getLocalizedPath('/privacy-policy', lang)} class="drawer-nav-link hover:text-accent transition-colors px-2 py-3 min-h-[44px] flex items-center">
          {t.nav.privacy}
        </a>
        <a href={getLocalizedPath('/contact', lang)} class="drawer-nav-link hover:text-accent transition-colors px-2 py-3 min-h-[44px] flex items-center">
          {t.nav.contact}
        </a>
      </div>
    </div>
  </div>
</aside>

<style>
  button[aria-expanded="true"] .hamburger-line-top {
    transform: translateY(6px) rotate(45deg);
  }
  button[aria-expanded="true"] .hamburger-line-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  button[aria-expanded="true"] .hamburger-line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Drawer Backdrop */
  #mobile-backdrop {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  #mobile-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Mobile Drawer Positioning & Direction */
  #mobile-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    height: 100%;
    height: 100dvh;
    width: min(320px, 85vw);
    max-width: 100%;
    z-index: 70;
    visibility: hidden;
    pointer-events: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s ease;
  }

  /* LTR: Slide in from the Right */
  html[dir="ltr"] #mobile-drawer,
  :root:not([dir="rtl"]) #mobile-drawer {
    right: 0;
    left: auto;
    transform: translateX(100%);
  }

  /* RTL: Slide in from the Left */
  html[dir="rtl"] #mobile-drawer {
    left: 0;
    right: auto;
    transform: translateX(-100%);
  }

  /* Drawer Open State */
  #mobile-drawer.is-open {
    transform: translateX(0) !important;
    visibility: visible;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-drawer,
    #mobile-backdrop,
    button[aria-expanded="true"] .hamburger-line-top,
    button[aria-expanded="true"] .hamburger-line-mid,
    button[aria-expanded="true"] .hamburger-line-bot {
      transition-duration: 0.01ms !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle.js';

  let headerCleanup: (() => void) | null = null;

  function initHeader() {
    initThemeToggle();

    if (typeof headerCleanup === 'function') {
      headerCleanup();
      headerCleanup = null;
    }

    const abortController = new AbortController();
    const { signal } = abortController;

    // Desktop Language Switcher
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');

    if (langBtn && langMenu) {
      const currentLangBtn = langBtn;
      const currentLangMenu = langMenu;

      const toggleLangMenu = (open?: boolean) => {
        const shouldOpen = open !== undefined ? open : currentLangMenu.classList.contains('hidden');
        if (shouldOpen) {
          currentLangMenu.classList.remove('hidden');
          currentLangBtn.setAttribute('aria-expanded', 'true');
        } else {
          currentLangMenu.classList.add('hidden');
          currentLangBtn.setAttribute('aria-expanded', 'false');
        }
      };

      currentLangBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleLangMenu();
      }, { signal });

      document.addEventListener('click', (e) => {
        const target = e.target as Node | null;
        if (target && !currentLangMenu.contains(target) && !currentLangBtn.contains(target)) {
          toggleLangMenu(false);
        }
      }, { signal });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !currentLangMenu.classList.contains('hidden')) {
          toggleLangMenu(false);
          currentLangBtn.focus();
        }
      }, { signal });
    }

    // Language option click handler: store preference in cookie + localStorage
    document.querySelectorAll('.lang-option').forEach((opt) => {
      opt.addEventListener('click', (e) => {
        const targetLang = opt.getAttribute('data-lang');
        const targetHref = opt.getAttribute('href');
        if (targetLang) {
          try {
            localStorage.setItem('toolnest_lang', targetLang);
            document.cookie = `toolnest_lang=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
            document.cookie = `lang-hint=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
          } catch (err) {}
        }
        if (targetHref && document.startViewTransition) {
          e.preventDefault();
          document.startViewTransition(() => {
            window.location.href = targetHref;
          });
        }
      }, { signal });
    });

    // Mobile Drawer Controller
    const menuToggleBtn = document.getElementById('mobile-menu-toggle');
    const menuCloseBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');

    if (!menuToggleBtn || !drawer || !backdrop) return;

    const toggleBtn = menuToggleBtn;
    const drawerEl = drawer;
    const backdropEl = backdrop;

    let isDrawerOpen = false;

    function lockScroll() {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      document.body.style.touchAction = 'none';
      if (scrollbarWidth > 0) {
        document.documentElement.style.paddingRight = `${scrollbarWidth}px`;
      }
    }

    function unlockScroll() {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
      document.documentElement.style.paddingRight = '';
    }

    const openDrawer = () => {
      if (isDrawerOpen) return;
      isDrawerOpen = true;
      lockScroll();

      document.querySelectorAll('main, footer').forEach((el) => {
        el.setAttribute('inert', '');
      });

      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Close menu');
      drawerEl.setAttribute('aria-hidden', 'false');

      backdropEl.classList.add('is-open');
      drawerEl.classList.add('is-open');

      requestAnimationFrame(() => {
        if (menuCloseBtn) menuCloseBtn.focus();
      });
    };

    const closeDrawer = (restoreFocus = true) => {
      if (!isDrawerOpen) return;
      isDrawerOpen = false;
      unlockScroll();

      document.querySelectorAll('main, footer').forEach((el) => {
        el.removeAttribute('inert');
      });

      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Open menu');
      drawerEl.setAttribute('aria-hidden', 'true');

      backdropEl.classList.remove('is-open');
      drawerEl.classList.remove('is-open');

      if (restoreFocus && toggleBtn) {
        toggleBtn.focus();
      }
    };

    toggleBtn.addEventListener('click', () => {
      if (isDrawerOpen) closeDrawer();
      else openDrawer();
    }, { signal });

    if (menuCloseBtn) {
      menuCloseBtn.addEventListener('click', () => closeDrawer(), { signal });
    }

    backdropEl.addEventListener('click', () => closeDrawer(), { signal });

    drawerEl.querySelectorAll('.drawer-nav-link').forEach((link) => {
      link.addEventListener('click', () => closeDrawer(false), { signal });
    });

    drawerEl.querySelectorAll('.lang-option').forEach((link) => {
      link.addEventListener('click', () => closeDrawer(false), { signal });
    });

    document.addEventListener('keydown', (e) => {
      if (!isDrawerOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDrawer();
      }
    }, { signal });

    headerCleanup = () => {
      if (isDrawerOpen) {
        unlockScroll();
        document.querySelectorAll('main, footer').forEach((el) => {
          el.removeAttribute('inert');
        });
      }
      abortController.abort();
    };
  }

  if (document.readyState !== 'loading') {
    initHeader();
  } else {
    document.addEventListener('DOMContentLoaded', initHeader);
  }
  document.addEventListener('astro:after-swap', initHeader);
</script>

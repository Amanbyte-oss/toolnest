---
/**
 * Header.astro
 * Responsive header with desktop navigation, language switcher dropdown,
 * theme toggle, and fully accessible mobile slide-in drawer menu.
 */
import {
  LANGUAGES,
  type Lang,
  getTranslations,
  getLocalizedPath,
  getLangFromPath,
  LOCALES,
} from '../i18n';

export interface Props {
  lang?: Lang;
}

const currentPath = Astro.url.pathname;
const detectedLang = getLangFromPath(currentPath);
const lang: Lang = Astro.props.lang || detectedLang;
const t = getTranslations(lang);
const currentLangMeta = LANGUAGES[lang] || LANGUAGES.en;

interface ToolNavItem {
  name: string;
  href: string;
  emoji: string;
}

const navTools: ToolNavItem[] = [
  { name: t.nav.ageCalculator, href: getLocalizedPath('/age-calculator', lang), emoji: '🎂' },
  { name: t.nav.birthdayFacts, href: getLocalizedPath('/birthday-facts', lang), emoji: '🎉' },
  { name: t.nav.decisionWheel, href: getLocalizedPath('/decision-wheel', lang), emoji: '🎡' },
  { name: t.nav.randomPicker, href: getLocalizedPath('/random-picker', lang), emoji: '🎲' },
  { name: t.nav.countdown, href: getLocalizedPath('/countdown', lang), emoji: '⏳' },
  { name: t.nav.nameMeaning, href: getLocalizedPath('/name-meaning', lang), emoji: '🏷️' },
];

const homeHref = getLocalizedPath('/', lang);
const currentNormalizedPath = currentPath.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 w-full border-b border-border-light dark:border-border-dark bg-bg-light/90 dark:bg-bg-dark/90 backdrop-blur-md transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a 
      href={homeHref} 
      class="group inline-flex items-center gap-2.5 text-lg font-bold tracking-tight text-primary-light dark:text-primary-dark hover:opacity-90 focus-visible:rounded-lg shrink-0"
      aria-label="ToolNest Home"
    >
      <span class="w-8 h-8 rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent shadow-sm group-hover:border-accent transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </span>
      <span>ToolNest</span>
    </a>

    <!-- Desktop Navigation (>= md breakpoint) -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1 flex-nowrap whitespace-nowrap overflow-x-auto" aria-label="Main Navigation">
      {navTools.map((tool) => {
        const isActive = currentNormalizedPath === tool.href.replace(/\/$/, '');
        return (
          <a
            href={tool.href}
            class:list={[
              'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm rounded-lg font-medium transition-colors duration-150 flex items-center shrink-0 min-h-[36px]',
              isActive
                ? 'text-accent bg-accent/10 dark:bg-accent/15 font-semibold'
                : 'text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {tool.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Language Switcher, Theme Toggle & Mobile Menu Trigger) -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Language Switcher Dropdown (Desktop >= sm) -->
      <div class="relative hidden sm:block" id="lang-switcher-container">
        <button
          id="lang-dropdown-btn"
          type="button"
          class="h-10 px-3 rounded-xl flex items-center gap-2 text-xs font-semibold text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={t.nav.switchLanguage}
          title={t.nav.switchLanguage}
        >
          <svg class="w-4 h-4 text-accent shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span>{currentLangMeta.nativeName}</span>
          <svg class="w-3.5 h-3.5 text-secondary-light dark:text-secondary-dark opacity-75" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="lang-dropdown-menu"
          class="hidden absolute end-0 mt-1.5 w-44 rounded-xl border border-border-light dark:border-border-dark bg-surface-light dark:bg-surface-dark shadow-xl p-1.5 z-50 transition-all duration-150"
          role="menu"
          aria-orientation="vertical"
        >
          {LOCALES.map((localeCode) => {
            const item = LANGUAGES[localeCode];
            const isSelected = localeCode === lang;
            const targetUrl = getLocalizedPath(currentPath, localeCode);
            return (
              <a
                href={targetUrl}
                data-lang={localeCode}
                class:list={[
                  'lang-option flex items-center justify-between w-full px-3 py-2 rounded-lg text-xs font-medium transition-colors',
                  isSelected
                    ? 'bg-accent/10 text-accent font-semibold'
                    : 'text-primary-light dark:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
                ]}
                role="menuitem"
              >
                <div class="flex items-center gap-2">
                  <span class="text-sm">{item.flag}</span>
                  <span>{item.nativeName}</span>
                </div>
                {isSelected && (
                  <svg class="w-3.5 h-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Dark / Light Mode Toggle Button -->
      <button
        id="theme-toggle"
        type="button"
        class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent relative overflow-hidden"
        aria-label="Switch theme"
        title="Switch theme"
      >
        <svg
          id="theme-icon-sun"
          class="w-5 h-5 text-amber-400 absolute transition-all duration-150 transform scale-0 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100 pointer-events-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg
          id="theme-icon-moon"
          class="w-5 h-5 text-secondary-light dark:text-secondary-dark absolute transition-all duration-150 transform scale-100 rotate-0 opacity-100 dark:scale-0 dark:-rotate-90 dark:opacity-0 pointer-events-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <div class="w-5 h-3.5 flex flex-col justify-between pointer-events-none relative" aria-hidden="true">
          <span class="hamburger-line-top w-5 h-0.5 bg-current rounded-full transition-transform duration-250 ease-out origin-center"></span>
          <span class="hamburger-line-mid w-5 h-0.5 bg-current rounded-full transition-all duration-200 ease-out origin-center"></span>
          <span class="hamburger-line-bot w-5 h-0.5 bg-current rounded-full transition-transform duration-250 ease-out origin-center"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop Overlay -->
  <div
    id="mobile-backdrop"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-250 ease-out md:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile Slide-In Navigation Drawer -->
  <aside
    id="mobile-drawer"
    class="fixed top-0 end-0 bottom-0 h-full w-[min(320px,85vw)] max-w-full bg-surface-light dark:bg-surface-dark border-s border-border-light dark:border-border-dark z-[70] shadow-2xl transform translate-x-full rtl:-translate-x-full transition-transform duration-250 ease-out md:hidden flex flex-col overflow-hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation Menu"
    aria-hidden="true"
  >
    <!-- Drawer Header -->
    <div class="h-16 px-4 border-b border-border-light dark:border-border-dark flex items-center justify-between shrink-0 bg-surface-light dark:bg-surface-dark">
      <a 
        href={homeHref} 
        class="drawer-nav-link inline-flex items-center gap-2 text-base font-bold tracking-tight text-primary-light dark:text-primary-dark hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent rounded-lg"
        aria-label="ToolNest Home"
      >
        <span class="w-7 h-7 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent shadow-sm">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </span>
        <span>ToolNest</span>
      </a>

      <!-- Close Drawer Button -->
      <button
        id="mobile-menu-close"
        type="button"
        class="w-10 h-10 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="Close menu"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation Links -->
    <div class="flex-1 overflow-y-auto px-3 py-4 space-y-4">
      <!-- Language Switcher in Mobile Drawer -->
      <div class="space-y-1.5 pb-3 border-b border-border-light dark:border-border-dark">
        <span class="text-[11px] font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark px-2 block">
          {t.nav.switchLanguage}
        </span>
        <div class="grid grid-cols-2 gap-1.5">
          {LOCALES.map((localeCode) => {
            const item = LANGUAGES[localeCode];
            const isSelected = localeCode === lang;
            const targetUrl = getLocalizedPath(currentPath, localeCode);
            return (
              <a
                href={targetUrl}
                data-lang={localeCode}
                class:list={[
                  'lang-option flex items-center gap-2 px-2.5 py-2 rounded-xl text-xs font-medium border transition-colors',
                  isSelected
                    ? 'border-accent bg-accent/10 text-accent font-semibold'
                    : 'border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark hover:border-accent hover:text-primary-light dark:hover:text-primary-dark',
                ]}
              >
                <span>{item.flag}</span>
                <span class="truncate">{item.nativeName}</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Tool Links -->
      <nav class="space-y-1" aria-label="Mobile Navigation">
        {navTools.map((tool) => {
          const isActive = currentNormalizedPath === tool.href.replace(/\/$/, '');
          return (
            <a
              href={tool.href}
              class:list={[
                'drawer-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors min-h-[44px]',
                isActive
                  ? 'bg-accent text-white font-semibold shadow-sm shadow-accent/20'
                  : 'text-primary-light dark:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="text-base">{tool.emoji}</span>
              <span>{tool.name}</span>
            </a>
          );
        })}
      </nav>

      <!-- Footer Info in Drawer -->
      <div class="pt-4 border-t border-border-light dark:border-border-dark space-y-2 text-xs text-secondary-light dark:text-secondary-dark px-1">
        <div class="flex items-center justify-between">
          <a href={getLocalizedPath('/about', lang)} class="drawer-nav-link hover:text-accent transition-colors py-1">
            {t.nav.about}
          </a>
          <a href={getLocalizedPath('/privacy-policy', lang)} class="drawer-nav-link hover:text-accent transition-colors py-1">
            {t.nav.privacy}
          </a>
          <a href={getLocalizedPath('/contact', lang)} class="drawer-nav-link hover:text-accent transition-colors py-1">
            {t.nav.contact}
          </a>
        </div>
      </div>
    </div>
  </aside>
</header>

<style>
  button[aria-expanded="true"] .hamburger-line-top {
    transform: translateY(6px) rotate(45deg);
  }
  button[aria-expanded="true"] .hamburger-line-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  button[aria-expanded="true"] .hamburger-line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle.js';

  let headerCleanup = null;

  function initHeader() {
    initThemeToggle();

    if (typeof headerCleanup === 'function') {
      headerCleanup();
      headerCleanup = null;
    }

    const abortController = new AbortController();
    const { signal } = abortController;

    // Desktop Language Switcher
    const langBtn = document.getElementById('lang-dropdown-btn');
    const langMenu = document.getElementById('lang-dropdown-menu');

    if (langBtn && langMenu) {
      function toggleLangMenu(open) {
        const shouldOpen = open !== undefined ? open : langMenu.classList.contains('hidden');
        if (shouldOpen) {
          langMenu.classList.remove('hidden');
          langBtn.setAttribute('aria-expanded', 'true');
        } else {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        }
      }

      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleLangMenu();
      }, { signal });

      document.addEventListener('click', (e) => {
        if (!langMenu.contains(e.target) && !langBtn.contains(e.target)) {
          toggleLangMenu(false);
        }
      }, { signal });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !langMenu.classList.contains('hidden')) {
          toggleLangMenu(false);
          langBtn.focus();
        }
      }, { signal });
    }

    // Language option click handler: store preference in cookie + localStorage
    document.querySelectorAll('.lang-option').forEach((opt) => {
      opt.addEventListener('click', (e) => {
        const targetLang = opt.getAttribute('data-lang');
        if (targetLang) {
          try {
            localStorage.setItem('toolnest_lang', targetLang);
            document.cookie = `toolnest_lang=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
            document.cookie = `lang-hint=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
          } catch (err) {}
        }
      }, { signal });
    });

    // Mobile Drawer Controller
    const menuToggleBtn = document.getElementById('mobile-menu-toggle');
    const menuCloseBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');

    if (!menuToggleBtn || !drawer || !backdrop) return;

    let isDrawerOpen = false;

    function lockScroll() {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = 'hidden';
      if (scrollbarWidth > 0) {
        document.documentElement.style.paddingRight = `${scrollbarWidth}px`;
      }
    }

    function unlockScroll() {
      document.documentElement.style.overflow = '';
      document.documentElement.style.paddingRight = '';
    }

    function openDrawer() {
      if (isDrawerOpen) return;
      isDrawerOpen = true;
      lockScroll();

      document.querySelectorAll('main, footer').forEach((el) => {
        el.setAttribute('inert', '');
      });

      menuToggleBtn.setAttribute('aria-expanded', 'true');
      menuToggleBtn.setAttribute('aria-label', 'Close menu');
      drawer.setAttribute('aria-hidden', 'false');

      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');

      drawer.classList.remove('translate-x-full', 'rtl:-translate-x-full');
      drawer.classList.add('translate-x-0');

      requestAnimationFrame(() => {
        if (menuCloseBtn) menuCloseBtn.focus();
      });
    }

    function closeDrawer(restoreFocus = true) {
      if (!isDrawerOpen) return;
      isDrawerOpen = false;
      unlockScroll();

      document.querySelectorAll('main, footer').forEach((el) => {
        el.removeAttribute('inert');
      });

      menuToggleBtn.setAttribute('aria-expanded', 'false');
      menuToggleBtn.setAttribute('aria-label', 'Open menu');
      drawer.setAttribute('aria-hidden', 'true');

      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full', 'rtl:-translate-x-full');

      if (restoreFocus && menuToggleBtn) {
        menuToggleBtn.focus();
      }
    }

    menuToggleBtn.addEventListener('click', () => {
      if (isDrawerOpen) closeDrawer();
      else openDrawer();
    }, { signal });

    if (menuCloseBtn) {
      menuCloseBtn.addEventListener('click', () => closeDrawer(), { signal });
    }

    backdrop.addEventListener('click', () => closeDrawer(), { signal });

    drawer.querySelectorAll('.drawer-nav-link').forEach((link) => {
      link.addEventListener('click', () => closeDrawer(false), { signal });
    });

    document.addEventListener('keydown', (e) => {
      if (!isDrawerOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDrawer();
      }
    }, { signal });

    headerCleanup = () => {
      if (isDrawerOpen) {
        unlockScroll();
        document.querySelectorAll('main, footer').forEach((el) => {
          el.removeAttribute('inert');
        });
      }
      abortController.abort();
    };
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>

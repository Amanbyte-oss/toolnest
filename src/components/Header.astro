---
/**
 * Header.astro
 * Responsive header with desktop navigation and fully accessible,
 * animated mobile slide-in drawer menu.
 * Z-index hierarchy: Header (50), Backdrop (60), Drawer (70).
 */

interface ToolNavItem {
  name: string;
  href: string;
  emoji: string;
}

const navTools: ToolNavItem[] = [
  { name: 'Age Calculator', href: '/age-calculator', emoji: '🎂' },
  { name: 'Birthday Facts', href: '/birthday-facts', emoji: '🎉' },
  { name: 'Decision Wheel', href: '/decision-wheel', emoji: '🎡' },
  { name: 'Random Picker', href: '/random-picker', emoji: '🎲' },
  { name: 'Countdown', href: '/countdown', emoji: '⏳' },
  { name: 'Name Meanings', href: '/name-meaning', emoji: '🏷️' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-50 w-full border-b border-border-light dark:border-border-dark bg-bg-light/90 dark:bg-bg-dark/90 backdrop-blur-md transition-colors duration-150">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- Brand Logo -->
    <a 
      href="/" 
      class="group inline-flex items-center gap-2.5 text-lg font-bold tracking-tight text-primary-light dark:text-primary-dark hover:opacity-90 focus-visible:rounded-lg shrink-0"
      aria-label="ToolNest Home"
    >
      <span class="w-8 h-8 rounded-lg bg-surface-light dark:bg-surface-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent shadow-sm group-hover:border-accent transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
      </span>
      <span>ToolNest</span>
    </a>

    <!-- Desktop Navigation (>= md breakpoint, all 6 links, no wrapping) -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1 flex-nowrap whitespace-nowrap overflow-x-auto" aria-label="Main Navigation">
      {navTools.map((tool) => {
        const isActive = currentPath === tool.href;
        return (
          <a
            href={tool.href}
            class:list={[
              'px-2.5 lg:px-3 py-1.5 text-xs lg:text-sm rounded-lg font-medium transition-colors duration-150 flex items-center shrink-0 min-h-[36px]',
              isActive
                ? 'text-accent bg-accent/10 dark:bg-accent/15 font-semibold'
                : 'text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {tool.name}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions (Theme Toggle & Mobile Menu Trigger) -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- Dark / Light Mode Toggle Button (48x48px touch target) -->
      <button
        id="theme-toggle"
        type="button"
        class="w-12 h-12 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent relative overflow-hidden"
        aria-label="Switch to dark mode"
        title="Switch to dark mode"
      >
        <!-- Sun Icon (crossfades & rotates in in dark mode) -->
        <svg
          id="theme-icon-sun"
          class="w-5 h-5 text-amber-400 absolute transition-all duration-150 transform scale-0 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100 pointer-events-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <!-- Moon Icon (crossfades & rotates out in dark mode) -->
        <svg
          id="theme-icon-moon"
          class="w-5 h-5 text-secondary-light dark:text-secondary-dark absolute transition-all duration-150 transform scale-100 rotate-0 opacity-100 dark:scale-0 dark:-rotate-90 dark:opacity-0 pointer-events-none"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button (48x48px tap target with animated hamburger ↔ X icon) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden w-12 h-12 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 border border-border-light dark:border-border-dark transition-all duration-150 active:scale-95 focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <div class="w-5 h-3.5 flex flex-col justify-between pointer-events-none relative" aria-hidden="true">
          <span class="hamburger-line-top w-5 h-0.5 bg-current rounded-full transition-transform duration-250 ease-out origin-center"></span>
          <span class="hamburger-line-mid w-5 h-0.5 bg-current rounded-full transition-all duration-200 ease-out origin-center"></span>
          <span class="hamburger-line-bot w-5 h-0.5 bg-current rounded-full transition-transform duration-250 ease-out origin-center"></span>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop Overlay (z-index 60) -->
  <div
    id="mobile-backdrop"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] opacity-0 pointer-events-none transition-opacity duration-250 ease-out md:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile Slide-In Navigation Drawer (z-index 70, slides in from right, width min(320px, 85vw)) -->
  <aside
    id="mobile-drawer"
    class="fixed top-0 right-0 bottom-0 h-full w-[min(320px,85vw)] max-w-full bg-surface-light dark:bg-surface-dark border-l border-border-light dark:border-border-dark z-[70] shadow-2xl transform translate-x-full transition-transform duration-250 ease-out md:hidden flex flex-col overflow-hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Navigation Menu"
    aria-hidden="true"
  >
    <!-- Drawer Header: Site Logo & Close (X) Button -->
    <div class="h-16 px-4 border-b border-border-light dark:border-border-dark flex items-center justify-between shrink-0 bg-surface-light dark:bg-surface-dark">
      <!-- Site Logo in Drawer -->
      <a 
        href="/" 
        class="drawer-nav-link inline-flex items-center gap-2 text-base font-bold tracking-tight text-primary-light dark:text-primary-dark hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-accent rounded-lg"
        aria-label="ToolNest Home"
      >
        <span class="w-7 h-7 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-accent shadow-sm">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
          </svg>
        </span>
        <span>ToolNest</span>
      </a>

      <!-- Close Drawer (X) Button (48x48px tap target) -->
      <button
        id="mobile-menu-close"
        type="button"
        class="w-12 h-12 -mr-2 rounded-xl flex items-center justify-center text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 transition-colors focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label="Close menu"
      >
        <svg class="w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Drawer Navigation Content (Scrollable) -->
    <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-4 overscroll-contain" aria-label="Mobile Navigation Links">
      <!-- ALL Tool Links (min 56px height, full-width, emoji + name + chevron) -->
      <div class="space-y-1">
        <div class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark select-none">
          Tools Collection
        </div>
        {navTools.map((tool) => {
          const isActive = currentPath === tool.href;
          return (
            <a
              href={tool.href}
              class:list={[
                'drawer-nav-link group flex items-center justify-between w-full px-3.5 py-3 rounded-xl min-h-[56px] transition-colors focus:outline-none focus:ring-2 focus:ring-accent',
                isActive
                  ? 'text-accent bg-accent/10 dark:bg-accent/15 font-semibold'
                  : 'text-primary-light dark:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 font-medium',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark flex items-center justify-center text-lg select-none shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                  {tool.emoji}
                </span>
                <span class="text-sm sm:text-base">{tool.name}</span>
              </div>
              <svg 
                class:list={[
                  'w-4 h-4 transition-transform group-hover:translate-x-0.5 shrink-0',
                  isActive ? 'text-accent' : 'text-secondary-light dark:text-secondary-dark opacity-50'
                ]} 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2.5" 
                stroke-linecap="round" 
                stroke-linejoin="round"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </a>
          );
        })}
      </div>

      <!-- Secondary Links (About & Privacy Policy) -->
      <div class="pt-3 border-t border-border-light dark:border-border-dark space-y-1">
        <div class="px-3 pb-1 text-[11px] font-bold uppercase tracking-wider text-secondary-light dark:text-secondary-dark select-none">
          Information
        </div>
        <a
          href="/about"
          class:list={[
            'drawer-nav-link group flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl min-h-[48px] text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-accent',
            currentPath === '/about'
              ? 'text-accent bg-accent/10 dark:bg-accent/15 font-semibold'
              : 'text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 font-medium',
          ]}
          aria-current={currentPath === '/about' ? 'page' : undefined}
        >
          <div class="flex items-center gap-3">
            <span class="text-base select-none">ℹ️</span>
            <span>About ToolNest</span>
          </div>
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform group-hover:translate-x-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
        <a
          href="/privacy-policy"
          class:list={[
            'drawer-nav-link group flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl min-h-[48px] text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-accent',
            currentPath === '/privacy-policy'
              ? 'text-accent bg-accent/10 dark:bg-accent/15 font-semibold'
              : 'text-secondary-light dark:text-secondary-dark hover:text-primary-light dark:hover:text-primary-dark hover:bg-black/5 dark:hover:bg-white/5 font-medium',
          ]}
          aria-current={currentPath === '/privacy-policy' ? 'page' : undefined}
        >
          <div class="flex items-center gap-3">
            <span class="text-base select-none">🔒</span>
            <span>Privacy Policy</span>
          </div>
          <svg class="w-3.5 h-3.5 opacity-50 transition-transform group-hover:translate-x-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>
    </nav>

    <!-- Drawer Footer: Dark-Mode Toggle Row -->
    <div class="p-4 border-t border-border-light dark:border-border-dark bg-bg-light/60 dark:bg-bg-dark/60 shrink-0">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-2.5">
          <span id="drawer-theme-icon" class="w-5 h-5 flex items-center justify-center text-secondary-light dark:text-amber-400 shrink-0 select-none">
            <svg class="w-5 h-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="w-5 h-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
          </span>
          <span id="drawer-theme-label" class="text-sm font-semibold text-primary-light dark:text-primary-dark">
            Dark Mode
          </span>
        </div>
        <button
          id="drawer-theme-toggle"
          type="button"
          class="relative inline-flex h-7 w-12 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-accent bg-border-light dark:bg-accent"
          role="switch"
          aria-checked="false"
          aria-label="Toggle dark mode"
        >
          <span
            id="drawer-theme-switch-thumb"
            class="pointer-events-none inline-block h-6 w-6 transform rounded-full bg-white shadow-md ring-0 transition duration-200 ease-in-out translate-x-0 dark:translate-x-5"
          ></span>
        </button>
      </div>
    </div>
  </aside>
</header>

<style>
  /* Animated Hamburger to X transformation */
  button[aria-expanded="true"] .hamburger-line-top {
    transform: translateY(6px) rotate(45deg);
  }
  button[aria-expanded="true"] .hamburger-line-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  button[aria-expanded="true"] .hamburger-line-bot {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle.js';

  let headerCleanup = null;

  function initHeader() {
    // 1. Initialize centralized theme controller
    initThemeToggle();

    // Clean up previous drawer event listeners if already initialized (guards against double-binding)
    if (typeof headerCleanup === 'function') {
      headerCleanup();
      headerCleanup = null;
    }

    const abortController = new AbortController();
    const { signal } = abortController;

    // Drawer Elements
    const menuToggleBtn = document.getElementById('mobile-menu-toggle');
    const menuCloseBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-backdrop');

    // ==========================================
    // MOBILE DRAWER CONTROLLER
    // ==========================================
    if (!menuToggleBtn || !drawer || !backdrop) return;

    let isDrawerOpen = false;

    // Scroll Lock with scrollbar width compensation
    function lockScroll() {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.overflow = 'hidden';
      if (scrollbarWidth > 0) {
        document.documentElement.style.paddingRight = `${scrollbarWidth}px`;
      }
    }

    function unlockScroll() {
      document.documentElement.style.overflow = '';
      document.documentElement.style.paddingRight = '';
    }

    // Get all focusable elements inside drawer for keyboard trap
    function getFocusableElements() {
      return Array.from(
        drawer.querySelectorAll(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function openDrawer() {
      if (isDrawerOpen) return;
      isDrawerOpen = true;

      // Lock background scroll
      lockScroll();

      // Make page content outside drawer inert
      document.querySelectorAll('main, footer').forEach((el) => {
        el.setAttribute('inert', '');
      });

      // Update ARIA states
      menuToggleBtn.setAttribute('aria-expanded', 'true');
      menuToggleBtn.setAttribute('aria-label', 'Close menu');
      drawer.setAttribute('aria-hidden', 'false');

      // Animate backdrop and drawer (transform & opacity only, 250ms)
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100', 'pointer-events-auto');

      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');

      // Move focus into the drawer
      requestAnimationFrame(() => {
        if (menuCloseBtn) {
          menuCloseBtn.focus();
        } else {
          const focusables = getFocusableElements();
          if (focusables.length > 0) focusables[0].focus();
        }
      });
    }

    function closeDrawer(restoreFocus = true) {
      if (!isDrawerOpen) return;
      isDrawerOpen = false;

      // Unlock background scroll
      unlockScroll();

      // Remove inert from page content
      document.querySelectorAll('main, footer').forEach((el) => {
        el.removeAttribute('inert');
      });

      // Update ARIA states
      menuToggleBtn.setAttribute('aria-expanded', 'false');
      menuToggleBtn.setAttribute('aria-label', 'Open menu');
      drawer.setAttribute('aria-hidden', 'true');

      // Animate backdrop and drawer out
      backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop.classList.add('opacity-0', 'pointer-events-none');

      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');

      // Return focus to the hamburger toggle button
      if (restoreFocus && menuToggleBtn) {
        menuToggleBtn.focus();
      }
    }

    // Toggle click on hamburger button
    menuToggleBtn.addEventListener(
      'click',
      () => {
        if (isDrawerOpen) {
          closeDrawer();
        } else {
          openDrawer();
        }
      },
      { signal }
    );

    // Close button click
    if (menuCloseBtn) {
      menuCloseBtn.addEventListener('click', () => closeDrawer(), { signal });
    }

    // Backdrop click
    backdrop.addEventListener('click', () => closeDrawer(), { signal });

    // Link click: navigate normally, close drawer smoothly
    drawer.querySelectorAll('.drawer-nav-link').forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          // Close drawer without snapping focus back to hamburger since user is navigating
          closeDrawer(false);
        },
        { signal }
      );
    });

    // Keyboard Management: Escape to close, Tab focus trapping
    document.addEventListener(
      'keydown',
      (e) => {
        if (!isDrawerOpen) return;

        // Escape Key
        if (e.key === 'Escape') {
          e.preventDefault();
          closeDrawer();
          return;
        }

        // Focus Trap (Tab & Shift+Tab cycling)
        if (e.key === 'Tab') {
          const focusables = getFocusableElements();
          if (focusables.length === 0) return;

          const firstElement = focusables[0];
          const lastElement = focusables[focusables.length - 1];

          if (e.shiftKey) {
            // Shift + Tab
            if (document.activeElement === firstElement) {
              e.preventDefault();
              lastElement.focus();
            }
          } else {
            // Tab
            if (document.activeElement === lastElement) {
              e.preventDefault();
              firstElement.focus();
            }
          }
        }
      },
      { signal }
    );

    // Register cleanup function for next lifecycle run
    headerCleanup = () => {
      if (isDrawerOpen) {
        unlockScroll();
        document.querySelectorAll('main, footer').forEach((el) => {
          el.removeAttribute('inert');
        });
      }
      abortController.abort();
    };
  }

  // Initialize on load and on Astro view swaps
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>

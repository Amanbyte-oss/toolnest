---
/**
 * src/components/Breadcrumbs.astro
 * Accessible, semantic breadcrumb navigation matching Schema.org BreadcrumbList.
 */
import { getNamespace, getLocalizedPath, type Lang } from '../i18n';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface Props {
  items?: BreadcrumbItem[];
  lang?: Lang;
}

const { items = [], lang = 'en' } = Astro.props;
const common = getNamespace(lang, 'common');

if (!items || items.length === 0) {
  return null;
}

const homePath = getLocalizedPath('/', lang);
const filteredItems = items.filter((b) => b.item !== homePath && b.item !== '/');

// For tool pages (single item not being about/contact/privacy/terms/faq/sitemap), insert Tools directory crumb
const isNonToolPage = filteredItems.some((b) => 
  b.item.includes('about') || b.item.includes('contact') || b.item.includes('privacy') || 
  b.item.includes('terms') || b.item.includes('faq') || b.item.includes('sitemap')
);

const allItems = [
  { name: common.nav?.home || 'Home', item: homePath },
  ...(!isNonToolPage && filteredItems.length === 1
    ? [{ name: common.nav?.toolsDropdown || 'Tools', item: getLocalizedPath('/sitemap-page', lang) }]
    : []),
  ...filteredItems,
];
---

<nav aria-label="Breadcrumb" class="w-full pb-4 pt-1">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-secondary-light dark:text-secondary-dark" itemscope itemtype="https://schema.org/BreadcrumbList">
    {allItems.map((crumb, idx) => {
      const isLast = idx === allItems.length - 1;
      return (
        <li
          class="inline-flex items-center gap-1.5"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          <meta itemprop="position" content={String(idx + 1)} />
          {isLast ? (
            <span
              class="font-semibold text-primary-light dark:text-primary-dark truncate max-w-[200px] sm:max-w-none"
              aria-current="page"
              itemprop="name"
            >
              {crumb.name}
            </span>
          ) : (
            <>
              <a
                href={crumb.item}
                class="hover:text-accent dark:hover:text-accent transition-colors underline-offset-2 hover:underline"
                itemprop="item"
              >
                <span itemprop="name">{crumb.name}</span>
              </a>
              <svg
                class="w-3 h-3 text-secondary-light/60 dark:text-secondary-dark/60 shrink-0 select-none rtl:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>

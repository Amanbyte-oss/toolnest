---
/**
 * src/components/Seo.astro
 * Wrapper around LocalizedHead for backward compatibility.
 */
import LocalizedHead, { type BreadcrumbItem } from './LocalizedHead.astro';
import type { Lang } from '../i18n';

export type { BreadcrumbItem };

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: BreadcrumbItem[];
  extraSchemas?: Record<string, any>[];
  noindex?: boolean;
  lang?: Lang;
  metaKey?: string;
}

const props = Astro.props;
---

<LocalizedHead {...props} />

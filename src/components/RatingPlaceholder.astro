---
/**
 * src/components/RatingPlaceholder.astro
 * Safe aggregate rating component.
 * To avoid Google rich snippet penalties, ONLY renders schema and UI if real verified rating data is provided.
 */

export interface RatingData {
  ratingValue: number;
  reviewCount: number;
  bestRating?: number;
  worstRating?: number;
}

export interface Props {
  rating?: RatingData | null;
}

const { rating = null } = Astro.props;

const hasRealData =
  rating &&
  typeof rating.ratingValue === 'number' &&
  typeof rating.reviewCount === 'number' &&
  rating.reviewCount > 0;
---

{hasRealData && (
  <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-secondary-light dark:text-secondary-dark">
    <div class="flex items-center text-amber-400 select-none" aria-hidden="true">
      {'★'.repeat(Math.round(rating.ratingValue))}
    </div>
    <span>
      {rating.ratingValue.toFixed(1)} ({rating.reviewCount.toLocaleString()} user reviews)
    </span>
  </div>
)}

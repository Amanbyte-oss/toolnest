---
/**
 * HistoryCard.astro
 * Standardized client-side history card for all tools.
 * Collapsible, accessible, mobile-first, and styled to the slate grey theme.
 */
import { getLangFromPath, getNamespace, type Lang } from '../i18n';

interface Props {
  toolId: string;
  title?: string;
  icon?: string;
  lang?: Lang;
}

const currentPath = Astro.url.pathname;
const detectedLang = getLangFromPath(currentPath);
const {
  toolId,
  title,
  icon = '🕘',
  lang = detectedLang,
} = Astro.props;

const common = getNamespace(lang, 'common');
const displayTitle = title || common.recentActivity || 'Recent Activity';
---

<section
  id={`history-card-${toolId}`}
  class="card p-4 sm:p-5 space-y-3 transition-all"
  aria-labelledby={`history-title-${toolId}`}
>
  <!-- Card Header / Collapsible Toggle -->
  <div class="flex items-center justify-between">
    <button
      id={`history-toggle-${toolId}`}
      type="button"
      class="flex items-center gap-2.5 text-left font-bold text-primary-light dark:text-primary-dark group cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent rounded-lg py-1 px-1 -ml-1 transition-colors"
      aria-expanded="false"
      aria-controls={`history-content-${toolId}`}
    >
      <span class="w-5 h-5 flex items-center justify-center text-accent shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </span>
      <span id={`history-title-${toolId}`} class="text-sm sm:text-base group-hover:text-accent transition-colors">
        {displayTitle}
      </span>
      <span
        id={`history-count-badge-${toolId}`}
        class="hidden px-2 py-0.5 rounded-full text-[11px] font-semibold bg-bg-light dark:bg-bg-dark border border-border-light dark:border-border-dark text-secondary-light dark:text-secondary-dark"
      >
        0
      </span>
      <svg
        id={`history-chevron-${toolId}`}
        class="w-4 h-4 text-secondary-light dark:text-secondary-dark transition-transform duration-200"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </button>

    <!-- Clear All with Inline Confirm -->
    <div class="flex items-center gap-2">
      <button
        id={`history-clear-prompt-${toolId}`}
        type="button"
        class="hidden text-xs font-semibold text-secondary-light hover:text-red-500 dark:text-secondary-dark dark:hover:text-red-400 transition-colors px-2 py-1 rounded focus:outline-none focus:ring-2 focus:ring-accent"
        aria-label={`${common.clearAll || 'Clear all'} ${displayTitle}`}
      >
        {common.clearAll || 'Clear all'}
      </button>

      <div
        id={`history-confirm-box-${toolId}`}
        class="hidden items-center gap-2 text-xs bg-red-500/10 dark:bg-red-500/20 border border-red-500/30 rounded-lg px-2.5 py-1"
      >
        <span class="text-red-600 dark:text-red-400 font-medium">{common.clearAllConfirm || 'Clear all?'}</span>
        <button
          id={`history-confirm-yes-${toolId}`}
          type="button"
          class="font-bold text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 underline focus:outline-none"
        >
          {common.yes || 'Yes'}
        </button>
        <button
          id={`history-confirm-no-${toolId}`}
          type="button"
          class="text-secondary-light dark:text-secondary-dark hover:underline focus:outline-none ml-1"
        >
          {common.cancel || 'Cancel'}
        </button>
      </div>
    </div>
  </div>

  <!-- Collapsible Body -->
  <div
    id={`history-content-${toolId}`}
    class="hidden space-y-3 pt-1 border-t border-border-light dark:border-border-dark"
  >
    <!-- Live Region for screen readers -->
    <div id={`history-live-${toolId}`} class="sr-only" aria-live="polite"></div>

    <!-- Empty State -->
    <div
      id={`history-empty-${toolId}`}
      class="py-5 px-4 text-center space-y-1.5 rounded-xl bg-input-light/30 dark:bg-input-dark/30 border border-dashed border-border-light dark:border-border-dark"
    >
      <div class="w-8 h-8 mx-auto rounded-full bg-surface-light dark:bg-surface-dark flex items-center justify-center text-secondary-light/60 dark:text-secondary-dark/60 shadow-xs">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <p class="text-xs sm:text-sm font-medium text-secondary-light dark:text-secondary-dark">
        {common.recentCalculations || 'No recent calculations saved yet'}
      </p>
      <p class="text-[11px] text-secondary-light/80 dark:text-secondary-dark/80">
        {common.entriesSavedPrivately || 'Your entries are automatically saved privately on this device.'}
      </p>
    </div>

    <!-- Dynamic History Items List -->
    <div
      id={`history-list-${toolId}`}
      class="space-y-2 hidden"
      role="list"
      aria-label={`${displayTitle}`}
    >
      <!-- Populated dynamically by initHistoryCard in src/scripts/history.js -->
    </div>
  </div>
</section>

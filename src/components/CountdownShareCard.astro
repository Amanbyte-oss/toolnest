---
interface Props {
  id?: string;
}

const { id = 'countdown-share-card' } = Astro.props;
---

<!-- Hidden Offscreen Render Target for High-Resolution PNG Export (540x675 at 2x = 1080x1350) -->
<div
  id={id}
  class="fixed pointer-events-none z-[-100] select-none text-slate-900 overflow-hidden font-sans"
  style="position: fixed; left: -9999px; top: 0; width: 540px; height: 675px; min-width: 540px; min-height: 675px; max-width: 540px; max-height: 675px; background: linear-gradient(145deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%);"
  aria-hidden="true"
>
  <!-- Card Container (Sticker style with rounded border & subtle shadow) -->
  <div class="w-full h-full p-9 flex flex-col justify-between relative box-border border-2 border-slate-300/90 rounded-[40px] bg-gradient-to-b from-white/95 via-slate-50/90 to-slate-100/90 shadow-2xl">
    <!-- Top Decorative Line -->
    <div class="absolute top-0 left-12 right-12 h-1.5 bg-gradient-to-r from-indigo-500 via-rose-500 to-amber-400 rounded-full"></div>

    <!-- Header Section -->
    <div class="text-center space-y-2 pt-2">
      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-indigo-50 text-indigo-600 border border-indigo-200/70 shadow-sm">
        <span class="text-sm">⏳</span>
        <span>Live Countdown</span>
      </div>

      <!-- Emoji -->
      <div data-card-emoji class="text-6xl leading-none my-1 filter drop-shadow-sm select-none">
        🎉
      </div>

      <!-- Title (max 2 lines with ellipsis) -->
      <h2
        data-card-title
        class="text-3xl font-black text-slate-900 tracking-tight leading-tight line-clamp-2 max-h-[4.5rem] break-words px-2"
      >
        Event Title
      </h2>

      <!-- Target Date Line -->
      <p data-card-target-date class="text-sm font-semibold text-slate-600 tracking-normal">
        Friday, 25 June 2026
      </p>

      <!-- Optional Elapsed Progress Bar (between created & target) -->
      <div data-card-progress-container class="hidden pt-1 max-w-xs mx-auto w-full space-y-1">
        <div class="w-full bg-slate-200/90 rounded-full h-2 overflow-hidden border border-slate-300/50">
          <div data-card-progress-bar class="bg-gradient-to-r from-indigo-500 to-rose-500 h-full rounded-full transition-all duration-300" style="width: 0%;"></div>
        </div>
        <div class="flex justify-between items-center text-[10px] font-bold text-slate-500 px-0.5">
          <span data-card-progress-start>Created</span>
          <span data-card-progress-pct class="text-indigo-600 font-mono">0% elapsed</span>
          <span>Target</span>
        </div>
      </div>
    </div>

    <!-- Center Section: Active 4-Unit Timer OR Celebratory Banner -->
    <div class="my-auto py-2">
      <!-- ACTIVE TIMER: 4 Big Unit Cards -->
      <div data-card-timer-grid class="grid grid-cols-4 gap-2.5 w-full">
        <!-- Days -->
        <div class="p-3.5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col items-center justify-center">
          <span data-card-days class="font-mono text-4xl font-black text-indigo-600 block tabular-nums tracking-tight leading-none">
            00
          </span>
          <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 mt-2">
            Days
          </span>
        </div>

        <!-- Hours -->
        <div class="p-3.5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col items-center justify-center">
          <span data-card-hours class="font-mono text-4xl font-black text-slate-800 block tabular-nums tracking-tight leading-none">
            00
          </span>
          <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 mt-2">
            Hours
          </span>
        </div>

        <!-- Minutes -->
        <div class="p-3.5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col items-center justify-center">
          <span data-card-minutes class="font-mono text-4xl font-black text-slate-800 block tabular-nums tracking-tight leading-none">
            00
          </span>
          <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 mt-2">
            Mins
          </span>
        </div>

        <!-- Seconds -->
        <div class="p-3.5 rounded-2xl bg-white border border-slate-200/90 shadow-sm flex flex-col items-center justify-center">
          <span data-card-seconds class="font-mono text-4xl font-black text-slate-800 block tabular-nums tracking-tight leading-none">
            00
          </span>
          <span class="text-[10px] uppercase tracking-wider font-bold text-slate-500 mt-2">
            Secs
          </span>
        </div>
      </div>

      <!-- CELEBRATION STATE (Shown when time has elapsed) -->
      <div
        data-card-celebration
        class="hidden p-6 rounded-3xl bg-gradient-to-br from-amber-50 via-rose-50 to-purple-50 border-2 border-amber-300/80 shadow-md text-center space-y-2"
      >
        <div class="text-3xl sm:text-4xl leading-none">🎉</div>
        <h3 class="text-2xl font-black text-amber-600 tracking-tight">
          It's here!
        </h3>
        <p data-card-elapsed-text class="text-xs sm:text-sm font-semibold text-slate-700 leading-snug">
          The moment has arrived!
        </p>
      </div>
    </div>

    <!-- Bottom Watermark & Branding Strip -->
    <div class="pt-3 border-t border-slate-200 flex items-center justify-between text-xs font-semibold text-slate-500">
      <div class="flex items-center gap-1.5 text-slate-700 font-bold">
        <span>⏳</span>
        <span>made with ToolNest</span>
      </div>
      <div class="font-mono text-[11px] text-slate-500 font-medium tracking-tight">
        toolnest.pages.dev
      </div>
    </div>
  </div>
</div>

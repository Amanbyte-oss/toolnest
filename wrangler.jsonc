{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolnest",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true
}